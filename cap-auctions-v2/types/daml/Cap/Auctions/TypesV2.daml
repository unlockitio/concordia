module Cap.Auctions.TypesV2
  ( Direction (..)
  , Quote (..)
  , AllocationTerms (..)
  , AuctionTerms (..)
  , AuctionSchedule (..)
  , SettlementBatch (..)
  ) where

import DA.Map (Map)
import DA.Time (RelTime)

import Splice.Api.Token.AllocationV2 (FinalizedAllocation, SettlementFactory, TransferLeg)
import Splice.Api.Token.HoldingV2 (InstrumentId)
import Splice.Api.Token.MetadataV1 (ExtraArgs)

data Direction
  = Forward
  | Reverse
  deriving (Eq, Show)

data Quote = Quote
  with
    price : Decimal
    quantity : Decimal
  deriving (Eq, Show, Ord)

data AllocationTerms = AllocationTerms
  with
    settlementWindow : RelTime
    -- ^ The settlement deadline of every allocation of an auction is the
    -- biddingClosesAt of the auction's schedule plus settlementWindow.
    committed : Bool
  deriving (Eq, Show)

data AuctionTerms = AuctionTerms
  with
    direction : Direction
    lots : Map InstrumentId Decimal
    payment : InstrumentId
    settleFactories : Map Party (ContractId SettlementFactory)
    allocationTerms : AllocationTerms
  deriving (Eq, Show)

data AuctionSchedule = AuctionSchedule
  with
    biddingOpensAt : Time
    biddingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

data SettlementBatch = SettlementBatch
  with
    factoryCid : ContractId SettlementFactory
    legs : [TransferLeg]
    allocations : [FinalizedAllocation]
    extraArgs : ExtraArgs
  deriving (Eq, Show)
