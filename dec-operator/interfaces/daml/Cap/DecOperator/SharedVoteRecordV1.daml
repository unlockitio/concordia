-- SPDX-License-Identifier: Apache-2.0

-- | A shared vote record holds the options of one decision and the members' votes
-- on it. Each app writes its own shared vote record template, because the options
-- have the app's action type. This interface lets the DecOperator service and
-- other clients read any app's shared vote records without the app's code.
--
-- The interface has no choices. Votes are cast and shared vote records are closed
-- through `DecOperatorRules`, so they are always counted against the member
-- list of the current rules contract.
module Cap.DecOperator.SharedVoteRecordV1 where

import DA.Map (Map)

import Splice.Api.Token.MetadataV1

import Cap.Core.Types (AuthenticKey, Identity, Snapshot)

import Cap.DecOperator.Types (CastVote, Reason)

data SharedVoteRecordView = SharedVoteRecordView
  with
    governance : AuthenticKey
    -- ^ The decentralized operator's governance key, the same as in `DecOperatorRulesView`.
    requester : Identity
    reason : Reason
    options : [Text]
    -- ^ The action of each option, rendered by the app. MUST match the action that executes.
    mechanism : Text
    -- ^ The name of the mechanism that decides the shared vote record. The
    -- requester chooses it among the mechanisms the app allows for the
    -- options. Clients read it to encode a vote and to show the tally.
    voteBefore : Time
    effectiveAt : Optional Time
    -- ^ None: an accepted action executes when the shared vote record closes.
    votes : Map Identity CastVote
    -- ^ Members without an entry have not voted.
    targets : Map AuthenticKey Snapshot
    -- ^ The contracts the options change, found by key through `KeyedTarget`.
    meta : Metadata
  deriving (Eq, Show)

interface SharedVoteRecord where
  viewtype SharedVoteRecordView
