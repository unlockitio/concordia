-- | The `Auction` interface: a contract that is one auction — it admits bids
-- while live and is consumed by exactly one resolution (or cancellation).
--
-- `Auction` requires `Mechanism` (cap-core): an auction is a mechanism. The
-- Mechanism face carries the operator (singleton `authorities`), the bidding
-- window, and the completeness switch. `Mechanism` has no choices, so
-- `Auction_Resolve` stays the one resolve door.
--
-- Design invariant carried by the standard (normative, documented, not
-- compiler-enforced): the auction contract is immutable from creation to
-- resolution — consumed exactly once, by `Auction_Resolve` or
-- `Auction_Cancel`, never archived-and-recreated. All evolving state (a
-- price ticker, a current-high-bid display, an admitted-bid registry) lives
-- in implementation companion contracts. This is what makes
-- `ContractId Auction` a stable, unforgeable auction identity for the whole
-- bidding window, makes the auction contract's existence mean "not yet
-- resolved", and makes double resolution impossible by construction rather
-- than by a status flag.
--
-- The interface names no seller: the only party roles are `operator`, `bidder`,
-- and `executor`/`beneficiary`. Sellers are template parties, which is what lets
-- forward, reverse, and double formats share the family.
module Cap.Auctions.AuctionV1 where

import DA.Foldable (forA_)
import DA.Action (void)

import Splice.Api.Token.MetadataV1
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1
import Cap.Core.TimeV1 (checkWindow, checkFloor)
import Cap.Core.ChecksV1
import Cap.Auctions.TypesV1
import Cap.Auctions.BidV1
import Cap.Auctions.OutcomeV1

-- | View of a live (not yet resolved) auction. The bidding window lives on
-- the Mechanism face, not here.
data AuctionView = AuctionView
  with
    auctionId : AuctionId
    meta : Metadata
  deriving (Eq, Show)

data Auction_SubmitBidResult = Auction_SubmitBidResult
  with
    bidCid : ContractId Bid
    meta : Metadata
  deriving (Eq, Show)

data Auction_ResolveResult = Auction_ResolveResult
  with
    outcomeCids : [ContractId AuctionOutcome]
      -- ^ One per obligation. May be empty (a rejection, a reserve not met).
      -- Typed, so a parent transaction can resolve and settle atomically.
    meta : Metadata
  deriving (Eq, Show)

data Auction_CancelResult = Auction_CancelResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Auction requires Mechanism where
  viewtype AuctionView

  auction_submitBidImpl : ContractId Auction -> Auction_SubmitBid -> Update Auction_SubmitBidResult
    -- ^ The admission policy: gates eligibility and any close earlier or more
    -- dynamic than a declared `submissionClosesAt` bound the fixed window
    -- enforces (`None` leaves the close entirely here), validates the
    -- escrow named in `extraArgs.context` completely (executor, settlement
    -- reference pinned to `self`, leg, expiry), and mints the bid with
    -- `self` baked in — under the auction signatories' authority, which is
    -- what makes the binding unforgeable.
  auction_resolveImpl : ContractId Auction -> Auction_Resolve -> Update Auction_ResolveResult
    -- ^ The pricing rule. MUST validate every bid it prices (downcast to its
    -- own bid template, assert the `auction == self` binding, timing) and emit
    -- one outcome per obligation. Consumes bids via their pre-agreed choices,
    -- not bare archives (the source of the bidder's authority) — under
    -- completeness, whenever it chooses, but leaving none permanently orphaned.
    -- MUST NOT consume a bid while leaving its escrow locked: a loser's
    -- escrow is returned here or left recoverable.
  auction_cancelImpl : ContractId Auction -> Auction_Cancel -> Update Auction_CancelResult
    -- ^ MUST release every bid passed to it; stragglers it misses remain
    -- recoverable via `Bid_Withdraw`.

  -- | THE admission path — bids come into existence only here. Nonconsuming, so
  -- concurrent bidders never contend and (on Canton) do not learn of each
  -- other's submissions. Controller is the bidder alone, but the body also runs
  -- with the auction signatories' authority, letting the impl create a bid
  -- co-signed by the auction — the root of every downstream integrity property.
  -- The fixed body enforces the declared window; the format's earlier or moving
  -- close is `auction_submitBidImpl`'s.
  nonconsuming choice Auction_SubmitBid : Auction_SubmitBidResult
    with
      bidder : Party
      bidData : AnyValue
        -- ^ Format-specific payload — a commitment hash for sealed formats,
        -- an open value otherwise; each format documents its encoding.
      extraArgs : ExtraArgs
        -- ^ Escrow reference (reserved keys), disclosure context, …
    controller bidder
    do
      now <- getTime
      let mv = view (toInterface @Mechanism this)
      checkWindow "submissions are open" now mv.submissionOpensAt mv.submissionClosesAt
      auction_submitBidImpl this self arg

  -- | The pricing rule. Consumes the auction contract: an auction resolves at
  -- most once, by construction. Without completeness an omitted bid stays live
  -- and bidder-withdrawable, so censorship stalls a resolution but cannot take
  -- funds; under completeness the gate demands the exact slot cover, so an
  -- omitted bid aborts the resolution instead.
  choice Auction_Resolve : Auction_ResolveResult
    with
      bidCids : [ContractId Bid]
      evidence : [ContractId Submittable]
        -- ^ The non-bid slot artifacts under completeness — registration tickets
        -- never bid on, withdrawal receipts — as their Submittable face.
        -- Must be empty when the auction declares no completeness.
      extraArgs : ExtraArgs
    controller (view this).auctionId.operator
    do
      let rv = view (toInterface @Mechanism this)
      now <- getTime
      checkFloor "resolution does not precede the submission open" now rv.submissionOpensAt
      case rv.size of
        None -> assertMsg "evidence without completeness" (null evidence)
        Some n -> do
          -- a full submittable is a bid; routing it through `evidence`
          -- would cover its slot while hiding it from the pricing rule
          forA_ evidence $ \ecid -> do
            e <- fetch ecid
            assertMsg "a full submittable must be priced as a bid"
              ((view e).state /= S_Full)
          void $ admitSubmittablesWithCompleteness n
            (toInterfaceContractId @Mechanism self)
            (toInterface this)
            (map (toInterfaceContractId @Submittable) bidCids <> evidence)
      auction_resolveImpl this self arg

  -- | Call the auction off. Consuming for the same once-only reason.
  choice Auction_Cancel : Auction_CancelResult
    with
      bidCids : [ContractId Bid]
      extraArgs : ExtraArgs
    controller (view this).auctionId.operator
    do auction_cancelImpl this self arg
