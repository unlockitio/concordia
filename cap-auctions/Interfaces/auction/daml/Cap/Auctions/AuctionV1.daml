-- | The `Auction` interface: a contract that is one auction — it admits bids
-- while live and is consumed by exactly one resolution (or cancellation).

module Cap.Auctions.AuctionV1 where

import DA.Foldable (forA_)
import DA.Action (void)

import Splice.Api.Token.MetadataV1
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1
import Cap.Core.TimeV1 (checkWindow, checkFloor)
import Cap.Core.ChecksV1
import Cap.Auctions.TypesV1
import Cap.Auctions.BidV1
import Cap.Auctions.OutcomeV1

-- | View of a live (not yet resolved) auction. The bidding window lives on
-- the Mechanism interface, not here.
data AuctionView = AuctionView
  with
    auctionId : AuctionId
    meta : Metadata
  deriving (Eq, Show)

data Auction_SubmitBidResult = Auction_SubmitBidResult
  with
    bidCid : ContractId Bid
    meta : Metadata
  deriving (Eq, Show)

data Auction_ResolveResult = Auction_ResolveResult
  with
    outcomeCids : [ContractId AuctionOutcome]
      -- ^ One per obligation. May be empty (a rejection, a reserve not met).
      -- Typed, so a parent transaction can resolve and settle atomically.
    meta : Metadata
  deriving (Eq, Show)

data Auction_CancelResult = Auction_CancelResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Auction requires Mechanism where
  viewtype AuctionView

  auction_submitBidImpl : ContractId Auction -> Auction_SubmitBid -> Update Auction_SubmitBidResult
    -- ^ The admission hook
  auction_resolveImpl : ContractId Auction -> Auction_Resolve -> Update Auction_ResolveResult
    -- ^ The pricing rule. MUST validate every bid it prices (downcast to its
    -- own bid template, assert the `auction == self` binding, timing) and emit
    -- one outcome per obligation. 
  auction_cancelImpl : ContractId Auction -> Auction_Cancel -> Update Auction_CancelResult
    -- ^ MUST release every bid passed to it; stragglers it misses remain
    -- recoverable via `Bid_Withdraw`.

  
  nonconsuming choice Auction_SubmitBid : Auction_SubmitBidResult
    with
      bidder : Party
      bidData : AnyValue
        -- ^ Format-specific payload — a commitment hash for sealed formats,
        -- an open value otherwise; each format documents its encoding.
      extraArgs : ExtraArgs
        -- ^ Escrow reference (reserved keys), disclosure context, …
    controller bidder
    do
      now <- getTime
      let mv = view (toInterface @Mechanism this)
      checkWindow "submissions are open" now mv.submissionOpensAt mv.submissionClosesAt
      auction_submitBidImpl this self arg

  choice Auction_Resolve : Auction_ResolveResult
    with
      bidCids : [ContractId Bid]
      evidence : [ContractId Submittable]
        -- ^ The non-bid slot artifacts under completeness
      extraArgs : ExtraArgs
    controller (view this).auctionId.operator
    do
      let rv = view (toInterface @Mechanism this)
      now <- getTime
      checkFloor "resolution does not precede the submission open" now rv.submissionOpensAt
      case rv.size of
        None -> assertMsg "evidence without completeness" (null evidence)
        Some n -> do
          -- a full submittable is a bid; routing it through `evidence`
          -- would cover its slot while hiding it from the pricing rule
          forA_ evidence $ \ecid -> do
            e <- fetch ecid
            assertMsg "a full submittable must be priced as a bid"
              ((view e).state /= S_Full)
          void $ admitSubmittablesWithCompleteness n
            (toInterfaceContractId @Mechanism self)
            (toInterface this)
            (map (toInterfaceContractId @Submittable) bidCids <> evidence)
      auction_resolveImpl this self arg

  -- | Call the auction off. Consuming for the same once-only reason.
  choice Auction_Cancel : Auction_CancelResult
    with
      bidCids : [ContractId Bid]
      extraArgs : ExtraArgs
    controller (view this).auctionId.operator
    do auction_cancelImpl this self arg
