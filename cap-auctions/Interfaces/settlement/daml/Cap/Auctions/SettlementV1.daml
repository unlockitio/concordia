module Cap.Auctions.SettlementV1 where

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.Util (require)
import Cap.Core.Utils (admitActors, ExecutionCore, requireExpired, requireOpen)
import Cap.Auctions.RegistryV1 (SettlementFactoryCall)

data SettlementBatch = SettlementBatch
  with
    leg : Alloc.TransferLeg
    sender : Alloc.FinalizedAllocation
    receiver : Alloc.FinalizedAllocation
    factory : SettlementFactoryCall
  deriving (Eq, Show)

data SettlementView = SettlementView
  with
    core : ExecutionCore
    settlement : Alloc.SettlementInfo
    batches : [SettlementBatch]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_SettleResult = Settlement_SettleResult
  with
    batches : [Alloc.SettlementFactory_SettleBatchResult]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_CancelResult = Settlement_CancelResult
  with
    released : [ContractId Alloc.Allocation]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_ExpireResult = Settlement_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)



interface Settlement where
  viewtype SettlementView

  settlement_cancelImpl : Settlement_Cancel -> Update Settlement_CancelResult

  choice Settlement_Settle : Settlement_SettleResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      let v = view this
      now <- getTime
      requireOpen "the settlement window is open" now v.core.opensAt v.core.expiresAt
      require "the actors are an executor set of this settlement"
        (admitActors v.core.executors actors)
      require "the settlement moves at least one leg" (not (null v.batches))
      results <- forA v.batches $ \b ->
        exercise b.factory.factoryCid Alloc.SettlementFactory_SettleBatch with
          settlement = v.settlement
          transferLegs = [b.leg]
          allocations = [b.sender, b.receiver]
          actors = v.settlement.executors
          extraArgs = b.factory.settleBatchArgs
      pure Settlement_SettleResult with batches = results; meta = emptyMetadata

  choice Settlement_Cancel : Settlement_CancelResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are an executor set of this settlement"
        (admitActors (view this).core.executors actors)
      settlement_cancelImpl this (Settlement_Cancel with actors; extraArgs)

  choice Settlement_Expire : Settlement_ExpireResult
    with
      actor : Party
    controller actor
    do
      now <- getTime
      requireExpired "the settlement has expired" now (view this).core.expiresAt
      pure Settlement_ExpireResult with meta = emptyMetadata


allocationsOf : SettlementView -> [ContractId Alloc.Allocation]
allocationsOf v =
  concat [[b.sender.allocationCid, b.receiver.allocationCid] | b <- v.batches]