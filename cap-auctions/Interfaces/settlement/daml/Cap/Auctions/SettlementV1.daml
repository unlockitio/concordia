module Cap.Auctions.SettlementV1 where

import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.Util (require)
import Cap.Core.Utils (entitled, ExecutionAction (..), ExecutionCore, requireExpired, requireOpen)

data SettlementBatch = SettlementBatch
  with
    legs : [Alloc.TransferLeg]
    allocations : [Alloc.FinalizedAllocation]
    factoryCid : ContractId Alloc.SettlementFactory
  deriving (Eq, Show)

data SettlementView = SettlementView
  with
    core : ExecutionCore
    settlement : Alloc.SettlementInfo
    batches : [SettlementBatch]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_SettleResult = Settlement_SettleResult
  with
    batches : [Alloc.SettlementFactory_SettleBatchResult]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_CancelResult = Settlement_CancelResult
  with
    released : [ContractId Alloc.Allocation]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_ExpireResult = Settlement_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)



interface Settlement where
  viewtype SettlementView

  settlement_cancelImpl : Settlement_Cancel -> Update Settlement_CancelResult

  choice Settlement_Settle : Settlement_SettleResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      let v = view this
      now <- getTime
      requireOpen "the settlement window is open" now v.core.opensAt v.core.expiresAt
      require "the actors are entitled to settle"
        (entitled v.core.availableActions EA_Execute actors)
      require "every batch of the settlement moves at least one leg"
        (not (null v.batches) && all (\b -> not (null b.legs)) v.batches)
      results <- forA v.batches $ \b -> do
        forA_ b.allocations $ \fa -> do
          a <- fetch fa.allocationCid
          require "the allocation is signed by the admin it names"
            ((view a).allocation.admin `elem` signatory a)
        exercise b.factoryCid Alloc.SettlementFactory_SettleBatch with
          settlement = v.settlement
          transferLegs = b.legs
          allocations = b.allocations
          actors = v.settlement.executors
          extraArgs
      pure Settlement_SettleResult with batches = results; meta = emptyMetadata

  choice Settlement_Cancel : Settlement_CancelResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to cancel"
        (entitled (view this).core.availableActions EA_Cancel actors)
      settlement_cancelImpl this (Settlement_Cancel with actors; extraArgs)

  choice Settlement_Expire : Settlement_ExpireResult
    with
      actor : Party
    controller actor
    do
      now <- getTime
      requireExpired "the settlement has expired" now (view this).core.expiresAt
      pure Settlement_ExpireResult with meta = emptyMetadata