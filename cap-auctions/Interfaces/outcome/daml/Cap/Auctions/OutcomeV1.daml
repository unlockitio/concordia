-- | The `AuctionOutcome` interface: a contract that is one settlement
-- obligation produced by a resolution 

module Cap.Auctions.OutcomeV1 where

import Splice.Api.Token.MetadataV1
import Cap.Auctions.TypesV1

-- | View of a settlement obligation.
data AuctionOutcomeView = AuctionOutcomeView
  with
    auctionId : AuctionId
    beneficiary : Party
      -- ^ The winner / matched party this obligation awards to.
    settleBefore : Optional Time
      -- ^ Settlement deadline; None = no deadline. The view *displays* it; the
      -- settle/fail impls *enforce* it, alongside the token layer's own
      -- wallet-side `settleBefore` on the escrow allocations.
    meta : Metadata

  deriving (Eq, Show)

data AuctionOutcome_SettleResult = AuctionOutcome_SettleResult
  with
    meta : Metadata
  deriving (Eq, Show)

data AuctionOutcome_FailResult = AuctionOutcome_FailResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface AuctionOutcome where
  viewtype AuctionOutcomeView

  isExecutor : [Party] -> Bool


  auctionOutcome_settleImpl : ContractId AuctionOutcome -> AuctionOutcome_Settle -> Update AuctionOutcome_SettleResult
    -- ^ MUST validate every settlement leg named in `extraArgs.context` exactly
    -- — amount, sender, receiver, instrument, and settlement reference tied to
    -- `self` — and execute all legs in this one transaction (DvP atomicity).
  auctionOutcome_failImpl : ContractId AuctionOutcome -> AuctionOutcome_Fail -> Update AuctionOutcome_FailResult
    -- ^ Makes parties whole per the implementation's declared policy
    -- (return the lot, refund or seize deposits). MUST NOT run while the
    -- settlement window is still open.


  choice AuctionOutcome_Settle : AuctionOutcome_SettleResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      assertMsg "actors are not an executor set" (isExecutor this actors)
      auctionOutcome_settleImpl this self arg

  choice AuctionOutcome_Fail : AuctionOutcome_FailResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      assertMsg "actors are not an executor set" (isExecutor this actors)
      auctionOutcome_failImpl this self arg
