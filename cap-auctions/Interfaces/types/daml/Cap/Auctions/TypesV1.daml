-- | Auction-specific shared data. The generic shapes 

module Cap.Auctions.TypesV1 where


data AuctionId = AuctionId
  with
    operator : Party
    id : Text
      -- ^ Operator-scoped; unique per operator by that operator's discipline.
  deriving (Eq, Ord, Show)
