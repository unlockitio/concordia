module Cap.Auctions.Tests.Fixtures where

import DA.Action (unless)
import DA.Date (Month (..), date)
import qualified DA.Map as Map
import DA.Map (Map)
import DA.Optional (fromSome)
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime, days, hours, time)
import Daml.Script

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.HoldingV2 (InstrumentId (..))
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.TokenStandard.Utils (basicAccount)

import Cap.Core.Types (AuthenticKey (..), ResolutionInfo (..))
import Cap.Auctions.Types
  ( AllocationTerms (..), AuctionSchedule (..), AuctionTerms (..), Direction (..), Funding (..)
  , HasSingleLotQuotes (..), LotTerms (..), Quote (..)
  )
import Cap.Auctions.Bid (Bid, BidView (..))
import Cap.Auctions.Funding (settlementOf)
import Cap.Auctions.SingleLot (SingleLotAuctionTerms (..))


-- templates used as data only!

template TestBid
  with
    signatories : [Party]
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    fundings : Map Party Funding
    quotes : [Quote]
  where
    signatory signatories

    interface instance Bid for TestBid where
      view = BidView with
        resolutionInfo
        terms
        schedule
        fundings
        availableActions = Map.empty
        meta = emptyMetadata
      bid_fundImpl _ _ = abort "not used in unit tests"
      bid_withdrawImpl _ _ = abort "not used in unit tests"
      bid_closeImpl _ _ = abort "not used in unit tests"
      bid_expireImpl _ _ = abort "not used in unit tests"

instance HasSingleLotQuotes TestBid where
  singleLotQuotes bid = bid.quotes

-- Gives the checks a contract id to report, since an allocation contract id cannot be built without a ledger.
template AllocationStandIn
  with
    owner : Party
  where
    signatory owner

authorityParty : Party
authorityParty = fromSome (partyFromText "authority")

principalParty : Party
principalParty = fromSome (partyFromText "principal")

aliceParty : Party
aliceParty = fromSome (partyFromText "alice")

bobParty : Party
bobParty = fromSome (partyFromText "bob")

carolParty : Party
carolParty = fromSome (partyFromText "carol")

lotAdminParty : Party
lotAdminParty = fromSome (partyFromText "lot-admin")

agentParty : Party
agentParty = fromSome (partyFromText "agent")

paymentAdminParty : Party
paymentAdminParty = fromSome (partyFromText "payment-admin")

resolution : ResolutionInfo
resolution = ResolutionInfo with
  resolver = AuthenticKey with authorities = Set.singleton authorityParty; id = "resolver"
  resolverCid = None
  mechanism = "cap-auctions/single-lot/pay-as-bid"
  id = "auction"

auctionTerms : AuctionTerms
auctionTerms = AuctionTerms with
  direction = Forward
  lots = Map.fromList [((InstrumentId with admin = lotAdminParty; id = "LOT"), LotTerms with supply = 10.0; amountStep = 1.0; reservePrice = 5.0)]
  payment = InstrumentId with admin = paymentAdminParty; id = "USD"
  allocationTerms = AllocationTerms with settlementWindow = days 2; committed = True; executors = None

singleLotTerms : SingleLotAuctionTerms
singleLotTerms = SingleLotAuctionTerms with
  direction = Forward
  payment = InstrumentId with admin = paymentAdminParty; id = "USD"
  lotInstrumentId = InstrumentId with admin = lotAdminParty; id = "LOT"
  lotTerms = LotTerms with supply = 10.0; amountStep = 1.0; reservePrice = 5.0

auctionSchedule : AuctionSchedule
auctionSchedule = AuctionSchedule with
  biddingOpensAt = addRelTime (time (date 2026 Jan 1) 0 0 0) (hours 1)
  biddingClosesAt = addRelTime (time (date 2026 Jan 1) 0 0 0) (days 1)
  expiresAt = addRelTime (time (date 2026 Jan 1) 0 0 0) (days 5)

-- The time until which every allocation must stay settleable.
auctionDeadline : Time
auctionDeadline = addRelTime auctionSchedule.biddingClosesAt auctionTerms.allocationTerms.settlementWindow

-- Alice's bid for the auction, quoting 4 units at 6, with no fundings; each test adds the fundings it needs.
unfundedBid : TestBid
unfundedBid = TestBid with
  signatories = [aliceParty]
  resolutionInfo = resolution
  terms = auctionTerms
  schedule = auctionSchedule
  fundings = Map.empty
  quotes = [Quote with price = 6.0; amount = 4.0]

-- The view of a valid allocation of the account for the auction's settlement, reserving the given amounts.
validAllocationView : Party -> Party -> [(Text, Decimal)] -> Alloc.AllocationView
validAllocationView owner admin reserved = Alloc.AllocationView with
  originalAllocationCid = None
  settlement = settlementOf resolution None
  allocation = Alloc.AllocationSpecification with
    admin
    authorizer = basicAccount owner
    transferLegSides = []
    settlementDeadline = Some auctionDeadline
    nextIterationFunding = Some (TextMap.fromList reserved)
    committed = True
    meta = emptyMetadata
  holdingCids = []
  createdAt = time (date 2026 Jan 1) 0 0 0
  numIterations = 0
  expiresAt = None
  availableActions = Map.empty
  meta = emptyMetadata

data ClearingCase = ClearingCase with
    name : Text
    direction : Direction
    lotTerms : LotTerms
    bids : [(Int, [Quote])]

clearingCases : [ClearingCase]
clearingCases =
  [ ClearingCase "equal quotes at one price" Forward (lot 10.0 1.0 0.0)
      [(0, [q 5.0 5.0]), (1, [q 5.0 5.0]), (2, [q 5.0 5.0])]
  , ClearingCase "demand curves" Forward (lot 10.0 1.0 5.0)
      [(0, [q 9.0 3.0, q 7.0 4.0]), (1, [q 8.0 5.0]), (2, [q 7.0 4.0, q 4.0 10.0])]
  , ClearingCase "reverse with a cut-off" Reverse (lot 10.0 1.0 6.0)
      [(0, [q 3.0 4.0]), (1, [q 5.0 5.0]), (2, [q 5.0 3.0]), (3, [q 7.0 10.0])]
  , ClearingCase "half step" Forward (lot 7.5 0.5 1.0)
      [(0, [q 2.0 2.5]), (1, [q 2.0 3.5]), (2, [q 2.0 4.0])]
  , ClearingCase "step 0.3" Forward (lot 0.9 0.3 0.0)
      [(0, [q 1.0 0.6]), (1, [q 1.0 0.6]), (2, [q 1.0 0.3])]
  , ClearingCase "smallest step" Forward (lot 1.0 0.0000000001 0.0)
      [(0, [q 1.0 1.0]), (1, [q 1.0 1.0]), (2, [q 1.0 1.0])]
  , ClearingCase "single item tie" Forward (lot 1.0 1.0 0.0)
      [(0, [q 5.0 1.0]), (1, [q 5.0 1.0]), (2, [q 4.0 1.0])]
  , ClearingCase "reverse single item tie" Reverse (lot 1.0 1.0 10.0)
      [(0, [q 6.0 1.0]), (1, [q 3.0 1.0]), (2, [q 3.0 1.0])]
  , ClearingCase "demand below supply" Forward (lot 10.0 1.0 0.0)
      [(0, [q 3.0 2.0]), (1, [q 2.0 3.0])]
  , ClearingCase "small winner above a split" Forward (lot 10.0 1.0 0.0)
      [(0, [q 10.0 1.0]), (1, [q 8.0 6.0]), (2, [q 8.0 6.0])]
  , ClearingCase "reverse small winner below a split" Reverse (lot 10.0 1.0 10.0)
      [(0, [q 2.0 1.0]), (1, [q 5.0 6.0]), (2, [q 5.0 6.0])]
  ]
  where
    lot supply amountStep reservePrice = LotTerms with supply; amountStep; reservePrice
    q price amount = Quote with price; amount

checkCase : Text -> Bool -> Script ()
checkCase label holds = unless holds (fail label)
