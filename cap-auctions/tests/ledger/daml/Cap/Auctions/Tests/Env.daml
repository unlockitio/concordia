module Cap.Auctions.Tests.Env where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Map (Map)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime, days, hours)
import Daml.Script

import Splice.Api.Token.MetadataV1 (ExtraArgs (..), emptyMetadata)
import Splice.Api.Token.HoldingV2 (InstrumentId (..))
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.Api.Token.AllocationInstructionV2 (AllocationInstructionResult_Output (..))
import Splice.TokenStandard.Utils (basicAccount)

import Splice.Testing.Utils (Disclosures', emptyExtraArgs)
import Splice.Testing.Registries.AmuletRegistryV2 (AmuletRegistry, defaultAmuletRegistryConfig)
import qualified Splice.Testing.Registries.TestRegistries as TestRegistries
import Splice.Testing.Registries.TestTokenV1_RegistryV1 (TestTokenV1RegistryConfig (..))
import Splice.Testing.Registries.TestTokenV2_RegistryV2 (TestTokenV2Registry, TestTokenV2RegistryConfig (..))
import qualified Splice.Testing.Registries.TestTokenV2_RegistryV2 as TestTokenV2Registry
import Splice.Testing.TokenStandard.MultiRegistry (MultiRegistry, getRegistryApiV2, mkRegistryApisV1V2)
import qualified Splice.Testing.TokenStandard.RegistryApiV2 as RegistryApiV2
import Splice.Testing.TokenStandard.WalletClientV2 (allocateV2, createBatchingUtility)

import Cap.Core.Types (AuthenticKey (..), ResolutionInfo (..))
import Cap.Auctions.Types (AllocationTerms (..), AuctionSchedule (..), AuctionTerms (..), Direction (..), Funding (..), LotTerms (..), Quote (..))
import Cap.Auctions.Funding (SettleBatchContext (..), settlementOf)
import Cap.Auctions.SingleLot (payAsBidMechanism)

import Cap.Auctions.Tests.Harness (Probe (..), TestBid (..))


data TestEnv = TestEnv with
    registries : MultiRegistry
    amulet : AmuletRegistry
    paymentRegistry : TestTokenV2Registry
    lotAdmin : Party
    paymentAdmin : Party
    lot : InstrumentId
    payment : InstrumentId
    authority : Party
    principal : Party
    alice : Party
    bob : Party
    carol : Party
    outsider : Party
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    settlement : Alloc.SettlementInfo
    probe : ContractId Probe
    unfundedBid : TestBid

-- Sets up the registries, the parties with their holdings, a valid forward auction that tests change one field at a time, a Probe owned by the authority, and alice's bid quoting 4 units at 8 with no fundings.
setupTest : Text -> Script TestEnv
setupTest ns = do
  splice <- TestRegistries.initialize TestRegistries.Config with
    amulet = defaultAmuletRegistryConfig with dsoPartyName = ns <> "-dso"
    testTokenV1 = TestTokenV1RegistryConfig with adminPartyName = ns <> "-test-token-v1"
    testTokenV2 = TestTokenV2RegistryConfig with adminPartyName = ns <> "-lot-admin"
  paymentRegistry <- TestTokenV2Registry.initialize TestTokenV2RegistryConfig with adminPartyName = ns <> "-payment-admin"
  let lotRegistry = splice.testTokenV2
      registries = Map.insert paymentRegistry.admin (mkRegistryApisV1V2 paymentRegistry paymentRegistry) splice.registries
      lot = InstrumentId with admin = lotRegistry.admin; id = "LOT"
      payment = InstrumentId with admin = paymentRegistry.admin; id = "USD"
  authority <- allocateParty (ns <> "-authority")
  principal <- allocateParty (ns <> "-principal")
  alice <- allocateParty (ns <> "-alice")
  bob <- allocateParty (ns <> "-bob")
  carol <- allocateParty (ns <> "-carol")
  outsider <- allocateParty (ns <> "-outsider")
  forA_ [principal, alice, bob, carol] $ \party -> do
    createBatchingUtility party
    TestTokenV2Registry.mint lotRegistry (basicAccount party) "LOT" 100.0
    TestTokenV2Registry.mint paymentRegistry (basicAccount party) "USD" 1000.0
  t0 <- getTime
  probe <- submit authority $ createCmd Probe with owners = [authority]
  let resolutionInfo = ResolutionInfo with
        resolver = AuthenticKey with authorities = Set.singleton authority; id = "resolver"
        resolverCid = None
        mechanism = payAsBidMechanism.name
        id = ns <> "-auction"
      terms = AuctionTerms with
        direction = Forward
        lots = Map.fromList [(lot, LotTerms with supply = 10.0; amountStep = 1.0; reservePrice = 5.0)]
        payment
        allocationTerms = AllocationTerms with
          settlementWindow = days 2
          committed = True
          executors = None
      schedule = AuctionSchedule with
        biddingOpensAt = addRelTime t0 (hours 1)
        biddingClosesAt = addRelTime t0 (days 1)
        expiresAt = addRelTime t0 (days 5)
  pure TestEnv with
    amulet = splice.amuletV2
    lotAdmin = lotRegistry.admin
    paymentAdmin = paymentRegistry.admin
    settlement = settlementOf resolutionInfo None
    unfundedBid = TestBid with
      signatories = [alice]
      observers = [authority]
      resolutionInfo
      terms
      schedule
      fundings = Map.empty
      quotes = [Quote with price = 8.0; amount = 4.0]
      actions = Map.empty
    ..

-- Creates an allocation of the owner's basic account for the auction's settlement under the instrument's admin, reserving the amount of the instrument, or nothing if the amount is zero.
allocateForThisLot : TestEnv -> Party -> InstrumentId -> Decimal -> Script Funding
allocateForThisLot env owner instrument amount = do
  let account = basicAccount owner
  result <- allocateV2 env.registries owner env.settlement Alloc.AllocationSpecification with
    admin = instrument.admin
    authorizer = account
    transferLegSides = []
    settlementDeadline = Some (addRelTime env.schedule.biddingClosesAt env.terms.allocationTerms.settlementWindow)
    nextIterationFunding = Some (TextMap.fromList [(instrument.id, amount) | amount > 0.0])
    committed = env.terms.allocationTerms.committed
    meta = emptyMetadata
  case result.output of
    AllocationInstructionResult_Completed allocationCid -> pure Funding with account; allocation = allocationCid
    output -> fail ("the allocation was not created: " <> show output)

-- Asks each registry for its settlement factory and choice context, as an executor would before settling. The legs are only known after clearing, and a registry may build the context from the accounts on the legs, so each funding account is passed on a placeholder leg.
getSettleBatchContexts : TestEnv -> [Map Party Funding] -> Script (Map Party SettleBatchContext, Disclosures')
getSettleBatchContexts env allFundings = do
  contexts <- forA (dedup [admin | fundings <- allFundings, admin <- Map.keys fundings]) $ \admin -> do
    registry <- getRegistryApiV2 env.registries admin
    enriched <- RegistryApiV2.getSettlementFactory registry Alloc.SettlementFactory_SettleBatch with
      settlement = env.settlement
      transferLegs =
        [ Alloc.TransferLeg with
            transferLegId = ""
            sender = funding.account
            receiver = funding.account
            amount = 0.0
            instrumentId = ""
            meta = emptyMetadata
        | fundings <- allFundings, Some funding <- [Map.lookup admin fundings] ]
      allocations =
        [ Alloc.FinalizedAllocation with allocationCid = funding.allocation; extraTransferLegSides = []; nextIterationFunding = None
        | fundings <- allFundings, Some funding <- [Map.lookup admin fundings] ]
      actors = env.settlement.executors
      extraArgs = emptyExtraArgs
    pure ((admin, SettleBatchContext with factoryCid = enriched.factoryCid; extraArgs = enriched.arg.extraArgs), enriched.disclosures)
  pure (Map.fromList (map fst contexts), mconcat (map snd contexts))

-- Asks each registry for the choice context to cancel each allocation of the fundings.
getCancelContexts : TestEnv -> [Map Party Funding] -> Script (Map (ContractId Alloc.Allocation) ExtraArgs, Disclosures')
getCancelContexts env allFundings = do
  contexts <- forA [(admin, funding) | fundings <- allFundings, (admin, funding) <- Map.toList fundings] $ \(admin, funding) -> do
    registry <- getRegistryApiV2 env.registries admin
    context <- RegistryApiV2.getAllocation_CancelContext registry funding.allocation emptyMetadata
    pure ((funding.allocation, ExtraArgs with context = context.choiceContext; meta = emptyMetadata), context.disclosures)
  pure (Map.fromList (map fst contexts), mconcat (map snd contexts))
