module Cap.Auctions.Settlement where

import DA.Map (Map)
import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Auctions.Types (Funding)
import Cap.Auctions.Funding (Batch, SettleBatchContext)

data SettlementView = SettlementView
  with
    authorities : Set Party
    resolutionInfo : ResolutionInfo
    settlers : [[Party]]
    -- ^ The actors of Settlement_Settle include every party of one set.
    cancellers : [[Party]]
    -- ^ The actors of Settlement_Cancel include every party of one set.
    opensAt : Time
    cancelAfter : Time
    -- ^ No earlier than opensAt.
    expiresAt : Optional Time
    executors : Optional [Party]
    batches : [Batch]
    fundings : [Map Party Funding]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_SettleResult = Settlement_SettleResult
  with
    batches : [Alloc.SettlementFactory_SettleBatchResult]
    cancelled : [Alloc.AllocationResult]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_CancelResult = Settlement_CancelResult
  with
    cancelled : [ContractId Alloc.Allocation]
    meta : Metadata
  deriving (Eq, Show)

data Settlement_ExpireResult = Settlement_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)


interface Settlement where
  viewtype SettlementView

  settlement_settleImpl : Settlement_Settle -> Update Settlement_SettleResult

  settlement_cancelImpl : Settlement_Cancel -> Update Settlement_CancelResult
  settlement_expireImpl : Settlement_Expire -> Update Settlement_ExpireResult

  -- | Implementations MUST require that the settlement window is open
  -- (opensAt <= now < expiresAt) and that the actors are one of the settlers.

  choice Settlement_Settle : Settlement_SettleResult
    with
      actors : [Party]
      settleBatchContexts : Map Party SettleBatchContext
      cancelContexts : Map (ContractId Alloc.Allocation) ExtraArgs
    controller actors
    do settlement_settleImpl this arg

  -- | Implementations MUST require that cancelAfter is no earlier than
  -- opensAt, that now is at or after cancelAfter, and that the actors are one
  -- of the cancellers.

  choice Settlement_Cancel : Settlement_CancelResult
    with
      actors : [Party]
      cancelExtraArgs : Map (ContractId Alloc.Allocation) ExtraArgs
    controller actors
    do settlement_cancelImpl this arg

  -- | Implementations MUST require that expiresAt has passed.

  choice Settlement_Expire : Settlement_ExpireResult
    with
      actor : Party
    controller actor
    do settlement_expireImpl this arg
