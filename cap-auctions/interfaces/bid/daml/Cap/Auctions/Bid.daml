module Cap.Auctions.Bid where

import DA.Map (Map)
import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 (Allocation)
import Splice.Util (HasCheckedFetch (..), require)
import Cap.Core.Types (ResolutionInfo)
import Cap.Core.Utils (entitled, requireBefore, requireExpired, requireOpen)

import Cap.Auctions.Types (AuctionSchedule, AuctionTerms, Funding)

data BidProposalAction
  = BPA_Accept
  | BPA_Withdraw
  | BPA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data BidProposal_AcceptResult = BidProposal_AcceptResult
  with
    bid : ContractId Bid
    meta : Metadata
  deriving (Eq, Show)

data BidProposal_WithdrawResult = BidProposal_WithdrawResult
  with
    meta : Metadata
  deriving (Eq, Show)


data BidProposalView = BidProposalView
  with
    authorities : Set Party
    resolutionInfo : Optional ResolutionInfo
    terms : AuctionTerms
    availableActions : Map BidProposalAction [[Party]]
    meta : Metadata
  deriving (Eq, Show)


interface BidProposal where
  viewtype BidProposalView

  bidProposal_acceptImpl
    : ContractId BidProposal -> BidProposal_Accept -> Update BidProposal_AcceptResult

  bidProposal_withdrawImpl
    : ContractId BidProposal -> BidProposal_Withdraw -> Update BidProposal_WithdrawResult

  nonconsuming choice BidProposal_Accept : BidProposal_AcceptResult
    with
      actors : [Party]
      resolutionInfo : ResolutionInfo
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to accept"
        (entitled (view this).availableActions BPA_Accept actors)
      bidProposal_acceptImpl this self (BidProposal_Accept with ..)

  choice BidProposal_Withdraw : BidProposal_WithdrawResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to withdraw"
        (entitled (view this).availableActions BPA_Withdraw actors)
      bidProposal_withdrawImpl this self (BidProposal_Withdraw with ..)



data BidAction
  = BA_Fund
  | BA_Quote
  | BA_Withdraw
  | BA_Close
  | BA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data Bid_FundResult = Bid_FundResult
  with
    bid : ContractId Bid
    meta : Metadata
  deriving (Eq, Show)

data Bid_WithdrawResult = Bid_WithdrawResult
  with
    bid : Optional (ContractId Bid)
    withdrawn : [ContractId Allocation]
    meta : Metadata
  deriving (Eq, Show)

data Bid_CloseResult = Bid_CloseResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Bid_ExpireResult = Bid_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

data BidView = BidView
  with
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    fundings : Map Party Funding
    -- ^ allocation per admin, not instrumentId 
    availableActions : Map BidAction [[Party]]
    meta : Metadata
  deriving (Eq, Show)


interface Bid where
  viewtype BidView

  bid_fundImpl : ContractId Bid -> Bid_Fund -> Update Bid_FundResult

  bid_withdrawImpl : ContractId Bid -> Bid_Withdraw -> Update Bid_WithdrawResult

  bid_closeImpl : ContractId Bid -> Bid_Close -> Update Bid_CloseResult

  bid_expireImpl : ContractId Bid -> Bid_Expire -> Update Bid_ExpireResult


  choice Bid_Fund : Bid_FundResult 
    with
      actors : [Party]
      fundings : Map Party Funding
      extraArgs : ExtraArgs
    controller actors
    do
      let bv = view this
      require "the actors are entitled to fund"
        (entitled bv.availableActions BA_Fund actors)
      now <- getTime
      requireOpen "the bidding window is open"
        now bv.schedule.biddingOpensAt (Some bv.schedule.biddingClosesAt)
      bid_fundImpl this self (Bid_Fund with ..)

  nonconsuming choice Bid_Withdraw : Bid_WithdrawResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      let bv = view this
      require "the actors are entitled to withdraw"
        (entitled bv.availableActions BA_Withdraw actors)
      now <- getTime
      requireBefore "bidding has not closed" now bv.schedule.biddingClosesAt
      bid_withdrawImpl this self (Bid_Withdraw with ..)

  nonconsuming choice Bid_Close : Bid_CloseResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to close"
        (entitled (view this).availableActions BA_Close actors)
      bid_closeImpl this self (Bid_Close with ..)

  nonconsuming choice Bid_Expire : Bid_ExpireResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      now <- getTime
      requireExpired "the bid has expired" now (Some (view this).schedule.expiresAt)
      bid_expireImpl this self (Bid_Expire with ..)


instance Show Bid where
  show bid = "Bid " <> show (view bid)

-- | A bid belongs to the resolution its view names, so that fetchGroup aborts
-- on a bid of another resolution.
instance HasCheckedFetch Bid ResolutionInfo where
  contractGroupId bid = (view bid).resolutionInfo
