module Cap.Auctions.TradeProposal where

import DA.Map (Map)

import Splice.Api.Token.MetadataV1
import Splice.Util (require)
import Cap.Core.Types (ResolutionInfo)
import Cap.Core.Utils (entitled, requireBefore, requireExpired)
import Cap.Auctions.Types (AuctionSchedule, AuctionTerms, Funding)

data TradeProposalAction
  = SPA_Accept
  | SPA_Reject
  | SPA_Withdraw
  | SPA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data TradeProposalView = TradeProposalView
  with
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    acceptBefore : Time
    availableActions : Map TradeProposalAction [[Party]]
    meta : Metadata
  deriving (Eq, Show)

data TradeProposal_AcceptResult = TradeProposal_AcceptResult
  with
    trade : AnyContractId -- should be auction and optional ?
    meta : Metadata
  deriving (Eq, Show)

data TradeProposal_RejectResult = TradeProposal_RejectResult
  with
    meta : Metadata
  deriving (Eq, Show)

data TradeProposal_WithdrawResult = TradeProposal_WithdrawResult
  with
    meta : Metadata
  deriving (Eq, Show)

data TradeProposal_ExpireResult = TradeProposal_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface TradeProposal where
  viewtype TradeProposalView

  tradeProposal_acceptImpl
    : ContractId TradeProposal -> TradeProposal_Accept -> Update TradeProposal_AcceptResult

  tradeProposal_rejectImpl
    : ContractId TradeProposal -> TradeProposal_Reject -> Update TradeProposal_RejectResult

  tradeProposal_withdrawImpl
    : ContractId TradeProposal -> TradeProposal_Withdraw -> Update TradeProposal_WithdrawResult

  choice TradeProposal_Accept : TradeProposal_AcceptResult
    with
      actors : [Party]
      fundings : Map Party Funding -- if bid changes this changes as well
      extraArgs : ExtraArgs
    controller actors
    do
      let v = view this
      require "the actors are entitled to accept"
        (entitled v.availableActions SPA_Accept actors)
      now <- getTime
      requireBefore "the acceptance window is open" now v.acceptBefore
      tradeProposal_acceptImpl this self (TradeProposal_Accept with ..)

  choice TradeProposal_Reject : TradeProposal_RejectResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to reject"
        (entitled (view this).availableActions SPA_Reject actors)
      tradeProposal_rejectImpl this self (TradeProposal_Reject with ..)

  choice TradeProposal_Withdraw : TradeProposal_WithdrawResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to withdraw"
        (entitled (view this).availableActions SPA_Withdraw actors)
      tradeProposal_withdrawImpl this self (TradeProposal_Withdraw with ..)

  choice TradeProposal_Expire : TradeProposal_ExpireResult
    with
      actor : Party
    controller actor
    do
      now <- getTime
      requireExpired "the proposal has expired" now (Some (view this).acceptBefore)
      pure TradeProposal_ExpireResult with meta = emptyMetadata
