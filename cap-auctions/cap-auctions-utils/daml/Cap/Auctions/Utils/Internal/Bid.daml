module Cap.Auctions.Utils.Internal.Bid
  ( saleSettlement
  , paymentLegId
  , lotLegId
  , paymentLeg
  , lotLeg
  ) where

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.HoldingV2 as Holding

import Cap.Auctions.OneLotBidV1 (Direction (..), OneLotAuctionTerms)


------------------  ONE LOT AUCTION UTILITIES ------------------

saleSettlement : Text -> [Party] -> Alloc.SettlementInfo
saleSettlement saleId executors = Alloc.SettlementInfo with
  executors
  id = saleId
  cid = None
  meta = emptyMetadata

paymentLegId, lotLegId : Text
paymentLegId = "payment"
lotLegId = "lot"

paymentLeg : OneLotAuctionTerms -> Holding.Account -> Decimal -> Alloc.TransferLeg
paymentLeg terms bidderPaymentAccount amount =
  let (payer, payee) = case terms.direction of
        Forward -> (bidderPaymentAccount, terms.sellerPaymentAccount)
        Reverse -> (terms.sellerPaymentAccount, bidderPaymentAccount)
  in Alloc.TransferLeg with
    transferLegId = paymentLegId
    sender = payer
    receiver = payee
    amount
    instrumentId = terms.payment.id
    meta = emptyMetadata

lotLeg : OneLotAuctionTerms -> Holding.Account -> Decimal -> Alloc.TransferLeg
lotLeg terms bidderLotAccount units =
  let (deliverer, recipient) = case terms.direction of
        Forward -> (terms.sellerLotAccount, bidderLotAccount)
        Reverse -> (bidderLotAccount, terms.sellerLotAccount)
  in Alloc.TransferLeg with
    transferLegId = lotLegId
    sender = deliverer
    receiver = recipient
    amount = units
    instrumentId = terms.lot.instrument.id
    meta = emptyMetadata
