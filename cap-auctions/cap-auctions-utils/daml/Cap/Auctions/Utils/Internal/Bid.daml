module Cap.Auctions.Utils.Internal.Bid
  ( oneLotSettlement
  , sellerOf
  , bidderOf
  , committedAllocation
  , fundingOneInstrumentAllocation
  , receivingAllocation
  , paymentLegId
  , lotLegId
  , paymentLeg
  , lotLeg
  ) where

import qualified DA.Set as Set
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.HoldingV2 as Holding
import Splice.TokenStandard.Utils (regularAccountOwner)

import Cap.Auctions.OneLotBidV1 (Direction (..), OneLotAuctionTerms, OneLotBidView)


------------------  ONE LOT AUCTION UTILITIES ------------------

oneLotSettlement : Text -> Set.Set Party -> Alloc.SettlementInfo
oneLotSettlement saleId authorities = Alloc.SettlementInfo with
  executors = Set.toList authorities
  id = saleId
  cid = None
  meta = emptyMetadata

sellerOf : OneLotAuctionTerms -> Party
sellerOf terms = regularAccountOwner terms.sellerLotAccount

bidderOf : OneLotBidView -> Party
bidderOf bid = regularAccountOwner bid.bidderPaymentAccount


------------------  COMMITTED ALLOCATION SPECS  ------------------

-- | The committed-allocation skeleton every side of a one-lot settlement shares.
committedAllocation
  : Holding.InstrumentId -> Holding.Account -> Time
  -> Optional (TextMap.TextMap Decimal) -> Alloc.AllocationSpecification
committedAllocation instrument account deadline reserving =
  Alloc.AllocationSpecification with
    admin = instrument.admin
    authorizer = account
    transferLegSides = []
    settlementDeadline = Some deadline
    nextIterationFunding = reserving
    committed = True
    meta = emptyMetadata

-- | The delivering side: funds `amount` of the instrument for settlement.
fundingOneInstrumentAllocation
  : Holding.InstrumentId -> Holding.Account -> Time -> Decimal -> Alloc.AllocationSpecification
fundingOneInstrumentAllocation instrument account deadline amount =
  committedAllocation instrument account deadline
    (Some (TextMap.fromList [(instrument.id, amount)]))

-- | The receiving side: reserves nothing.
receivingAllocation
  : Holding.InstrumentId -> Holding.Account -> Time -> Alloc.AllocationSpecification
receivingAllocation instrument account deadline =
  committedAllocation instrument account deadline (Some TextMap.empty)


paymentLegId, lotLegId : Text
paymentLegId = "payment"
lotLegId = "lot"

paymentLeg : OneLotBidView -> Decimal -> Alloc.TransferLeg
paymentLeg bid amount =
  let (payer, payee) = case bid.terms.direction of
        Forward -> (bid.bidderPaymentAccount, bid.terms.sellerPaymentAccount)
        Reverse -> (bid.terms.sellerPaymentAccount, bid.bidderPaymentAccount)
  in Alloc.TransferLeg with
    transferLegId = paymentLegId
    sender = payer
    receiver = payee
    amount
    instrumentId = bid.terms.payment.id
    meta = emptyMetadata

lotLeg : OneLotBidView -> Decimal -> Alloc.TransferLeg
lotLeg bid units =
  let (deliverer, recipient) = case bid.terms.direction of
        Forward -> (bid.terms.sellerLotAccount, bid.bidderLotAccount)
        Reverse -> (bid.bidderLotAccount, bid.terms.sellerLotAccount)
  in Alloc.TransferLeg with
    transferLegId = lotLegId
    sender = deliverer
    receiver = recipient
    amount = units
    instrumentId = bid.terms.lot.instrument.id
    meta = emptyMetadata
