-- | Cap.Auctions.Funding is a set of helpers for auctions to check funding,
-- ignore bids, and build, settle and cancel token standard settlement
-- batches. It keeps the mechanism logic separate from settlement.

module Cap.Auctions.Funding
  ( -- * Settlement info
    settlementOf

    -- * Checks
  , validFundingTerms
  , emptyTransferLegAllocations
  , bidForResolution
  , accountSignedBid
  , noPrincipalAccountsInBid
  , distinctAccountsAmongBids

    -- * Ignoring invalid bids
  , AllocationsCheck
  , ignoreFailingAllocations
  , ignoreConflictingBids

    -- * Fetching allocations
  , fetchFundingAllocations

    -- * Checking the principal
  , validPrincipalFunding
  , requireValidPrincipalFunding

    -- * Building batches
  , Batch (..)
  , buildBatchesByAccount

    -- * Settling batches
  , SettleBatchContext (..)
  , Finalizer
  , settleBatches
  , lastIterationFinalizer

    -- * Cancelling unsettled allocations
  , unsettledAllocations
  , cancelAllocations
  ) where

import DA.List (dedup)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (fromOptional, isSome)
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime)

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.TokenStandard.Utils (transferLegSidesWithAuthorizer)

import Cap.Core.Types (ResolutionInfo (..))
import Cap.Core.Utils
  ( Check, ContractFilter, Unmet
  , ignoreFailing, ignoreUnlessM, orAbort, requireMet )
import Cap.Auctions.Bid (Bid)
import Cap.Auctions.Types (AuctionSchedule (..), AuctionTerms (..), Direction (..), Funding (..))


-- Settlement info
------------------
-- The token standard SettlementInfo that every allocation of an auction is made for.

-- | The SettlementInfo of a resolution. Its id is the ResolutionInfo id, so
-- the resolver must keep resolution ids unique among all resolutions whose
-- settlements can share executors. The executors are the explicit executors
-- if given, otherwise the resolver's authorities.
settlementOf : ResolutionInfo -> Optional [Party] -> Alloc.SettlementInfo
settlementOf resolutionInfo executors =
    Alloc.SettlementInfo with
      executors = fromOptional (Set.toList resolutionInfo.resolver.authorities) executors
      id = resolutionInfo.id
      cid = resolutionInfo.resolverCid
      meta = emptyMetadata

-- Checks 
---------
-- Each check returns its unmet conditions. Use requireMet or requireChecks to
-- abort on them, at submission or resolution, or ignoreFailing to ignore the
-- bid at resolution.

-- 
-- | Requires every allocation of the bid to be for this settlement, under its
-- admin, authorized by its account, not to expire before the auction's
-- settlement deadline, and to be committed if the terms require it.
-- (checking the reserve, is currently being done in clearing)
validFundingTerms : Alloc.SettlementInfo -> AuctionTerms -> AuctionSchedule -> AllocationsCheck t
validFundingTerms settlement terms schedule _ fundings =
  [ "allocation " <> show funding.allocation <> " " <> errorMsg
  | (admin, (funding, v)) <- Map.toList fundings
  , (False, errorMsg) <-
      [ (v.settlement == settlement, "is for another settlement")
      , (v.allocation.admin == admin, "has another admin")
      , (v.allocation.authorizer == funding.account, "is authorized by another account")
      , (optional True (>= deadline) v.allocation.settlementDeadline, "expires before the settlement deadline")
      , (optional True (>= deadline) v.expiresAt, "can be expired by the registry before the settlement deadline")
      , (not terms.allocationTerms.committed || v.allocation.committed, "is not committed")
      ]
  ]
  where
    deadline = addRelTime schedule.biddingClosesAt terms.allocationTerms.settlementWindow

-- | Requires every allocation of the bid to have no transfer leg sides and to set nextIterationFunding.
emptyTransferLegAllocations : AllocationsCheck t
emptyTransferLegAllocations _ fundings =
  [ "allocation " <> show funding.allocation <> " " <> errorMsg
  | (_, (funding, v)) <- Map.toList fundings
  , (False, errorMsg) <-
      [ (null v.allocation.transferLegSides, "has transfer leg sides")
      , (isSome v.allocation.nextIterationFunding, "does not enable iterated settlement")
      ]
  ]

-- | Requires the bid to be for this resolution. Use it at submission. At
-- resolution, fetching the bids with fetchGroup keyed by the resolution
-- already aborts on a bid of another resolution: the resolver chose the bids,
-- so it is its error.
bidForResolution : HasToInterface t Bid => ResolutionInfo -> Check t
bidForResolution resolutionInfo bid =
  ["the bid is for another resolution" | (view (toInterface @Bid bid)).resolutionInfo /= resolutionInfo]

-- | Requires the owner of every funding account, or its provider if it has no
-- owner, to be a signatory of the bid. This prevents a bidder from putting
-- another bidder's allocation in their own bid. The bid's signatories tie the bid to the funds.
accountSignedBid : (HasSignatory t, HasToInterface t Bid) => t -> Unmet
accountSignedBid bid =
  [ "account " <> show funding.account <> " under admin " <> show admin <> " did not sign the bid"
  | (admin, funding) <- Map.toList (view (toInterface @Bid bid)).fundings
  , case accountSigner funding.account of
      None -> True
      Some signer -> signer `notElem` signatory bid
  ]
  where
    accountSigner account = case account.owner of
      Some owner -> Some owner
      None -> account.provider

-- | Requires the bid to use none of the principal's accounts under the same admin.
noPrincipalAccountsInBid : HasToInterface t Bid => Map Party Funding -> t -> Unmet
noPrincipalAccountsInBid principalFundings bid =
  [ "account " <> show funding.account <> " is used under admin " <> show admin <> " by the principal"
  | (admin, funding) <- Map.toList (view (toInterface @Bid bid)).fundings
  , Some principalFunding <- [Map.lookup admin principalFundings]
  , principalFunding.account == funding.account
  ]

-- | Requires no other bid to use one of the bid's accounts under the same admin.
-- Pass the bids still kept, with ignoreFailing, and check consent with
-- accountSignedBid before, so that only the owner of an account can make
-- their own bids clash.
distinctAccountsAmongBids : HasToInterface t Bid => [t] -> t -> Unmet
distinctAccountsAmongBids bids bid =
  [ "account " <> show funding.account <> " is used under admin " <> show admin <> " by another bid"
  | (admin, funding) <- Map.toList (view (toInterface @Bid bid)).fundings
  , fromOptional 0 (Map.lookup (funding.account, admin) uses) > 1
  ]
  where
    uses = Map.fromListWithR (+)
      [ ((otherFunding.account, otherAdmin), 1)
      | other <- bids
      , (otherAdmin, otherFunding) <- Map.toList (view (toInterface @Bid other)).fundings
      ]


-- Ignoring invalid bids
------------------------
-- A resolver fetches the bids with fetchGroup, keyed by its resolution, so
-- that a bid presented twice or of another resolution aborts. It then aborts
-- on the checks that are its own error with requireChecks, and ignores the
-- bids that fail the others with ignoreFailing, ignoreFailingAllocations and
-- applyFilters (Cap.Core.Utils).

-- | A check on the bid and its fetched allocations.
type AllocationsCheck t = t -> Map Party (Funding, Alloc.AllocationView) -> Unmet

-- | Fetches the allocations of every bid, once per bid, and ignores the bids
-- that fail a check on them. Put it after the checks on the bid alone in
-- applyFilters, so that no allocations are fetched for a bid already ignored.
-- With no checks it fetches nothing.
ignoreFailingAllocations : HasToInterface t Bid => [AllocationsCheck t] -> ContractFilter t
ignoreFailingAllocations [] bids = pure (bids, [])
ignoreFailingAllocations checks bids =
  ignoreUnlessM (\bid -> do
      fetchedFundings <- fetchFundingAllocations (view (toInterface @Bid bid)).fundings
      pure (concat [check bid fetchedFundings | check <- checks]))
    bids

-- | Ignores the bids that use one of the principal's accounts or share an
-- account with another bid. Use it for bids that passed their checks at
-- submission. It fetches no allocations.
ignoreConflictingBids : HasToInterface t Bid => Map Party Funding -> ContractFilter t
ignoreConflictingBids principalFundings =
  ignoreFailing [noPrincipalAccountsInBid principalFundings] [distinctAccountsAmongBids]


-- Fetching allocations
-----------------------
-- Fetches the allocations of a party's fundings, for the checks at submission and for the principal.

-- | Fetches the allocation of each funding, keyed by admin.
fetchFundingAllocations : Map Party Funding -> Update (Map Party (Funding, Alloc.AllocationView))
fetchFundingAllocations fundings = do
  views <- forA (Map.toList fundings) $ \(admin, funding) -> do
    allocation <- fetch funding.allocation
    pure (admin, (funding, view allocation))
  pure (Map.fromList views)


-- Checking the principal
----------------------
-- Checks on the principal's funding, at submission or resolution. They abort, because the auction cannot run without the principal.

-- | Requires every funding of the principal to meet the funding terms and be an
-- empty transfer leg allocation, and the principal to reserve the most it can
-- send: the supply of every lot in a forward auction, and the supply of every
-- lot times its reserve price in a reverse auction.
validPrincipalFunding
  : Alloc.SettlementInfo -> AuctionTerms -> AuctionSchedule -> Map Party (Funding, Alloc.AllocationView) -> Unmet
validPrincipalFunding settlement terms schedule fetchedPrincipalFundings =
  [ "allocation " <> show funding.allocation <> " " <> errorMsg
  | (admin, (funding, v)) <- Map.toList fetchedPrincipalFundings
  , (False, errorMsg) <-
      [ (null v.allocation.transferLegSides, "has transfer leg sides")
      , (isSome v.allocation.nextIterationFunding, "does not enable iterated settlement")
      , (v.settlement == settlement, "is for another settlement")
      , (v.allocation.admin == admin, "has another admin")
      , (v.allocation.authorizer == funding.account, "is authorized by another account")
      , (optional True (>= deadline) v.allocation.settlementDeadline, "expires before the settlement deadline")
      , (optional True (>= deadline) v.expiresAt, "can be expired by the registry before the settlement deadline")
      , (not terms.allocationTerms.committed || v.allocation.committed, "is not committed")
      ]
  ]
    <> [ "no allocation under admin " <> show admin
       | admin <- dedup (terms.payment.admin :: map (.admin) (Map.keys terms.lots))
       , not (Map.member admin fetchedPrincipalFundings)
       ]
    <> [ "allocation " <> show funding.allocation <> " reserves less than the " <> show mostSent
           <> " of " <> instrument.id <> " the principal can send"
       | (instrument, mostSent) <- Map.toList mostSentPerInstrument
       , Some (funding, v) <- [Map.lookup instrument.admin fetchedPrincipalFundings]
       , fromOptional 0.0 (v.allocation.nextIterationFunding >>= TextMap.lookup instrument.id) < mostSent
       ]
  where
    deadline = addRelTime schedule.biddingClosesAt terms.allocationTerms.settlementWindow
    mostSentPerInstrument = case terms.direction of
      Forward -> fmap (.supply) terms.lots
      Reverse -> Map.fromList [(terms.payment, sum [lot.supply * lot.reservePrice | lot <- Map.values terms.lots])]

-- | Fetches the principal's allocations and requires them to pass validPrincipalFunding.
-- Call it when the principal funds the auction.
requireValidPrincipalFunding
  : Alloc.SettlementInfo -> AuctionTerms -> AuctionSchedule -> Map Party Funding -> Update ()
requireValidPrincipalFunding settlement terms schedule principalFundings = do
  fetchedPrincipalFundings <- fetchFundingAllocations principalFundings
  requireMet (validPrincipalFunding settlement terms schedule fetchedPrincipalFundings)


-- Building batches
-------------------
-- Groups the outcome's transfer legs into one settlement batch per instrument admin.

data Batch = Batch
  with
    admin : Party
    legs : [Alloc.TransferLeg]
    -- ^ Legs that will be settled in the batch. They must all have the same admin.
    fundings : [Funding]
    -- ^ Fundings that have an allocation under the batch's admin and are used in the batch's legs.
  deriving (Eq, Show)

-- | Groups the legs by admin into one batch per admin. The fundings SHOULD
-- be all the fundings of this settlement, and the legs SHOULD be all the
-- legs of the settlement.
--
-- It does not check that every account on the legs has a funding. That is
-- left to the bid filters before the outcome and to the settlement factory
-- at settlement, because some cases might not want to abort in this
-- function, for example not to complicate the completeness checks.
buildBatchesByAccount
  : [Map Party Funding]
  -> [(Party, Alloc.TransferLeg)]
  -> [Batch]
buildBatchesByAccount allFundings allLegsToSettleWithAdmin =
  [ Batch with admin; legs; fundings
  | (admin, legs) <- allLegsToSettleByAdmin
  , let accounts = accountsOnLegs legs
  , let fundings =
          [ funding
          | byAdmin <- allFundings
          , Some funding <- [Map.lookup admin byAdmin]
          , funding.account `elem` accounts
          ]
  ]
  where
    allLegsToSettleByAdmin = Map.toList (Map.fromListWithR (<>) [(admin, [leg]) | (admin, leg) <- allLegsToSettleWithAdmin])
    accountsOnLegs legs = dedup (concatMap (\leg -> [leg.sender, leg.receiver]) legs)


-- Settling batches
-------------------
-- Exercises each batch's settlement factory to settle the allocations.

data SettleBatchContext = SettleBatchContext
  with
    factoryCid : ContractId Alloc.SettlementFactory
    extraArgs : ExtraArgs
  deriving (Eq, Show)

-- | Builds the FinalizedAllocation of one funding in a batch, given the
-- batch's legs. settleBatches calls it once per funding. It does not see the
-- allocation's contents or the other fundings in the batch.
--
-- The settlement factory rejects the batch unless every side of every leg is
-- authorized by exactly one allocation. An allocation authorizes its own
-- transferLegSides plus the extraTransferLegSides returned here.
type Finalizer = [Alloc.TransferLeg] -> Funding -> Alloc.FinalizedAllocation

-- | Settles every batch, using an allocation Finalizer each with its own extra args.
settleBatches
  : Finalizer
  -> Alloc.SettlementInfo
  -> Map Party SettleBatchContext
  -> [Batch]
  -> Update [Alloc.SettlementFactory_SettleBatchResult]
settleBatches finalizer settlement contexts batches =
  forA batches $ \batch -> do
    context <- orAbort ("no settle batch context for admin " <> show batch.admin) (Map.lookup batch.admin contexts)
    exercise context.factoryCid Alloc.SettlementFactory_SettleBatch with
      settlement
      transferLegs = batch.legs
      allocations = map (finalizer batch.legs) batch.fundings
      actors = settlement.executors
      extraArgs = context.extraArgs

-- | Finalizes an allocation for its last settlement iteration.
--
-- extraTransferLegSides holds all sides of the batch legs where the funding
-- account is the sender or the receiver. nextIterationFunding is None, so
-- the registry creates no next allocation and returns unused reserved funds
-- to the authorizer.
--
-- Use When:
--
--  - every allocation has an empty transferLegSides, and sets 
--    nextIterationFunding.
--
--  - each account has at most one allocation per admin in the batch.
lastIterationFinalizer : Finalizer
lastIterationFinalizer legs funding = Alloc.FinalizedAllocation with
  allocationCid = funding.allocation
  extraTransferLegSides =
    [ side
    | leg <- legs
    , (account, side) <- transferLegSidesWithAuthorizer leg
    , account == funding.account
    ]
  nextIterationFunding = None


-- Cancelling unsettled allocations
-----------------------------------
-- Cancels the allocations that no batch settles.

-- | The allocations of the fundings that no batch settles, each once.
unsettledAllocations : [Map Party Funding] -> [Batch] -> [ContractId Alloc.Allocation]
unsettledAllocations allFundings batches =
  dedup
    [ funding.allocation
    | byAdmin <- allFundings
    , funding <- Map.values byAdmin
    , funding.allocation `notElem` settled
    ]
  where
    settled = [funding.allocation | batch <- batches, funding <- batch.fundings]

-- | Cancels the allocations as the settlement's executors, each with its extra
-- args from the contexts.
cancelAllocations
  : Alloc.SettlementInfo
  -> Map (ContractId Alloc.Allocation) ExtraArgs
  -> [ContractId Alloc.Allocation]
  -> Update [Alloc.AllocationResult]
cancelAllocations settlement contexts allocationCids =
  forA allocationCids $ \allocationCid -> do
    extraArgs <- orAbort ("no cancel context for allocation " <> show allocationCid)
      (Map.lookup allocationCid contexts)
    exercise allocationCid Alloc.Allocation_Cancel with
      actors = settlement.executors
      extraArgs
