module Cap.Governance.Harness (

  -- * A ballot on the ledger
  LiveBallot (..),
  putBallotUnbound,
  castArg,
  withdrawArg,
  runCast,
  runCastFails,
  runWithdraw,
  runWithdrawFails,
  runBallotExpire,
  runBallotExpireFails,
  runConsume,
  runConsumeFails,
  runConsumeUnauthorized,

  -- * An execution on the ledger
  LiveExecution (..),
  putExecutableUnbound,
  executeArg,
  cancelArg,
  runExecute,
  runExecuteFails,
  runCancel,
  runCancelFails,
  runExecutionExpire,
  runExecutionExpireFails,

  -- * An action on the ledger
  LiveAction (..),
  putActionUnbound,
  authorizeArg,
  runAuthorize,
  runAuthorizeFails,

  -- * Reading views
  ballotView,
  executionView,
  entitledToCast,
  entitledToExecute,

) where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import qualified DA.Set as Set
import Daml.Script hiding (AnyContractId)

import Splice.Api.Token.MetadataV1

import Cap.Core.Utils (ExecutionAction (..), ExecutionCore (..))
import Cap.Core.Harness (emptyExtraArgs)
import Cap.Core.Harness.Failures
import Cap.Governance.ActionV1
import Cap.Governance.BallotV1
import Cap.Governance.BindingV1 (Bind, TargetKey)
import Cap.Governance.Dummies.Action
import Cap.Governance.Dummies.Ballot
import Cap.Governance.Dummies.Executable
import Cap.Governance.ExecutableV1


-- A ballot on the ledger
--------------------------

data LiveBallot = LiveBallot with
    ballotCid : ContractId Ballot
    voters : [Party]
    vote : AnyValue
    targets : Map TargetKey AnyContractId
    extraArgs : ExtraArgs
    disclosures : [Disclosure]

putBallotUnbound : DummyBallot -> Script LiveBallot
putBallotUnbound ballot = do
  cid <- submit ballot.voter $ createCmd ballot
  pure LiveBallot with
    ballotCid = toInterfaceContractId @Ballot cid
    voters = [ballot.voter]
    vote = AV_Text "yes"
    targets = Map.empty
    extraArgs = emptyExtraArgs
    disclosures = []

castArg : LiveBallot -> Ballot_Cast
castArg live = Ballot_Cast with
  actors = live.voters
  vote = live.vote
  targets = live.targets
  extraArgs = live.extraArgs

withdrawArg : LiveBallot -> Ballot_Withdraw
withdrawArg live = Ballot_Withdraw with
  actors = live.voters
  extraArgs = live.extraArgs

runCast : LiveBallot -> Ballot_Cast -> Script (ContractId Ballot)
runCast live arg =
  submit (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid arg

runCastFails : LiveBallot -> Text -> Ballot_Cast -> Script ()
runCastFails live expectedMsg arg =
  failsWith expectedMsg (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid arg

runWithdraw : LiveBallot -> Ballot_Withdraw -> Script Ballot_WithdrawResult
runWithdraw live arg =
  submit (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid arg

runWithdrawFails : LiveBallot -> Text -> Ballot_Withdraw -> Script ()
runWithdrawFails live expectedMsg arg =
  failsWith expectedMsg (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid arg

runBallotExpire : LiveBallot -> [Party] -> Script Ballot_ExpireResult
runBallotExpire live actors =
  submit (actAs actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid Ballot_Expire with actors; extraArgs = live.extraArgs

runBallotExpireFails : LiveBallot -> Text -> [Party] -> Script ()
runBallotExpireFails live expectedMsg actors =
  failsWith expectedMsg (actAs actors <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid Ballot_Expire with actors; extraArgs = live.extraArgs

runConsume : LiveBallot -> [Party] -> Script Ballot_ConsumeResult
runConsume live authorities =
  submit (actAs authorities <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid Ballot_Consume with extraArgs = live.extraArgs

runConsumeFails : LiveBallot -> Text -> [Party] -> Script ()
runConsumeFails live expectedMsg authorities =
  failsWith expectedMsg (actAs authorities <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid Ballot_Consume with extraArgs = live.extraArgs

runConsumeUnauthorized : LiveBallot -> [Party] -> Script ()
runConsumeUnauthorized live authorities =
  submitMustFail (actAs authorities <> discloseMany live.disclosures) $
    exerciseCmd live.ballotCid Ballot_Consume with extraArgs = live.extraArgs


-- An execution on the ledger
------------------------------

data LiveExecution = LiveExecution with
    executionCid : ContractId Executable
    executors : [Party]
    targets : Map TargetKey AnyContractId
    extraArgs : ExtraArgs
    disclosures : [Disclosure]

putExecutableUnbound : DummyExecutable -> [Party] -> Script LiveExecution
putExecutableUnbound executable executors = do
  cid <- submit (actAs (Set.toList executable.core.authorities)) $ createCmd executable
  pure LiveExecution with
    executionCid = toInterfaceContractId @Executable cid
    executors
    targets = Map.empty
    extraArgs = emptyExtraArgs
    disclosures = []

executeArg : LiveExecution -> Executable_Execute
executeArg live = Executable_Execute with
  actors = live.executors
  targets = live.targets
  extraArgs = live.extraArgs

cancelArg : LiveExecution -> Executable_Cancel
cancelArg live = Executable_Cancel with
  actors = live.executors
  extraArgs = live.extraArgs

runExecute : LiveExecution -> Executable_Execute -> Script Executable_ExecuteResult
runExecute live arg =
  submit (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid arg

runExecuteFails : LiveExecution -> Text -> Executable_Execute -> Script ()
runExecuteFails live expectedMsg arg =
  failsWith expectedMsg (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid arg

runCancel : LiveExecution -> Executable_Cancel -> Script Executable_CancelResult
runCancel live arg =
  submit (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid arg

runCancelFails : LiveExecution -> Text -> Executable_Cancel -> Script ()
runCancelFails live expectedMsg arg =
  failsWith expectedMsg (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid arg

runExecutionExpire : LiveExecution -> Party -> Script Executable_ExpireResult
runExecutionExpire live actor =
  submit (actAs actor <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid Executable_Expire with actor

runExecutionExpireFails : LiveExecution -> Text -> Party -> Script ()
runExecutionExpireFails live expectedMsg actor =
  failsWith expectedMsg (actAs actor <> discloseMany live.disclosures) $
    exerciseCmd live.executionCid Executable_Expire with actor


-- An action on the ledger
---------------------------

data LiveAction = LiveAction with
    actionCid : ContractId Action
    authorizers : [Party]
    core : ExecutionCore
    outcome : Optional AnyValue
    bindings : Map TargetKey Bind
    extraArgs : ExtraArgs
    disclosures : [Disclosure]

putActionUnbound : DummyAction -> ExecutionCore -> Script LiveAction
putActionUnbound action core = do
  cid <- submit action.signer $ createCmd action
  pure LiveAction with
    actionCid = toInterfaceContractId @Action cid
    authorizers = [action.signer]
    core
    outcome = None
    bindings = Map.empty
    extraArgs = emptyExtraArgs
    disclosures = []

authorizeArg : LiveAction -> Action_AuthorizeExecution
authorizeArg live = Action_AuthorizeExecution with
  actors = live.authorizers
  core = live.core
  outcome = live.outcome
  bindings = live.bindings
  extraArgs = live.extraArgs

runAuthorize
  : LiveAction -> Action_AuthorizeExecution -> Script Action_AuthorizeExecutionResult
runAuthorize live arg =
  submit (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.actionCid arg

runAuthorizeFails : LiveAction -> Text -> Action_AuthorizeExecution -> Script ()
runAuthorizeFails live expectedMsg arg =
  failsWith expectedMsg (actAs arg.actors <> discloseMany live.disclosures) $
    exerciseCmd live.actionCid arg


-- Reading views
-----------------

ballotView : Party -> ContractId Ballot -> Script BallotView
ballotView reader cid = do
  seen <- queryInterfaceContractId reader cid
  case seen of
    Some v -> pure v
    None -> fail ("the ballot " <> show cid <> " is not visible to " <> show reader)

executionView : Party -> ContractId Executable -> Script ExecutableView
executionView reader cid = do
  seen <- queryInterfaceContractId reader cid
  case seen of
    Some v -> pure v
    None -> fail ("the execution " <> show cid <> " is not visible to " <> show reader)

entitledToCast : Party -> ContractId Ballot -> Script [[Party]]
entitledToCast reader cid = do
  v <- ballotView reader cid
  pure (optional [] identity (Map.lookup BA_Cast v.availableActions))

entitledToExecute : Party -> ContractId Executable -> Script [[Party]]
entitledToExecute reader cid = do
  v <- executionView reader cid
  pure (optional [] identity (Map.lookup EA_Execute v.core.availableActions))

