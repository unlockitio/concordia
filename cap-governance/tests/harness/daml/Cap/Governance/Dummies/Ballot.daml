module Cap.Governance.Dummies.Ballot
  ( DummyBallot (..)
  ) where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1

import Cap.Core.SubmittableV1
import Cap.Governance.ActionV1 (Action, Stage (..))
import Cap.Governance.BallotV1
import Cap.Governance.BindingV1
import Cap.Governance.Utils (pinStateAt)

template DummyBallot
  with
    mechanism : Mechanism
    actionCid : ContractId Action
    voter : Party
    observers : [Party]
    opensAt : Time
    closesAt : Time
    expiresAt : Time
    availableActions : Map BallotAction [[Party]]
    bindings : Map TargetKey Bind
    vote : Optional AnyValue
  where
    signatory voter
    observer Set.toList (authoritiesOf mechanism), observers

    interface instance Submittable for DummyBallot where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata

    interface instance Ballot for DummyBallot where
      view = BallotView with
        opensAt
        closesAt
        expiresAt
        availableActions
        bindings
        vote
        meta = emptyMetadata

      ballot_castImpl self arg = do
        action <- fetch actionCid
        pinned <- pinStateAt Submission arg.targets (view action).bindSpec
        archive self
        toInterfaceContractId @Ballot <$>
          create this with vote = Some arg.vote; bindings = pinned

      ballot_withdrawImpl _ _ = pure Ballot_WithdrawResult with meta = emptyMetadata

      ballot_expireImpl _ _ = pure Ballot_ExpireResult with meta = emptyMetadata

      ballot_consumeImpl _ _ = pure Ballot_ConsumeResult with meta = emptyMetadata
