-- SPDX-License-Identifier: Apache-2.0

-- | A minimal Executable that checks its binds against the targets presented to
-- it, so the drift path can be tested.
--
-- core, bindings and outcome are plain fields, so a test sets the execution
-- window, who may execute, and the pinned binds directly.
--
-- executable_executeImpl compares each Authentic bind against what its target
-- now carries. Opaque binds are skipped, because fetchAuthenticTargets does not
-- fetch them either. 
--
-- DummyAction.action_authorizeExecutionImpl creates this contracts
-- from what Action_AuthorizeExecution is handed, which is the step
-- Cap.Governance.Tests.TestDrift runs between casting and executing.
module Cap.Governance.Dummies.Executable
  ( DummyExecutable (..)
  ) where

import DA.Foldable (forA_)
import DA.Map (Map)
import qualified DA.Map as Map
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.Utils (ExecutionCore (..), orAbort)
import Cap.Governance.BindingV1
import Cap.Governance.ExecutableV1
import Cap.Governance.Utils (holds, unchanged)

template DummyExecutable
  with
    core : ExecutionCore
    observers : [Party]
    bindings : Map TargetKey Bind
    outcome : Optional AnyValue
  where
    signatory Set.toList core.authorities
    observer observers

    interface instance Executable for DummyExecutable where
      view = ExecutableView with
        core
        bindings
        outcome

      executable_executeImpl targets _ = do
        fetched <- fetchAuthenticTargets targets
        forA_ (Map.toList bindings) $ \(tkey, bind) -> do
          cid <- orAbort "the bound target was not presented" (Map.lookup tkey targets)
          current <- case tkey of
            Authentic _ -> do
              presented <- orAbort "the bound target was not presented"
                (Map.lookup tkey fetched)
              pure Bind with state = (view presented).state; cid = Some cid
            Opaque _ -> pure Bind with state = None; cid = Some cid
          require "the target still satisfies the bind" (holds unchanged bind current)
        pure Executable_ExecuteResult with
          created = []
          meta = emptyMetadata

      executable_cancelImpl _ = pure Executable_CancelResult with meta = emptyMetadata
