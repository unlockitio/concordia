module Cap.Governance.Dummies.Target
  ( DummyTarget (..)
  ) where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1

import Cap.Governance.BindingV1

template DummyTarget
  with
    authorities : Set Party
    signer : Party
    id : Text
    state : Optional AnyValue
    observers : [Party]
  where
    signatory signer
    observer observers

    interface instance AuthenticTarget for DummyTarget where
      view = AuthenticTargetView with
        authorities
        id
        state
        meta = emptyMetadata
