-- | Shared fixtures for the unit tests.
module Cap.Governance.Tests.Support
  ( TestVoteRecord (..)
  , Dummy (..)
  , dummyCids
  , keyIn
  ) where

import DA.Map (Map)
import qualified DA.Map as Map
import qualified DA.Set as Set
import Daml.Script hiding (AnyContractId)

import Splice.Api.Token.MetadataV1 (AnyContractId)

import Splice.Util (HasCheckedFetch (..))

import Cap.Core.AuthenticKeyV1 (AuthenticKey (..))
import Cap.Core.IdentityV1 (Identity)
import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Core.Identity (HasIdentities (..))
import Cap.Governance.VoteRecordV1 (Vote)
import Cap.Governance.Vote (IsVoteRecord (..))


-- | A vote record carrying only votes. The tests that use it read nothing else, so
-- the other IsVoteRecord methods are stubs.
data TestVoteRecord v = TestVoteRecord with
    votes : Map Identity (Vote v)
  deriving (Eq, Show)

instance Show v => HasCheckedFetch (TestVoteRecord v) ResolutionInfo where
  contractGroupId _ = error "a TestVoteRecord belongs to no resolution"

instance HasIdentities (TestVoteRecord v) where
  identitiesOf record = Set.fromList (Map.keys record.votes)

instance Show v => IsVoteRecord (TestVoteRecord v) v () where
  votesOf record = record.votes
  snapshotsOf _ = Map.empty
  actionOf _ = ()
  consume _ = pure ()


-- | A contract created only to get contract ids for snapshots.
template Dummy
  with
    owner : Party
    tag : Int
  where
    signatory owner

dummyCids : Party -> Int -> Script [AnyContractId]
dummyCids owner n = forA [1 .. n] $ \tag ->
  coerceContractId <$> submit owner (createCmd Dummy with owner; tag)

-- | A target key under one party.
keyIn : Party -> Text -> AuthenticKey
keyIn party id = AuthenticKey with authorities = Set.fromList [party]; id
