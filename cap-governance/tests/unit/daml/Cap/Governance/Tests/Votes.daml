module Cap.Governance.Tests.Votes where

import DA.Assert ((===))
import DA.Foldable (forA_)
import qualified DA.Map as Map
import Daml.Script

import Splice.Api.Token.MetadataV1 (AnyValue (..))

import Cap.Core.IdentityV1 (Identity (..))
import Cap.Governance.VoteRecordV1 (Vote (..))
import Cap.Governance.Count (Cast (..))
import Cap.Governance.Vote
import Cap.Governance.Resolution (casts)

import Cap.Governance.Tests.Support


-- The standard decoders accept exactly what their encoders produce, and pass
-- Abstained and Absent through.
standardDecodersAreExactAndKeepAbstentions : Script ()
standardDecodersAreExactAndKeepAbstentions = do
  forA_ [Voted "yes", Abstained, Absent] $ \(vote : Vote Text) ->
    decodeTextVote (encodeTextVote vote) === Some vote
  forA_ [Voted 0.25, Abstained, Absent] $ \(vote : Vote Decimal) ->
    decodeDecimalVote (encodeDecimalVote vote) === Some vote
  decodeDecimalVote (Voted (AV_Int 1)) === None
  decodeDecimalVote (Voted (AV_Text "0.5")) === None
  decodeTextVote (Voted (AV_Decimal 0.5)) === None

-- A vote that does not decode fails as such, without the value check; a vote
-- that decodes fails only the value check; an abstention passes.
validVotesReportsEachFailureOnce : Script ()
validVotesReportsEachFailureOnce = do
  let (yes, maybe, wrongKind, abstains) =
        (ExternalIdentity "yes", ExternalIdentity "maybe", ExternalIdentity "kind", ExternalIdentity "abstains")
      record = TestVoteRecord $ Map.fromList
        [ (yes, Voted (AV_Text "yes"))
        , (maybe, Voted (AV_Text "maybe"))
        , (wrongKind, Voted (AV_Int 1))
        , (abstains, Abstained)
        ]
  validVotes decodeTextVote (validOneOf ["yes", "no"]) record
    === [ "the vote of " <> show wrongKind <> " does not decode as the kind this mechanism counts"
        , "the vote of " <> show maybe <> ": the value \"maybe\" is not among [\"yes\",\"no\"]"
        ]

-- The voters come from the weights map: a voter without a record, or whose
-- vote does not decode, is Absent; one outside the map is not counted.
castsCountsTheVotersOfTheWeightsMap : Script ()
castsCountsTheVotersOfTheWeightsMap = do
  let (yes, abstains, wrongKind, noRecord, outside) =
        ( ExternalIdentity "yes", ExternalIdentity "abstains", ExternalIdentity "kind"
        , ExternalIdentity "no-record", ExternalIdentity "outside" )
      records =
        [ TestVoteRecord $ Map.fromList [(yes, Voted (AV_Text "yes")), (abstains, Abstained)]
        , TestVoteRecord $ Map.fromList [(wrongKind, Voted (AV_Int 1)), (outside, Voted (AV_Text "no"))]
        ]
      weights = Map.fromList [(yes, 2.0), (abstains, 1.0), (wrongKind, 1.5), (noRecord, 3.0)]
  casts decodeTextVote weights records === Map.fromList
    [ (yes, Cast with weight = 2.0; vote = Voted "yes")
    , (abstains, Cast with weight = 1.0; vote = Abstained)
    , (wrongKind, Cast with weight = 1.5; vote = Absent)
    , (noRecord, Cast with weight = 3.0; vote = Absent)
    ]

-- Both bounds are inclusive, and None leaves a side open.
withinBoundsIsInclusiveAndOpenOnNone : Script ()
withinBoundsIsInclusiveAndOpenOnNone = do
  validWithinBounds (Some 0.0) (Some 1.0) 0.0 === []
  validWithinBounds (Some 0.0) (Some 1.0) 1.0 === []
  validWithinBounds (Some 0.0) (Some 1.0) (-0.5) === ["the value -0.5 is below the minimum 0.0"]
  validWithinBounds (Some 0.0) (Some 1.0) 1.5 === ["the value 1.5 is above the maximum 1.0"]
  validWithinBounds None (Some 1.0) (-100.0) === []
  validWithinBounds (Some 0.0) None 100.0 === []
