module Cap.Governance.Tests.Ballots where

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script

import Cap.Governance.Types (Vote (..))
import Cap.Governance.Utils.VoteRecords

import Cap.Governance.Tests.Support


-- Every ballot of a voter who appears twice fails, whatever the order, and on
-- ballots with several voters only the shared voter is reported.
distinctVotersFailsEveryBallotOfARepeatedVoter : Script ()
distinctVotersFailsEveryBallotOfARepeatedVoter = do
  let (twice, once, alone) = ("twice", "once", "alone")
      votesOf' parties = TestBallot $ Map.fromList [(p, Voted "yes") | p <- parties]
      first = votesOf' [twice]
      second = votesOf' [twice, once]
      third = votesOf' [alone]
      repeated = ["the voter " <> show twice <> " is on another vote record"]
  map (distinctVotersAmongVoteRecords [first, second, third]) [first, second, third]
    === [repeated, repeated, []]
  map (distinctVotersAmongVoteRecords [third, second, first]) [first, second, third]
    === [repeated, repeated, []]
