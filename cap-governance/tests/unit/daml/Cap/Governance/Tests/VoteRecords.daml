module Cap.Governance.Tests.VoteRecords where

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script

import Cap.Core.IdentityV1 (Identity (..))
import Cap.Core.Identity (validateDistinctIdentitiesAmong)
import Cap.Governance.VoteRecordV1 (Vote (..))

import Cap.Governance.Tests.Support


-- Every vote record of a voter who appears twice fails, whatever the order, and
-- on records with several voters only the shared voter is reported.
distinctVotersFailsEveryVoteRecordOfARepeatedVoter : Script ()
distinctVotersFailsEveryVoteRecordOfARepeatedVoter = do
  let (twice, once, alone) = (ExternalIdentity "twice", ExternalIdentity "once", ExternalIdentity "alone")
      recordOf parties = TestVoteRecord $ Map.fromList [(p, Voted "yes") | p <- parties]
      first = recordOf [twice]
      second = recordOf [twice, once]
      third = recordOf [alone]
      repeated = ["the identity " <> show twice <> " is on another contract"]
  map (validateDistinctIdentitiesAmong [first, second, third]) [first, second, third]
    === [repeated, repeated, []]
  map (validateDistinctIdentitiesAmong [third, second, first]) [first, second, third]
    === [repeated, repeated, []]
