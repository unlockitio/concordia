module Cap.Governance.Tests.Count where

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script

import Cap.Governance.Utils.Count


data Voters = Voters with
    alice : Party
    bob : Party
    carol : Party
    dave : Party

votersIn : Text -> Script Voters
votersIn ns = do
  alice <- allocateParty (ns <> "-alice")
  bob <- allocateParty (ns <> "-bob")
  carol <- allocateParty (ns <> "-carol")
  dave <- allocateParty (ns <> "-dave")
  pure Voters with ..

cast : Decimal -> Vote a -> Cast a
cast weight vote = Cast with weight; vote


weightedVotesSkipsAbsentVotersAndAbstentions : Script ()
weightedVotesSkipsAbsentVotersAndAbstentions = do
  v <- votersIn "weighted-votes"
  let casts = Map.fromList
        [(v.alice, cast 2.0 (Voted "yes")), (v.bob, cast 3.0 Abstained), (v.carol, cast 4.0 Absent)]
  weightedVotes casts === [("yes", 2.0)]
  votedWeight casts === 2.0
  presentWeight casts === 5.0

quorumsCountPresenceVotesOrWeight : Script ()
quorumsCountPresenceVotesOrWeight = do
  v <- votersIn "quorums"
  let casts = Map.fromList
        [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 Abstained), (v.carol, cast 1.0 Absent)]
  anyTurnout casts === True
  atLeastPresent 2 casts === True
  atLeastPresent 3 casts === False
  atLeastVotes 2 casts === False
  atLeastVotes 1 casts === True
  atLeastVotedWeight 1.0 casts === True
  atLeastVotedWeight 1.5 casts === False

atLeastShareOfTotalComparesThePresentWeightWithTheEligibleWeight : Script ()
atLeastShareOfTotalComparesThePresentWeightWithTheEligibleWeight = do
  v <- votersIn "share-total"
  let casts = Map.fromList
        [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 Abstained), (v.carol, cast 2.0 Absent)]
  atLeastShareOfTotal 1 2 casts === True
  atLeastShareOfTotal 3 4 casts === False
  atLeastShareOfTotal 1 0 casts === False
  atLeastShareOfTotal 1 2 (Map.fromList [(v.alice, cast 0.0 (Voted "yes"))]) === False

atLeastShareOfTotalMeetsAnExactTwoThirds : Script ()
atLeastShareOfTotalMeetsAnExactTwoThirds = do
  v <- votersIn "share-thirds"
  let eligible present absent =
        Map.fromList [(v.alice, cast present (Voted "yes")), (v.bob, cast absent Absent)]
  atLeastShareOfTotal 2 3 (eligible 6.0 3.0) === True
  atLeastShareOfTotal 2 3 (eligible 5.9 3.1) === False
  atLeastShareOfTotal 2 3 (eligible 6.6666666667 3.3333333333) === True
  atLeastShareOfTotal 2 3 (eligible 6.6666666666 3.3333333334) === False

allOfAndAnyOfCombineQuorums : Script ()
allOfAndAnyOfCombineQuorums = do
  v <- votersIn "combine"
  let casts = Map.fromList [(v.alice, cast 1.0 (Voted "yes"))]
  allOf [atLeastVotes 1, atLeastVotedWeight 5.0] casts === False
  anyOf [atLeastVotes 1, atLeastVotedWeight 5.0] casts === True
  allOf [] casts === True
  anyOf [] casts === False

unanimousNeedsEveryVoteToAgree : Script ()
unanimousNeedsEveryVoteToAgree = do
  v <- votersIn "unanimous"
  unanimous (Map.fromList
    [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "yes")), (v.carol, cast 1.0 Abstained)])
    === Some "yes"
  unanimous (Map.fromList [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "no"))])
    === None
  unanimous (Map.fromList [(v.alice, cast 1.0 (Abstained : Vote Text))]) === None

pluralityPicksTheHeaviestOption : Script ()
pluralityPicksTheHeaviestOption = do
  v <- votersIn "plurality"
  plurality (Map.fromList
    [(v.alice, cast 3.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "no")), (v.carol, cast 1.0 (Voted "no"))])
    === Some "yes"
  plurality (Map.fromList [(v.alice, cast 2.0 (Voted "yes")), (v.bob, cast 2.0 (Voted "no"))])
    === None
  plurality (Map.fromList [(v.alice, cast 1.0 (Abstained : Vote Text))]) === None

shareOfVotesNeedsExactlyOneOptionOverTheBar : Script ()
shareOfVotesNeedsExactlyOneOptionOverTheBar = do
  v <- votersIn "share-votes"
  let casts = Map.fromList [(v.alice, cast 3.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "no"))]
  shareOfVotes 1 2 casts === Some "yes"
  shareOfVotes 3 4 casts === Some "yes"
  shareOfVotes 1 5 casts === None
  shareOfVotes 9 10 casts === None
  shareOfVotes 1 0 casts === None

shareOfVotesMeetsAnExactTwoThirds : Script ()
shareOfVotesMeetsAnExactTwoThirds = do
  v <- votersIn "share-votes-thirds"
  let casts = Map.fromList
        [(v.alice, cast 2.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "no"))]
  shareOfVotes 2 3 casts === Some "yes"

medianAveragesTheTwoMiddlesOnAnEvenCount : Script ()
medianAveragesTheTwoMiddlesOnAnEvenCount = do
  v <- votersIn "median"
  median (Map.fromList
    [(v.alice, cast 5.0 (Voted 1.0)), (v.bob, cast 1.0 (Voted 3.0)), (v.carol, cast 1.0 (Voted 2.0))])
    === Some 2.0
  median (Map.fromList
    [ (v.alice, cast 1.0 (Voted 1.0)), (v.bob, cast 1.0 (Voted 2.0))
    , (v.carol, cast 1.0 (Voted 3.0)), (v.dave, cast 1.0 (Voted 4.0)) ])
    === Some 2.5
  median (Map.fromList [(v.alice, cast 1.0 Abstained)]) === None

weightedMedianTakesTheValueThatCrossesHalfTheWeight : Script ()
weightedMedianTakesTheValueThatCrossesHalfTheWeight = do
  v <- votersIn "weighted-median"
  weightedMedian (Map.fromList
    [(v.alice, cast 1.0 (Voted 1.0)), (v.bob, cast 1.0 (Voted 2.0)), (v.carol, cast 5.0 (Voted 10.0))])
    === Some 10.0
  weightedMedian (Map.fromList
    [(v.alice, cast 1.0 (Voted 1.0)), (v.bob, cast 0.0 (Voted 100.0))])
    === Some 1.0
  weightedMedian (Map.fromList [(v.alice, cast 1.0 Abstained)]) === None

firstOfTakesTheFirstTallyThatDecides : Script ()
firstOfTakesTheFirstTallyThatDecides = do
  v <- votersIn "first-of"
  let casts = Map.fromList [(v.alice, cast 1.0 (Voted "yes"))]
  firstOf [const None, unanimous] casts === Some "yes"
  firstOf [] casts === (None : Optional Text)

decideCombinesTheQuorumAndTheTally : Script ()
decideCombinesTheQuorumAndTheTally = do
  v <- votersIn "decide"
  let agreed = Map.fromList [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "yes"))]
      split = Map.fromList [(v.alice, cast 1.0 (Voted "yes")), (v.bob, cast 1.0 (Voted "no"))]
  decide (atLeastVotes 5) unanimous agreed === Lapsed
  decide anyTurnout unanimous split === Undecided
  decide anyTurnout unanimous agreed === Decided "yes"


