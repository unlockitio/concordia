checkIdentityRefusesASnapshotWithAState : Script ()
checkIdentityRefusesASnapshotWithAState = do
  env <- setup "identity-state"
  t1 <- target env "t1" 5
  submitMustFailContaining "is snapshotted by identity alone" env.owner $
    exerciseCmd env.probe Probe_CheckIdentity with
      key = keyOf env "t1"
