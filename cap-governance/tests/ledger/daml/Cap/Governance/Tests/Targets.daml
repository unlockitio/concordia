module Cap.Governance.Tests.Targets where

import Prelude hiding (Action)

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script hiding (AnyContractId)

import Splice.Api.Token.MetadataV1

import Cap.Core.Types (AuthenticKey (..), Snapshot (..))
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.ActionV1 (Action)

import Cap.Governance.Tests.Harness
import Cap.Governance.Tests.Support


data Env = Env with
    owner : Party
    probe : ContractId Probe

setup : Text -> Script Env
setup ns = do
  owner <- allocateParty (ns <> "-owner")
  probe <- submit owner $ createCmd Probe with owner
  pure Env with ..

target : Env -> Text -> Int -> Script (ContractId Target)
target env tag value = submit env.owner $ createCmd Target with
  owner = env.owner; tag; value; readers = []

keyOf : Env -> Text -> AuthenticKey
keyOf env = targetKey env.owner

emptySnapshot : Snapshot
emptySnapshot = Snapshot with state = None; cid = None

stateOf' : Int -> Snapshot
stateOf' value = Snapshot with state = Some (toAnyValue value); cid = None

cidOf : ContractId Target -> Snapshot
cidOf cid = Snapshot with state = None; cid = Some (coerceContractId cid)


snapshotStatesTakesTheOpenTargets : Script ()
snapshotStatesTakesTheOpenTargets = do
  env <- setup "snapshot-states"
  t1 <- target env "t1" 5
  t2 <- target env "t2" (-1)
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotStates with
    targets = Map.fromList [(keyOf env "t1", emptySnapshot), (keyOf env "t2", emptySnapshot)]
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1), (keyOf env "t2", coerceContractId t2)]
  taken === Map.fromList [(keyOf env "t1", stateOf' 5)]

snapshotStatesSkipsTargetsTheActionFixed : Script ()
snapshotStatesSkipsTargetsTheActionFixed = do
  env <- setup "snapshot-targets"
  t1 <- target env "t1" 5
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotStates with
    targets = Map.fromList [(keyOf env "t1", stateOf' 3)]
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]
  taken === Map.empty

snapshotStatesRefusesATargetTheActionDoesNotName : Script ()
snapshotStatesRefusesATargetTheActionDoesNotName = do
  env <- setup "snapshot-extra"
  t1 <- target env "t1" 5
  t2 <- target env "t2" 7
  submitMustFailContaining "the action names the presented target" env.owner $
    exerciseCmd env.probe Probe_SnapshotStates with
      targets = Map.fromList [(keyOf env "t1", emptySnapshot)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1), (keyOf env "t2", coerceContractId t2)]

snapshotCidsRefusesATargetTheActionDoesNotName : Script ()
snapshotCidsRefusesATargetTheActionDoesNotName = do
  env <- setup "snapshot-cids-extra"
  t1 <- target env "t1" 5
  t2 <- target env "t2" 7
  submitMustFailContaining "the action names the presented target" env.owner $
    exerciseCmd env.probe Probe_SnapshotCids with
      targets = Map.fromList [(keyOf env "t1", emptySnapshot)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1), (keyOf env "t2", coerceContractId t2)]

snapshotStatesRefusesAMissingTarget : Script ()
snapshotStatesRefusesAMissingTarget = do
  env <- setup "snapshot-missing"
  submitMustFailContaining "a target the action names was not presented" env.owner $
    exerciseCmd env.probe Probe_SnapshotStates with
      targets = Map.fromList [(keyOf env "t1", emptySnapshot)]; targetCids = Map.empty

snapshotCidsRecordsThePresentedContract : Script ()
snapshotCidsRecordsThePresentedContract = do
  env <- setup "snapshot-cids"
  t1 <- target env "t1" 5
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotCids with
    targets = Map.fromList [(keyOf env "t1", emptySnapshot)]
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]
  taken === Map.fromList [(keyOf env "t1", cidOf t1)]

snapshotCidsChecksTheKey : Script ()
snapshotCidsChecksTheKey = do
  env <- setup "snapshot-cids-key"
  t2 <- target env "t2" 5
  submitMustFailContaining "Contract group identifier mismatch" env.owner $
    exerciseCmd env.probe Probe_SnapshotCids with
      targets = Map.fromList [(keyOf env "t1", emptySnapshot)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t2)]

dummyAction : Env -> Map.Map AuthenticKey Snapshot -> Script (ContractId Action)
dummyAction env targets = do
  cid <- submit env.owner $ createCmd DummyAction with
    owner = env.owner; readers = []; authorizers = [[env.owner]]; targets
  pure (toInterfaceContractId cid)

snapshotStatesUsesTheActionsReaderAndTargets : Script ()
snapshotStatesUsesTheActionsReaderAndTargets = do
  env <- setup "snapshot-states-action"
  t1 <- target env "t1" 5
  t2 <- target env "t2" 7
  actionCid <- dummyAction env
    (Map.fromList [(keyOf env "t1", emptySnapshot), (keyOf env "t2", stateOf' 3)])
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotStatesOfAction with
    actionCid
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1), (keyOf env "t2", coerceContractId t2)]
  taken === Map.fromList [(keyOf env "t1", stateOf' 5)]

snapshotCidsUsesTheActionsReaderAndTargets : Script ()
snapshotCidsUsesTheActionsReaderAndTargets = do
  env <- setup "snapshot-cids-action"
  t1 <- target env "t1" 5
  actionCid <- dummyAction env (Map.fromList [(keyOf env "t1", emptySnapshot)])
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotCidsOfAction with
    actionCid
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]
  taken === Map.fromList [(keyOf env "t1", cidOf t1)]

mergeSnapshotsFillsTheOpenParts : Script ()
mergeSnapshotsFillsTheOpenParts = do
  env <- setup "merge-ok"
  merged <- submit env.owner $ exerciseCmd env.probe Probe_MergeSnapshots with
    targets = Map.fromList [(keyOf env "t1", emptySnapshot), (keyOf env "t2", emptySnapshot)]
    taken = Map.fromList [(keyOf env "t1", stateOf' 5)]
  merged === Map.fromList [(keyOf env "t1", stateOf' 5), (keyOf env "t2", emptySnapshot)]

mergeSnapshotsRefusesASnapshotOfAnUnknownTarget : Script ()
mergeSnapshotsRefusesASnapshotOfAnUnknownTarget = do
  env <- setup "merge-unknown"
  submitMustFailContaining "the action names the snapshot target" env.owner $
    exerciseCmd env.probe Probe_MergeSnapshots with
      targets = Map.fromList [(keyOf env "t1", emptySnapshot)]
      taken = Map.fromList [(keyOf env "t9", stateOf' 5)]

mergeSnapshotsRefusesAStateOverAFixedState : Script ()
mergeSnapshotsRefusesAStateOverAFixedState = do
  env <- setup "merge-state"
  submitMustFailContaining "takes no state snapshot of" env.owner $
    exerciseCmd env.probe Probe_MergeSnapshots with
      targets = Map.fromList [(keyOf env "t1", stateOf' 3)]
      taken = Map.fromList [(keyOf env "t1", stateOf' 5)]

mergeSnapshotsRefusesAContractOverAFixedContract : Script ()
mergeSnapshotsRefusesAContractOverAFixedContract = do
  env <- setup "merge-cid"
  t1 <- target env "t1" 5
  t1b <- target env "t1" 6
  submitMustFailContaining "takes no contract snapshot of" env.owner $
    exerciseCmd env.probe Probe_MergeSnapshots with
      targets = Map.fromList [(keyOf env "t1", cidOf t1)]
      taken = Map.fromList [(keyOf env "t1", cidOf t1b)]

mergeSnapshotsRefusesAStateForAFixedContract : Script ()
mergeSnapshotsRefusesAStateForAFixedContract = do
  env <- setup "merge-state-cid"
  t1 <- target env "t1" 5
  submitMustFailContaining "whose contract the action fixed" env.owner $
    exerciseCmd env.probe Probe_MergeSnapshots with
      targets = Map.fromList [(keyOf env "t1", cidOf t1)]
      taken = Map.fromList [(keyOf env "t1", stateOf' 5)]

requireSameKeysAcceptsExactlyTheSnapshottedTargets : Script ()
requireSameKeysAcceptsExactlyTheSnapshottedTargets = do
  env <- setup "same-keys"
  t1 <- target env "t1" 5
  t2 <- target env "t2" 5
  let snapshots = Map.fromList [(keyOf env "t1", emptySnapshot)]
  submit env.owner $ exerciseCmd env.probe Probe_RequireSameKeys with
    snapshots; targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]
  submitMustFailContaining "was not presented" env.owner $
    exerciseCmd env.probe Probe_RequireSameKeys with snapshots; targetCids = Map.empty
  submitMustFailContaining "every presented target has a snapshot" env.owner $
    exerciseCmd env.probe Probe_RequireSameKeys with
      snapshots; targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1), (keyOf env "t2", coerceContractId t2)]

checkTargetAcceptsATargetThatStillMatchesItsSnapshot : Script ()
checkTargetAcceptsATargetThatStillMatchesItsSnapshot = do
  env <- setup "check-ok"
  t1 <- target env "t1" 5
  result <- submit env.owner $ exerciseCmd env.probe Probe_CheckTarget with
    key = keyOf env "t1"
    snapshots = Map.fromList [(keyOf env "t1", stateOf' 5)]
    targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]
  result === t1

checkTargetRefusesAKeyWithoutSnapshot : Script ()
checkTargetRefusesAKeyWithoutSnapshot = do
  env <- setup "check-no-snapshot"
  t1 <- target env "t1" 5
  submitMustFailContaining "has no snapshot" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"; snapshots = Map.empty
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]

checkTargetRefusesAMissingTarget : Script ()
checkTargetRefusesAMissingTarget = do
  env <- setup "check-missing"
  submitMustFailContaining "was not presented" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"; snapshots = Map.fromList [(keyOf env "t1", emptySnapshot)]; targetCids = Map.empty

checkTargetRefusesAnotherContractThanTheSnapshottedOne : Script ()
checkTargetRefusesAnotherContractThanTheSnapshottedOne = do
  env <- setup "check-cid"
  t1 <- target env "t1" 5
  t1b <- target env "t1" 5
  submitMustFailContaining "is the one its snapshot recorded" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"
      snapshots = Map.fromList [(keyOf env "t1", cidOf t1)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1b)]

checkTargetRefusesAContractUnderAnotherKey : Script ()
checkTargetRefusesAContractUnderAnotherKey = do
  env <- setup "check-key"
  t2 <- target env "t2" 5
  submitMustFailContaining "Contract group identifier mismatch" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"
      snapshots = Map.fromList [(keyOf env "t1", emptySnapshot)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t2)]

checkTargetRefusesAContractSignedByAnotherParty : Script ()
checkTargetRefusesAContractSignedByAnotherParty = do
  env <- setup "check-signer"
  other <- allocateParty "check-signer-other"
  forged <- submit other $ createCmd Target with owner = other; tag = "t1"; value = 5; readers = [env.owner]
  submitMustFailContaining "Contract group identifier mismatch" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"
      snapshots = Map.fromList [(keyOf env "t1", emptySnapshot)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId forged)]

checkTargetRefusesADriftedState : Script ()
checkTargetRefusesADriftedState = do
  env <- setup "check-drift"
  t1 <- target env "t1" 6
  submitMustFailContaining "has drifted from its snapshot" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"
      snapshots = Map.fromList [(keyOf env "t1", stateOf' 5)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]

checkTargetRefusesASnapshotThatDoesNotDecode : Script ()
checkTargetRefusesASnapshotThatDoesNotDecode = do
  env <- setup "check-decode"
  t1 <- target env "t1" 5
  submitMustFailContaining "does not decode" env.owner $
    exerciseCmd env.probe Probe_CheckTarget with
      key = keyOf env "t1"
      snapshots = Map.fromList [(keyOf env "t1", Snapshot with state = Some (AV_Text "x"); cid = None)]
      targetCids = Map.fromList [(keyOf env "t1", coerceContractId t1)]

