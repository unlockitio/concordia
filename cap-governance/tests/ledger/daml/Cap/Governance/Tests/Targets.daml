module Cap.Governance.Tests.Targets where

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script hiding (AnyContractId)

import Cap.Core.Types (AuthenticKey, Snapshot (..))
import Cap.Core.Utils (IsAnyValue (..))

import Cap.Governance.Tests.Harness
import Cap.Governance.Tests.Support


data Env = Env with
    owner : Party
    probe : ContractId Probe

setup : Text -> Script Env
setup ns = do
  owner <- allocateParty (ns <> "-owner")
  probe <- submit owner $ createCmd Probe with owner
  pure Env with ..

target : Env -> Text -> Int -> Script (ContractId Target)
target env tag value = submit env.owner $ createCmd Target with owner = env.owner; tag; value

keyOf : Env -> Text -> AuthenticKey
keyOf env = targetKey env.owner

open : Snapshot
open = Snapshot with state = None; cid = None

stateSnapshot : Int -> Snapshot
stateSnapshot value = open with state = Some (toAnyValue value)


-- Only targets the action left fully open are read: a target whose reader
-- returns no state stays open, and a target the action fixed is not read, so
-- it need not be presented.
snapshotStatesWithReadsOnlyTheOpenTargets : Script ()
snapshotStatesWithReadsOnlyTheOpenTargets = do
  env <- setup "snapshot-states"
  read <- target env "read" 5
  unread <- target env "unread" (-1)
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotStatesWith with
    actionSnapshots = Map.fromList
      [ (keyOf env "read", open)
      , (keyOf env "unread", open)
      , (keyOf env "fixed", stateSnapshot 7)
      ]
    targetCids = Map.fromList
      [ (keyOf env "read", coerceContractId read)
      , (keyOf env "unread", coerceContractId unread)
      ]
  taken === Map.fromList [(keyOf env "read", stateSnapshot 5)]

-- A contract is recorded for every target whose contract the action left
-- open, including one whose state it fixed; a target whose contract it fixed
-- is not read, so it need not be presented.
snapshotCidsWithRecordsOnlyTheOpenContracts : Script ()
snapshotCidsWithRecordsOnlyTheOpenContracts = do
  env <- setup "snapshot-cids"
  openCid <- target env "open" 1
  stateFixed <- target env "state-fixed" 2
  cidFixed <- target env "cid-fixed" 3
  taken <- submit env.owner $ exerciseCmd env.probe Probe_SnapshotCidsWith with
    actionSnapshots = Map.fromList
      [ (keyOf env "open", open)
      , (keyOf env "state-fixed", stateSnapshot 2)
      , (keyOf env "cid-fixed", open with cid = Some (coerceContractId cidFixed))
      ]
    targetCids = Map.fromList
      [ (keyOf env "open", coerceContractId openCid)
      , (keyOf env "state-fixed", coerceContractId stateFixed)
      ]
  taken === Map.fromList
    [ (keyOf env "open", open with cid = Some (coerceContractId openCid))
    , (keyOf env "state-fixed", open with cid = Some (coerceContractId stateFixed))
    ]

-- The drift check runs on the contract that is fetched: a target still in its
-- snapshotted state is returned, and one whose live state changed aborts.
fetchTargetMatchingSnapshotChecksTheFetchedState : Script ()
fetchTargetMatchingSnapshotChecksTheFetchedState = do
  env <- setup "fetch-matching"
  unchangedCid <- target env "unchanged" 5
  drifted <- target env "drifted" 6
  let snapshots = Map.fromList
        [ (keyOf env "unchanged", stateSnapshot 5)
        , (keyOf env "drifted", stateSnapshot 5)
        ]
      targetCids = Map.fromList
        [ (keyOf env "unchanged", coerceContractId unchangedCid)
        , (keyOf env "drifted", coerceContractId drifted)
        ]
  fetched <- submit env.owner $ exerciseCmd env.probe Probe_FetchTargetMatchingSnapshot with
    key = keyOf env "unchanged"; snapshots; targetCids
  fetched === unchangedCid
  submitMustFailContaining "has drifted from its snapshot" env.owner $
    exerciseCmd env.probe Probe_FetchTargetMatchingSnapshot with
      key = keyOf env "drifted"; snapshots; targetCids
