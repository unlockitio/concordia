module Cap.Governance.Tests.TestBinding () where

import Prelude hiding (Action)

import DA.Assert ((===))
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.Time
import Daml.Script hiding (AnyContractId)

import Splice.Api.Token.MetadataV1

import Cap.Core.Harness (emptyExtraArgs)
import Cap.Core.SubmittableV1
import Cap.Core.Utils (ExecutionAction (..), ExecutionCore (..))
import Cap.Governance.ActionV1 (Action, AsOf (..), BindSpec (..), Stage (..))
import Cap.Governance.BallotV1
import Cap.Governance.BindingV1
import Cap.Governance.Dummies.Action
import Cap.Governance.Dummies.Ballot
import Cap.Governance.Dummies.Target
import Cap.Governance.ExecutableV1 (Executable)
import Cap.Governance.Harness


-- The setup
-------------

data Fixture = Fixture with
    liveBallot : LiveBallot
    mechanism : Mechanism
    actionCid : ContractId Action
    dso : Party
    voter : Party
    external : Party
    authorities : Set Party
    configKey : AuthenticTargetKey
    configCid : ContractId DummyTarget

configId : Text
configId = "config"

openingState : Text
openingState = "opening"

createTarget
  : Set Party -> Party -> Text -> Text -> [Party] -> Script (ContractId DummyTarget)
createTarget authorities signer id state observers =
  submit signer $ createCmd DummyTarget with
    authorities
    signer
    id
    state = Some (AV_Text state)
    observers

targetsOf : AuthenticTargetKey -> ContractId DummyTarget -> Map TargetKey AnyContractId
targetsOf tkey cid = Map.fromList [(Authentic tkey, coerceContractId cid)]

opaqueKey : TargetKey
opaqueKey = Opaque (OpaqueTargetKey "ans")

setupAs : Text -> Script Fixture
setupAs ns = do
  let party role = "binding-" <> ns <> "-" <> role
  dso <- allocatePartyByHint (PartyIdHint (party "dso"))
  voter <- allocatePartyByHint (PartyIdHint (party "voter"))
  external <- allocatePartyByHint (PartyIdHint (party "external"))
  now <- getTime

  let observers = [voter]
      authorities = Set.fromList [dso]
      configKey = AuthenticTargetKey with authorities; id = configId
      mechanism = Mechanism with
        resolver = ResolverKey with authorities; id = "body-1"
        resolverCid = None
        procedure = "procedure-1"
        id = "mechanism-1"

  configCid <- createTarget authorities dso configId openingState observers

  dummyActionCid <- submit dso $ createCmd DummyAction with
    signer = dso
    observers = observers
    authorizers = [[dso]]
    bindSpec = Map.fromList
      [ ( Authentic configKey
        , BindSpec with
            state = Some AsOf with stage = Submission; seen = None
            cid = AsOf with stage = Execution; seen = None
        )
      ]

  let actionCid = toInterfaceContractId @Action dummyActionCid

      ballot = DummyBallot with
        mechanism
        actionCid
        voter
        observers = observers
        opensAt = now `addRelTime` hours (-1)
        closesAt = now `addRelTime` days 1
        expiresAt = now `addRelTime` days 2
        availableActions = Map.fromList
          [ (BA_Cast, [[voter]])
          , (BA_Withdraw, [[voter]])
          ]
        bindings = Map.empty
        vote = None

  ballotCid <- submit voter $ createCmd ballot

  let liveBallot = LiveBallot with
        ballotCid = toInterfaceContractId @Ballot ballotCid
        voters = [voter]
        vote = AV_Text "yes"
        targets = targetsOf configKey configCid
        extraArgs = emptyExtraArgs
        disclosures = []

  pure Fixture with ..

replaceTarget : Fixture -> Text -> Script (ContractId DummyTarget)
replaceTarget Fixture {..} state = do
  submit dso $ archiveCmd configCid
  createTarget authorities dso configId state [voter]

authorizedOn
  : Fixture -> ExecutionCore -> Map TargetKey Bind -> Script (ContractId Executable)
authorizedOn Fixture {..} core bindings = do
  let liveAction = LiveAction with
        actionCid
        authorizers = [dso]
        core
        outcome = Some (AV_Text "yes")
        bindings
        extraArgs = emptyExtraArgs
        disclosures = []
  result <- runAuthorize liveAction (authorizeArg liveAction)
  case result.executionCids of
    [cid] -> pure cid
    cids -> fail ("expected one execution, got " <> show (length cids))

executionOver
  : Fixture -> ContractId Executable -> ContractId DummyTarget -> LiveExecution
executionOver Fixture {..} executionCid targetCid = LiveExecution with
  executionCid
  executors = [voter]
  targets = Map.fromList [(Authentic configKey, coerceContractId targetCid)]
  extraArgs = emptyExtraArgs
  disclosures = []

setupOpaqueAs : Text -> Script Fixture
setupOpaqueAs ns = do
  let party role = "opaque-" <> ns <> "-" <> role
  dso <- allocatePartyByHint (PartyIdHint (party "dso"))
  voter <- allocatePartyByHint (PartyIdHint (party "voter"))
  external <- allocatePartyByHint (PartyIdHint (party "external"))
  now <- getTime

  let observers = [voter]
      authorities = Set.fromList [dso]
      configKey = AuthenticTargetKey with authorities; id = configId
      mechanism = Mechanism with
        resolver = ResolverKey with authorities; id = "body-1"
        resolverCid = None
        procedure = "procedure-1"
        id = "mechanism-1"

  configCid <- createTarget authorities dso configId openingState observers

  dummyActionCid <- submit dso $ createCmd DummyAction with
    signer = dso
    observers = observers
    authorizers = [[dso]]
    bindSpec = Map.fromList
      [ ( opaqueKey
        , BindSpec with
            state = None
            cid = AsOf with stage = Submission; seen = None
        )
      ]

  let actionCid = toInterfaceContractId @Action dummyActionCid

  ballotCid <- submit voter $ createCmd DummyBallot with
    mechanism
    actionCid
    voter
    observers = observers
    opensAt = now `addRelTime` hours (-1)
    closesAt = now `addRelTime` days 1
    expiresAt = now `addRelTime` days 2
    availableActions = Map.fromList
      [ (BA_Cast, [[voter]])
      , (BA_Withdraw, [[voter]])
      ]
    bindings = Map.empty
    vote = None

  let liveBallot = LiveBallot with
        ballotCid = toInterfaceContractId @Ballot ballotCid
        voters = [voter]
        vote = AV_Text "yes"
        targets = Map.fromList [(opaqueKey, coerceContractId configCid)]
        extraArgs = emptyExtraArgs
        disclosures = []

  pure Fixture with ..

-- Binding tests
-----------------

-- | What BindingV1 does when an AuthenticTarget is presented: fetch it, check its
-- contract group identifier equals the key it was presented under, and check
-- its signatories cover the authorities its own view claims. An Opaque key is
-- never fetched, so none of that applies to one.

aTargetOfItsOwnKeyIsFetched : Script ()
aTargetOfItsOwnKeyIsFetched = do
  Fixture {..} <- setupAs "fetched"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  Map.lookup (Authentic configKey) seen.bindings
    === Some (Bind with state = Some (AV_Text "opening"); cid = None)

aTargetOfAnotherKeyIsRefused : Script ()
aTargetOfAnotherKeyIsRefused = do
  Fixture {..} <- setupAs "other-key"
  other <- createTarget authorities dso "another-config" openingState [voter]
  runCastFails liveBallot "Contract group identifier mismatch" $
    castArg liveBallot with
      targets = Map.fromList [(Authentic configKey, coerceContractId other)]

aTargetOfAnotherAuthorityIsRefused : Script ()
aTargetOfAnotherAuthorityIsRefused = do
  Fixture {..} <- setupAs "other-authority"
  other <- createTarget (Set.fromList [external]) external configId openingState [voter]
  runCastFails liveBallot "Contract group identifier mismatch" $
    castArg liveBallot with
      targets = Map.fromList [(Authentic configKey, coerceContractId other)]

aTargetNotSignedByItsAuthoritiesIsRefused : Script ()
aTargetNotSignedByItsAuthoritiesIsRefused = do
  Fixture {..} <- setupAs "impostor"
  impostor <- createTarget authorities external configId openingState [voter]
  runCastFails liveBallot "the target carries the signatures its cgid demands" $
    castArg liveBallot with
      targets = Map.fromList [(Authentic configKey, coerceContractId impostor)]

aPartlySignedTargetIsRefused : Script ()
aPartlySignedTargetIsRefused = do
  Fixture {..} <- setupAs "partly-signed"
  let bothKey = AuthenticTargetKey with
        authorities = Set.insert external authorities
        id = configKey.id
  partly <- createTarget bothKey.authorities dso configKey.id openingState [voter]
  runCastFails liveBallot "the target carries the signatures its cgid demands" $
    castArg liveBallot with
      targets = Map.fromList [(Authentic bothKey, coerceContractId partly)]

anOpaqueTargetIsNotFetched : Script ()
anOpaqueTargetIsNotFetched = do
  Fixture {..} <- setupAs "opaque"
  impostor <- createTarget authorities external configId openingState [voter]
  _ <- runCast liveBallot $
    castArg liveBallot with
      targets = Map.fromList
        [ (Authentic configKey, coerceContractId configCid)
        , (Opaque (OpaqueTargetKey "anything"), coerceContractId impostor)
        ]
  pure ()

anUnknownAuthenticTargetIsRefused : Script ()
anUnknownAuthenticTargetIsRefused = do
  Fixture {..} <- setupAs "unknown-key"
  let unknown = AuthenticTargetKey with authorities; id = "no-such-target"
  runCastFails liveBallot "Contract group identifier mismatch" $
    castArg liveBallot with
      targets = Map.fromList [(Authentic unknown, coerceContractId configCid)]


-- Opaque tests
----------------

-- | An Opaque key names a contract that doesnot implement autheticTarget, so it does not show state
--  Only its contract id can be pinned, and only against the id presented later.

anOpaqueBindPinsItsContract : Script ()
anOpaqueBindPinsItsContract = do
  Fixture {..} <- setupOpaqueAs "pins"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  Map.lookup opaqueKey seen.bindings
    === Some (Bind with state = None; cid = Some (coerceContractId configCid))

anOpaqueTargetThatWasnNotArchivedAndCreatedExecutes : Script ()
anOpaqueTargetThatWasnNotArchivedAndCreatedExecutes = do
  f@Fixture {..} <- setupOpaqueAs "stayed"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  let live = (executionOver f executionCid configCid) with
        targets = Map.fromList [(opaqueKey, coerceContractId configCid)]
  _ <- runExecute live (executeArg live)
  pure ()

anOpaqueTargetThatMovedIsRefused : Script ()
anOpaqueTargetThatMovedIsRefused = do
  f@Fixture {..} <- setupOpaqueAs "moved"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  moved <- replaceTarget f openingState
  let live = (executionOver f executionCid configCid) with
        targets = Map.fromList [(opaqueKey, coerceContractId moved)]
  runExecuteFails live "the target still satisfies the bind" (executeArg live)

anUnpresentedOpaqueTargetIsRefused : Script ()
anUnpresentedOpaqueTargetIsRefused = do
  f@Fixture {..} <- setupOpaqueAs "unpresented"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  let live = (executionOver f executionCid configCid) with targets = Map.empty
  runExecuteFails live "the bound target was not presented" (executeArg live)


-- Drift tests
---------------

-- | What a bind is for: casting pins the state a voter saw, the pin travels to
-- the execution, and the execution refuses a target that no longer satisfies
-- it. Pin at Submission, move the state, then execute.

castingPinsWhatTheVoterSaw : Script ()
castingPinsWhatTheVoterSaw = do
  Fixture {..} <- setupAs "pins"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  Map.lookup (Authentic configKey) seen.bindings
    === Some (Bind with state = Some (AV_Text openingState); cid = None)

anUndriftedTargetExecutes : Script ()
anUndriftedTargetExecutes = do
  f@Fixture {..} <- setupAs "undrifted"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  _ <- runExecute (executionOver f executionCid configCid) $
    executeArg (executionOver f executionCid configCid)
  pure ()

aDriftedTargetIsRefused : Script ()
aDriftedTargetIsRefused = do
  f@Fixture {..} <- setupAs "drifted"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  drifted <- replaceTarget f "moved"
  let live' = executionOver f executionCid drifted
  runExecuteFails live' "the target still satisfies the bind" (executeArg live')

aRecreatedTargetOfTheSameStateExecutes : Script ()
aRecreatedTargetOfTheSameStateExecutes = do
  f@Fixture {..} <- setupAs "recreated"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  same <- replaceTarget f openingState
  let live' = executionOver f executionCid same
  _ <- runExecute live' (executeArg live')
  pure ()

anUnpresentedTargetIsRefused : Script ()
anUnpresentedTargetIsRefused = do
  f@Fixture {..} <- setupAs "unpresented"
  cast <- runCast liveBallot (castArg liveBallot)
  seen <- ballotView voter cast
  now <- getTime
  let executionCore = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList
          [ (EA_Execute, [[voter]])
          , (EA_Cancel, [[voter]])
          ]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = None
        meta = emptyMetadata
  executionCid <- authorizedOn f executionCore seen.bindings
  let live' = (executionOver f executionCid configCid) with targets = Map.empty
  runExecuteFails live' "the bound target was not presented" (executeArg live')

-- Action tests
----------------

-- | What an action may declare as a bind spec. wellFormedAt runs in the
-- action's ensure, so a malformed spec never reaches a ledger: no pre-seen
-- value, no state fixed as late as its contract, no state on an Opaque key.

anActionCannotDeclareAPinItNeverTook : Script ()
anActionCannotDeclareAPinItNeverTook = do
  Fixture {..} <- setupAs "forged"
  submitMustFail dso $ createCmd DummyAction with
    signer = dso
    observers = [voter]
    authorizers = [[dso]]
    bindSpec = Map.fromList
      [ ( Authentic configKey
        , BindSpec with
            state = Some AsOf with
              stage = Submission
              seen = Some (AV_Text "never observed")
            cid = AsOf with stage = Execution; seen = None
        )
      ]

anActionCannotFixStateNoEarlierThanItsContract : Script ()
anActionCannotFixStateNoEarlierThanItsContract = do
  Fixture {..} <- setupAs "no-earlier"
  submitMustFail dso $ createCmd DummyAction with
    signer = dso
    observers = [voter]
    authorizers = [[dso]]
    bindSpec = Map.fromList
      [ ( Authentic configKey
        , BindSpec with
            state = Some AsOf with stage = Submission; seen = None
            cid = AsOf with stage = Submission; seen = None
        )
      ]

anOpaqueTargetCannotPublishState : Script ()
anOpaqueTargetCannotPublishState = do
  Fixture {..} <- setupAs "opaque-state"
  submitMustFail dso $ createCmd DummyAction with
    signer = dso
    observers = [voter]
    authorizers = [[dso]]
    bindSpec = Map.fromList
      [ ( Opaque (OpaqueTargetKey "ans")
        , BindSpec with
            state = Some AsOf with stage = Submission; seen = None
            cid = AsOf with stage = Execution; seen = None
        )
      ]


