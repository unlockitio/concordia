module Cap.Governance.Tests.TestFixedBodies () where

import Prelude hiding (Action)

import DA.Assert ((===))
import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time
import Daml.Script hiding (AnyContractId)

import Splice.Api.Token.MetadataV1

import Cap.Core.SubmittableV1 (Mechanism (..), ResolverKey (..))
import Cap.Core.Utils (ExecutionAction (..), ExecutionCore (..))
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.BallotV1
import Cap.Governance.Dummies.Action
import Cap.Governance.Dummies.Ballot
import Cap.Governance.Dummies.Executable
import Cap.Governance.Harness

data Fixture = Fixture with
    dso : Party
    voter : Party
    delegate : Party
    external : Party
    now : Time
    ballot : DummyBallot
    action : DummyAction
    executable : DummyExecutable
    core : ExecutionCore

setupAs : Text -> Script Fixture
setupAs ns = do
  let party role = "fixed-" <> ns <> "-" <> role
  dso <- allocatePartyByHint (PartyIdHint (party "dso"))
  voter <- allocatePartyByHint (PartyIdHint (party "voter"))
  delegate <- allocatePartyByHint (PartyIdHint (party "delegate"))
  external <- allocatePartyByHint (PartyIdHint (party "external"))
  now <- getTime

  let watchers = [voter, delegate, external]
      action = DummyAction with
        signer = dso; observers = watchers; authorizers = [[dso]]; bindSpec = Map.empty
      core = ExecutionCore with
        authorities = Set.fromList [dso]
        availableActions = Map.fromList [(EA_Execute, [[voter]]), (EA_Cancel, [[voter]])]
        opensAt = now `addRelTime` hours (-1)
        cancelAt = now `addRelTime` hours (-1)
        expiresAt = Some (now `addRelTime` days 1)
        meta = emptyMetadata
      executable = DummyExecutable with
        core; observers = watchers; bindings = Map.empty; outcome = None

  actionCid <- toInterfaceContractId @Action <$> submit dso (createCmd action)

  let ballot = DummyBallot with
        mechanism = Mechanism with
          resolver = ResolverKey with authorities = Set.fromList [dso]; id = "body-1"
          resolverCid = None
          procedure = "procedure-1"
          id = "mechanism-1"
        actionCid
        voter
        observers = watchers
        opensAt = now `addRelTime` hours (-1)
        closesAt = now `addRelTime` days 1
        expiresAt = now `addRelTime` days 2
        availableActions = Map.fromList [(BA_Cast, [[voter]]), (BA_Withdraw, [[voter]])]
        bindings = Map.empty
        vote = None

  pure Fixture with ..

anAdmittedVoterCasts : Script ()
anAdmittedVoterCasts = do
  Fixture {..} <- setupAs "cast-admitted"
  live <- putBallotUnbound ballot
  cast <- runCast live (castArg live)
  seen <- ballotView voter cast
  seen.vote === Some live.vote

aStrangerDoesNotCast : Script ()
aStrangerDoesNotCast = do
  Fixture {..} <- setupAs "cast-stranger"
  live <- putBallotUnbound ballot
  runCastFails live "the actors are entitled to cast" $
    (castArg live) with actors = [external]

aDelegateCastsWhenTheMapNamesIt : Script ()
aDelegateCastsWhenTheMapNamesIt = do
  Fixture {..} <- setupAs "cast-delegate"
  live <- putBallotUnbound (ballot with
    availableActions = Map.fromList
      [ (BA_Cast, [[voter], [delegate]])
      , (BA_Withdraw, [[voter]])
      ])
  _ <- runCast live ((castArg live) with actors = [delegate])
  pure ()

aJointGroupCastsTogether : Script ()
aJointGroupCastsTogether = do
  Fixture {..} <- setupAs "cast-joint"
  live <- putBallotUnbound (ballot with
    availableActions = Map.fromList [(BA_Cast, [[voter, delegate]])])
  _ <- runCast live ((castArg live) with actors = [voter, delegate])
  pure ()

