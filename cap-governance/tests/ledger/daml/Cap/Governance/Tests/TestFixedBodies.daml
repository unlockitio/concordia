aVoterDoesNotConsume : Script ()
aVoterDoesNotConsume = do
  Fixture {..} <- setupAs "consume-voter"
  live <- putBallotUnbound ballot
  runConsumeUnauthorized live [voter]

everyResolverAuthorityConsentsToAConsume : Script ()
everyResolverAuthorityConsentsToAConsume = do
  Fixture {..} <- setupAs "consume-joint"
  let joint = Set.fromList [dso, delegate]
  live <- putBallotUnbound (ballot with
    mechanism = ballot.mechanism with
      resolver = ResolverKey with
        authorities = joint
        id = ballot.mechanism.resolver.id)
  runConsumeUnauthorized live [dso]
  _ <- runConsume live (Set.toList joint)
  pure ()

anAuthorizerSetAuthorizes : Script ()
anAuthorizerSetAuthorizes = do
  Fixture {..} <- setupAs "authorize-admitted"
  live <- putActionUnbound (action with authorizers = [[dso]]) core
  result <- runAuthorize live (authorizeArg live)
  length result.executionCids === 1

