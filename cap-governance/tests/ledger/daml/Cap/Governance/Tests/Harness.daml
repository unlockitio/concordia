-- | Templates and a probe that run the library functions whose own logic needs
-- Update, so that the tests can call them on ledger contracts.
module Cap.Governance.Tests.Harness where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..))

import Cap.Core.Types (AuthenticKey (..), Snapshot (..))
import Cap.Core.Utils (IsAnyValue (..), fetchCheckedAny, signatoriesKey)
import Cap.Governance.Utils


targetKey : Party -> Text -> AuthenticKey
targetKey party tag = AuthenticKey with authorities = Set.fromList [party]; id = tag

-- | A target whose state is its value.
template Target
  with
    owner : Party
    tag : Text
    value : Int
  where
    signatory owner

instance HasCheckedFetch Target AuthenticKey where
  contractGroupId target = signatoriesKey target.tag target

instance HasState Target Int where
  stateOf target = target.value

-- | Reads a target's state, and no state for a negative value, so that a test
-- can leave a target open.
readTarget : TargetReader
readTarget key cid = do
  (_, target) <- fetchCheckedAny @Target key cid
  pure (if target.value < 0 then None else Some (toAnyValue (stateOf target)))


template Probe
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice Probe_SnapshotStatesWith : Map AuthenticKey Snapshot
      with
        actionSnapshots : Map AuthenticKey Snapshot
        targetCids : Map AuthenticKey AnyContractId
      controller owner
      do snapshotStatesWith readTarget actionSnapshots targetCids

    nonconsuming choice Probe_SnapshotCidsWith : Map AuthenticKey Snapshot
      with
        actionSnapshots : Map AuthenticKey Snapshot
        targetCids : Map AuthenticKey AnyContractId
      controller owner
      do snapshotCidsWith readTarget actionSnapshots targetCids

    nonconsuming choice Probe_FetchTargetMatchingSnapshot : ContractId Target
      with
        key : AuthenticKey
        snapshots : Map AuthenticKey Snapshot
        targetCids : Map AuthenticKey AnyContractId
      controller owner
      do fst <$> fetchTargetMatchingSnapshot @Target unchanged key snapshots targetCids
