module Cap.Governance.Tests.VotingRights where

import DA.Assert ((===))
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import Daml.Script

import Splice.Util (HasCheckedFetch (..))

import Cap.Governance.Types (OwnerId, VotingRight (..))
import Cap.Governance.Utils.VotingRights


-- | Voting rights a test sets directly.
template VotingRightsSource
  with
    owner : Party
    tag : Text
    rights : Map OwnerId VotingRight
  where
    signatory owner

instance HasCheckedFetch VotingRightsSource Text where
  contractGroupId source = source.tag

instance HasVotingRights VotingRightsSource where
  rightsOf source = source.rights

template VotingRightsProbe
  with
    owner : Party
  where
    signatory owner

    nonconsuming choice VotingRightsProbe_FetchVotingRightsSummingWeights : Map OwnerId VotingRight
      with
        rightKeys : Set Text
        rightCids : Map Text (ContractId VotingRightsSource)
      controller owner
      do fetchVotingRightsSummingWeights rightKeys rightCids


-- An owner named by several contracts gets the sum of their weights and the
-- union of their casters; a contract that only names casters adds no weight.
fetchVotingRightsSummingWeightsUnitesCasters : Script ()
fetchVotingRightsSummingWeightsUnitesCasters = do
  [owner, alice, bob] <- forA ["owner", "alice", "bob"] $ \n -> allocateParty ("rights-merge-" <> n)
  probe <- submit owner $ createCmd VotingRightsProbe with owner
  let source tag rights = submit owner $ createCmd VotingRightsSource with owner; tag; rights = Map.fromList rights
  r1 <- source "r1" [("sv-1", VotingRight 2.0 (Set.fromList [alice])), ("sv-2", VotingRight 1.0 (Set.fromList [bob]))]
  r2 <- source "r2" [("sv-1", VotingRight 1.5 Set.empty)]
  r3 <- source "r3" [("sv-1", VotingRight 0.0 (Set.fromList [bob]))]
  rights <- submit owner $ exerciseCmd probe VotingRightsProbe_FetchVotingRightsSummingWeights with
    rightKeys = Set.fromList ["r1", "r2", "r3"]
    rightCids = Map.fromList [("r1", r1), ("r2", r2), ("r3", r3)]
  rights === Map.fromList
    [ ("sv-1", VotingRight 3.5 (Set.fromList [alice, bob]))
    , ("sv-2", VotingRight 1.0 (Set.fromList [bob]))
    ]
