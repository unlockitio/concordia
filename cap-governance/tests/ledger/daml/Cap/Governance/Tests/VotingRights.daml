module Cap.Governance.Tests.VotingRights where

import DA.Assert ((===))
import qualified DA.Map as Map
import qualified DA.Set as Set
import Daml.Script

import Cap.Governance.Tests.Harness


data Env = Env with
    owner : Party
    alice : Party
    bob : Party
    probe : ContractId Probe

setup : Text -> Script Env
setup ns = do
  owner <- allocateParty (ns <> "-owner")
  alice <- allocateParty (ns <> "-alice")
  bob <- allocateParty (ns <> "-bob")
  probe <- submit owner $ createCmd Probe with owner
  pure Env with ..

weight : Env -> Text -> Party -> Decimal -> Script (ContractId Weight)
weight env tag holder amount = submit env.owner $ createCmd Weight with
  owner = env.owner; tag; holder; amount


-- A holder with rights in several contracts gets the sum of its weights.
fetchWeightsPerContractSumsAHolderAcrossContracts : Script ()
fetchWeightsPerContractSumsAHolderAcrossContracts = do
  env <- setup "weights-sum"
  w1 <- weight env "w1" env.alice 2.0
  w2 <- weight env "w2" env.alice 1.5
  w3 <- weight env "w3" env.bob 1.0
  weights <- submit env.owner $ exerciseCmd env.probe Probe_FetchWeightsPerContract with
    rightKeys = Set.fromList ["w1", "w2", "w3"]
    rightCids = Map.fromList [("w1", w1), ("w2", w2), ("w3", w3)]
  weights === Map.fromList [(env.alice, 3.5), (env.bob, 1.0)]

-- A holder whose total weight is zero is not a voter.
fetchVotersPerContractDropsHoldersWithoutWeight : Script ()
fetchVotersPerContractDropsHoldersWithoutWeight = do
  env <- setup "voters-zero"
  w1 <- weight env "w1" env.alice 2.0
  w2 <- weight env "w2" env.bob 0.0
  voters <- submit env.owner $ exerciseCmd env.probe Probe_FetchVotersPerContract with
    rightKeys = Set.fromList ["w1", "w2"]
    rightCids = Map.fromList [("w1", w1), ("w2", w2)]
  voters === Set.fromList [env.alice]
