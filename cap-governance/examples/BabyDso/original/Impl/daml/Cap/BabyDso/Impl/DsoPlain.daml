-- =============================================================================
-- Baby-DSO : idiomatic plain-Daml reproduction of Splice's DSO governance
-- with NO cap-core dependency. It covers
-- both the VOTING path and the CONFIRMATION / SV-onboarding path,
-- the MEDIAN amulet-price path, and the RULES-config (SetConfig) path.
--
-- The confirmation path adds the threshold-gated ConfirmAction/ExecuteConfirmed
-- flow and the StartSvOnboarding -> ConfirmSvOnboarding -> AddConfirmedSv chain,
-- plus the onboarding request's two exits (expiry and post-onboarding archival).
-- The MEDIAN path (Splice.DSO.AmuletPrice) adds the per-SV standing
-- AmuletPriceVote (updated under the same cooldown, minted at onboarding with a
-- None price), fetchMedianAmuletPrice's "every sv voted exactly once" check,
-- and the round-advancement consumer that lands the median on AmuletRules.
-- The CONFIG path (Splice's DsoRules_SetConfig) adds the whole-config vote: its
-- action carries the config it was prepared against, and close PATCHES only the
-- fields that changed against that base onto the live config. So two config
-- votes proposed against the same base but touching different fields COMPOSE in
-- either order, instead of the later one reverting the earlier (Splice's `patch`
-- branch — golden vector GV-20).
--
-- =============================================================================
module Cap.BabyDso.Impl.DsoPlain where

import DA.List (sort, (!!))
import DA.Time (RelTime, addRelTime, minutes)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.Text as T
import DA.Action (void, unless)
import DA.Optional (fromOptional, fromSome, isSome, mapOptional)


data Reason = Reason with
    url  : Text
    body : Text
  deriving (Eq, Show)

-- Mirrors Splice.Types.Round (the mining round an SV joined in).
data Round = Round with
    number : Int
  deriving (Eq, Ord, Show)

-- Mirrors DsoRules.SvInfo : per-SV metadata held in the svs map.
data SvInfo = SvInfo with
    name            : Text  -- human-readable; unique
    joinedAsOfRound : Round
    svRewardWeight  : Int   -- reward-distribution weight; NOT used by the vote tally
    participantId   : Text
  deriving (Eq, Show)

-- Mirrors DsoRules.OffboardedSvInfo : kept for offboarded SVs.
data OffboardedSvInfo = OffboardedSvInfo with
    name          : Text
    participantId : Text
  deriving (Eq, Show)

-- A vote cast by an SV. accept is BINARY — abstain = absence from the votes map.
data Vote = Vote with
    sv        : Party
    accept    : Bool
    reason    : Reason
    optCastAt : Optional Time
  deriving (Eq, Show)

-- Mirrors VoteRequestOutcome (the value the golden vectors assert).
data VoteRequestOutcome
  = VRO_Accepted with effectiveAt : Time
  | VRO_Rejected
  | VRO_Expired
  deriving (Eq, Show)

-- The action a passed vote executes. Downstream asset effects are out of scope;
-- we model only the governance self-amendment the vectors exercise plus a no-op
-- standing in for grant/revoke (always succeeds, no state change).
-- Beyond the voting path, ConfirmSvOnboarding is the action the CONFIRMATION path
-- runs to approve a new SV (mirrors SRARC_ConfirmSvOnboarding).
data GovAction
  = NoOp
  | OffboardSv with offboard : Party
  | ConfirmSvOnboarding with
      newSvParty       : Party
      newSvName        : Text
      newParticipantId : Text
      newSvRewardWeight : Int
      reason           : Text
      
  -- Whole-config amendment (mirrors SRARC_SetConfig / DsoRules_SetConfig).
  -- baseConfig = the config the vote was prepared against; None replaces wholesale.
  | SetConfig with
      newConfig  : DsoRulesConfig
      baseConfig : Optional DsoRulesConfig

  -- Mirrors Splice's ARC_AnsEntryContext: the action embeds a
  -- ContractId, so an approval pins an instance and not an identity. Every other
  -- action here is value-typed; this one exists only to exercise the liveness bug.
  | TouchAmuletRules with
      amuletRulesCid : ContractId AmuletRules
  deriving (Eq, Show)

-- Result of closing, mirroring DsoRules_CloseVoteRequestResult's asserted fields.
data CloseResult = CloseResult with
    outcome          : VoteRequestOutcome
    offboardedVoters : [Text]
    abstainingSvs    : [Text]
    completedAt      : Time
  deriving (Eq, Show)

-- Subset of DsoRulesConfig the voting + confirmation choices read.
data DsoRulesConfig = DsoRulesConfig with
    voteRequestTimeout           : RelTime
    voteCooldownTime             : Optional RelTime  -- None = default (1 min)
    maxTextLength                : Int
    actionConfirmationTimeout    : RelTime           -- TTL of a Confirmation
    svOnboardingRequestTimeout   : RelTime           -- TTL of an SvOnboardingRequest
    svOnboardingConfirmedTimeout : RelTime           -- TTL of an SvOnboardingConfirmed
  deriving (Eq, Show)

getVoteCooldownTime : DsoRulesConfig -> RelTime
getVoteCooldownTime config = fromOptional (minutes 1) config.voteCooldownTime

-- --- Amulet-price (median) voting (mirrors Splice.DSO.AmuletPrice) ------------

-- | A vote by an SV for their desired amulet price. Standing, not per-decision:
-- each SV holds exactly one (minted at onboarding, price None until first set)
-- and re-prices it at will under the recast cooldown.
template AmuletPriceVote with
    dso           : Party
    sv            : Party
    amuletPrice   : Optional Decimal  -- None for new svs, defined thereafter
    lastUpdatedAt : Time              -- rate-limits recasting (enforceCooldown)
  where
    ensure optional True (0.0 <) amuletPrice
    signatory dso

-- | Splice's fetchMedianAmuletPrice: the votes are reference data (fetched,
-- never archived), every current SV must be represented exactly once, and a
-- None price counts as abstention — dropped from the median.
fetchMedianAmuletPrice : Party -> [Party] -> [ContractId AmuletPriceVote] -> Update Decimal
fetchMedianAmuletPrice dso svs voteCids = do
  votes <- forA voteCids (fetchReferenceData (ForDso with dso))
  let voters = map (.sv) votes
  require "Every sv voted exactly once" (sort voters == sort svs)
  pure $ median $ mapOptional (.amuletPrice) votes

-- | Not defined for the empty list.
median : [Decimal] -> Decimal
median [] = error "median: not defined for the empty list"
median xs0 =
    0.5 * (xs !! ((n - 1) / 2) + xs !! (n / 2))
  where
    xs = sort xs0
    n = length xs

-- | The standing contract the median lands on — Splice opens each new
-- OpenMiningRound at the median price; mining machinery is out of scope, so
-- here the round advancement sets AmuletRules' current price directly.
template AmuletRules with
    dso         : Party
    amuletPrice : Decimal
  where
    ensure amuletPrice > 0.0
    signatory dso

    choice ASetAmuletPrice : ContractId AmuletRules
      with
        newAmuletPrice : Decimal
      controller dso
      do create this with amuletPrice = newAmuletPrice

-- --- Per-decision contract ---------------------------------------------------

template VoteRequest with
    dso               : Party
    requester         : Text                -- SV NAME
    action            : GovAction
    reason            : Reason
    voteBefore        : Time
    votes             : Map.Map Text Vote   -- keyed by SV NAME
    trackingCid       : Optional (ContractId VoteRequest)  -- stable id across recreations
    targetEffectiveAt : Optional Time
  where
    ensure optional True (voteBefore <=) targetEffectiveAt
    signatory dso

-- --- Onboarding + confirmation-path contracts --------------------------------

-- Created by a sponsoring SV to start onboarding a candidate (mirrors
-- SvOnboardingRequest). Observer candidateParty so the not-yet-SV can see it.
template SvOnboardingRequest with
    candidateName          : Text
    candidateParty         : Party
    candidateParticipantId : Text
    token                  : Text
    sponsor                : Party
    dso                    : Party
    expiresAt              : Time
  where
    signatory dso
    observer candidateParty

    -- Archive if we are past the `expiresAt`.
    choice SvOnboardingRequest_Expire : ()
      controller dso
      do
        now <- getTime
        require "Onboarding has expired" (now >= expiresAt)

-- Approval marker produced by the confirmation path; the candidate self-adds off it.
template SvOnboardingConfirmed with
    svParty         : Party
    svName          : Text
    svRewardWeight  : Int
    svParticipantId : Text
    reason          : Text
    dso             : Party
    expiresAt       : Time
  where
    signatory dso
    observer svParty

-- One SV's confirmation of an action (mirrors Confirmation). The confirmation path
-- collects >= requiredNumVotes of these for the same action, then executes it.
template Confirmation with
    dso       : Party
    confirmer : Party
    action    : GovAction
    expiresAt : Time
  where
    signatory dso

-- --- Standing body -----------------------------------------------------------

template DsoRules with
    dso           : Party
    epoch         : Int
    svs           : Map.Map Party SvInfo
    offboardedSvs : Map.Map Party OffboardedSvInfo
    dsoDelegate   : Party
    config        : DsoRulesConfig
  where
    signatory dso

    -- Self-amendment used by close to execute an accepted OffboardSv.
    -- Mirrors DsoRules_OffboardSv (size>1 guard, "Not a sv", delegate reassign).
    choice DsoRules_OffboardSv : ContractId DsoRules
      with
        offboard : Party
      controller dso
      do
        require "There is more than one sv" (Map.size svs > 1)
        case Map.lookup offboard svs of
          None -> fail "Not a sv"
          Some info -> do
            let newSvs = Map.delete offboard svs
            let isDelegate = offboard == dsoDelegate
            let newDelegate = case Map.keys newSvs of
                  (k :: _) | isDelegate -> k
                  _                     -> dsoDelegate
            let newEpoch = if isDelegate then epoch + 1 else epoch
            let offboardedSvInfo = OffboardedSvInfo with
                  name = info.name
                  participantId = info.participantId
            create this with
              svs = newSvs
              offboardedSvs = Map.insert offboard offboardedSvInfo offboardedSvs
              dsoDelegate = newDelegate
              epoch = newEpoch

    -- Add an SV, recreating DsoRules with the expanded set (mirrors DsoRules_AddSv
    -- via dsoRules_addSv, non-devnet path). Consuming. Driven directly by dso
    -- (bootstrap) or by the candidate's DsoRules_AddConfirmedSv / the confirmation path.
    choice DsoRules_AddSv : ContractId DsoRules
      with
        newSvParty         : Party
        newSvName          : Text
        newSvRewardWeight  : Int
        newSvParticipantId : Text
        joinedAsOfRound    : Round
      controller dso
      do
        ensureNeverOperatedNode newSvParty this
        require "SV is not currently onboarded"
          (newSvName `notElem` map (.name) (Map.values svs))
        let info = SvInfo with
              name = newSvName
              joinedAsOfRound
              svRewardWeight = newSvRewardWeight
              participantId = newSvParticipantId
        -- Per-SV-party contracts (mirrors createPerSvPartyContracts): the price
        -- vote is tracked per operator, so it resets on re-onboarding; it is NOT
        -- archived at offboarding (Splice: the offboardee could otherwise block
        -- its removal by re-pricing at the right time — a GC trigger cleans up).
        now <- getTime
        void $ create AmuletPriceVote with
          dso
          sv = newSvParty
          amuletPrice = None
          lastUpdatedAt =
            -- allow casting a vote immediately after onboarding
            now `addRelTime` negate (getVoteCooldownTime config)
        create this with svs = Map.insert newSvParty info svs

    -- A sponsoring SV starts onboarding a candidate (mirrors DsoRules_StartSvOnboarding).
    nonconsuming choice DsoRules_StartSvOnboarding : ContractId SvOnboardingRequest
      with
        candidateName          : Text
        candidateParty         : Party
        candidateParticipantId : Text
        token                  : Text
        sponsor                : Party
      controller sponsor
      do
        require "Sponsor is an SV" (sponsor `Map.member` svs)
        now <- getTime
        let expiresAt = now `addRelTime` config.svOnboardingRequestTimeout
        create SvOnboardingRequest with
          candidateName; candidateParty; candidateParticipantId; token; sponsor; dso; expiresAt

    -- Expire a stale onboarding request (mirrors DsoRules_ExpireSvOnboardingRequest).
    nonconsuming choice DsoRules_ExpireSvOnboardingRequest : ()
      with
        cid : ContractId SvOnboardingRequest
        sv  : Optional Party
      controller sv
      do
        _ <- getAndValidateSvParty this sv
        exercise cid SvOnboardingRequest_Expire

    -- Archive the leftover request of a candidate that completed onboarding
    -- (mirrors DsoRules_ArchiveSvOnboardingRequest).
    nonconsuming choice DsoRules_ArchiveSvOnboardingRequest : ()
      with
        svOnboardingRequestCid : ContractId SvOnboardingRequest
        sv                     : Optional Party
      controller sv
      do
        _ <- getAndValidateSvParty this sv
        r <- fetchAndArchive (ForDso with dso) svOnboardingRequestCid
        let maybeSv = Map.lookup r.candidateParty svs
        require "SV party is an SV" (isSome maybeSv)
        require "SV name matches" ((fromSome maybeSv).name == r.candidateName)

    -- The confirmation-path action that approves a candidate: creates the
    -- SvOnboardingConfirmed marker (mirrors DsoRules_ConfirmSvOnboarding). Run by
    -- DsoRules_ExecuteConfirmedAction, so it carries dso authority. Nonconsuming.
    nonconsuming choice DsoRules_ConfirmSvOnboarding : ContractId SvOnboardingConfirmed
      with
        newSvParty        : Party
        newSvName         : Text
        newParticipantId  : Text
        newSvRewardWeight : Int
        reason            : Text
      controller dso
      do
        ensureNeverOperatedNode newSvParty this
        require "SV name is expected to be new"
          (newSvName `notElem` map (.name) (Map.values svs))
        now <- getTime
        let expiresAt = now `addRelTime` config.svOnboardingConfirmedTimeout
        create SvOnboardingConfirmed with
          svParty = newSvParty; svName = newSvName; svRewardWeight = newSvRewardWeight
          svParticipantId = newParticipantId; reason; dso; expiresAt

    -- The candidate completes onboarding by self-adding off its confirmation
    -- (mirrors DsoRules_AddConfirmedSv). The OpenMiningRound handshake Splice uses
    -- to derive a cheat-resistant joinedAsOfRound is AmuletRules/mining machinery
    -- (out of scope), so we default the round.
    nonconsuming choice DsoRules_AddConfirmedSv : ContractId DsoRules
      with
        sv                       : Party
        svOnboardingConfirmedCid : ContractId SvOnboardingConfirmed
      controller sv
      do
        soc <- fetchAndArchive (ForOwner with dso; owner = sv) svOnboardingConfirmedCid
        assertWithinDeadline "svOnboardingConfirmed.expiresAt" soc.expiresAt
        exercise self DsoRules_AddSv with
          newSvParty = sv
          newSvName = soc.svName
          newSvRewardWeight = soc.svRewardWeight
          newSvParticipantId = soc.svParticipantId
          joinedAsOfRound = Round 0

    -- Confirmation path: one SV records its confirmation of an action
    -- (mirrors DsoRules_ConfirmAction). Nonconsuming.
    nonconsuming choice DsoRules_ConfirmAction : ContractId Confirmation
      with
        confirmer : Party
        action    : GovAction
      controller confirmer
      do
        require "Confirmer is an SV" (confirmer `Map.member` svs)
        now <- getTime
        let expiresAt = now `addRelTime` config.actionConfirmationTimeout
        create Confirmation with dso; confirmer; action; expiresAt

    -- Confirmation path: execute an action once enough distinct, unexpired,
    -- matching confirmations exist (mirrors DsoRules_ExecuteConfirmedAction).
    nonconsuming choice DsoRules_ExecuteConfirmedAction : ()
      with
        action           : GovAction
        confirmationCids : [ContractId Confirmation]
        sv               : Optional Party
      controller sv
      do
        _ <- getAndValidateSvParty this sv
        let r = requiredNumVotes (Map.size svs)
        require "Enough confirmations" (length confirmationCids >= r)
        confirmers <- mapA
          (\cid -> do
              c <- fetchAndArchive (ForDso with dso) cid
              require "Confirmer is an SV" (c.confirmer `Map.member` svs)
              require "Confirmed action matches" (c.action == action) -- no id
              assertWithinDeadline "confirmation.expiresAt" c.expiresAt
              pure c.confirmer)
          confirmationCids
        require "No duplicate confirmers"
          (Set.size (Set.fromList confirmers) == length confirmers)
        executeAction self action

    -- Open a vote request; the requester's YES is auto-inserted (DsoRules.daml:726).
    nonconsuming choice DsoRules_RequestVote : ContractId VoteRequest
      with
        requester          : Party
        action             : GovAction
        reason             : Reason
        voteRequestTimeout : Optional RelTime
        targetEffectiveAt  : Optional Time
      controller requester
      do
        requesterName <- case Map.lookup requester svs of
          None      -> fail "Requester is not an SV"
          Some info -> pure info.name
        requireWellformedReason config reason
        now <- getTime
        let voteBefore = case voteRequestTimeout of
              Some value -> now `addRelTime` value
              None       -> now `addRelTime` config.voteRequestTimeout
        require "There is some time to vote" (now < voteBefore)
        let requesterVote = Vote with
              sv = requester
              accept = True
              reason = Reason with url = ""; body = "I accept, as I requested the vote."
              optCastAt = Some now
        create VoteRequest with
          dso; requester = requesterName; action; reason; voteBefore
          votes = Map.fromList [(requesterName, requesterVote)]
          trackingCid = None
          targetEffectiveAt

    -- Cast or update a vote (checked fetch + archive + recreate). DsoRules.daml:764.
    nonconsuming choice DsoRules_CastVote : ContractId VoteRequest
      with
        requestCid : ContractId VoteRequest
        vote       : Vote
      controller vote.sv
      do
        requireWellformedVote config vote
        voterName <- case Map.lookup vote.sv svs of
          None      -> fail "Voter is not an SV"
          Some info -> pure info.name
        request <- fetchAndArchive (ForDso with dso) requestCid
        -- rate-limit recasting by the same SV (skipped on first vote for the request)
        enforceCooldown ("voteCooldownTime for " <> partyToText vote.sv) (getVoteCooldownTime config) $ do
          pastVote <- Map.lookup voterName request.votes
          pastVote.optCastAt
        now <- getTime
        create request with
          votes = Map.insert voterName (vote with optCastAt = Some now) request.votes
          trackingCid = Some (fromOptional requestCid request.trackingCid)

    -- Close: tally, threshold, decision table (DsoRules.daml:813), self-amend on accept.
    nonconsuming choice DsoRules_CloseVoteRequest : CloseResult
      with
        requestCid : ContractId VoteRequest
        sv         : Optional Party
      controller sv
      do
        _ <- getAndValidateSvParty this sv
        now <- getTime
        request <- fetchAndArchive (ForDso with dso) requestCid

        let activeNames   = map (.name) (Map.values svs)
        let activeNameSet = Set.fromList activeNames
        let voteList      = Map.toList request.votes
        let validVotes        = [ vote | (name, vote) <- voteList, name `Set.member` activeNameSet ]
        let offboardedVoters  = [ name | (name, _)    <- voteList, not (name `Set.member` activeNameSet) ]
        let abstainingSvs = [ name | name <- activeNames, not (name `Map.member` request.votes) ]
        let numYays  = length (filter (.accept) validVotes)
        let numNays  = length (filter (not . (.accept)) validVotes)
        let numVotes = numYays + numNays
        let r = requiredNumVotes (Map.size svs)

        -- Mirrors Splice: the accepted action runs inside the close transaction
        -- with no try/catch, so a stale action (its precondition no longer holds)
        -- aborts the whole close — no false acceptance record commits.
        let exec effAt = do
              executeAction self request.action
              pure (VRO_Accepted with effectiveAt = effAt)

        outcome <- case request.targetEffectiveAt of
          Some _        | numNays >= r                              -> pure VRO_Rejected
          Some _        | now >= request.voteBefore && numVotes < r -> pure VRO_Expired
          Some effTime  | now >= effTime && numYays >= r            -> exec effTime
          Some effTime  | now >= effTime                            -> pure VRO_Rejected
          Some _                                                    -> fail "no definitive outcome for voting request with effectivity"
          None          | numNays >= r                              -> pure VRO_Rejected
          None          | numYays >= r                              -> exec now
          None          | now >= request.voteBefore                 -> pure VRO_Expired
          None                                                      -> fail "no definite outcome for voting request without effectivity"

        pure CloseResult with outcome; offboardedVoters; abstainingSvs; completedAt = now

    -- Voting on the amulet price: an SV re-prices its OWN standing vote, under
    -- the same recast cooldown as DsoRules_CastVote (mirrors
    -- DsoRules_UpdateAmuletPriceVote — Splice's rationale: an SV must not be
    -- able to block round advancement by re-pricing too often).
    nonconsuming choice DsoRules_UpdateAmuletPriceVote : ContractId AmuletPriceVote
      with
        sv          : Party
        voteCid     : ContractId AmuletPriceVote
        amuletPrice : Decimal
      controller sv
      do
        pastVote <- fetchAndArchive (ForOwner with dso; owner = sv) voteCid
        enforceCooldown ("voteCooldownTime for " <> partyToText sv)
          (getVoteCooldownTime config) (Some pastVote.lastUpdatedAt)
        now <- getTime
        create AmuletPriceVote with
          dso; sv
          amuletPrice = Some amuletPrice
          lastUpdatedAt = now

    -- The median's consumer (mirrors DsoRules_AdvanceOpenMiningRounds): any
    -- current SV advances the round, presenting every SV's standing vote; the
    -- median of the priced ones becomes the round's amulet price.
    nonconsuming choice DsoRules_AdvanceOpenMiningRounds : ContractId AmuletRules
      with
        amuletRulesCid      : ContractId AmuletRules
        amuletPriceVoteCids : [ContractId AmuletPriceVote]
        sv                  : Optional Party
      controller sv
      do
        _ <- getAndValidateSvParty this sv
        amuletPrice <- fetchMedianAmuletPrice dso (Map.keys svs) amuletPriceVoteCids
        exercise amuletRulesCid ASetAmuletPrice with newAmuletPrice = amuletPrice

    -- Whole-config self-amendment (mirrors DsoRules_SetConfig), run by close when
    -- a SetConfig action is accepted. With a baseConfig the accepted change is
    -- PATCHED onto the live config (concurrent config votes on other fields
    -- survive); without one it replaces wholesale.
    choice DsoRules_SetConfig : ContractId DsoRules
      with
        newConfig  : DsoRulesConfig
        baseConfig : Optional DsoRulesConfig
      controller dso
      do case baseConfig of
           None      -> create this with config = newConfig
           Some base -> create this with config = patch newConfig base config

-- --- helpers -----------------------------------------------------------------

-- | Mirrors DsoRules getAndValidateSvParty: the acting SV must be a current SV.
getAndValidateSvParty : DsoRules -> Optional Party -> Update Party
getAndValidateSvParty _ None = fail "no SV party provided"
getAndValidateSvParty rules (Some sv) = do
  require "SV party is an actual SV" (sv `Map.member` rules.svs)
  pure sv

-- | Mirrors DsoRules ensureNeverOperatedNode: the new party must never have been
-- an SV (neither active nor offboarded).
ensureNeverOperatedNode : Party -> DsoRules -> Update ()
ensureNeverOperatedNode p this =
  require "SV party has not yet operated a node"
    (not (p `Map.member` this.svs || p `Map.member` this.offboardedSvs))

executeAction : ContractId DsoRules -> GovAction -> Update ()
executeAction self action = case action of
  NoOp                  -> pure ()
  OffboardSv offboard   -> void (exercise self DsoRules_OffboardSv with offboard)
  ConfirmSvOnboarding{..} ->
    void (exercise self DsoRules_ConfirmSvOnboarding with newSvParty; newSvName; newParticipantId; newSvRewardWeight; reason)
  SetConfig{..}         -> void (exercise self DsoRules_SetConfig with newConfig; baseConfig)
  -- Reads the pinned instance: executes only while that exact cid is live.
  TouchAmuletRules{..}  -> void (fetch amuletRulesCid)




  -- --- Splice-equivalent utility helpers (mirrors splice-util / DsoRules) -------

-- | Splice's Util.require: wraps the message identically.
require : Text -> Bool -> Update ()
require msg cond = assertMsg ("The requirement '" <> msg <> "' was not met.") cond

-- | Assert that a deadline has been reached (now >= deadline). Used by cooldown.
assertDeadlineExceeded : Text -> Time -> Update ()
assertDeadlineExceeded name deadline = do
  now <- getTime
  require (name <> " has been reached") (now >= deadline)

-- | Assert that a deadline has NOT yet passed (now < deadline). Used by TTLs.
assertWithinDeadline : Text -> Time -> Update ()
assertWithinDeadline name deadline = do
  now <- getTime
  require (name <> " has not passed") (now < deadline)


-- --- Patchable (mirrors Splice.Util `patch`) ---------------------------------
-- Three-way merge: `patch new base current` writes a field iff it changed
-- between `base` and `new`, otherwise keeps `current`. This is what lets two
-- config votes prepared against the same base compose (the SetConfig patch branch).

class Patchable a where
  patch : a -> a -> a -> a

patchScalar : Eq a => a -> a -> a -> a
patchScalar new base current
  | new == base = current
  | otherwise   = new

instance Patchable Int where patch = patchScalar
instance Patchable RelTime where patch = patchScalar

instance Patchable a => Patchable (Optional a) where
  patch new base current = case (base, new) of
    (None,   None)   -> current      -- no change requested
    (Some _, None)   -> None         -- remove the value
    (None,   Some n) -> Some n        -- write the complete new value
    (Some b, Some n) -> case current of
      None   -> None                  -- removed by a concurrent change
      Some c -> Some (patch n b c)

instance Patchable DsoRulesConfig where
  patch new base current = DsoRulesConfig with
    voteRequestTimeout           = patch new.voteRequestTimeout base.voteRequestTimeout current.voteRequestTimeout
    voteCooldownTime             = patch new.voteCooldownTime base.voteCooldownTime current.voteCooldownTime
    maxTextLength                = patch new.maxTextLength base.maxTextLength current.maxTextLength
    actionConfirmationTimeout    = patch new.actionConfirmationTimeout base.actionConfirmationTimeout current.actionConfirmationTimeout
    svOnboardingRequestTimeout   = patch new.svOnboardingRequestTimeout base.svOnboardingRequestTimeout current.svOnboardingRequestTimeout
    svOnboardingConfirmedTimeout = patch new.svOnboardingConfirmedTimeout base.svOnboardingConfirmedTimeout current.svOnboardingConfirmedTimeout

requireWellformedReason : DsoRulesConfig -> Reason -> Update ()
requireWellformedReason config reason = do
  require "Reason URL is not too long" (T.length reason.url <= config.maxTextLength)
  require "Reason body is not too long" (T.length reason.body <= config.maxTextLength)

requireWellformedVote : DsoRulesConfig -> Vote -> Update ()
requireWellformedVote config vote = requireWellformedReason config vote.reason

-- | Splice's enforceCooldown: if there was a previous action time, the next
-- action is only allowed once `cooldown` has elapsed.
enforceCooldown : Text -> RelTime -> Optional Time -> Update ()
enforceCooldown name cooldown lastActionTime = case lastActionTime of
  Some lastTime -> assertDeadlineExceeded name (lastTime `addRelTime` cooldown)
  None          -> pure ()

-- --- Threshold ---------------------------------------------------

requiredNumVotes : Int -> Int
requiredNumVotes numSvs = ceiling (intToDecimal (numSvs + f + 1) / 2.0)
  where f = floor (intToDecimal (numSvs - 1) / 3.0)

-- --- Checked fetch (ported from Splice.Util) ----------------------------------

-- A contract's group id names the group it belongs to (its DSO, or an owner
-- within a DSO). A checked fetch fails unless the fetched contract's group id
-- equals the expected one, so a choice cannot be handed a contract from another
-- DSO or SV. The mismatch message is Splice's verbatim.

class (Show t, Eq cgid, Show cgid) => HasCheckedFetch t cgid where
  contractGroupId : t -> cgid

checkContractGroupId : HasCheckedFetch t cgid => cgid -> ContractId t -> t -> Update t
checkContractGroupId expectedcgid cid co = do
  let cgid = contractGroupId co
  unless (expectedcgid == cgid) $ fail $
    "Contract group identifier mismatch: expected " <> show expectedcgid <>
    ", got " <> show cgid <> " for " <> show (cid, co)
  pure co

fetchChecked : (HasFetch t, HasCheckedFetch t cgid) => cgid -> ContractId t -> Update t
fetchChecked expectedcgid cid = do
  co <- fetch cid
  checkContractGroupId expectedcgid cid co

-- | Fetch, verify the group, and archive in one step (mutating fetch).
fetchAndArchive : (HasFetch t, HasArchive t, HasCheckedFetch t cgid) => cgid -> ContractId t -> Update t
fetchAndArchive cgid cid = do
  co <- fetchChecked cgid cid
  archive cid
  pure co

-- | Fetch reference data: verify the group, never archive.
fetchReferenceData : (HasFetch t, HasCheckedFetch t cgid) => cgid -> ContractId t -> Update t
fetchReferenceData = fetchChecked

-- Group ids used by this package (mirror Splice's).
data ForDso = ForDso with dso : Party
  deriving (Eq, Show)

data ForOwner = ForOwner with
    dso   : Party
    owner : Party
  deriving (Eq, Show)

instance HasCheckedFetch VoteRequest ForDso where
  contractGroupId vr = ForDso with dso = vr.dso

instance HasCheckedFetch Confirmation ForDso where
  contractGroupId c = ForDso with dso = c.dso

instance HasCheckedFetch SvOnboardingRequest ForDso where
  contractGroupId r = ForDso with dso = r.dso

instance HasCheckedFetch SvOnboardingConfirmed ForOwner where
  contractGroupId soc = ForOwner with dso = soc.dso; owner = soc.svParty

instance HasCheckedFetch AmuletPriceVote ForDso where
  contractGroupId v = ForDso with dso = v.dso

instance HasCheckedFetch AmuletPriceVote ForOwner where
  contractGroupId v = ForOwner with dso = v.dso; owner = v.sv

