-- =============================================================================
-- AmuletPriceVote — Splice's STANDING per-SV price vote (template of the same
-- name), implemented as a cap-governance `Ballot`: one vote per SV, living
-- across every mining round, re-read at each round advance — cross-decision
-- replay is the intended semantics, so it binds the anchor by plain
-- `ForMechanism` with no decision discriminator. S_Empty is Splice's `None`
-- price (new SV: registered, not yet priced); S_Full carries the price.
-- Re-pricing is `Ballot_Cast` (rate-limited, Splice's `lastUpdatedAt`
-- cooldown); abstaining again is `Ballot_Withdraw`.
-- =============================================================================
module Cap.Final.AmuletPriceVote where

import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time (addRelTime, time)
import DA.Date (Month (..), date)

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), require)
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1 (Mechanism, ForMechanism (..))
import Cap.Governance.BallotV1
import Cap.Governance.TargetUtil (fetchTargetFromContext)

import Cap.Final.Common (svListKey)
import Cap.Final.DsoRules (DsoRules, dsoRulesKey)

-- | The standing machine never closes: its window ceiling is this sentinel.
foreverTime : Time
foreverTime = time (date 9999 Dec 31) 0 0 0

-- | Decode the opaque `Ballot_Cast.vote`: a price is a positive `AV_Decimal`
-- (Splice's `ensure` on the vote, enforced here at cast).
decodePrice : AnyValue -> Update Decimal
decodePrice (AV_Decimal p) = do
  assertMsg "amulet price must be positive" (p > 0.0)
  pure p
decodePrice _ = fail "vote is not a decimal"

template AmuletPriceVote
  with
    dso           : Party
    org           : Text                   -- the organization whose live SV list gates a cast
    anchor        : ContractId Mechanism   -- the standing DsoAnchor, never churns
    voter         : Party
    state         : SubmittableState
    price         : Optional Decimal   -- Some iff the vote is priced (S_Full)
    lastUpdatedAt : Time
  where
    -- The voter co-signs only once a price is on: an unpriced slot is the
    -- authority's to mint, a priced vote needs both.
    signatory (dso :: (if state == S_Full then [voter] else []))
    observer voter

    interface instance Submittable for AmuletPriceVote where
      view = SubmittableView with
        mechanism = anchor
        authorities = Set.singleton dso
        slot = None      -- cover is proven per-advance against the LIVE SV list
        state
        meta = emptyMetadata

    interface instance Ballot for AmuletPriceVote where
      view = BallotView with
        governor = anchor
        voters = Set.singleton voter    -- closed: the fixed doors admit only this SV
        expiresAt = foreverTime  -- standing: never anyone-archivable; GC is the anchor's door
        meta = emptyMetadata

      -- Re-price at will, rate-limited (Splice: "an SV cannot block round
      -- advancement by changing their price vote too often"). Cooldown and
      -- SV list come fresh off the live `DsoRules` in the context.
      ballot_castImpl arg = do
        newPrice <- decodePrice arg.vote
        rules <- fetchTargetFromContext @DsoRules (dsoRulesKey dso org) svListKey arg.extraArgs.context
        require "Caster is a sv" (voter `Map.member` rules.svs)
        now <- getTime
        require "Price vote is rate-limited"
          (state /= S_Full || now >= addRelTime lastUpdatedAt rules.config.voteCooldownTime)
        cid <- create this with state = S_Full; price = Some newPrice; lastUpdatedAt = now
        pure (toInterfaceContractId @Ballot cid)

      -- Back to abstaining: still covers the SV list at advance, contributes no
      -- price — Splice's `None`.
      ballot_withdrawImpl _ = do
        cid <- create this with state = S_Withdrawn; price = None
        pure (toInterfaceContractId @Ballot cid)

      ballot_consumeImpl _ = pure (Ballot_ConsumeResult with meta = emptyMetadata)

-- | Standing binding: the anchor alone, no decision discriminator — every
-- round's advance admits the same votes by design.
instance HasCheckedFetch AmuletPriceVote ForMechanism where
  contractGroupId v = ForMechanism with mechanism = v.anchor
