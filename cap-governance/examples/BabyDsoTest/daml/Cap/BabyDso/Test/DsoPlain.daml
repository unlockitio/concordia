-- =============================================================================
-- Baby-DSO golden-vector tests. Each Script encodes golden vectors inline
-- (labelled VR-*, BS-*, OB-*, ON-*) and asserts the Splice-asserted outcome.
-- Passing here establishes that the plain (oracle) reproduction matches
-- Splice's decisions.
--
-- Test timing (passTime) mirrors Splice's own scripts so the reproduced
-- per-SV recast cooldown (default 1 min) is satisfied exactly as in Splice.
-- =============================================================================
module Cap.BabyDso.Test.DsoPlain where

import DA.Assert ((===))
import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time (RelTime, days, hours, minutes, seconds, addRelTime)
import Daml.Script

import Cap.BabyDso.Impl.DsoPlain

-- --- helpers -----------------------------------------------------------------

mkReason : Reason
mkReason = Reason with url = ""; body = ""

testConfig : DsoRulesConfig
testConfig = DsoRulesConfig with
  voteRequestTimeout = days 7
  voteCooldownTime = None       -- default 1 minute
  maxTextLength = 1024
  actionConfirmationTimeout = minutes 5
  svOnboardingRequestTimeout = hours 1
  svOnboardingConfirmedTimeout = hours 1

-- An SvInfo fixture. weight/round are not read by any voting-path check.
svInfo : Text -> SvInfo
svInfo name = SvInfo with
  name
  joinedAsOfRound = Round 0
  svRewardWeight = 10
  participantId = name <> "-participant-id"

setup4 : Script (Party, Party, Party, Party, Party, ContractId DsoRules)
setup4 = do
  sv1 <- allocateParty "sv1"
  sv2 <- allocateParty "sv2"
  sv3 <- allocateParty "sv3"
  sv4 <- allocateParty "sv4"
  dso <- allocateParty "dso"
  cid <- submit dso $ createCmd DsoRules with
    dso
    epoch = 0
    svs = Map.fromList [(sv1, svInfo "sv1"), (sv2, svInfo "sv2"), (sv3, svInfo "sv3"), (sv4, svInfo "sv4")]
    offboardedSvs = Map.empty
    dsoDelegate = sv1
    config = testConfig
  pure (dso, sv1, sv2, sv3, sv4, cid)

getRules : Party -> Script (ContractId DsoRules)
getRules dso = do
  rs <- query @DsoRules dso
  case rs of
    [(cid, _)] -> pure cid
    _          -> fail "expected exactly one DsoRules"

request : Party -> Party -> ContractId DsoRules -> GovAction -> Optional Time -> Optional RelTime -> Script (ContractId VoteRequest)
request dso sv rules action tEff timeout =
  submit (actAs [sv] <> readAs [dso]) $ exerciseCmd rules DRequestVote with
    requester = sv; action; reason = mkReason
    voteRequestTimeout = timeout; targetEffectiveAt = tEff

requestFail : Party -> Party -> ContractId DsoRules -> GovAction -> Optional Time -> Optional RelTime -> Script ()
requestFail dso sv rules action tEff timeout =
  submitMustFail (actAs [sv] <> readAs [dso]) $ exerciseCmd rules DRequestVote with
    requester = sv; action; reason = mkReason
    voteRequestTimeout = timeout; targetEffectiveAt = tEff

cast : Party -> Party -> ContractId DsoRules -> ContractId VoteRequest -> Bool -> Script (ContractId VoteRequest)
cast dso sv rules req acc =
  submit (actAs [sv] <> readAs [dso]) $ exerciseCmd rules DCastVote with
    requestCid = req
    vote = Vote with sv; accept = acc; reason = mkReason; optCastAt = None

close : Party -> Party -> ContractId DsoRules -> ContractId VoteRequest -> Script CloseResult
close dso sv rules req =
  submit (actAs [sv] <> readAs [dso]) $ exerciseCmd rules DCloseVoteRequest with requestCid = req; sv = Some sv

closeFail : Party -> Party -> ContractId DsoRules -> ContractId VoteRequest -> Script ()
closeFail dso sv rules req =
  submitMustFail (actAs [sv] <> readAs [dso]) $ exerciseCmd rules DCloseVoteRequest with requestCid = req; sv = Some sv

-- =============================================================================
-- §1 Threshold function (pure vectors)
-- =============================================================================

-- Checks the supermajority threshold R(n) for the SV counts the scenarios use.
test_threshold : Script ()
test_threshold = do
  requiredNumVotes 1  === 1
  requiredNumVotes 2  === 2
  requiredNumVotes 3  === 2
  requiredNumVotes 4  === 3
  requiredNumVotes 7  === 5
  requiredNumVotes 10 === 7

-- =============================================================================
-- §2 Close-outcome vectors (n=4, R=3)
--
-- "Regime" = which branch of the close decision table applies, set by a request's
-- targetEffectiveAt:
--   * None  -> "immediate" regime: a yes-supermajority closes (and takes effect)
--     as soon as it's reached (early acceptance).
--   * Some t -> "effectivity" regime: acceptance is deferred until time t; before t
--     a yes-supermajority cannot close, though a no-supermajority can reject early.
-- =============================================================================

-- Immediate regime, acceptance: votes climb to a yes-supermajority -> Accepted;
-- closing earlier (too few votes) fails with "no definite outcome".
-- VR-01, VR-02, VR-03
test_acceptanceWithoutEffectivity : Script ()
test_acceptanceWithoutEffectivity = do
  (dso, sv1, sv2, sv3, _sv4, rules) <- setup4
  req <- request dso sv1 rules NoOp None (Some (days 7))   -- {sv1:yes}
  req <- cast dso sv2 rules req False                      -- VR-01: 1 yes / 1 no
  closeFail dso sv1 rules req
  passTime (days 1)                                        -- a day passes (Splice), sv2 recasts
  req <- cast dso sv2 rules req True                       -- VR-02: 2 yes
  closeFail dso sv1 rules req
  req <- cast dso sv3 rules req True                       -- VR-03: 3 yes >= R
  r <- close dso sv1 rules req
  r.outcome === VRO_Accepted with effectiveAt = r.completedAt
  r.offboardedVoters === []

-- Effectivity regime, acceptance: even a yes-supermajority can't close before the
-- effective time; only once it passes does the request close as Accepted at effTime.
-- VR-04, VR-05, VR-06
test_acceptanceWithEffectivity : Script ()
test_acceptanceWithEffectivity = do
  (dso, sv1, sv2, sv3, sv4, rules) <- setup4
  now <- getTime
  let effTime = addRelTime now (days 8)
  req <- request dso sv1 rules NoOp (Some effTime) (Some (days 7))  -- {sv1:yes}; voteBefore=now+7d
  req <- cast dso sv2 rules req True                          -- 2 yes
  req <- cast dso sv3 rules req True                          -- VR-04: 3 yes >= R but effectivity
  closeFail dso sv1 rules req
  req <- cast dso sv4 rules req False                         -- 3 yes / 1 no
  passTime (days 7)                                          -- now >= voteBefore, < effTime, quorum met
  closeFail dso sv1 rules req                                 -- VR-05
  req <- cast dso sv4 rules req True                          -- 4 yes (recast after 7d)
  passTime (days 1 + seconds 1)                              -- now >= effTime
  r <- close dso sv1 rules req                                -- VR-06
  r.outcome === VRO_Accepted with effectiveAt = effTime
  r.abstainingSvs === []

-- Immediate regime, rejection: a no-supermajority closes early as Rejected; the
-- non-voter (sv3) shows up in abstainingSvs.
-- VR-07
test_rejectionWithoutEffectivity : Script ()
test_rejectionWithoutEffectivity = do
  (dso, sv1, sv2, _sv3, sv4, rules) <- setup4
  req <- request dso sv1 rules NoOp None (Some (days 7))   -- {sv1:yes}
  req <- cast dso sv2 rules req False
  req <- cast dso sv4 rules req False
  passTime (minutes 1)                                     -- cooldown before sv1 recasts (Splice)
  req <- cast dso sv1 rules req False                      -- 0 yes / 3 no
  r <- close dso sv1 rules req
  r.outcome === VRO_Rejected
  r.offboardedVoters === []
  r.abstainingSvs === ["sv3"]

-- Effectivity regime, early rejection: a no-supermajority rejects even before the
-- vote window ends (rejection isn't deferred the way acceptance is).
-- VR-08
test_rejectionWithEffectivityBeforeExpiration : Script ()
test_rejectionWithEffectivityBeforeExpiration = do
  (dso, sv1, sv2, _sv3, sv4, rules) <- setup4
  now <- getTime
  let effTime = addRelTime now (days 8)
  req <- request dso sv1 rules NoOp (Some effTime) (Some (days 3))
  req <- cast dso sv2 rules req False
  req <- cast dso sv4 rules req False
  passTime (minutes 1)                                     -- cooldown before sv1 recasts (Splice)
  req <- cast dso sv1 rules req False                      -- 3 no, before voteBefore
  r <- close dso sv1 rules req
  r.outcome === VRO_Rejected
  r.abstainingSvs === ["sv3"]

-- Effectivity regime: rejecting bad input (voteBefore > targetEffectiveAt fails the
-- ensure), no early acceptance, but SVs can flip to a no-supermajority after the
-- window and reject.
-- VR-G1, VR-09, VR-10
test_rejectionWithEffectivityAfterExpiration : Script ()
test_rejectionWithEffectivityAfterExpiration = do
  (dso, sv1, sv2, _sv3, sv4, rules) <- setup4
  now <- getTime
  let effTime = addRelTime now (days 8)
  -- VR-G1: voteBefore (now+2d) > targetEffectiveAt (now+1d) violates the ensure
  requestFail dso sv1 rules NoOp (Some (addRelTime now (days 1))) (Some (days 2))
  req <- request dso sv1 rules NoOp (Some effTime) (Some (days 3))
  req <- cast dso sv2 rules req True
  req <- cast dso sv4 rules req True               -- VR-09: 3 yes >= R but effectivity
  closeFail dso sv1 rules req
  passTime (days 3)                                -- now >= voteBefore, < effTime
  req <- cast dso sv2 rules req False
  req <- cast dso sv4 rules req False
  req <- cast dso sv1 rules req False              -- VR-10: 3 no
  r <- close dso sv1 rules req
  r.outcome === VRO_Rejected
  r.abstainingSvs === ["sv3"]

-- =============================================================================
-- §3 SV-set dynamics — testRacingSvRemoval (VR-11..VR-14)
-- =============================================================================

-- SVs race to offboard each other: drives the set 4->2->1, exercising the threshold
-- recompute, AcceptedButActionFailed (offboarding an already-gone SV), and Expired.
test_racingSvRemoval : Script ()
test_racingSvRemoval = do
  (dso, sv1, sv2, sv3, sv4, rules) <- setup4
  now <- getTime
  let effTime = addRelTime now (days 8)
  req1 <- request dso sv1 rules (OffboardSv sv2) None (Some (days 7))
  req2 <- request dso sv1 rules (OffboardSv sv2) None (Some (days 7))
  req3 <- request dso sv2 rules (OffboardSv sv1) None (Some (days 7))
  req4 <- request dso sv1 rules (OffboardSv sv2) (Some effTime) (Some (days 2))

  passTime (minutes 1)   -- cooldown for the requesters before they recast (Splice line 407)

  let castAll r0 = do
        r <- cast dso sv1 rules r0 True
        r <- cast dso sv2 rules r  True
        r <- cast dso sv3 rules r  True
        r <- cast dso sv4 rules r  True
        pure r
  req1 <- castAll req1
  req2 <- castAll req2
  req3 <- castAll req3

  -- VR-11: req1 closes, sv2 removed
  r <- close dso sv1 rules req1
  r.outcome === VRO_Accepted with effectiveAt = r.completedAt
  r.offboardedVoters === []
  r.abstainingSvs === []

  -- VR-12: req2 re-offboards the now-absent sv2 -> action fails
  rules <- getRules dso
  r <- close dso sv1 rules req2
  r.outcome === VRO_AcceptedButActionFailed with description = "Not a sv"
  r.offboardedVoters === ["sv2"]

  -- req4 (effectivity): majority rejects after expiration -> Rejected
  req4 <- cast dso sv3 rules req4 False
  req4 <- cast dso sv4 rules req4 True
  passTime (days 3)
  req4 <- cast dso sv1 rules req4 False
  r <- close dso sv1 rules req4
  r.outcome === VRO_Rejected
  r.offboardedVoters === []

  -- req3: offboard sv1 -> svs = {sv3, sv4}
  r <- close dso sv1 rules req3
  r.outcome === VRO_Accepted with effectiveAt = r.completedAt
  r.offboardedVoters === ["sv2"]
  rules <- getRules dso
  Some dsoRules <- queryContractId dso rules
  Set.fromList (Map.keys dsoRules.svs) === Set.fromList [sv3, sv4]

  -- VR-13: n=2 (R=2), only requester's auto-yes -> Expired at deadline
  reqA <- request dso sv3 rules (OffboardSv sv4) None (Some (seconds 1))
  closeFail dso sv3 rules reqA               -- pre-deadline: no definite outcome
  passTime (seconds 1)
  r <- close dso sv3 rules reqA
  r.outcome === VRO_Expired

  -- VR-14: both vote yes -> Accepted, svs = {sv3}
  reqB <- request dso sv3 rules (OffboardSv sv4) None (Some (days 1))
  reqB <- cast dso sv4 rules reqB True
  r <- close dso sv3 rules reqB
  r.outcome === VRO_Accepted with effectiveAt = r.completedAt
  rules <- getRules dso
  Some dsoRules <- queryContractId dso rules
  Map.keys dsoRules.svs === [sv3]

-- =============================================================================
-- §4 Bootstrap genesis (BS-01) + offboard-via-vote (OB-01)
-- =============================================================================

-- Bootstrap: the genesis DsoRules starts with sv1 as the sole SV.
-- BS-01
test_bootstrapGenesis : Script ()
test_bootstrapGenesis = do
  sv1 <- allocateParty "sv1"
  dso <- allocateParty "dso"
  cid <- submit dso $ createCmd DsoRules with
    dso; epoch = 0
    svs = Map.fromList [(sv1, svInfo "sv1")]
    offboardedSvs = Map.empty; dsoDelegate = sv1; config = testConfig
  Some r <- queryContractId dso cid
  Map.keys r.svs === [sv1]

-- Offboarding an SV through the voting path (3 yes incl. requester) shrinks the set.
-- OB-01
test_offboardViaVote : Script ()
test_offboardViaVote = do
  (dso, sv1, sv2, sv3, sv4, rules) <- setup4
  req <- request dso sv1 rules (OffboardSv sv4) None (Some (days 7))
  req <- cast dso sv2 rules req True
  req <- cast dso sv3 rules req True
  r <- close dso sv1 rules req
  r.outcome === VRO_Accepted with effectiveAt = r.completedAt
  rules <- getRules dso
  Some dsoRules <- queryContractId dso rules
  Set.fromList (Map.keys dsoRules.svs) === Set.fromList [sv1, sv2, sv3]

-- =============================================================================
-- §5 Onboarding via the CONFIRMATION path (set-grow)
-- =============================================================================

onboardAction : Party -> GovAction
onboardAction svX = ConfirmSvOnboarding with
  newSvParty = svX
  newSvName = "svX"
  newParticipantId = "svX-participant-id"
  newSvRewardWeight = 19
  reason = "because"

-- Full onboarding: sponsor starts it, 3 SVs confirm (n=4, R=3), an SV executes the
-- confirmed action -> SvOnboardingConfirmed, then the candidate self-adds -> in svs.
-- ON-01
test_svOnboarding : Script ()
test_svOnboarding = do
  (dso, sv1, sv2, sv3, sv4, rules) <- setup4
  svX <- allocateParty "svX"
  let action = onboardAction svX
  -- sv2 (not the delegate) sponsors the onboarding
  _ <- submit (actAs [sv2] <> readAs [dso]) $ exerciseCmd rules DStartSvOnboarding with
    candidateName = "svX"; candidateParty = svX
    candidateParticipantId = "svX-participant-id"; token = "mock-token"; sponsor = sv2
  -- three SVs confirm the onboarding action
  c2 <- submit (actAs [sv2] <> readAs [dso]) $ exerciseCmd rules DConfirmAction with confirmer = sv2; action
  c3 <- submit (actAs [sv3] <> readAs [dso]) $ exerciseCmd rules DConfirmAction with confirmer = sv3; action
  c4 <- submit (actAs [sv4] <> readAs [dso]) $ exerciseCmd rules DConfirmAction with confirmer = sv4; action
  -- enough confirmations -> execute -> SvOnboardingConfirmed created
  submit (actAs [sv1] <> readAs [dso]) $ exerciseCmd rules DExecuteConfirmedAction with
    action; confirmationCids = [c2, c3, c4]; sv = Some sv1
  [(socCid, _)] <- query @SvOnboardingConfirmed dso
  -- candidate self-adds
  _ <- submit (actAs [svX] <> readAs [dso]) $ exerciseCmd rules DAddConfirmedSv with sv = svX; svOnboardingConfirmedCid = socCid
  rules <- getRules dso
  Some dsoRules <- queryContractId dso rules
  Set.fromList (Map.keys dsoRules.svs) === Set.fromList [sv1, sv2, sv3, svX, sv4]

-- Confirmation path enforces the same threshold: 2 confirmations (< R=3) can't execute.
-- ON-02
test_confirmationThreshold : Script ()
test_confirmationThreshold = do
  (dso, sv1, sv2, sv3, _sv4, rules) <- setup4
  svX <- allocateParty "svX"
  let action = onboardAction svX
  c2 <- submit (actAs [sv2] <> readAs [dso]) $ exerciseCmd rules DConfirmAction with confirmer = sv2; action
  c3 <- submit (actAs [sv3] <> readAs [dso]) $ exerciseCmd rules DConfirmAction with confirmer = sv3; action
  submitMustFail (actAs [sv1] <> readAs [dso]) $ exerciseCmd rules DExecuteConfirmedAction with
    action; confirmationCids = [c2, c3]; sv = Some sv1   -- only 2 < R=3