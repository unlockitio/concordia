-- SPDX-License-Identifier: Apache-2.0

-- | One decision and the votes cast on it, readable without knowing the
-- template. A record holds the votes of every voter, or one record per voter
-- holds that voter's vote; the records of one decision share its
-- ResolutionInfo and its options. Votes are cast through the resolver
-- (Resolver_CastVote, or a choice of the app's own), not through the record.
-- Resolvers count records through the IsVoteRecord instance in
-- cap-governance-vote-utils.
module Cap.Governance.VoteRecordV1 where

import Prelude hiding (Action)

import DA.Foldable (Foldable (..))
import DA.Map (Map)
import DA.Traversable (Traversable (..))

import Splice.Api.Token.MetadataV1

import Cap.Core.AuthenticKeyV1 (AuthenticKey)
import Cap.Core.IdentityV1 (Identity)
import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Governance.KeyedTargetV1 (Snapshot)
import Cap.Governance.ActionV1 (ActionId)


------------------  VOTE  ------------------

-- | One identity's vote on a resolution.
data Vote a
  = Absent       -- eligible but no vote presented
  | Abstained    -- present but chose no option
  | Voted a
  deriving (Eq, Show)

-- | Maps the payload of a Voted vote, leaving Abstained and Absent as they
-- are: fmap toAnyValue turns a Vote Text into a Vote AnyValue.
instance Functor Vote where
  fmap f (Voted v) = Voted (f v)
  fmap _ Abstained = Abstained
  fmap _ Absent = Absent

instance Foldable Vote where
  foldr f z (Voted v) = f v z
  foldr _ z _ = z

-- | Decodes the payload of a Voted vote, leaving Abstained and Absent as they
-- are: Traversable.mapA fromAnyValue turns a Vote AnyValue into an
-- Optional (Vote Text), None when the payload does not decode.
instance Traversable Vote where
  mapA f (Voted v) = Voted <$> f v
  mapA _ Abstained = pure Abstained
  mapA _ Absent = pure Absent


-- | A link to the full text, and a short body.
data Reason = Reason
  with
    url : Text
    body : Text
  deriving (Eq, Show)

-- | One voter's vote as a vote record stores it.
data CastVote = CastVote
  with
    voter : Party
    -- ^ The acting party that cast the vote.
    vote : Vote AnyValue
    -- ^ Abstained or Voted. A record MUST NOT store Absent: a voter without
    -- an entry has not voted.
    reason : Optional Reason
    castAt : Time
  deriving (Eq, Show)


------------------  VOTE RECORD  ------------------

data VoteRecordView = VoteRecordView
  with
    resolution : ResolutionInfo
    -- ^ The resolver, the mechanism and the id of the decision. Its id MUST
    -- survive re-creating the record.
    requester : Identity
    reason : Reason
    options : [ActionId]
    -- ^ The actions the voters choose among, in the order a client shows
    -- them, without duplicates. The view MUST compute each id from the typed
    -- action the record stores, or from the Action contract it names, never
    -- from text the requester supplied.
    voteBefore : Optional Time
    -- ^ Casts MUST be rejected from this time. None for a standing record.
    effectiveAt : Optional Time
    -- ^ None: an accepted action executes when the decision closes.
    votes : Map Identity CastVote
    targets : Map AuthenticKey Snapshot
    -- ^ The contracts the options change, with their state or contract id
    -- when the record was created.
    consumers : [Party]
    -- ^ The parties that archive the record through VoteRecord_Consume once it
    -- is counted. Empty for a standing record, which MAY be counted many times.
    meta : Metadata
  deriving (Eq, Show)


interface VoteRecord where
  viewtype VoteRecordView

  choice VoteRecord_Consume : ()
    controller (view this).consumers
    do pure ()


-- | HasCheckedFetch requires Show, and an interface has no derived instance.
-- fetchVoteRecords and fetchGroup print the record when a check fails.
instance Show VoteRecord where
  show record = "VoteRecord " <> show (view record)
