-- SPDX-License-Identifier: Apache-2.0

-- | Voting rights: a weight per owner, and the parties that may cast for each
-- owner, read from contracts a resolver trusts under keys it stores. They tell
-- the resolver who the voters are, how much each vote weighs, and who may cast
-- it.
module Cap.Governance.Utils.VotingRights
  ( HasVotingRights (..)

    -- * Checks
  , validVotingRightKeys
  , validWeights

    -- * Fetching
  , fetchVotingRights
  , fetchVotingRightsPerContract
  , fetchVotingRightsFromOneContract

    -- * Reading voting rights
  , weightsOf
  , castersOf
  , votersOf

    -- * Owners
  , partyAsOwnerId
  , equalWeights
  ) where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Util (HasCheckedFetch, fetchChecked)

import Cap.Governance.Types (OwnerId, VotingRight (..))
import Cap.Core.Utils.Checks (Unmet, requireMet)


------------------  VOTING RIGHTS  ------------------
-- Used by a resolver to read voting rights from contracts whose templates it
-- knows.

-- | The voting rights a contract grants: each owner's weight and the parties
-- that may cast for it.
class HasVotingRights t where
  rightsOf : t -> Map OwnerId VotingRight


------------------  CHECKS  ------------------
-- Each check returns its unmet conditions. Voting rights are never ignored: the
-- fetches below abort on any of them.

-- | Validates that the presented voting rights contracts are exactly the ones under
-- the right keys: every key presented, and nothing presented under another
-- key.
validVotingRightKeys : (Ord k, Show k) => Set k -> Map k c -> Unmet
validVotingRightKeys rightKeys rightCids =
  [ "the voting rights under " <> show key <> " were not presented"
  | key <- Set.toList rightKeys
  , not (Map.member key rightCids)
  ]
    <> [ "the presented voting rights under " <> show key <> " are not under a right key"
       | key <- Map.keys rightCids
       , not (Set.member key rightKeys)
       ]

-- | Validates that no weight is negative.
validWeights : Map OwnerId Decimal -> Unmet
validWeights weights =
  [ "the weight of " <> show owner <> " is negative"
  | (owner, weight) <- Map.toList weights
  , weight < 0.0
  ]


------------------  FETCHING  ------------------

-- | Fetches the contracts in rightCids and checks them against rightKeys,
-- which the resolver stores. Returns the voting rights under each key,
-- unmerged: an owner can have voting rights in several contracts.
fetchVotingRights
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map k (Map OwnerId VotingRight))
fetchVotingRights rightKeys rightCids = do
  requireMet (validVotingRightKeys rightKeys rightCids)
  Map.fromList <$> forA (Map.toList rightCids) (\(rkey, cid) -> do
    contract <- fetchChecked rkey cid
    let rights = rightsOf contract
    requireMet (validWeights (weightsOf rights))
    pure (rkey, rights))

-- | The voting rights spread over several contracts, merged: an owner named
-- by several contracts gets the sum of their weights and the union of their
-- casters.
fetchVotingRightsPerContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map OwnerId VotingRight)
fetchVotingRightsPerContract rightKeys rightCids = do
  rights <- fetchVotingRights rightKeys rightCids
  pure (Map.fromListWithR merge (concatMap Map.toList (Map.values rights)))
  where
    merge a b = VotingRight with
      weight = a.weight + b.weight
      casters = Set.union a.casters b.casters

-- | The voting rights of a single contract.
fetchVotingRightsFromOneContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => k -> ContractId t -> Update (Map OwnerId VotingRight)
fetchVotingRightsFromOneContract rightsKey rightsCid =
  fetchVotingRightsPerContract (Set.singleton rightsKey) (Map.singleton rightsKey rightsCid)


------------------  READING VOTING RIGHTS  ------------------

-- | The weight of each owner.
weightsOf : Map OwnerId VotingRight -> Map OwnerId Decimal
weightsOf = fmap (.weight)

-- | The parties that may cast for each owner.
castersOf : Map OwnerId VotingRight -> Map OwnerId (Set Party)
castersOf = fmap (.casters)

-- | The voters: the owners whose weight is above zero.
votersOf : Map OwnerId VotingRight -> Set OwnerId
votersOf rights = Set.fromList [owner | (owner, r) <- Map.toList rights, r.weight > 0.0]


------------------  OWNERS  ------------------

-- | The OwnerId of a party that holds a voting right itself.
partyAsOwnerId : Party -> OwnerId
partyAsOwnerId = partyToText

-- | Weight 1 for every owner in the set.
equalWeights : Set OwnerId -> Map OwnerId Decimal
equalWeights owners = Map.fromList [(owner, 1.0) | owner <- Set.toList owners]
