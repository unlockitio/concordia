-- | Reading voting rights from contracts a resolver trusts.
module Cap.Governance.Utils.VotingRights
  ( HasVotingRights (..)

    -- * Checks
  , validVotingRights

    -- * Fetching
  , fetchVotingRights
  , fetchVotingRightsPerContract
  , fetchVotingRightsFromOneContract

    -- * Owners
  , partyAsOwnerId
  , equalWeights
  ) where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Util (HasCheckedFetch, fetchChecked)

import Cap.Governance.Types (OwnerId, VotingRight (..))
import Cap.Core.Utils.Checks (Unmet, requireMet)


------------------  VOTING RIGHTS  ------------------

class HasVotingRights t where
  rightsOf : t -> Map OwnerId VotingRight


------------------  CHECKS  ------------------
-- A resolver MUST NOT ignore failing voting rights; the fetches abort on any
-- unmet check.

-- | Validates that the voting rights are exactly the ones under rightKeys, every
-- key presented and nothing under another key, and that no weight is negative.
validVotingRights : (Ord k, Show k) => Set k -> Map k (Map OwnerId VotingRight) -> Unmet
validVotingRights rightKeys rights =
  [ "the voting rights under " <> show key <> " were not presented"
  | key <- Set.toList rightKeys
  , not (Map.member key rights)
  ]
    <> [ "the presented voting rights under " <> show key <> " are not under a right key"
       | key <- Map.keys rights
       , not (Set.member key rightKeys)
       ]
    <> [ "the weight of " <> show owner <> " under " <> show key <> " is negative"
       | (key, owners) <- Map.toList rights
       , (owner, right) <- Map.toList owners
       , right.weight < 0.0
       ]


------------------  FETCHING  ------------------

-- | Fetches and checks the contracts against rightKeys. Returns the rights
-- per key, unmerged.
fetchVotingRights
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map k (Map OwnerId VotingRight))
fetchVotingRights rightKeys rightCids = do
  rights <- Map.fromList <$> forA (Map.toList rightCids) (\(rkey, cid) -> do
    contract <- fetchChecked rkey cid
    pure (rkey, rightsOf contract))
  requireMet (validVotingRights rightKeys rights)
  pure rights

-- | Merged: an owner named by several contracts gets the sum of their
-- weights and the union of their casters.
fetchVotingRightsPerContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map OwnerId VotingRight)
fetchVotingRightsPerContract rightKeys rightCids = do
  rights <- fetchVotingRights rightKeys rightCids
  pure (Map.fromListWithR merge (concatMap Map.toList (Map.values rights)))
  where
    merge a b = VotingRight with
      weight = a.weight + b.weight
      casters = Set.union a.casters b.casters

-- | The voting rights of a single contract.
fetchVotingRightsFromOneContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => k -> ContractId t -> Update (Map OwnerId VotingRight)
fetchVotingRightsFromOneContract rightsKey rightsCid =
  fetchVotingRightsPerContract (Set.singleton rightsKey) (Map.singleton rightsKey rightsCid)


------------------  OWNERS  ------------------

-- | The OwnerId of a party that holds a voting right itself.
partyAsOwnerId : Party -> OwnerId
partyAsOwnerId = partyToText

-- | Weight 1 for every owner in the set.
equalWeights : Set OwnerId -> Map OwnerId Decimal
equalWeights owners = Map.fromList [(owner, 1.0) | owner <- Set.toList owners]
