module Cap.Governance.Utils.VotingRights
  ( HasVotingRights (..)

    -- * Checks
  , rightsUnderKeys
  , nonNegativeWeights

    -- * Fetching
  , fetchVotingRights
  , fetchWeightsPerContract
  , fetchVotersPerContract
  , fetchWeightsFromOneContract
  , fetchVotersFromOneContract

    -- * Weights
  , equalWeights
  ) where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Util (HasCheckedFetch, fetchChecked)

import Cap.Core.Utils (Unmet, requireMet)


------------------  VOTING RIGHTS  ------------------
-- Used by a resolver to read voting rights/weight from contracts whose templates it knows.

-- | The voting rights a contract carries: each holder and its weight.
class HasVotingRights t where
  rightsOf : t -> Map Party Decimal


------------------  CHECKS  ------------------
-- Each check returns its unmet conditions. Voting rights are never ignored:
-- the fetches below abort on any of them.

-- | Validates that the presented voting rights are exactly the ones under the
-- right keys: every key presented, and nothing presented under another key.
rightsUnderKeys : (Ord k, Show k) => Set k -> Map k c -> Unmet
rightsUnderKeys rightKeys rightCids =
  [ "the voting rights under " <> show key <> " were not presented"
  | key <- Set.toList rightKeys
  , not (Map.member key rightCids)
  ]
    <> [ "the presented voting rights under " <> show key <> " are not under a right key"
       | key <- Map.keys rightCids
       , not (Set.member key rightKeys)
       ]

-- | Validates that no weight is negative.
nonNegativeWeights : Map Party Decimal -> Unmet
nonNegativeWeights weights =
  [ "the weight of " <> show holder <> " is negative"
  | (holder, weight) <- Map.toList weights
  , weight < 0.0
  ]


------------------  FETCHING  ------------------

-- | Fetches the contracts in rightCids and checks them against rightKeys,
-- which the resolver stores. Returns the voting rights under each key: each
-- holder and its weight. It does not add up the weight of each holder! Because
-- a holder can have rights in several contracts.
fetchVotingRights
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map k (Map Party Decimal))
fetchVotingRights rightKeys rightCids = do
  requireMet (rightsUnderKeys rightKeys rightCids)
  Map.fromList <$> forA (Map.toList rightCids) (\(rkey, cid) -> do
    contract <- fetchChecked rkey cid
    let rights = rightsOf contract
    requireMet (nonNegativeWeights rights)
    pure (rkey, rights))


-- Rights spread over several contracts, one contract per key.
fetchWeightsPerContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Map Party Decimal)
fetchWeightsPerContract rightKeys rightCids = do
  rights <- fetchVotingRights rightKeys rightCids
  pure (Map.fromListWithR (+) (concatMap Map.toList (Map.values rights)))

fetchVotersPerContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => Set k -> Map k (ContractId t) -> Update (Set Party)
fetchVotersPerContract rightKeys rightCids = do
  weights <- fetchWeightsPerContract rightKeys rightCids
  pure (Set.fromList [voter | (voter, weight) <- Map.toList weights, weight > 0.0])


-- All rights in the same contract
fetchWeightsFromOneContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => k -> ContractId t -> Update (Map Party Decimal)
fetchWeightsFromOneContract rightsKey rightsCid =
  fetchWeightsPerContract (Set.singleton rightsKey) (Map.singleton rightsKey rightsCid)

fetchVotersFromOneContract
  : (HasFetch t, HasCheckedFetch t k, HasVotingRights t, Ord k, Show k)
  => k -> ContractId t -> Update (Set Party)
fetchVotersFromOneContract rightsKey rightsCid =
  fetchVotersPerContract (Set.singleton rightsKey) (Map.singleton rightsKey rightsCid)


------------------  WEIGHTS  ------------------

-- | Weight 1 for every voter in the set.
equalWeights : Set Party -> Map Party Decimal
equalWeights voters = Map.fromList [(voter, 1.0) | voter <- Set.toList voters]
