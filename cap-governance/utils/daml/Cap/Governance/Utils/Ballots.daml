module Cap.Governance.Utils.Ballots
  ( IsBallot (..)
  , weighBallotsEqually
  , weighBallots
  , consumeBallots
  , commonAction
  , commonBinds
  ) where

import DA.Foldable (mapA_)
import DA.List (unique)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Util (require)

import Cap.Core.Types (AuthenticKey)
import Cap.Core.Utils (allEqual, orAbort)
import Cap.Governance.Types (Bind)
import Cap.Governance.Utils.Count (Cast (..), Casts)


------------------  BALLOTS  ------------------
-- Used by the choice that resolves a proposal, over the ballots presented to it.

-- | What a resolution reads from a ballot: the votes it carries, by voter
-- with 'None' for an abstention; the preconditions it pinned; the action it
-- asks to authorize; and how the resolution retires it once counted.
class IsBallot b v a | b -> v a where
  castsOf : b -> Map Party (Optional v)
  bindsOf : b -> Map AuthenticKey Bind
  actionOf : b -> a
  consume : ContractId b -> Update ()

-- | The casts of the presented ballots, each voter counting with weight 1.
-- Refuses a voter appearing on two ballots, a vote of another kind than the
-- procedure counts, and a voter outside the set.
weighBallotsEqually
  : IsBallot b v act
  => (v -> Optional a) -> Set Party -> [b] -> Update (Casts a)
weighBallotsEqually narrow voters =
  weighBallots narrow (Map.fromList [(voter, 1.0) | voter <- Set.toList voters])

-- | The casts of the presented ballots, each voter counting with its weight
-- in the map. Refuses a voter appearing on two ballots, a vote of another kind
-- than the procedure counts, a voter missing from the map, and a negative weight.
weighBallots
  : IsBallot b v act
  => (v -> Optional a) -> Map Party Decimal -> [b] -> Update (Casts a)
weighBallots narrow weights ballots = do
  let pairs = concatMap (Map.toList . castsOf) ballots
  require "the presented ballots come from distinct voters" (unique (map fst pairs))
  Map.fromList <$> forA pairs (\(voter, raw) -> do
    vote <- case raw of
      None -> pure None
      Some v -> Some <$> orAbort
        ("the vote of " <> show voter <> " is not of the kind this procedure counts")
        (narrow v)
    weight <- orAbort ("the voter " <> show voter <> " has no right to vote")
      (Map.lookup voter weights)
    require ("the weight of the voter " <> show voter <> " is not negative") (weight >= 0.0)
    pure (voter, Cast with weight; vote))

-- | Consumes every presented ballot, so it cannot be counted again.
consumeBallots : IsBallot b v act => [ContractId b] -> Update ()
consumeBallots = mapA_ consume

-- checks that all actions match and return the action 
commonAction : (IsBallot b v act, Eq act) => [b] -> Update act
commonAction ballots = do
  require "at least one ballot is presented" (not (null ballots))
  orAbort "the presented ballots ask for different actions"
    (allEqual (map actionOf ballots))

-- checks that all binds match and returns the binds. 
commonBinds : IsBallot b v act => [b] -> Update (Map AuthenticKey Bind)
commonBinds ballots = do
  require "at least one ballot is presented" (not (null ballots))
  orAbort "the presented ballots pin different binds"
    (allEqual (map bindsOf ballots))
