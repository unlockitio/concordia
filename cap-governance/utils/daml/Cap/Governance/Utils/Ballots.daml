module Cap.Governance.Utils.Ballots
  ( IsBallot (..)
  , castsOf
  , weightedCastsOf
  , consumeBallots
  , agreedAction
  , agreedSnapshots
  ) where

import Prelude hiding (Action)

import DA.Foldable (forA_, mapA_)
import DA.List (unique)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (fromOptional)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Util (require)

import Cap.Core.Types (AuthenticKey, Snapshot)
import Cap.Core.Utils (uniformValue, orAbort)
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.Utils.Count (Cast (..), Casts, Vote (..))


------------------  BALLOTS  ------------------
-- Used by the choice that resolves a proposal, over the ballots presented to it.

-- | What a resolution reads from a ballot: the votes it carries, by voter;
-- the snapshots it took; the action it asks to authorize; and how the
-- resolution retires it once counted.
class IsBallot b v | b -> v where
  votesOf : b -> Map Party (Vote v)
  snapshotsOf : b -> Map AuthenticKey Snapshot
  actionOf : b -> ContractId Action
  consume : ContractId b -> Update ()

-- | The casts of every eligible voter in the set, with equal weights: every
-- voter gets weight 1, and a voter with no presented vote is Absent.
-- voteOf returns the vote as the kind the mechanism counts, or None for
-- another kind. Refuses: a voter appearing on two ballots, a vote of another
-- kind than the mechanism counts, and a voter outside the set.
castsOf
  : IsBallot b v
  => (v -> Optional a) -> Set Party -> [b] -> Update (Casts a)
castsOf voteOf voters =
  weightedCastsOf voteOf (Map.fromList [(voter, 1.0) | voter <- Set.toList voters])

-- | The casts of every eligible voter in the map, each counting with its
-- weight; a voter with no presented vote is Absent. voteOf returns the
-- vote as the kind the mechanism counts, or None for another kind. Refuses:
-- a voter appearing on two ballots, a vote of another kind than the mechanism
-- counts, a voter missing from the map, and a negative weight.
weightedCastsOf
  : IsBallot b v
  => (v -> Optional a) -> Map Party Decimal -> [b] -> Update (Casts a)
weightedCastsOf voteOf weights ballots = do
  let pairs = concatMap (Map.toList . votesOf) ballots
  require "the presented ballots come from distinct voters" (unique (map fst pairs))
  forA_ (Map.toList weights) $ \(voter, weight) ->
    require ("the weight of the voter " <> show voter <> " is not negative") (weight >= 0.0)
  presented <- Map.fromList <$> forA pairs (\(voter, raw) -> do
    require ("the voter " <> show voter <> " has no right to vote") (Map.member voter weights)
    vote <- case raw of
      Voted v -> Voted <$> orAbort
        ("the vote of " <> show voter <> " is not of the kind this mechanism counts")
        (voteOf v)
      Abstained -> pure Abstained
      Absent -> pure Absent
    pure (voter, vote))
  pure (Map.fromList
    [ (voter, Cast with weight; vote = fromOptional Absent (Map.lookup voter presented))
    | (voter, weight) <- Map.toList weights ])

-- | Consumes every presented ballot, so it cannot be counted again.
consumeBallots : IsBallot b v => [ContractId b] -> Update ()
consumeBallots = mapA_ consume

-- checks that all actions match and return the action 
agreedAction : IsBallot b v => [b] -> Update (ContractId Action)
agreedAction ballots = do
  require "at least one ballot is presented" (not (null ballots))
  orAbort "the presented ballots ask for different actions"
    (uniformValue (map actionOf ballots))

-- checks that all snapshots match and returns the snapshots.
agreedSnapshots : IsBallot b v => [b] -> Update (Map AuthenticKey Snapshot)
agreedSnapshots ballots = do
  require "at least one ballot is presented" (not (null ballots))
  orAbort "the presented ballots carry different snapshots"
    (uniformValue (map snapshotsOf ballots))
