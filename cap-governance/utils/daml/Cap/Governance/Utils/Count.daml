-- SPDX-License-Identifier: Apache-2.0

module Cap.Governance.Utils.Count
  ( -- * Casts
    Cast (..)
  , Casts
  , voted
  , votedWeight

    -- * Verdicts
  , Quorum
  , Tally
  , Verdict (..)
  , rule

    -- * Quorums
  , anyTurnout
  , allOf
  , anyOf
  , atLeastBallots
  , atLeastVotes
  , atLeastWeight
  , shareOfTotal

    -- * Tallies
  , undecided
  , firstOf
  , unanimous
  , plurality
  , shareOfVotes
  , median
  , weightedMedian
  ) where

import DA.List (sort, sortOn)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (mapOptional)
import Cap.Core.Utils (allEqual)
import Cap.Governance.Types (Verdict (..))


data Cast a = Cast
  with
    weight : Decimal
    vote : Optional a
  deriving (Eq, Show)

type Casts a = Map Party (Cast a)

voted : Casts a -> [(Decimal, a)]
voted casts = [(c.weight, v) | c <- Map.values casts, Some v <- [c.vote]]

votedWeight : Casts a -> Decimal
votedWeight casts = sum (map fst (voted casts))


type Quorum a = Casts a -> Bool

type Tally a r = Casts a -> Optional r

rule : Quorum a -> Tally a r -> Casts a -> Verdict r
rule quorum tally casts
  | not (quorum casts) = Lapsed
  | otherwise = optional Undecided Decided (tally casts)


anyTurnout : Quorum a
anyTurnout _ = True

allOf : [Quorum a] -> Quorum a
allOf quorums casts = all (\quorum -> quorum casts) quorums

anyOf : [Quorum a] -> Quorum a
anyOf quorums casts = any (\quorum -> quorum casts) quorums

atLeastBallots : Int -> Quorum a
atLeastBallots n casts = Map.size casts >= n

atLeastVotes : Int -> Quorum a
atLeastVotes n casts = length (voted casts) >= n

atLeastWeight : Decimal -> Quorum a
atLeastWeight w casts = votedWeight casts >= w

shareOfTotal : Int -> Int -> Decimal -> Quorum a
shareOfTotal numerator denominator total casts =
  denominator > 0 && total > 0.0
    && votedWeight casts * intToDecimal denominator >= intToDecimal numerator * total


undecided : Tally a r
undecided _ = None

firstOf : [Tally a r] -> Tally a r
firstOf tallies casts = case mapOptional (\tally -> tally casts) tallies of
  result :: _ -> Some result
  [] -> None

unanimous : Eq a => Tally a a
unanimous casts = allEqual (map snd (voted casts))

plurality : Ord a => Tally a a
plurality casts =
  case sortOn (negate . snd) (Map.toList (weightPerOption casts)) of
    (option, best) :: rest | all (\(_, w) -> w < best) rest -> Some option
    _ -> None

shareOfVotes : Ord a => Int -> Int -> Tally a a
shareOfVotes numerator denominator casts
  | denominator <= 0 = None
  | otherwise =
      case [ option | (option, w) <- Map.toList (weightPerOption casts)
                    , w * intToDecimal denominator >= intToDecimal numerator * votedWeight casts ] of
        [option] -> Some option
        _ -> None

median : Tally Decimal Decimal
median casts = case sort (map snd (voted casts)) of
  [] -> None
  sorted ->
    let n = length sorted
    in case (drop ((n - 1) / 2) sorted, drop (n / 2) sorted) of
      (lo :: _, hi :: _) -> Some ((lo + hi) / 2.0)
      _ -> None

weightedMedian : Tally Decimal Decimal
weightedMedian casts =
  crossingHalf (votedWeight casts / 2.0) 0.0
    (sortOn snd (filter ((> 0.0) . fst) (voted casts)))


crossingHalf : Decimal -> Decimal -> [(Decimal, Decimal)] -> Optional Decimal
crossingHalf _ _ [] = None
crossingHalf half below ((w, value) :: rest)
  | below + w >= half = Some value
  | otherwise = crossingHalf half (below + w) rest

weightPerOption : Ord a => Casts a -> Map a Decimal
weightPerOption casts = Map.fromListWithR (+) [(option, w) | (w, option) <- voted casts]
