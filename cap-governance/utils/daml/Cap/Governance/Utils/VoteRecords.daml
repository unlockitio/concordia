-- SPDX-License-Identifier: Apache-2.0

-- | The vote record as a contract: what a resolution reads from it
module Cap.Governance.Utils.VoteRecords
  ( IsVoteRecord (..)

    -- * Checks
  , validVoteRecordAction
  , validVoteRecordSnapshots
  , validVoteRecordVoters
  , distinctVotersAmongVoteRecords
  , validVoteRecordCasters
  , validVoteRecordSignatories
  , validConsumers

    -- * Agreement
  , expectUniformAction
  , expectUniformSnapshots

    -- * Ledger
  , consumeVoteRecords
  ) where

import Prelude hiding (Action)

import DA.Action (unless)
import DA.Foldable (mapA_)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (fromOptional, fromSomeNote)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (AnyValue)

import Cap.Core.Types (AuthenticKey, Snapshot)
import Cap.Governance.Types (OwnerId, Vote (..))
import Cap.Core.Utils (AmongCheck, Check, uniformOptional)
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.VoteRecordV1 (VoteRecord, VoteRecordView (..), VoteRecord_Consume (..))


------------------  VOTE RECORDS  ------------------
-- A resolver MUST fetch presented records with fetchGroup keyed by its
-- resolution, so a duplicate or a record of another resolution aborts.

-- r is the record, v the type its votes carry and act the type of the action
-- it asks for, such as an app-specific enum or a ContractId Action.
class Eq act => IsVoteRecord r v act | r -> v, r -> act where
  votesOf : r -> Map OwnerId (Vote v)
  snapshotsOf : r -> Map AuthenticKey Snapshot
  actionOf : r -> act
  consume : ContractId r -> Update ()


------------------  INTERFACE  ------------------
-- Any package can implement VoteRecord, so a resolver counting through it
-- MUST check signs each record (validVoteRecordCasters or
-- validVoteRecordSignatories) and validConsumers. A record with no consumers
-- is standing and is not consumed. The action is None when the record asks
-- for an app-specific action, or none.

instance IsVoteRecord VoteRecord AnyValue (Optional (ContractId Action)) where
  votesOf record = (view record).votes
  snapshotsOf record = (view record).snapshots
  actionOf record = (view record).action
  consume cid = do
    record <- fetch cid
    unless (null (view record).consumers) $ exercise cid VoteRecord_Consume


------------------  CHECKS  ------------------
-- A resolver SHOULD pass its own errors to requireMetFrom (aborts) and a
-- voter's errors to ignoreFailing (skips the record), so one bad record
-- cannot block the resolution.

-- | Validates that the vote record asks for the given action. Through the
-- VoteRecord interface, pass Some of the action.
validVoteRecordAction : IsVoteRecord r v act => act -> Check r
validVoteRecordAction action record =
  ["the vote record asks for another action" | actionOf record /= action]

-- | Validates that the vote record carries exactly the given snapshots.
validVoteRecordSnapshots : IsVoteRecord r v act => Map AuthenticKey Snapshot -> Check r
validVoteRecordSnapshots snapshots record =
  ["the vote record carries other snapshots" | snapshotsOf record /= snapshots]

-- | Validates that every owner on the vote record is a voter.
validVoteRecordVoters : IsVoteRecord r v act => Set OwnerId -> Check r
validVoteRecordVoters voters record =
  [ "the voter " <> show voter <> " has no right to vote"
  | voter <- Map.keys (votesOf record)
  , not (Set.member voter voters)
  ]

-- | Validates that no other vote record carries a vote of one of its voters.
-- Every record of a voter on several records fails, so the result does not
-- depend on presentation order.
distinctVotersAmongVoteRecords : IsVoteRecord r v act => AmongCheck r
distinctVotersAmongVoteRecords records record =
  [ "the voter " <> show voter <> " is on another vote record"
  | voter <- Map.keys (votesOf record)
  , fromOptional 0 (Map.lookup voter uses) > 1
  ]
  where
    uses = Map.fromListWithR (+)
      [(voter, 1) | other <- records, voter <- Map.keys (votesOf other)]

-- | Validates that every vote on the vote record was signed by a caster of its
-- owner.
validVoteRecordCasters : (HasSignatory r, IsVoteRecord r v act) => Map OwnerId (Set Party) -> Check r
validVoteRecordCasters casters record =
  [ "no caster of the voter " <> show voter <> " signed the vote record"
  | voter <- Map.keys (votesOf record)
  , let entitled = fromOptional Set.empty (Map.lookup voter casters)
  , not (any (`Set.member` entitled) (signatory record))
  ]

-- | Validates that the parties are signatories of the vote record. For
-- records the resolver's own choices create; callers SHOULD pass the
-- resolver's authorities.
validVoteRecordSignatories : HasSignatory r => [Party] -> Check r
validVoteRecordSignatories parties record =
  [ "the vote record is not signed by " <> show party
  | party <- parties
  , party `notElem` signatory record
  ]

-- | Validates that the consumers a VoteRecord names are among the actors.
-- Callers MUST pass the resolving parties, so consuming after counting
-- cannot fail.
validConsumers : [Party] -> Check VoteRecord
validConsumers actors record =
  [ "the vote record names the consumer " <> show consumer <> ", who is not resolving"
  | consumer <- (view record).consumers
  , consumer `notElem` actors
  ]


------------------  AGREEMENT  ------------------
-- For mechanisms that take the action and snapshots from the records. They
-- abort on disagreement; a lenient resolution SHOULD instead check each record
-- with validVoteRecordAction and validVoteRecordSnapshots.

-- | The action every vote record asks for. Fails when they differ or there
-- are none. Through the VoteRecord interface the result is Optional: callers
-- SHOULD fail on None when they need an action.
expectUniformAction : IsVoteRecord r v act => [r] -> act
expectUniformAction =
  fromSomeNote "the presented vote records ask for different actions, or there are none"
    . uniformOptional . map actionOf

-- | The snapshots every vote record carries. Fails when they differ or there
-- are none.
expectUniformSnapshots : IsVoteRecord r v act => [r] -> Map AuthenticKey Snapshot
expectUniformSnapshots =
  fromSomeNote "the presented vote records carry different snapshots, or there are none" . uniformOptional . map snapshotsOf


------------------  LEDGER  ------------------

-- | Consumes the vote records so they cannot be counted again. Standing
-- records are left as they are. Through the VoteRecord interface, a resolver
-- MUST consume only the kept records: an ignored one may name consumers who
-- are not resolving.
consumeVoteRecords : IsVoteRecord r v act => [ContractId r] -> Update ()
consumeVoteRecords = mapA_ consume
