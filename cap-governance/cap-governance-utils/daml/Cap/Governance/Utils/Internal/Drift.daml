module Cap.Governance.Utils.Internal.Drift
  ( DriftPolicy
  , holds
  , holdsAll
  , anyState
  , unchanged
  , typed
  ) where

import DA.Map (Map)
import qualified DA.Map as Map

import Splice.Api.Token.MetadataV1

import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.BindingV1 (Bind, TargetKey)

-- | Whether a target still carries state an approval may act on.
data DriftPolicy = DriftPolicy
  with
    holds : Bind -> Bind -> Bool

instance Semigroup DriftPolicy where
  a <> b = DriftPolicy with
    holds = \pinned current -> a.holds pinned current && b.holds pinned current

instance Monoid DriftPolicy where
  mempty = anyState

-- A pinned cid must be the current cid ALWAYS, a state comparison SHOULD never
-- see a contract id. Every constructor below
-- goes through this one.
wellFormedPolicyOnState : (AnyValue -> AnyValue -> Bool) -> DriftPolicy
wellFormedPolicyOnState onState = DriftPolicy with
  holds = \pinned current -> case pinned.cid of
    Some x -> current.cid == Some x
    None -> case (pinned.state, current.state) of
      (None, None) -> True
      (Some p, Some c) -> onState p c
      _ -> False

-- | Admits any state at all, and still holds a pinned contract id.
anyState : DriftPolicy
anyState = wellFormedPolicyOnState (\_ _ -> True)

-- | Admits only state identical to what was pinned.
unchanged : DriftPolicy
unchanged = wellFormedPolicyOnState (==)

-- | Lifts a comparison on a decoded value, refusing anything it cannot decode.
typed : IsAnyValue a => (a -> a -> Bool) -> DriftPolicy
typed p = wellFormedPolicyOnState $ \pinned current ->
  case (fromAnyValue pinned, fromAnyValue current) of
    (Some a, Some b) -> p a b
    _ -> False

-- Whether two pinnings of the same targets agree under a policy. For
-- comparing Bind Maps, not for checking a pinning against live contracts.
holdsAll : DriftPolicy -> Map TargetKey Bind -> Map TargetKey Bind -> Bool
holdsAll policy pinned current =
  Map.keys pinned == Map.keys current
    && all (\(k, p) -> optional False (holds policy p) (Map.lookup k current))
         (Map.toList pinned)
