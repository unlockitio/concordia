-- | Lets clients find, read and vote on a decision without knowing the
-- template. A cast MUST create or update a VoteRecord; a topic that stores
-- its own votes MAY implement VoteRecord itself.
module Cap.Governance.VoteTopicV1 where

import Prelude hiding (Action)

import Splice.Api.Token.MetadataV1

import Cap.Core.Types (ResolutionInfo)
import Cap.Governance.Types (OwnerId, Reason, Vote)
import Cap.Governance.ActionV1 (Action)


data VoteTopicView = VoteTopicView
  with
    resolution : ResolutionInfo           -- its id MUST survive recreating the topic
    proposer : OwnerId
    subject : Reason
    action : Optional (ContractId Action) -- None when the action is an app-specific type
    voteBefore : Optional Time            -- casts MUST be rejected from this time; None for a standing topic
    effectiveAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

data VoteTopic_CastVoteResult = VoteTopic_CastVoteResult
  with
    created : [AnyContractId]  -- the recreated topic or the vote record
    meta : Metadata
  deriving (Eq, Show)


interface VoteTopic where
  viewtype VoteTopicView

  voteTopic_castVoteImpl : ContractId VoteTopic -> VoteTopic_CastVote -> Update VoteTopic_CastVoteResult

  -- | Implementations MUST check that caster may cast for ownerId.
  nonconsuming choice VoteTopic_CastVote : VoteTopic_CastVoteResult
    with
      caster : Party
      ownerId : OwnerId
      vote : Vote AnyValue
      reason : Optional Reason
      extraArgs : ExtraArgs
    controller caster
    do voteTopic_castVoteImpl this self (VoteTopic_CastVote with ..)
