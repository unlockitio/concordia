-- | The vote topic interface: lets off-ledger find what is
-- being voted on, read it, and cast a vote on it, without knowing the
-- template. A topic can be standing (always open) or created for one
-- decision. Resolving it stays a typed choice on the app's resolver.
--
-- The view carries no votes: a cast creates or updates a VoteRecord. A topic
-- that stores its votes on itself can also implement VoteRecord; one whose
-- votes are private exposes none.
--
-- What a vote looks like is documented per mechanism name
-- (resolution.mechanism). The resolver checks every vote it counts
-- regardless.
module Cap.Governance.VoteTopicV1 where

import Prelude hiding (Action)

import Splice.Api.Token.MetadataV1

import Cap.Core.Types (ResolutionInfo)
import Cap.Governance.Types (OwnerId, Reason, Vote)
import Cap.Governance.ActionV1 (Action)


data VoteTopicView = VoteTopicView
  with
    resolution : ResolutionInfo           -- the resolver, the mechanism, and an id that survives recreating the topic
    proposer : OwnerId                    -- who raised it
    subject : Reason                      -- what it is about
    action : Optional (ContractId Action) -- the action it decides; None when the action is one of the app's own types
    voteBefore : Optional Time            -- votes are accepted before this time; None for a standing topic
    effectiveAt : Optional Time           -- when an accepted action takes effect, if set
    meta : Metadata
  deriving (Eq, Show)

data VoteTopic_CastVoteResult = VoteTopic_CastVoteResult
  with
    created : [AnyContractId]  -- the recreated topic, or the vote record that now carries the vote
    meta : Metadata
  deriving (Eq, Show)


interface VoteTopic where
  viewtype VoteTopicView

  voteTopic_castVoteImpl : ContractId VoteTopic -> VoteTopic_CastVote -> Update VoteTopic_CastVoteResult

  -- | Casts a vote for the owner.
  nonconsuming choice VoteTopic_CastVote : VoteTopic_CastVoteResult
    with
      caster : Party
      ownerId : OwnerId
      vote : Vote AnyValue
      reason : Optional Reason
      extraArgs : ExtraArgs
    controller caster
    do voteTopic_castVoteImpl this self (VoteTopic_CastVote with ..)
