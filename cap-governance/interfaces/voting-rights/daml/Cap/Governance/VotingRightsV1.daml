-- | Lets a resolver read voting rights without knowing the template. A
-- resolver SHOULD only count contracts whose signatories and keyId match an
-- AuthenticKey it trusts.
module Cap.Governance.VotingRightsV1 where

import DA.Map (Map)

import Splice.Api.Token.MetadataV1

import Cap.Governance.Types (OwnerId, VotingRight)


-- | An owner MAY be named by several contracts; implementations MUST then sum
-- their weights and take the union of their casters.
data VotingRightsView = VotingRightsView
  with
    keyId : Text
    rights : Map OwnerId VotingRight  -- weights MUST NOT be negative
    validUntil : Optional Time        -- implementations MAY archive the contract from this time
    meta : Metadata
  deriving (Eq, Show)


interface VotingRights where
  viewtype VotingRightsView

  nonconsuming choice VotingRights_PublicFetch : VotingRightsView
    with
      actor : Party
    controller actor
    do pure (view this)
