-- | Proof that votes were cast, readable without knowing the template. A
-- record with no consumers is standing: it MAY be counted many times.
module Cap.Governance.VoteRecordV1 where

import Prelude hiding (Action)

import DA.Map (Map)

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..))

import Cap.Core.Types (AuthenticKey, ResolutionInfo, Snapshot)
import Cap.Governance.Types (OwnerId, Vote)
import Cap.Governance.ActionV1 (Action)


data VoteRecordView = VoteRecordView
  with
    resolution : ResolutionInfo
    votes : Map OwnerId (Vote AnyValue)
    snapshots : Map AuthenticKey Snapshot
    action : Optional (ContractId Action)   -- None when the action is an app-specific type, or there is none
    consumers : [Party]                     -- empty for a standing record
    meta : Metadata
  deriving (Eq, Show)


interface VoteRecord where
  viewtype VoteRecordView

  choice VoteRecord_Consume : ()
    controller (view this).consumers
    do pure ()


instance Show VoteRecord where
  show record = "VoteRecord " <> show (view record)

instance HasCheckedFetch VoteRecord ResolutionInfo where
  contractGroupId record = (view record).resolution
