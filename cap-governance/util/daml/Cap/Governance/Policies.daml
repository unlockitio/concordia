-- | Governor-specific timing profiles for the `Governor` hooks
module Cap.Governance.Policies where

import Cap.Core.MechanismV1
import Cap.Core.Policies
import Cap.Governance.GovernorV1

-- | The governor's `Mechanism` interface, which carries the window.
mechanismOf : Governor -> Mechanism
mechanismOf = toInterface @Mechanism

-- | The timelock must never lift before the close of voting; with no declared
-- close there is nothing for it to respect.
timelockAfterClose : Governor -> Update ()
timelockAfterClose p = case (view (mechanismOf p)).submissionClosesAt of
  None -> pure ()
  Some c ->
    assertMsg "timelock lifts before the close of voting"
      ((view p).executeAfter >= c)

-- | Resolve only after the close, and never with a timelock that lifts before
-- it.
windowedResolution : Governor -> Time -> Update ()
windowedResolution p now = do
  resolveAfterClose (mechanismOf p) now
  timelockAfterClose p

-- | Resolve at any time after open. Sound only when a verdict once reached is
-- final — a quorate tally with quorums above half the electorate.
confirmationResolution : Governor -> Time -> Update ()
confirmationResolution p _now = timelockAfterClose p
