-- | Reference decision rules — pure functions an implementation supplies as its
-- `tally`.
-- Each takes a decoder because the submission is opaque to the interface.
-- Decoders MUST filter on the submittable's `state`: an admitted submittable
-- may be empty or withdrawn.

module Cap.Governance.Tallies where

import DA.List (sort, (!!))
import DA.Optional (mapOptional)

import Cap.Core.SubmittableV1 (Submittable)
import Cap.Governance.GovernorV1 (Verdict (..))



-- | Yes/no decided by quorum: approved at `quorum` yes-votes, rejected at
-- `quorum` no-votes, lapsed otherwise.
-- `quorum` is an absolute count denominated in the electorate (number of
-- voters, not turnout).
quorateMajority : Int -> (Submittable -> Optional Bool) -> [Submittable] -> Verdict
quorateMajority quorum decode subs
  | countOf identity >= quorum = VApproved None
  | countOf not >= quorum = VRejected
  | otherwise = VLapsed
  where
    votes = mapOptional decode subs
    countOf side = length (filter side votes)

-- | `quorateMajority` for decoders yielding many votes per submittable: a
-- container ("ballot box") ballot carries its whole vote map, a per-voter
-- ballot a singleton. An unrecognized submittable decodes to `[]`.
quorateMajorityAll : Int -> (Submittable -> [Bool]) -> [Submittable] -> Verdict
quorateMajorityAll quorum decode subs
  | countOf identity >= quorum = VApproved None
  | countOf not >= quorum = VRejected
  | otherwise = VLapsed
  where
    votes = concatMap decode subs
    countOf side = length (filter side votes)

-- | Weighted yes/no decided by quorum: the decoder yields each submission's
-- weight and direction. Approved at `quorum` yes-weight, rejected at `quorum`
-- no-weight, lapsed otherwise. `quorum` is denominated in the electorate's
-- total weight, snapshotted at governor creation.
weightedQuorate : Decimal -> (Submittable -> Optional (Decimal, Bool)) -> [Submittable] -> Verdict
weightedQuorate quorum decode subs
  | weightOf identity >= quorum = VApproved None
  | weightOf not >= quorum = VRejected
  | otherwise = VLapsed
  where
    votes = mapOptional decode subs
    weightOf side = sum [w | (w, s) <- votes, side s]

-- | Not defined for the empty list.
median : [Decimal] -> Decimal
median [] = error "median: not defined for the empty list"
median xs0 = 0.5 * (xs !! ((n - 1) / 2) + xs !! (n / 2))
  where
    xs = sort xs0
    n = length xs

-- | Yes/no decided by a threshold over turnout: approved when the yes share
-- of the decoded votes exceeds `threshold` (0.5 = majority), rejected
-- otherwise; lapsed only when nothing decodes. Sound only under completeness,
-- where the denominator is proven rather than resolver-chosen; without
-- completeness a turnout share flips under omission — use a quorate rule.
turnoutThreshold : Decimal -> (Submittable -> Optional Bool) -> [Submittable] -> Verdict
turnoutThreshold threshold decode subs =
  case mapOptional decode subs of
    [] -> VLapsed
    votes
      | intToDecimal (length (filter identity votes))
          > threshold * intToDecimal (length votes) -> VApproved None
      | otherwise -> VRejected
