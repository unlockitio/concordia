-- | Helpers for `governanceOutcome_executeImpl` bodies that act on committed targets.
module Cap.Governance.TargetUtil where

import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..))
import Cap.Core.CheckedFetchV1 (require, fetchCheckedInterface, authoritySigned)
import Cap.Governance.TargetV1

-- | Apply a state change on one committed target: downcast the checked target
-- to its template type, archive the presented cid, and create the successor
-- `f` returns. 
mutateTarget : forall t. (HasCreate t, HasArchive t, HasFromInterface t Target)
  => CheckedTarget -> ContractId Target -> (t -> Update t) -> Update (ContractId t)
mutateTarget c tcid f = case fromInterface @t c.target of
  None -> fail "committed target is not the expected template"
  Some t -> do
    archive (fromInterfaceContractId @t tcid)
    create =<< f t

-- | Admit a live target delivered in a choice context: read its cid under
-- `ctxKey`, checked-fetch it under `key`, require the authority's signature, and
-- downcast. For implementation bodies needing governed state the fixed choices do
-- not hand them.
fetchTargetFromContext : forall t. HasFromInterface t Target => ForTarget -> Text -> ChoiceContext -> Update t
fetchTargetFromContext key ctxKey ctx = case TextMap.lookup ctxKey ctx.values of
  Some (AV_ContractId cid) -> do
    t <- fetchCheckedInterface key (coerceContractId cid : ContractId Target)
    require "target is signed by its authority" (authoritySigned key.authorities (signatory t))
    case fromInterface @t t of
      None -> fail "context target is not the expected template"
      Some r -> pure r
  _ -> fail ("context lacks a target under " <> ctxKey)
