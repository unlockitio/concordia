-- | Named drift policies for `GovernanceOutcome`'s `onTargetDrift` hook.

module Cap.Governance.TargetPolicies where

import Cap.Core.CheckedFetchV1 (require)
import Cap.Governance.TargetV1

-- Policies receive the target the voters saw and the current target and can decide based on it.

-- | Strict policy: any drift refuses execution.
driftAborts : CheckedTarget -> Update ()
driftAborts c =
  require
    ("target " <> show c.commitment.targetKey
       <> " still carries the approved state token " <> show c.commitment.stateToken)
    False

-- | Merging policy: permits every drift; the merge is executeImpl's field-wise patch.
driftMerges : CheckedTarget -> Update ()
driftMerges _ = pure ()
