module Cap.Governance.ExecutableV1 where

import DA.Map (Map)

import Splice.Api.Token.MetadataV1
import Splice.Util (require)
import Cap.Core.Utils (entitled, ExecutionAction (..), ExecutionCore (..), requireExpired, requireOpen)
import Cap.Governance.BindingV1 (Bind, TargetKey)

data ExecutableView = ExecutableView
  with
    core : ExecutionCore
    bindings : Map TargetKey Bind
    outcome : Optional AnyValue
  deriving (Eq, Show)

data Executable_ExecuteResult = Executable_ExecuteResult
  with
    created : [AnyContractId]
    meta : Metadata
  deriving (Eq, Show)

data Executable_CancelResult = Executable_CancelResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Executable_ExpireResult = Executable_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Executable where
  viewtype ExecutableView

  executable_executeImpl
    : Map TargetKey AnyContractId -> ExtraArgs -> Update Executable_ExecuteResult

  executable_cancelImpl : Executable_Cancel -> Update Executable_CancelResult

  choice Executable_Execute : Executable_ExecuteResult
    with
      actors : [Party]
      targets : Map TargetKey AnyContractId
      extraArgs : ExtraArgs
    controller actors
    do
      let v = view this
      now <- getTime
      requireOpen "the execution window is open" now v.core.opensAt v.core.expiresAt
      require "the actors are entitled to execute"
        (entitled v.core.availableActions EA_Execute actors)
      executable_executeImpl this targets extraArgs

  choice Executable_Cancel : Executable_CancelResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are entitled to cancel"
        (entitled (view this).core.availableActions EA_Cancel actors)
      executable_cancelImpl this (Executable_Cancel with ..)

  choice Executable_Expire : Executable_ExpireResult
    with
      actor : Party
    controller actor
    do
      now <- getTime
      requireExpired "the execution has expired" now (view this).core.expiresAt
      pure Executable_ExpireResult with meta = emptyMetadata
