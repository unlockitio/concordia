-- Exists after resolve

module Cap.Governance.OutcomeV1 where

import qualified DA.Map as Map

import Splice.Api.Token.MetadataV1
import Cap.Core.TimeV1 (isOpen)
import Cap.Core.OutcomeV1 (Outcome, isExecutor)
import Cap.Governance.TargetV1 (Target, TargetRef (..), matchByKey)


data GovernanceOutcomeView = GovernanceOutcomeView
  with
    committedTargets : [TargetRef]
      -- ^ The targets this outcome was approved to act upon.
      -- MUST populate it with exactly the targets and
      -- state tokens the approved decision authorized.
  deriving (Eq, Show)

data GovernanceOutcome_ExecuteResult = GovernanceOutcome_ExecuteResult
  with
    meta : Metadata
  deriving (Eq, Show)

-- | One committed target Ref at outcome creation, its its current state and its live
-- cid contract
data TargetContext = TargetContext with
    commitment : TargetRef
    target     : Target
    targetCid  : ContractId Target

-- | Reconcile the presented live targets against the committed refs by key: one
-- `TargetContext` per committed target, in any presentation order.
toContexts : [TargetRef] -> [ContractId Target] -> Update [TargetContext]
toContexts committed cids = do
  let decl = Map.fromList [(r.targetKey, r.stateToken) | r <- committed]
  matched <- matchByKey decl cids
  pure
    [ TargetContext with
        commitment = TargetRef with targetKey = key; stateToken = tok
        target = t
        targetCid = cid
    | (key, (tok, cid, t)) <- Map.toList matched ]


interface GovernanceOutcome requires Outcome where
  viewtype GovernanceOutcomeView

  -- Forwards to the effect + drift logic defined alongside the action.

  governanceOutcome_executeImpl : [TargetContext] -> ExtraArgs -> Update ()
    -- ^ Apply the approved outcome across all committed targets at once. Owns the
    -- whole execute logic — drift detection, policy (MUST abort to refuse), effect
    -- — and may condition any target's effect on any target's drift.

  choice GovernanceOutcome_Execute : GovernanceOutcome_ExecuteResult
    with
      actors : [Party]
      targets : [ContractId Target]
        -- ^ The live targets to act upon, matched to `committedTargets` by key.
      extraArgs : ExtraArgs
    controller actors
    do
      let core = toInterface @Outcome this
      let cv = view core
      now <- getTime
      assertMsg "outcome is outside its execution window"
        (isOpen now cv.executeAfter cv.executeUntil)
      assertMsg "actors are not an executor set" (isExecutor core actors)

      contexts <- toContexts (view this).committedTargets targets
      governanceOutcome_executeImpl this contexts extraArgs
      pure (GovernanceOutcome_ExecuteResult with meta = emptyMetadata)
