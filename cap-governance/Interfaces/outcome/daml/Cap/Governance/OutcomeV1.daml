module Cap.Governance.OutcomeV1 where

import DA.Action (when)
import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import Cap.Core.TimeV1 (isOpen)
import Cap.Core.OutcomeV1 (Outcome, isExecutor)
import Cap.Governance.TargetV1 (Target, TargetCommitment, CheckedTarget (..), checkTargetBinding)


data GovernanceOutcomeView = GovernanceOutcomeView
  with
    committedTargets : [TargetCommitment]
      -- ^ The targets this outcome was approved to act upon.
      -- `governor_issueOutcome` MUST populate it with exactly the targets and
      -- state pins the approved decision authorized.
    meta : Metadata
  deriving (Eq, Show)

data GovernanceOutcome_ExecuteResult = GovernanceOutcome_ExecuteResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface GovernanceOutcome requires Outcome where
  viewtype GovernanceOutcomeView

  onTargetDrift : CheckedTarget -> Update ()
    -- ^ The drift policy, invoked per committed target whose pinned state no
    -- longer matches the fresh one.
    -- MUST abort to refuse execution; on return, `governanceOutcome_executeImpl`
    -- MUST apply its change as a field-wise patch onto the fresh state it is handed.

  governanceOutcome_executeImpl : [CheckedTarget] -> GovernanceOutcome_Execute -> Update GovernanceOutcome_ExecuteResult
    -- ^ The applied effect, run with the outcome signatories' authority in
    -- scope. The checked targets MUST arrive in commitment order.

  choice GovernanceOutcome_Execute : GovernanceOutcome_ExecuteResult
    with
      actors : [Party]
      targets : [ContractId Target]
        -- ^ The live targets to act upon, checked against `committedTargets`.
      extraArgs : ExtraArgs
    controller actors
    do
      let core = toInterface @Outcome this
      let cv = view core
      now <- getTime
      assertMsg "outcome is outside its execution window"
        (isOpen now cv.executeAfter cv.executeUntil)
      assertMsg "actors are not an executor set" (isExecutor core actors)
      checked <- checkTargetBinding (view this).committedTargets targets
      forA_ checked $ \c -> when c.drifted (onTargetDrift this c)
      governanceOutcome_executeImpl this checked (GovernanceOutcome_Execute with actors; targets; extraArgs)
