-- | `Governor` requires `Mechanism` and is
-- resolved with `Ballot`s (its own package); `Governor_Resolve` is the one
-- resolve door, running the shared cap-core checks then governance's own.
module Cap.Governance.GovernorV1 where

import DA.Optional (catOptionals)

import Splice.Api.Token.MetadataV1
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1
import Cap.Core.CheckedFetchV1
import Cap.Core.TimeV1 (checkFloor)
import Cap.Core.ChecksV1
import Cap.Governance.OutcomeV1
import Cap.Governance.BallotV1

-- Shared data
--------------

-- | The proposal put before the electorate.
data Proposal = Proposal
  with
    url : Text
    body : Text
  deriving (Eq, Show)

-- Governor
-----------

-- | View of a governor under vote. The authority, voting window, expiry, and
-- completeness switch live on the governor's `MechanismView`; this view carries
-- only what is governance's alone.
data GovernorView = GovernorView
  with
    proposer : Party
    proposal : Proposal
    executeAfter : Time
      -- ^ The timelock: the instant the approved outcome may first execute —
      -- part of what voters approve. `governor_issueOutcome` MUST pin each issued
      -- outcome's `executeAfter` to exactly this value.
    meta : Metadata
      -- ^ Display and extension data; never security-relevant.
  deriving (Eq, Show)

-- | The tally's verdict (method-level, not serialized). `VApproved` may carry a
-- selected option, opaque to the interface. A winning "enact nothing" is
-- `VRejected`.
data Verdict
  = VApproved (Optional Text)
  | VRejected
  | VLapsed
    -- ^ The vote never became definitive (e.g. quorum not reached).
  deriving (Eq, Show)

-- | Serialized outcome of a resolution. The extension constructor works around
-- the current lack of variant upgrading in Daml 3.x.
data ResolutionOutcome
  = RO_Approved
      with
        outcomeCids : [ContractId GovernanceOutcome]
          -- ^ One per obligation of the approved action; independent lifecycles
          -- get independent contracts. Never empty.
        option : Optional Text
          -- ^ The winning option for multi-option governors, exactly as `tally`
          -- selected it; None for plain approve/reject.
  | RO_Rejected
  | RO_Lapsed
  | ExtResolutionOutcome with dummyUnitField : ()
  deriving (Eq, Show)

data Governor_ResolveResult = Governor_ResolveResult
  with
    outcome : ResolutionOutcome
    resolvedAt : Time
    meta : Metadata
  deriving (Eq, Show)

data Governor_WithdrawResult = Governor_WithdrawResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Governor_ExpireResult = Governor_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Governor requires Mechanism where
  viewtype GovernorView

  tally : [Ballot] -> Verdict
    -- ^ THE social choice function — pure. Side effects belong in `onResolved`.
  isResolver : Party -> Bool
    -- ^ Who may trigger resolution. Resolution is safe-by-construction except
    -- submittable selection (gated under completeness), so broad resolver sets
    -- are fine.
  governor_issueOutcome : ContractId Mechanism -> Optional Text -> ExtraArgs -> Update [ContractId GovernanceOutcome]
    -- ^ Builds the approved outcomes. Gets this governor's own anchor (passed in
    -- because an implementation cannot see its own cid), the winning option as
    -- `tally` selected it (None for approve/reject), and the resolver's `extraArgs`.
    -- MUST return at least one outcome, each signed by this governor's
    -- authority, with `source` exactly the given anchor, `executeAfter` exactly
    -- the governor's `executeAfter` and any `executeUntil` past both issuance
    -- and that instant; MUST set each `committedTargets` to the targets the
    -- approved option authorized.
  onResolved : ResolutionOutcome -> ExtraArgs -> Update Metadata
    -- ^ Side effects atomic with resolution (rejection record, successor on a
    -- lapse, notifications), run with the authority's signature in scope; the
    -- returned metadata lands in the result.
  governor_withdrawImpl : Governor_Withdraw -> Update Governor_WithdrawResult
    -- ^ Cleanup on withdrawal (release pre-minted rights or escrow named in
    -- `extraArgs.context`). Runs after `Mechanism`'s `withdrawAllowed` passed.

  -- | Resolve the governor with its ballots. Consuming: a governor resolves
  -- exactly once. Ballots are read, not consumed — teardown is a later
  -- `Ballot_Consume`/`Ballot_Expire`; they only lose their anchor once the
  -- governor dies. Issuing the outcome can be made atomic with resolution,
  -- useful to prevent frontrunning.
  choice Governor_Resolve : Governor_ResolveResult
    with
      resolver : Party
      ballots : [ContractId Ballot]
        -- ^ Every live ballot on the governor's slots
      extraArgs : ExtraArgs
    controller resolver
    do
      let res = toInterface @Mechanism this
      let rv = view res
      assertMsg "not authorised to resolve" (isResolver this resolver)
      checkAuthoritySigned res
      now <- getTime
      checkFloor "resolution does not precede the submission open" now rv.submissionOpensAt
      resolutionAllowed res now

      -- Admit the ballots, then score each:
      -- a cast ballot is tallied and consumed, an uncast/withdrawn one only fills
      -- its slot. No per-voter dedup — one ballot per slot is structural.
      admitted <- admitBallots self res ballots
      tallied <- forA admitted $ \(_, b) -> admitTally (rv.size /= None) b

      outcome <- case tally this (catOptionals tallied) of
        VRejected -> pure RO_Rejected
        VLapsed -> pure RO_Lapsed
        VApproved option -> do
          let anchor = toInterfaceContractId @Mechanism self
          outcomeCids <- governor_issueOutcome this anchor option extraArgs
          pure RO_Approved with outcomeCids; option
      resultMeta <- onResolved this outcome extraArgs
      pure Governor_ResolveResult with outcome; resolvedAt = now; meta = resultMeta

  -- | Consuming. Timing is the `withdrawAllowed` policy; the standard profile
  -- allows withdrawal only before voting opens, so a proposer can never cancel a
  -- losing vote.
  choice Governor_Withdraw : Governor_WithdrawResult
    with
      extraArgs : ExtraArgs
    controller (view this).proposer
    do
      now <- getTime
      withdrawAllowed (toInterface @Mechanism this) now
      governor_withdrawImpl this (Governor_Withdraw with extraArgs)

  -- | Lets any party with visibility archive a governor that can no longer
  -- resolve. Effect-free, because the caller is arbitrary; never before the
  -- close, because `expiresAt` MUST sit past it (`MechanismView`).
  choice Governor_Expire : Governor_ExpireResult
    with
      actor : Party
    controller actor
    do
      case (view (toInterface @Mechanism this)).expiresAt of
        None -> abort "governor has no expiry"
        Some e -> do
          now <- getTime
          assertMsg "governor not yet expired" (now >= e)
          pure Governor_ExpireResult with meta = emptyMetadata

-- | Admit the ballots presented at resolution as `(cid, ballot)` pairs to tally.
-- Under completeness the cap-core gate proves binding, authority signature, and
-- exact cover (which subsumes distinctness); without it, there is no cover, so
-- the gate asserts distinctness directly. Either way no ballot is counted twice.
admitBallots : ContractId Governor -> Mechanism -> [ContractId Ballot] -> Update [(ContractId Ballot, Ballot)]
admitBallots self res ballots = do
  let anchor = toInterfaceContractId @Mechanism self
  let scids = map (toInterfaceContractId @Submittable) ballots
  pairs <- case (view res).size of
    Some n -> admitSubmittablesWithCompleteness n (toInterfaceContractId @Mechanism self) res scids
    None -> admitSubmittables (view res).authorities anchor scids

  forA pairs $ \(scid, s) -> case fromInterface @Ballot s of
    None -> abort "admitted submittable is not a ballot"
    Some b -> pure (fromInterfaceContractId @Ballot scid, b)

-- | Score one presented ballot. A full ballot is returned to tally; the gate
-- already proved the set distinct, so it needs no consuming here. Vote
-- provenance is the trusted template's own (its signatory and controller
-- structure), not re-proved here — a container format records votes on an
-- authority-signed contract the voters never sign. An uncast or withdrawn one
-- only fills a slot, illegal unless the governor declares completeness.
admitTally : Bool -> Ballot -> Update (Optional Ballot)
admitTally covered b =
  case (view (toInterface @Submittable b)).state of
    S_Full -> pure (Some b)
    _ -> do
      assertMsg "an uncovered resolution takes only cast ballots" covered
      pure None
