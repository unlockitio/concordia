module Cap.Governance.ActionV1 where

import Prelude hiding (Action)

import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Cap.Governance.ExecutableV1 (Executable, ExecutableView (..))

data ActionView = ActionView
  with
    authorities : Set Party
      -- ^ Whose authority governs this action. 
    meta : Metadata
  deriving (Eq, Show)

data Action_IssueExecutionResult = Action_IssueExecutionResult
  with
    executionCids : [ContractId Executable]
    meta : Metadata
  deriving (Eq, Show)

interface Action where
  viewtype ActionView

  action_issueExecutionImpl : ContractId Action -> Action_IssueExecution -> Update Action_IssueExecutionResult

  nonconsuming choice Action_IssueExecution : Action_IssueExecutionResult
    with
      execution : ExecutableView
      extraArgs : ExtraArgs
    controller Set.toList (view this).authorities
    do action_issueExecutionImpl this self (Action_IssueExecution with ..)
