module Cap.Governance.ActionV1 where

import Prelude hiding (Action)

import Splice.Api.Token.MetadataV1
import Splice.Util (require)
import Cap.Core.Utils (admitActors)
import Cap.Governance.ExecutableV1 (Executable, ExecutableView (..))

data ActionView = ActionView
  with
    authorizers : [[Party]]
      -- ^ Who may authorize an execution against this action: any one group,
      --   all of its members
    meta : Metadata
  deriving (Eq, Show)

data Action_AuthorizeExecutionResult = Action_AuthorizeExecutionResult
  with
    executionCids : [ContractId Executable]
    meta : Metadata
  deriving (Eq, Show)

interface Action where
  viewtype ActionView

  action_authorizeExecutionImpl : ContractId Action -> Action_AuthorizeExecution -> Update Action_AuthorizeExecutionResult

  nonconsuming choice Action_AuthorizeExecution : Action_AuthorizeExecutionResult
    with
      actors : [Party]
      execution : ExecutableView
      extraArgs : ExtraArgs
    controller actors
    do
      require "the actors are an authorizer set of this action"
        (admitActors (view this).authorizers actors)
      action_authorizeExecutionImpl this self (Action_AuthorizeExecution with ..)
