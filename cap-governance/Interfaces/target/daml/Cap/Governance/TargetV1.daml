module Cap.Governance.TargetV1 where

import DA.Set (Set)
import DA.Map (Map)
import qualified DA.Map as Map

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), HasAuthority (..), authoritySigned, require)

data TargetView = TargetView
  with
    authorities : Set Party
    id : Text
      -- ^ Distinguishes several targets of one authority; part of `ForTarget`.
    stateToken : Optional Text
      -- ^ An opaque token that ONLY changes when action-relevant state changes.
    meta : Metadata
  deriving (Eq, Show)

-- A target's identifying key: its authority plus an `id` distinguishing
-- several targets of one authority, so an approved outcome cannot be redirected
-- to a different target of the same authority.
-- Authority MUST guarantee key uniqueness.
data ForTarget = ForTarget
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show, Ord)

instance HasCheckedFetch TargetView ForTarget where
  contractGroupId v = ForTarget v.authorities v.id

instance HasAuthority ForTarget where
  keyAuthorities k = k.authorities

interface Target where
  viewtype TargetView


-- | Used to fix a target + a state
data TargetRef = TargetRef
  with
    targetKey : ForTarget
    stateToken : Optional Text
  deriving (Eq, Show)



-- | A presented target's own authority-verified key, plus its payload. The key
-- is read from the target itself and checked against its signatories, so a
-- presented contract can only ever be treated as the target it actually is.
readTargetKey : ContractId Target -> Update (ForTarget, Target)
readTargetKey cid = do
  t <- fetch cid
  let key = ForTarget with authorities = (view t).authorities; id = (view t).id
  require "target is signed by its authority" (authoritySigned key.authorities (signatory t))
  pure (key, t)

-- | Match presented targets to a key-addressed declaration by each target's OWN
-- key. Aborts unless they form a bijection with the declared keys: every
-- presented target is declared and authority-signed, all are distinct, and every
-- declared key is present. Presentation order is irrelevant.
matchByKey : Map ForTarget e -> [ContractId Target] -> Update (Map ForTarget (e, ContractId Target, Target))
matchByKey decl cids = do
  pairs <- forA cids $ \cid -> do
    (key, t) <- readTargetKey cid
    case Map.lookup key decl of
      None -> fail ("presented target is not declared: " <> show key)
      Some e -> pure (key, (e, cid, t))
  let matched = Map.fromList pairs
  require "presented targets are distinct" (Map.size matched == length pairs)
  require "every declared target is presented" (Map.size matched == Map.size decl)
  pure matched

-- | Build the committed refs from a key-addressed declaration (`True` records
-- the state token) and the presented targets, matched by key.
buildRefs : Map ForTarget Bool -> [ContractId Target] -> Update [TargetRef]
buildRefs pins cids = do
  matched <- matchByKey pins cids
  pure
    [ TargetRef with
        targetKey = key
        stateToken = if pinsState then (view t).stateToken else None
    | (key, (pinsState, _, t)) <- Map.toList matched ]



