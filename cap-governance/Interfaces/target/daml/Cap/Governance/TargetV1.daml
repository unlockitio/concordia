module Cap.Governance.TargetV1 where

import DA.Optional (isSome)
import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), fetchCheckedInterface, require, authoritySigned)

data TargetView = TargetView
  with
    authorities : Set Party
    id : Text
      -- ^ Distinguishes several targets of one authority; part of `ForTarget`.
    stateToken : Optional Text
      -- ^ An opaque token that ONLY changes when action-relevant state changes.
    meta : Metadata
  deriving (Eq, Show)


-- A target's identifying key: its authority plus an `id` distinguishing
-- several targets of one authority, so an approved outcome cannot be redirected
-- to a different target of the same authority.
-- Authority MUST guarantee key uniqueness.
data ForTarget = ForTarget
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show)

instance HasCheckedFetch TargetView ForTarget where
  contractGroupId v = ForTarget v.authorities v.id


interface Target where
  viewtype TargetView

-- What an approval commits an outcome to act upon: the target's identifying
-- key, plus optionally the state the approvers saw. `stateToken = None`
-- pins the Target by identity only.
data TargetCommitment = TargetCommitment
  with
    targetKey : ForTarget
    stateToken : Optional Text
    -- ^ copy of Target.stateToken when outcome is issued
  deriving (Eq, Show)


-- To be used by drift policies to decide what to do based on the drift.
data CheckedTarget = CheckedTarget
  with
    target : Target
    -- ^ current state
    commitment : TargetCommitment
    -- ^ what the approvers saw
    drifted : Bool
      -- ^ True if state drifted. False for an identity-only pin.

-- Verify the live targets presented at execution are the ones committed at
-- approval: a wrong key or a missing authority signature aborts; a committed
-- state pin is compared and routed to the caller's drift policy (not enforced here).
checkTargetBinding : [TargetCommitment] -> [ContractId Target] -> Update [CheckedTarget]
checkTargetBinding committed presented = do
  require "the presented targets pair with the committed targets"
    (length committed == length presented)
  forA (zip committed presented) $ \(c, cid) -> do
    t <- fetchCheckedInterface c.targetKey cid
    require "target is signed by its authority" (authoritySigned c.targetKey.authorities (signatory t))
    drifted <- case c.stateToken of
      None -> pure False
      Some pinned -> do
        let found = (view t).stateToken
        require "a state-pinned target exposes a state token" (isSome found)
        pure (Some pinned /= found)
    pure CheckedTarget with target = t; commitment = c; drifted
