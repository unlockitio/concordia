module Cap.Governance.BallotV1 where

import DA.Map (Map)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.Utils (admitActors, entitled, requireExpired, requireOpen)
import Cap.Core.SubmittableV1 (Submittable)
import Cap.Governance.BindingV1 (Bind, TargetKey)

data BallotAction
  = BA_Cast
  | BA_Withdraw
  | BA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data ProposalTerms = ProposalTerms
  with
    authorities : Set Party
    options : [AnyValue]
    actionCid : Optional AnyContractId
    bindings : [Bind]
    entryClosesAt : Time
    votingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

data BallotView = BallotView
  with
    terms : ProposalTerms
    availableActions : Map BallotAction [[Party]]
    voter : Party
    votes : [AnyValue]
    meta : Metadata
  deriving (Eq, Show)

data Ballot_WithdrawResult = Ballot_WithdrawResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Ballot_ExpireResult = Ballot_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Ballot_ConsumeResult = Ballot_ConsumeResult
  with
    meta : Metadata
  deriving (Eq, Show)


interface Ballot requires Submittable where
  viewtype BallotView

  ballot_castImpl : ContractId Ballot -> Ballot_Cast -> Update (ContractId Ballot)

  ballot_withdrawImpl : ContractId Ballot -> Ballot_Withdraw -> Update Ballot_WithdrawResult

  ballot_expireImpl : ContractId Ballot -> Ballot_Expire -> Update Ballot_ExpireResult

  ballot_consumeImpl : ContractId Ballot -> Ballot_Consume -> Update Ballot_ConsumeResult

  nonconsuming choice Ballot_Cast : ContractId Ballot
    with
      actors : [Party]
      votes : [AnyValue]
      currentTargets : Map TargetKey AnyContractId
      extraArgs : ExtraArgs
    controller actors
    do
      let bv = view this
      let sv = view (toInterface @Submittable this)
      require "the actors are entitled to cast"
        (entitled bv.availableActions BA_Cast actors)
      now <- getTime
      requireOpen "the voting window is open" now sv.opensAt (Some sv.closesAt)
      ballot_castImpl this self (Ballot_Cast with ..)

  nonconsuming choice Ballot_Withdraw : Ballot_WithdrawResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      let bv = view this
      let sv = view (toInterface @Submittable this)
      require "the actors are entitled to withdraw"
        (entitled bv.availableActions BA_Withdraw actors)
      now <- getTime
      requireOpen "the voting window is open" now sv.opensAt (Some sv.closesAt)
      ballot_withdrawImpl this self (Ballot_Withdraw with ..)

  nonconsuming choice Ballot_Expire : Ballot_ExpireResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      now <- getTime
      requireExpired "the ballot has expired" now (view (toInterface @Submittable this)).expiresAt
      ballot_expireImpl this self (Ballot_Expire with ..)

  nonconsuming choice Ballot_Consume : Ballot_ConsumeResult
    with
      actors : [Party]
      extraArgs : ExtraArgs
    controller actors
    do
      let mechanism = (view (toInterface @Submittable this)).mechanism
      require "the actors carry the authority of the resolver this ballot names"
        (admitActors [Set.toList mechanism.resolver.authorities] actors)
      ballot_consumeImpl this self (Ballot_Consume with ..)
