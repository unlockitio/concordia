-- | The `Ballot` voting interface: a re-castable submittable carrying opaque
-- votes against a mechanism; a format may hold one vote per contract or many.

module Cap.Governance.BallotV1 where

import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1
import Cap.Core.CheckedFetchV1
import Cap.Core.TimeV1 (checkWindow)

data BallotView = BallotView
  with
    governor : ContractId Mechanism
      -- ^ Binds exactly one mechanism by cid, as its `Mechanism`
    voters : Set Party
      -- ^ Who may cast/withdraw here
    expiresAt : Time
      -- ^ When the ballot becomes archivable by anyone with visibility.
      -- MUST NOT precede a declared close of voting on a cast ballot
  deriving (Eq, Show)


instance HasCheckedFetch BallotView ForMechanism where
  contractGroupId v = ForMechanism v.governor

-- | A voter is eligible when named in `voters`, or when `voters` is empty — an
-- open format admits anyone, and the implementation enforces its own rule.
isEligibleVoter : Set Party -> Party -> Bool
isEligibleVoter voters voter = Set.null voters || voter `Set.member` voters

data Ballot_ConsumeResult = Ballot_ConsumeResult
  with
    meta : Metadata
  deriving (Eq, Show)

data Ballot_ExpireResult = Ballot_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Ballot requires Submittable where
  viewtype BallotView

  ballot_castImpl : Ballot_Cast -> Update (ContractId Ballot)
    -- ^ Builds the cast full state, recording the opaque vote as `voter`'s.
    -- Runs with the authority's and the casting voter's signatures in scope.
    -- The successor:
    -- MUST preserve governor, voters, authority, and slot;
    -- MUST be `S_Full`, authority-signed,
    -- When `voters` is empty (open format) the implementation
    -- MUST enforce its own eligibility rule on `voter`.

  ballot_withdrawImpl : Ballot_Withdraw -> Update (ContractId Ballot)
    -- ^ Builds the withdrawn successor. Same obligations as `ballot_castImpl`.

  ballot_consumeImpl : Ballot_Consume -> Update Ballot_ConsumeResult
    -- ^ The authority's teardown effect: release escrowed weight named in
    -- `extraArgs.context`, mirroring `ballot_withdrawImpl` on the terminal path.


  -- | Cast (or re-cast) a vote — empty→full, withdrawn→full, or full→full.
  choice Ballot_Cast : ContractId Ballot
    with
      voter : Party
        -- ^ The casting party, checked against `voters` unless the format is open.
      vote : AnyValue
        -- ^ Each format documents its encoding, and the interface never reads it.
      extraArgs : ExtraArgs
    controller voter
    do
      let bv = view this
      now <- getTime
      assertMsg "ballot expired" (now < bv.expiresAt)
      assertMsg "caster is not an eligible voter" (isEligibleVoter bv.voters voter)
      -- Read the governor for its window and policy; the fetch aborts if it is
      -- resolved or withdrawn.
      r <- fetch bv.governor
      let mv = view r
      checkWindow "submissions are open" now mv.submissionOpensAt mv.submissionClosesAt
      submittableAllowed r now
      ballot_castImpl this (Ballot_Cast with voter; vote; extraArgs)

  -- | Withdraw — empty→withdrawn (decline) or full→withdrawn (retract)
  choice Ballot_Withdraw : ContractId Ballot
    with
      voter : Party
        -- ^ The retracting party; checked against `voters` unless the format is open.
      extraArgs : ExtraArgs
    controller voter
    do
      let bv = view this
      assertMsg "withdrawer is not an eligible voter" (isEligibleVoter bv.voters voter)
      ballot_withdrawImpl this (Ballot_Withdraw with voter; extraArgs)


  choice Ballot_Consume : Ballot_ConsumeResult
    with
      extraArgs : ExtraArgs
    controller (view (toInterface @Submittable this)).authorities
    do ballot_consumeImpl this (Ballot_Consume with extraArgs)

  -- | Archives an expired ballot
  choice Ballot_Expire : Ballot_ExpireResult
    with
      actor : Party
    controller actor
    do
      now <- getTime
      assertMsg "ballot not yet expired" (now >= (view this).expiresAt)
      pure Ballot_ExpireResult with meta = emptyMetadata
