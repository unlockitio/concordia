-- `Patchable` is the tool behind the merging drift policy

module Cap.Core.Patchable (Patchable (..), SetState (..), applySetState) where

import Splice.Util (Patchable (..))

-- | A generic delta action over patchable state. Moves the value from `base`
-- to `new`. Applied with `applySetState`.
data SetState a = SetState
  with
    base : a
    new : a
  deriving (Eq, Show)

-- | Apply a `SetState` against the fresh state: `patch new base current`, so
-- concurrent approved changes compose instead of last-write-wins.
applySetState : Patchable a => SetState a -> a -> a
applySetState s current = patch s.new s.base current
