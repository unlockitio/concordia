-- | `Patchable`: three-way merge for standing state that several approved
-- outcomes may update concurrently. `patch new base current` applies to
-- `current` only what changed between `base` and `new`, so a later outcome does
-- not revert an earlier one by replacing the whole value.
--
-- This is the machinery behind the reconciling drift policy
-- (`Cap.Core.TargetPolicies.driftReconciles`); conflicts resolve proposal-wins.
module Cap.Core.Patchable where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set, difference, union)
import qualified DA.Set as Set
import DA.Time (RelTime)

-- | `patch new base current` sets a field to its value in `new` iff it changed
-- between `base` and `new`; otherwise it keeps `current`. The `Set`, `Map` and
-- `Optional` instance semantics are ported from Splice's `Splice.Util`.
class Patchable a where
  patch : a -> a -> a -> a

patchScalar : Eq a => a -> a -> a -> a
patchScalar new base current
  | new == base = current
  | otherwise = new

-- | Treat a whole list as one value: any change replaces it.
patchListAsScalar : Eq a => [a] -> [a] -> [a] -> [a]
patchListAsScalar = patchScalar

-- | Treat a list as a set: merge element additions and removals.
patchListAsSet : (Patchable a, Ord a) => [a] -> [a] -> [a] -> [a]
patchListAsSet new base current =
  Set.toList (patch (Set.fromList new) (Set.fromList base) (Set.fromList current))

instance (Patchable a, Ord a) => Patchable (Set a) where
  patch new base current =
    let toAdd = difference new base
        toRemove = difference base new
    in union (difference current toRemove) toAdd

instance Patchable Decimal where
  patch = patchScalar

instance Patchable Int where
  patch = patchScalar

instance Patchable Text where
  patch = patchScalar

instance Patchable RelTime where
  patch = patchScalar

instance Patchable Time where
  patch = patchScalar

instance Patchable Party where
  patch = patchScalar

mapDifference : Ord k => Map k a -> Map k a -> Map k k
mapDifference = Map.merge (\_ _ -> None) (\k _ -> Some k) (\_ _ _ -> None)

instance (Ord k, Patchable v) => Patchable (Map k v) where
  patch new base current =
      Map.union toAdd (Map.filterWithKey (\key _ -> not (Map.member key keysToRemove)) current)
    where
      toAdd = Map.merge
        -- keys only in `new`: add them
        (\_ value -> Some value)
        -- keys only in `base`: remove them
        (\_key _ -> None)
        -- keys in both: patch, unless a concurrent change removed the key
        (\key newValue baseValue ->
          case Map.lookup key current of
            None -> None
            Some currentValue -> Some (patch newValue baseValue currentValue)
        )
        new
        base
      keysToRemove = mapDifference new base

instance Patchable a => Patchable (Optional a) where
  patch new base current =
    case (base, new) of
      (None, None) -> current        -- no change requested
      (Some _, None) -> None         -- remove the value
      (None, Some new') -> Some new' -- write the complete new value
      (Some base', Some new') ->
        case current of
          None -> None               -- value removed by a concurrent change
          Some current' -> Some (patch new' base' current')
