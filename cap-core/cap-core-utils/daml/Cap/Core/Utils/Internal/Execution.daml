module Cap.Core.Utils.Internal.Execution
  ( ExecutionAction (..)
  , ExecutionCore (..)
  ) where

import DA.Map (Map)
import DA.Set (Set)

import Splice.Api.Token.MetadataV1

data ExecutionAction
  = EA_Execute
  | EA_Cancel
  | EA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data ExecutionCore = ExecutionCore
  with
    authorities : Set Party
    availableActions : Map ExecutionAction [[Party]]
    opensAt : Time
    expiresAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)
