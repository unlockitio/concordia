-- | Utilities to implement cap-core resolvers, submittables and the doors
-- built on them. Domain-agnostic: nothing here names a target, an action, an
-- allocation or a vote.
module Cap.Core.Utils (

  -- * Binding discipline

  -- ** Checked and authentic fetches
  HasCheckedFetch (..),

  -- ** Admission predicates
  admitActors,
  entitled,

  -- * Windows

  -- ** Half-open window convention (inclusive floor, exclusive ceiling)
  isOpen,
  requireOpen,
  requireClosed,
  requireBeforeOpen,
  requireExpired,

  -- * Execution
  ExecutionCore (..),

  -- * Values
  IsAnyValue (..),

  -- * Optionals
  orAbort,

) where


import Splice.Util (HasCheckedFetch (..))

import Cap.Core.Utils.Internal.Admission
import Cap.Core.Utils.Internal.Time
import Cap.Core.Utils.Internal.Execution
import Cap.Core.Utils.Internal.Value
import Cap.Core.Utils.Internal.Patch ()

-- | Unwrap an 'Optional', aborting with the given message when it is 'None'.
orAbort : Text -> Optional a -> Update a
orAbort msg None = abort msg
orAbort _ (Some a) = pure a
