-- | The fixed checks for the DOMAIN submit and resolve choices run over a
-- mechanism's `ResolvableView` and its submittables. They are functions, not
-- interface methods or choices: the enforcement locus is the domain interface's
-- fixed choice body, which calls them and which implementations cannot override.
-- A domain that skips a call here is non-conforming at the interface-author
-- level, never at the template level.
--
-- The checked-fetch vocabulary these build on (`HasCheckedFetch`, the group
-- types, `fetchChecked*`, `require`, `authoritySigned`) lives one layer down in
-- `Cap.Core.CheckedFetchV1`.
--
-- The gate proves; it never consumes: when and how the cover is spent is the
-- implementation's, inside its resolution or afterwards through expiry.
module Cap.Core.ChecksV1 where

import DA.List (sort, unique)
import DA.Set (Set)

import Cap.Core.MetadataV1
import Cap.Core.TimeV1 (isOpen)
import Cap.Core.CheckedFetchV1
import Cap.Core.SubmittableV1
import Cap.Core.ResolvableV1

-- | The binding target a submittable's `resolvable` field must equal.
resolvableAnchor : ContractId Resolvable -> AnyContractId
resolvableAnchor = coerceInterfaceContractId @AnyContract

-- | The full authority's signature must be in scope, for any cap artifact whose
-- view groups by authority. Reads the authority set from the artifact's own
-- `ForAuthority` group, so it can never be checked against a foreign set — that
-- distinct case stays an explicit `authoritySigned` call.
checkAuthoritySigned : (HasInterfaceView i v, HasCheckedFetch v ForAuthority, HasSignatory i) => i -> Update ()
checkAuthoritySigned c =
  let ForAuthority authorities = contractGroupId (view c)
  in require "contract is signed by its authority"
       (authoritySigned authorities (signatory c))

-- | The submission window `[submissionOpensAt, submissionClosesAt)`.
checkSubmissionWindow : ResolvableView -> Time -> Update ()
checkSubmissionWindow v now =
  require "submissions are not open"
    (isOpen now v.submissionOpensAt (Some v.submissionClosesAt))

-- | The resolution floor: no resolution before `submissionOpensAt`.
-- Deliberately not "after the close" — resolving early is a domain timing
-- policy (quorum-triggered resolution is legitimate), never a core rule.
checkResolutionFloor : ResolvableView -> Time -> Update ()
checkResolutionFloor v now =
  require "resolution does not precede the submission open"
    (isOpen now v.submissionOpensAt None)

-- | Admit one presented submittable: fetch it through its `Submittable` face
-- bound to this mechanism (a submittable whose `resolvable` is not this anchor
-- aborts) and require the authority signed it. Run per item by both
-- `admitSubmittables` (distinct set) and `admitSubmittablesWithCompleteness` (exact cover).
admitSubmittable : Set Party -> AnyContractId -> ContractId Submittable -> Update (ContractId Submittable, Submittable)
admitSubmittable authorities anchor scid = do
  s <- fetchCheckedInterface (ForResolvable anchor) scid
  require "submittable is signed by the authority" (authoritySigned authorities (signatory s))
  pure (scid, s)

-- | The completeness-free admission: each submittable bound and authority-signed,
-- and the set itself distinct. Distinctness (no cid twice) is the no-double-count
-- guard where there is no cover to give it — which is why resolution never has to
-- consume to stop a recount. Completeness uses `admitSubmittablesWithCompleteness`
-- instead, where exact-cover already subsumes this check.
admitSubmittables : Set Party -> AnyContractId -> [ContractId Submittable] -> Update [(ContractId Submittable, Submittable)]
admitSubmittables authorities anchor scids = do
  require "the presented submittables are distinct" (unique scids)
  forA scids (admitSubmittable authorities anchor)

-- | Proof at resolution of exact cover: admit each submittable (bound, signed)
-- and prove its slots are exactly `0 .. n-1`. Cover subsumes distinctness — a
-- repeated cid repeats a slot and fails — so no separate distinctness check is
-- run here (that is `admitSubmittables`'s job, for the completeness-free path). The
-- resolvable's own signature is the fixed body's separate step, run before the gate.
admitSubmittablesWithCompleteness : Int -> ContractId Resolvable -> Resolvable -> [ContractId Submittable] -> Update [(ContractId Submittable, Submittable)]
admitSubmittablesWithCompleteness n self r scids = do
  pairs <- forA scids (admitSubmittable (view r).authorities (resolvableAnchor self))
  slots <- forA pairs $ \(_, s) -> case (view s).slot of
    None -> abort "The requirement 'submittable carries a slot' was not met."
    Some k -> pure k
  checkSlotCover n slots
  pure pairs

-- | The exact-cover assertion: the gathered slots must be exactly `0 .. n-1`,
-- each once. `n` MUST be sealed on the view at genesis.
checkSlotCover : Int -> [Int] -> Update ()
checkSlotCover n slots = do
  require "size is non-negative" (n >= 0)
  require "the submittables cover the slots exactly"
    (sort slots == [0 .. n - 1])
