-- | The `Outcome` interface: pre-committed authority, executable at most once
-- inside its window. The execute choice is the domain's own, layered on via
-- `requires`.
module Cap.Core.OutcomeV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..))
import Cap.Core.MechanismV1 (Mechanism, ForMechanism (..))
import Cap.Core.TimeV1 (checkFloor)


data OutcomeView = OutcomeView
  with
    authorities : Set Party
      -- ^ The authority this outcome carries. MUST be non-empty at mint.
    source : ContractId Mechanism
      -- ^ The mechanism whose resolution issued this outcome; to be compared,
      -- so it may already be archived.
    executeAfter : Time
      -- ^ Execution blocked before it. MUST be the value
      -- the approvers saw; use a past instant for immediate execution.
    executeUntil : Optional Time
      -- ^ Execution deadline. `None` = no deadline (never expirable).
    meta : Metadata
      -- ^ Display and extension data.
  deriving (Eq, Show)

-- | Groups an outcome by its issuing mechanism (`source`).
instance HasCheckedFetch OutcomeView ForMechanism where
  contractGroupId v = ForMechanism v.source

data Outcome_ExpireResult = Outcome_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Outcome where
  viewtype OutcomeView

  isExecutor : [Party] -> Bool
    -- ^ Whether this actor set may trigger the domain's execute choice.

  -- | Archives an outcome past its execution deadline (`executeUntil`).
  -- Deadline-only, no authority check. Undated outcomes are not expirable.
  choice Outcome_Expire : Outcome_ExpireResult
    with
      actor : Party
    controller actor
    do
      case (view this).executeUntil of
        None -> abort "outcome has no execution deadline"
        Some e -> do
          now <- getTime
          checkFloor "outcome not yet past its execution deadline" now e
          pure Outcome_ExpireResult with meta = emptyMetadata
