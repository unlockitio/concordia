-- | The `Outcome` interface: an outcome carrying pre-committed authority,
-- enactable at most once inside its window. The face is domain-neutral —
-- identity, window, executor set, and expiry; the execute door is the
-- domain's own (governance's target-bound `GovernanceOutcome_Execute`,
-- auctions' settle/fail pair), each layered on this via `requires`.
module Cap.Core.OutcomeV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..))
import Cap.Core.MechanismV1 (Mechanism, ForMechanism (..))

-- | View of an executable outcome.
data OutcomeView = OutcomeView
  with
    authorities : Set Party
      -- ^ The authority whose joint ledger authority this outcome carries.
      -- MUST be non-empty at mint — an empty anchor can never execute.
    source : ContractId Mechanism
      -- ^ The mechanism whose resolution issued this outcome. Only ever compared,
      -- never fetched through, so the mechanism may already be archived.
      -- MUST be set by the implementation to the mechanism that actually issued it.
    executeAfter : Time
      -- ^ The instant the timelock lifts: execution is blocked strictly before
      -- it. Part of what was approved, the implementation MUST set it to the
      -- value the approvers saw. Set it to the creation time (or any past
      -- instant) for immediate execution.
    executeUntil : Optional Time
      -- ^ Execution deadline; None = no deadline. WARNING: an undated outcome
      -- stays executable forever, against context its approvers never saw — date
      -- every outcome you issue, doubly so under a state-pinning drift policy.
    meta : Metadata
      -- ^ Display and extension data; never security-relevant.
  deriving (Eq, Show)

-- | An outcome's fine group is the one contract that issued it, so a relying
-- contract admits "the outcome of *this* mechanism" and a look-alike issued
-- elsewhere under the same authority aborts.
instance HasCheckedFetch OutcomeView ForMechanism where
  contractGroupId v = ForMechanism v.source

data Outcome_ExpireResult = Outcome_ExpireResult
  with
    meta : Metadata
  deriving (Eq, Show)

interface Outcome where
  viewtype OutcomeView

  isExecutor : [Party] -> Bool
    -- ^ Whether this actor set may trigger the domain's execute door; varies
    -- per authority model. Plural because settlement (Token Standard V2) can
    -- need several executors jointly.

  -- | Lets any party with visibility archive an outcome past its execution
  -- deadline. Effect-free, because the caller is arbitrary; an undated outcome
  -- (`executeUntil = None`) is never expirable — the cost `executeUntil` warns of.
  choice Outcome_Expire : Outcome_ExpireResult
    with
      actor : Party
    controller actor
    do
      case (view this).executeUntil of
        None -> abort "outcome has no execution deadline"
        Some e -> do
          now <- getTime
          assertMsg "outcome not yet past its execution deadline" (now >= e)
          pure Outcome_ExpireResult with meta = emptyMetadata
