module Cap.Core.MechanismV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1

-- | The fields the shared checks read.
data MechanismView = MechanismView
  with
    authorities : Set Party
      -- ^ The authority. MUST be non-empty at mint.
    size : Optional Int
      -- ^ Completeness flag and participant count. `Some n` = exact cover of
      -- slots `0..n-1` proven at resolution; `None` = no completeness claimed.
      -- MUST: `Some _` implies `expiresAt = Some _`.
    submissionOpensAt : Time
      -- ^ No submission or resolution before it.
    submissionClosesAt : Optional Time
      -- ^ No submission at or after it. `None` = no fixed close
    expiresAt : Optional Time
      -- ^ MUST be `> submissionClosesAt` when the submissionClosesAt is `Some _`.
    meta : Metadata
      -- ^ Display and extension data.
  deriving (Eq, Show)

interface Mechanism where
  viewtype MechanismView

  -- Timing-policy hooks. Standard policies in `Cap.Core.Policies`.
  submittableAllowed : Time -> Update ()
    -- ^ Extra restriction on submitting, above the window. Only tightens.
  resolutionAllowed : Time -> Update ()
    -- ^ Extra restriction on resolving, above the floor. Only tightens.
  withdrawAllowed : Time -> Update ()
    -- ^ When withdrawal is allowed; abort to refuse.

-- | The contract group a submittable or outcome binds to: its one mechanism.
-- Only ever compared, so the mechanism may already be archived
-- and this can still be used for comparison.
data ForMechanism = ForMechanism
  with
    mechanism : ContractId Mechanism
  deriving (Eq, Show)
