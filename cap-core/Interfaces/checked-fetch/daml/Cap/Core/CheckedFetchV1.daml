-- | The checked-fetch vocabulary: the contract-group identity every cap
-- artifact is grouped by (`HasCheckedFetch`, `ForAuthority`, `ForResolvable`,
-- `ForTarget`), the `fetchChecked*` helpers that abort on a group mismatch, the
-- `require` assertion idiom, and `authoritySigned`. Depends on nothing but the
-- value types, so it sits below every view: each view declares its own
-- `HasCheckedFetch` instance next to its `viewtype`, and the checks in
-- `Cap.Core.ChecksV1` build on this.
module Cap.Core.CheckedFetchV1 where

import DA.Action (unless)
import DA.Set (Set)
import qualified DA.Set as Set

import Cap.Core.MetadataV1

-- | Abort with a uniform message when a requirement is not met — the assertion
-- idiom every check is phrased in (Splice's `Util.require`), reused by
-- implementations so all failure text reads the same. State it positively.
require : CanAssert m => Text -> Bool -> m ()
require msg invariant =
  assertMsg ("The requirement '" <> msg <> "' was not met.") invariant

-- Checked fetches
------------------
--
-- A `ContractId` argument guarantees the template type, not the instance — a
-- submitter can pass a look-alike from a different group. Fetch through
-- `fetchChecked`/`fetchCheckedInterface` with the expected contract group
-- identifier and the mismatch aborts. 

-- | The coarse group every cap artifact belongs to: its authority — the set of
-- parties whose joint signature anchors it. Kept distinct from `ForResolvable`
-- at the type level so the two groupings can never be compared by mistake.
data ForAuthority = ForAuthority
  with
    authorities : Set Party
  deriving (Eq, Show)

-- | The fine group a submittable belongs to: the one mechanism it binds.
-- `ForAuthority` proves "under this authority"; this proves "*this* mechanism",
-- stopping a submittable being replayed at another mechanism's resolution.
data ForResolvable = ForResolvable
  with
    resolvable : AnyContractId
  deriving (Eq, Show)

-- | A target's *identifying key*: its authority plus an `id` distinguishing
-- several targets of one authority, so an approved outcome cannot be redirected
-- to a different target of the same authority. `""` names a
-- singleton-per-authority target; the `id` is compared, never interpreted.
data ForTarget = ForTarget
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show)

-- | Types that can state which contract group they belong to. No `HasFetch`
-- constraint, so interface views qualify. Every view declares its own instance
-- next to its `viewtype` (cap-core's `ResolvableView`, `SubmittableView`,
-- `TargetView`, `OutcomeView`; cap-governance's `BallotView`).
class (Show t, Eq cgid, Show cgid) => HasCheckedFetch t cgid where
  contractGroupId : t -> cgid

-- | Fetch an interface cid and abort unless its view belongs to the expected
-- group. The primary variant: cap consumers hold interface cids.
fetchCheckedInterface : (HasFetch i, HasInterfaceView i v, HasCheckedFetch v cgid) => cgid -> ContractId i -> Update i
fetchCheckedInterface expected cid = do
  co <- fetch cid
  let v = view co
  let got = contractGroupId v
  unless (expected == got) $ fail $
    "Contract group identifier mismatch: expected " <> show expected <>
    ", got " <> show got <> " for " <> show (cid, v)
  pure co

-- | Fetch a template cid and abort unless it belongs to the expected group.
fetchChecked : (HasFetch t, HasCheckedFetch t cgid) => cgid -> ContractId t -> Update t
fetchChecked expected cid = do
  co <- fetch cid
  let got = contractGroupId co
  unless (expected == got) $ fail $
    "Contract group identifier mismatch: expected " <> show expected <>
    ", got " <> show got <> " for " <> show (cid, co)
  pure co

-- | Checked fetch + archive, for choices that mutate another contract by
-- fetching, archiving, and creating the updated one. Archiving here so a
-- call site cannot forget it.
fetchAndArchive : (HasFetch t, HasCheckedFetch t cgid, HasArchive t) => cgid -> ContractId t -> Update t
fetchAndArchive expected cid = do
  co <- fetchChecked expected cid
  archive cid
  pure co

-- | `fetchChecked`, named so the call site says the contract is read-only.
fetchReferenceData : (HasFetch t, HasCheckedFetch t cgid) => cgid -> ContractId t -> Update t
fetchReferenceData = fetchChecked

-- | All parties in the authority signed the contract.
authoritySigned : Set Party -> [Party] -> Bool
authoritySigned authorities sigs =
  not (Set.null authorities) && all (`elem` sigs) (Set.toList authorities)
