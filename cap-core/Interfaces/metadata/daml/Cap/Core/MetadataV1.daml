-- | Pure shared data for the cap-core tier-1 interfaces. The shapes mirror
-- the Token Standard's `Splice.Api.Token.MetadataV1` one-to-one (Apache-2.0,
-- Digital Asset) without importing it, so implementations bridge
-- registry-supplied contexts mechanically and this package version-couples
-- to nothing.
--
-- Implementations MUST NOT put security-relevant data in metadata: the fixed
-- checks never read it.
module Cap.Core.MetadataV1 where

import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap
import DA.Time (RelTime)

-- | Machine-readable string metadata, keyed by DNS-style prefixed names.
-- The standard's extension mechanism: new information travels here, not in
-- new view fields.
data Metadata = Metadata
  with
    values : TextMap Text
  deriving (Eq, Show)

emptyMetadata : Metadata
emptyMetadata = Metadata with values = TextMap.empty

-- | Structured dynamic values for choice contexts.
data AnyValue
  = AV_Text Text
  | AV_Int Int
  | AV_Decimal Decimal
  | AV_Bool Bool
  | AV_Date Date
  | AV_Time Time
  | AV_RelTime RelTime
  | AV_Party Party
  | AV_ContractId AnyContractId
  | AV_List [AnyValue]
  | AV_Map (TextMap AnyValue)
  deriving (Eq, Show)

-- | Opaque contract handle: never fetched as such, only `coerceContractId`d
-- to the type the implementation expects.
type AnyContractId = ContractId AnyContract

-- | Not implemented by any template; exists only as a coercion target.
interface AnyContract where viewtype AnyContractView

data AnyContractView = AnyContractView {} deriving (Eq, Show)

-- | Implementation-defined extra input to a choice: escrow and settlement
-- references, registry-supplied contract ids, disclosure hints.
data ChoiceContext = ChoiceContext
  with
    values : TextMap AnyValue
  deriving (Eq, Show)

emptyChoiceContext : ChoiceContext
emptyChoiceContext = ChoiceContext with values = TextMap.empty

data ExtraArgs = ExtraArgs
  with
    context : ChoiceContext
    meta : Metadata
  deriving (Eq, Show)

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
