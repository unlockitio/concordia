-- A submittable records which mechanism and which slot.
-- The submission itself can be read by downcasting a full
-- submittable to the implementation's own template.
module Cap.Core.SubmittableV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..))
import Cap.Core.MechanismV1 (Mechanism, ForMechanism (..))


data SubmittableState
  = S_Empty
      -- ^ The slot is registered; nothing has been submitted.
  | S_Full
      -- ^ Holds the submission that resolution counts.
  | S_Withdrawn
      -- ^ A submission that was retracted.
  | ExtSubmittableState with dummyUnitField : ()
  deriving (Eq, Show)

data SubmittableView = SubmittableView
  with
    mechanism : ContractId Mechanism
      -- ^ The mechanism this submittable belongs to. To be compared,
      -- may already be archived.
    authorities : Set Party
      -- ^ The authority whose signature admission requires.
    slot : Optional Int
      -- ^ The slot this submittable covers. `Some` under
      -- completeness, `None` otherwise.
    state : SubmittableState
      -- ^ The implementation MUST have `S_Full` exactly when the contract
      -- carries a submission — the fixed bodies filter on it.
    meta : Metadata
  deriving (Eq, Show)

instance HasCheckedFetch SubmittableView ForMechanism where
  contractGroupId v = ForMechanism v.mechanism

interface Submittable where
  viewtype SubmittableView
