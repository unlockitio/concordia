module Cap.Core.SubmittableV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import DA.List (unique)

import Splice.Util (require, fetchCheckedInterface)
import Cap.Core.Utils (HasCheckedFetch (..), admitActors)

-- Split in Bid/Ballot

data ResolverKey = ResolverKey
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show, Ord)

data Mechanism = Mechanism
  with
    resolver : ResolverKey
    resolverCid : Optional AnyContractId
    procedure : Text
    id : Text
  deriving (Eq, Show)

data SubmittableView = SubmittableView
  with
    mechanism : Mechanism
    opensAt : Time
    closesAt : Time
    expiresAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

instance HasCheckedFetch SubmittableView Mechanism where
  contractGroupId v = v.mechanism

interface Submittable where
  viewtype SubmittableView

fetchSubmittables
  : [[Party]] -> Mechanism -> [ContractId Submittable] -> Update [(ContractId Submittable, Submittable)]
fetchSubmittables _ _ [] = fail "a presentation holds at least one submittable"
fetchSubmittables issuers mechanism cids = do
  require "the presented submittables are distinct" (unique cids)
  forA cids $ \cid -> do
    s <- fetchCheckedInterface mechanism cid
    require "the submittable is signed by its issuers" (admitActors issuers (signatory s))
    pure (cid, s)
