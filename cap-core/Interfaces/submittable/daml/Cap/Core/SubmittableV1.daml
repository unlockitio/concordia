module Cap.Core.SubmittableV1 where

import DA.Set (Set)

import Splice.Api.Token.MetadataV1
import DA.Either (partitionEithers)
import DA.List (unique)

import Splice.Util (require, fetchCheckedInterface)
import Cap.Core.Utils (HasCheckedFetch (..))

-- Split in Bid/Ballot
data ResolverKey = ResolverKey
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show, Ord)

data Mechanism = Mechanism
  with
    resolver : ResolverKey
    resolverCid : Optional AnyContractId
    procedure : Text
    id : Text
  deriving (Eq, Show)

data SubmittableView = SubmittableView
  with
    mechanism : Mechanism
    meta : Metadata
  deriving (Eq, Show)

instance HasCheckedFetch SubmittableView Mechanism where
  contractGroupId v = v.mechanism

interface Submittable where
  viewtype SubmittableView

-- will be up to each domain
fetchSubmittables
  : Mechanism -> [ContractId Submittable] -> Update [(ContractId Submittable, Submittable)]
fetchSubmittables _ [] = fail "a presentation holds at least one submittable"
fetchSubmittables mechanism cids = do
  require "the presented submittables are distinct" (unique cids)
  forA cids $ \cid -> do
    s <- fetchCheckedInterface mechanism cid
    pure (cid, s)

-- move to utils 
partitionPresentedAs
  : forall t. HasFromInterface t Submittable
  => [(ContractId Submittable, Submittable)]
  -> ([(ContractId t, t)], [(ContractId Submittable, Submittable)])
partitionPresentedAs presented = partitionEithers (map pick presented)
  where
    pick (cid, s) = case fromInterface s of
      Some t -> Left (fromInterfaceContractId cid, t)
      None -> Right (cid, s)

presentedAs
  : forall t. HasFromInterface t Submittable
  => Text -> [(ContractId Submittable, Submittable)] -> Update [(ContractId t, t)]
presentedAs what presented = case partitionPresentedAs @t presented of
  (ts, []) -> pure ts
  (_, (cid, _) :: _) ->
    abort ("the presented submittable " <> show cid <> " is not " <> what)
