-- | The `Submittable` interface: the single live artifact a slot holds while
-- a mechanism runs.
--
-- A submittable records which mechanism and which slot.
-- The submission itself can be read by downcasting a full
-- submittable to the implementation's own template.
module Cap.Core.SubmittableV1 where

import DA.Optional (isSome)
import DA.Set (Set)

import Cap.Core.MetadataV1
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), ForAuthority (..), ForResolvable (..))

-- | The lifecycle state. 
data SubmittableState
  = S_Empty
      -- ^ The slot is registered; nothing has been submitted.
  | S_Full
      -- ^ Holds the participant's submission — the only state resolution
      -- scores.
  | S_Withdrawn
      -- ^ A submission that was retracted.
  | ExtSubmittableState with dummyUnitField : ()
  deriving (Eq, Show)

-- | View of a submittable. Content checks are the implementation's
-- responsibility.
data SubmittableView = SubmittableView
  with
    resolvable : AnyContractId
      -- ^ The mechanism this submittable belongs to.
    authorities : Set Party
      -- ^ The authority anchor; every member signs. MUST be non-empty at mint —
      -- the fixed checks reject an empty (vacuous) anchor.
    slot : Optional Int
      -- ^ The slot this submittable covers. `Some` on every artifact of a
      -- completeness mechanism — the gate demands it; `None` when the mechanism
      -- declares no completeness (no slot set exists).
    state : SubmittableState
      -- ^ WARNING: an implementation-written claim the interface cannot verify.
      -- The implementation MUST mint `S_Full` exactly when the contract carries
      -- a submission — the fixed bodies filter on it.
    meta : Metadata
      -- ^ Display and extension data; never security-relevant.
  deriving (Eq, Show)

data Submittable_ConsumeResult = Submittable_ConsumeResult
  with
    meta : Metadata
  deriving (Eq, Show)

instance HasCheckedFetch SubmittableView ForAuthority where
  contractGroupId v = ForAuthority v.authorities

instance HasCheckedFetch SubmittableView ForResolvable where
  contractGroupId v = ForResolvable v.resolvable

interface Submittable where
  viewtype SubmittableView

  -- Under review: may be removed before the first tagged release.
  choice Submittable_Consume : Submittable_ConsumeResult
    controller (view this).authorities
    do
      assertMsg "unslotted submittable is not consumable through the interface"
        (isSome (view this).slot)
      pure Submittable_ConsumeResult with meta = emptyMetadata


