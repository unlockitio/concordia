import Cap.Core.Types (AuthenticKey (..), ResolutionInfo (..))


-- | The key of a contract built from its signatories, for use in a
-- HasCheckedFetch instance so that fetchChecked also checks who signed it.
signedKey : HasSignatory t => Text -> t -> AuthenticKey
signedKey id contract = AuthenticKey with authorities = Set.fromList (signatory contract); id

-- | Fetches a contract named by an AnyContractId as its concrete template and
-- checks its key, returning the typed contract id with the contract.
fetchCheckedAny
  : (HasFetch t, HasCheckedFetch t k)
  => k -> AnyContractId -> Update (ContractId t, t)
fetchCheckedAny key cid = do
  let typed = coerceContractId cid
  contract <- fetchChecked key typed
  pure (typed, contract)

-- | Fetches the presented contracts, each once, and checks that each one
-- belongs to the given group key, for example the resolution it is counted
-- in. Aborts if a contract is presented twice or belongs to another group:
-- the party presenting them chose the list, so these are its errors and are
-- never ignored. An empty list returns no contracts.
fetchGroup
  : (HasFetch t, HasCheckedFetch t k)
  => k -> [ContractId t] -> Update [(ContractId t, t)]
fetchGroup key cids = do
  require "the presented contracts are distinct" (unique cids)
  forA cids $ \cid -> do
    contract <- fetchChecked key cid
    pure (cid, contract)


-- | The conditions of a check that are not met. Empty when the check passes.
type Unmet = [Text]

type Contracts t = [(ContractId t, t)]

type Ignored t = [(ContractId t, Text)]

type ContractFilter t = Contracts t -> Update (Contracts t, Ignored t)

-- | Runs the filters in order, each on the contracts the previous ones kept, and collects the ignored contracts.
applyFilters : [ContractFilter t] -> Contracts t -> Update (Contracts t, Ignored t)
applyFilters filters contracts = foldlA step (contracts, []) filters
  where
    step (kept, ignored) contractFilter = do
      (stillKept, newlyIgnored) <- contractFilter kept
      pure (stillKept, ignored <> newlyIgnored)

-- | Ignores every contract with an unmet condition, with the first one as the reason.
ignoreUnless : (t -> Unmet) -> ContractFilter t
ignoreUnless unmet contracts = pure
  ( [contract | (contract, []) <- checked]
  , [(cid, reason) | ((cid, _), reason :: _) <- checked]
  )
  where
    checked = [(contract, unmet c) | contract@(_, c) <- contracts]

-- | Like ignoreUnless, for checks that run in Update, for example to fetch.
ignoreUnlessM : (t -> Update Unmet) -> ContractFilter t
ignoreUnlessM unmet contracts = do
  checked <- forA contracts $ \contract@(_, c) -> do
    result <- unmet c
    pure (contract, result)
  pure
    ( [contract | (contract, []) <- checked]
    , [(cid, reason) | ((cid, _), reason :: _) <- checked]
    )

-- | Like ignoreUnless, for checks that compare a contract with the other contracts still kept.
ignoreUnlessAmong : ([t] -> t -> Unmet) -> ContractFilter t
ignoreUnlessAmong unmet contracts = ignoreUnless (unmet (map snd contracts)) contracts

-- | Aborts with the first unmet condition.
requireMet : Unmet -> Update ()
requireMet [] = pure ()
requireMet (errorMsg :: _) = abort errorMsg


-- | A check on one contract alone.
type Check t = t -> Unmet

-- | A check on one contract among the others presented with it.
type AmongCheck t = [t] -> t -> Unmet

-- | The unmet conditions of every contract, one contract after the other:
-- first the checks on the contract alone, then the checks among all the
-- contracts.
unmetOf : [Check t] -> [AmongCheck t] -> [t] -> Unmet
unmetOf checks amongChecks contracts =
  concat [check c | c <- contracts, check <- checks]
    <> concat [check contracts c | c <- contracts, check <- amongChecks]

-- | Aborts with the first unmet condition of any contract. Use it for the
-- conditions that are the error of the party presenting the contracts. Run it
-- on every contract presented, before ignoring any: run on the kept contracts
-- only, a condition it checks would not abort on a contract already ignored.
requireChecks : [Check t] -> [AmongCheck t] -> [t] -> Update ()
requireChecks checks amongChecks contracts =
  requireMet (unmetOf checks amongChecks contracts)

-- | Ignores the contracts that fail a check, each with its first unmet
-- condition. Use it for the conditions that are the error of the party behind
-- a contract, such as a voter or a bidder. The checks among contracts run only
-- on the contracts the checks on the contract alone kept. Every check must
-- follow from the contracts and the ledger alone, so that any party presenting
-- them ignores the same contracts.
ignoreFailing : [Check t] -> [AmongCheck t] -> ContractFilter t
ignoreFailing checks amongChecks = applyFilters
  [ ignoreUnless (\c -> concatMap (\check -> check c) checks)
  , ignoreUnlessAmong (\cs c -> concatMap (\check -> check cs c) amongChecks)
  ]


-- | Checks that a resolution names this resolver and is bound to no other
-- resolver contract. The resolver passes its own key and its own contract id.
-- It does not check the mechanism; the resolver checks that where it picks the
-- rule the mechanism names.
requireResolvedBy : AuthenticKey -> AnyContractId -> ResolutionInfo -> Update ()
requireResolvedBy rKey self resolution = do
  require ("the resolution names the resolver " <> show rKey) (resolution.resolver == rKey)
  require "the resolution is bound to no other resolver contract"
    (optional True (== self) resolution.resolverCid)

-- remove this function
authoritiesOf : ResolutionInfo -> Set Party
authoritiesOf resolution = resolution.resolver.authorities


-- | Admits the actors when they include every party of some non-empty group.
-- The actors may be a superset of the group: the group [alice] admits the
-- actors [alice, bob].
admitActors : [[Party]] -> [Party] -> Bool
admitActors groups sigs =
  any (all (`elem` sigs)) (filter (not . null) groups)

entitled : Ord k => Map k [[Party]] -> k -> [Party] -> Bool
entitled availableActions action actors =
  case Map.lookup action availableActions of
    None -> False
    Some groups -> admitActors groups actors


isOpen : Time -> Time -> Optional Time -> Bool
isOpen now opensAt closesAt = now >= opensAt && optional True (now <) closesAt

requireOpen : CanAssert m => Text -> Time -> Time -> Optional Time -> m ()
requireOpen msg now opensAt closesAt = require msg (isOpen now opensAt closesAt)

requireClosed : CanAssert m => Text -> Time -> Time -> m ()
requireClosed msg now closesAt = require msg (now >= closesAt)

requireBeforeOpen : CanAssert m => Text -> Time -> Time -> m ()
requireBeforeOpen msg now opensAt = require msg (now < opensAt)

requireBefore : CanAssert m => Text -> Time -> Time -> m ()
requireBefore msg now deadline = require msg (now < deadline)

requireExpired : Text -> Time -> Optional Time -> Update ()
requireExpired msg now expiresAt = case expiresAt of
  None -> abort "this contract has no expiry"
  Some e -> require msg (now >= e)


class IsAnyValue a where
  toAnyValue : a -> AnyValue
  fromAnyValue : AnyValue -> Optional a

instance IsAnyValue AnyValue where
  toAnyValue v = v
  fromAnyValue v = Some v

instance IsAnyValue Int where
  toAnyValue = AV_Int
  fromAnyValue (AV_Int v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Decimal where
  toAnyValue = AV_Decimal
  fromAnyValue (AV_Decimal v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Text where
  toAnyValue = AV_Text
  fromAnyValue (AV_Text v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Bool where
  toAnyValue = AV_Bool
  fromAnyValue (AV_Bool v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Party where
  toAnyValue = AV_Party
  fromAnyValue (AV_Party v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Time where
  toAnyValue = AV_Time
  fromAnyValue (AV_Time v) = Some v
  fromAnyValue _ = None

instance IsAnyValue RelTime where
  toAnyValue = AV_RelTime
  fromAnyValue (AV_RelTime v) = Some v
  fromAnyValue _ = None

instance IsAnyValue Date where
  toAnyValue = AV_Date
  fromAnyValue (AV_Date v) = Some v
  fromAnyValue _ = None

instance IsAnyValue AnyContractId where
  toAnyValue = AV_ContractId
  fromAnyValue (AV_ContractId v) = Some v
  fromAnyValue _ = None

instance IsAnyValue a => IsAnyValue [a] where
  toAnyValue vs = AV_List (map toAnyValue vs)
  fromAnyValue (AV_List vs) = mapA fromAnyValue vs
  fromAnyValue _ = None

instance IsAnyValue a => IsAnyValue (TextMap a) where
  toAnyValue vs = AV_Map (fmap toAnyValue vs)
  fromAnyValue (AV_Map vs) = Traversable.mapA fromAnyValue vs
  fromAnyValue _ = None


-- | Unwrap an Optional, aborting with the given message when it is None.
orAbort : Text -> Optional a -> Update a
orAbort msg None = abort msg
orAbort _ (Some a) = pure a

single : [a] -> Optional a
single [a] = Some a
single _ = None

uniformValue : Eq a => [a] -> Optional a
uniformValue (a :: rest) | all (== a) rest = Some a
uniformValue _ = None
