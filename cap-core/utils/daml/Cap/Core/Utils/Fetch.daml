-- | Structural fetches: each contract is fetched once, and a contract
-- presented twice or of another resolution aborts.
module Cap.Core.Utils.Fetch
  ( HasCheckedFetch (..)
  , signatoriesKey
  , fetchCheckedAny
  , fetchGroup
  ) where

import DA.List (unique)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (AnyContractId)
import Splice.Util (HasCheckedFetch (..), fetchChecked, require)

import Cap.Core.Types (AuthenticKey (..), ResolutionInfo)
import Cap.Core.Utils.Admission (requireResolvedBy)
import Cap.Core.Utils.Checks (AmongCheck, Check, requireMetFrom)


-- | The key of a contract built from its signatories, for use in a
-- HasCheckedFetch instance so that fetchChecked also checks who signed it.
signatoriesKey : HasSignatory t => Text -> t -> AuthenticKey
signatoriesKey id contract = AuthenticKey with authorities = Set.fromList (signatory contract); id

-- | Fetches a contract named by an AnyContractId as its concrete template and
-- checks its key, returning the typed contract id with the contract.
fetchCheckedAny
  : (HasFetch t, HasCheckedFetch t k)
  => k -> AnyContractId -> Update (ContractId t, t)
fetchCheckedAny key cid = do
  let typed = coerceContractId cid
  contract <- fetchChecked key typed
  pure (typed, contract)

-- | Checks that the resolution names this resolver (requireResolvedBy), then
-- fetches the presented contracts, and checks that each one belongs to the
-- resolution and meets the checks. Aborts if the resolution names another
-- resolver, or a contract is presented twice, belongs to another resolution,
-- or fails a check. The resolver passes itself and its own contract id.
fetchGroup
  : (HasCheckedFetch res AuthenticKey, HasFetch t, HasCheckedFetch t ResolutionInfo)
  => res -> ContractId res -> [Check t] -> [AmongCheck t] -> ResolutionInfo -> [ContractId t]
  -> Update [(ContractId t, t)]
fetchGroup resolver self checks amongChecks resolution cids = do
  requireResolvedBy resolver self resolution
  require "the presented contracts are distinct" (unique cids)
  presented <- forA cids $ \cid -> do
    contract <- fetchChecked resolution cid
    pure (cid, contract)
  requireMetFrom checks amongChecks (map snd presented)
  pure presented
