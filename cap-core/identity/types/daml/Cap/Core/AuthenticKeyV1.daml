-- | How a contract is named without its contract id.
module Cap.Core.AuthenticKeyV1
  ( AuthenticKey (..)
  ) where

import DA.Set (Set)


-- | A key that its authorities keep unique among their active contracts.
data AuthenticKey = AuthenticKey
  with
    authorities : Set Party
    id : Text
    -- ^ The authorities are trusted to keep it unique.
  deriving (Eq, Show, Ord)
