module Cap.Core.Types
  ( AuthenticKey (..)
  , ResolutionInfo (..)
  , ExecutionAction (..)
  , ExecutionCore (..)
  , Snapshot (..)
  , TargetReader
  ) where

import DA.Map (Map)
import DA.Set (Set)

import Splice.Api.Token.MetadataV1


data AuthenticKey = AuthenticKey
  with
    authorities : Set Party
    id : Text
  deriving (Eq, Show, Ord)

data ResolutionInfo = ResolutionInfo 
  with
    resolver : AuthenticKey
    resolverCid : Optional AnyContractId
    mechanism : Text
    id : Text
  deriving (Eq, Show)

data ExecutionAction
  = EA_Execute
  | EA_Cancel
  | EA_Custom with
      id : Text
  deriving (Eq, Ord, Show)

data ExecutionCore = ExecutionCore
  with
    authorities : Set Party
    availableActions : Map ExecutionAction [[Party]]
    opensAt : Time
    cancelAfter : Time
    expiresAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

data Snapshot = Snapshot
  with
    state : Optional AnyValue
    cid : Optional AnyContractId
  deriving (Eq, Show)

-- | Reads a target named by a key: checks the contract is the one the key
-- names and returns its state, or None when it has none to snapshot. 
type TargetReader = AuthenticKey -> AnyContractId -> Update (Optional AnyValue)
