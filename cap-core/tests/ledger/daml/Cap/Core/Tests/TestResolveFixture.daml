module Cap.Core.Tests.TestResolveFixture
  ( Fixture (..)
  , setupAs
  ) where

import qualified DA.Set as Set
import DA.Time
import Daml.Script

import Cap.Core.SubmittableV1
import Cap.Core.Dummies.Resolver
import Cap.Core.Dummies.Submittable
import Cap.Core.Harness

data Fixture = Fixture with
    live : LiveMechanism
    dso : Party
    operator : Party
    alice : Party
    external : Party
    submittables : [ContractId Submittable]

setupAs : Text -> Script Fixture
setupAs ns = do
  let party role = "resolve-" <> ns <> "-" <> role
  dso <- allocatePartyByHint (PartyIdHint (party "dso"))
  operator <- allocatePartyByHint (PartyIdHint (party "operator"))
  alice <- allocatePartyByHint (PartyIdHint (party "alice"))
  external <- allocatePartyByHint (PartyIdHint (party "stranger"))
  now <- getTime
  live <- startMechanism DummyResolver with
    authorities = Set.fromList [dso]
    id = "resolver-1"
    procedure = "procedure-1"
    resolvers = [[operator]]
    observers = [operator, external, alice]
    expiresAt = Some (now `addRelTime` days 1)
  submittables <- createSubmittables
    [ DummySubmittable with
        mechanism = live.mechanism
        submitter = alice
        observers = [operator, external]
    ]
  pure Fixture with ..
