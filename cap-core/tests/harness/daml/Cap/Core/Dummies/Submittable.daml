-- | A minimal Submittable for cap-core's own tests.

module Cap.Core.Dummies.Submittable
  ( DummySubmittable (..)
  ) where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1

import Cap.Core.SubmittableV1

template DummySubmittable
  with
    mechanism : Mechanism
    submitter : Party
    observers : [Party]
  where
    signatory submitter
    observer Set.toList (authoritiesOf mechanism), observers

    interface instance Submittable for DummySubmittable where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata
