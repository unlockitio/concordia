module Cap.Core.Tests.Unit where

import DA.Assert ((===))
import DA.Date (Month (..), date)
import DA.Map (Map)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime, days, hours, time)
import Daml.Script

import Splice.Api.Token.MetadataV1

import Cap.Core.IdentityV1 (Identity (..))
import Cap.Core.AnyValue
import Cap.Core.Authorization
import Cap.Core.Identity
import Cap.Core.Optional
import Cap.Core.Time


t0 : Time
t0 = time (date 2026 Jan 1) 0 0 0

validActorsAcceptsACoveredGroup : Script ()
validActorsAcceptsACoveredGroup = do
  alice <- allocateParty "unit-admit-alice"
  bob <- allocateParty "unit-admit-bob"
  validActors "act" [[alice]] [alice] === []
  validActors "act" [[alice, bob]] [alice, bob] === []
  validActors "act" [[alice], [bob]] [bob] === []

validActorsRefusesAPartialGroup : Script ()
validActorsRefusesAPartialGroup = do
  alice <- allocateParty "unit-partial-alice"
  bob <- allocateParty "unit-partial-bob"
  validActors "act" [[alice, bob]] [alice] === ["the actors " <> show [alice] <> " are not entitled to act"]
  validActors "act" [[bob]] [alice] === ["the actors " <> show [alice] <> " are not entitled to act"]

validActorsIgnoresEmptyGroups : Script ()
validActorsIgnoresEmptyGroups = do
  alice <- allocateParty "unit-empty-alice"
  bob <- allocateParty "unit-empty-bob"
  null (validActors "act" [] [alice]) === False
  null (validActors "act" [[]] [alice]) === False
  validActors "act" [[], [bob]] [bob] === []

-- | A fixed acting-party mapping, for the tests below.
newtype ActingParties = ActingParties (Map Identity (Set.Set Party))

instance HasActingParties ActingParties where
  actingPartiesOf (ActingParties m) = m

actingPartiesForReadsTheMappingForEveryIdentity : Script ()
actingPartiesForReadsTheMappingForEveryIdentity = do
  alice <- allocateParty "unit-acting-alice"
  bob <- allocateParty "unit-acting-bob"
  carol <- allocateParty "unit-acting-carol"
  let mapping = ActingParties (Map.fromList
        [ (ExternalIdentity "org-a", Set.fromList [alice, bob])
        , (PartyIdentity carol, Set.singleton bob) ])
  actingPartiesFor mapping (ExternalIdentity "org-a") === Set.fromList [alice, bob]
  actingPartiesFor mapping (ExternalIdentity "org-b") === Set.empty
  -- a delegate acts for a party identity, and the party keeps acting for itself
  actingPartiesFor mapping (PartyIdentity carol) === Set.fromList [bob, carol]
  actingPartiesFor mapping (PartyIdentity alice) === Set.singleton alice

validActorsForRightsLooksUpTheRight : Script ()
validActorsForRightsLooksUpTheRight = do
  alice <- allocateParty "unit-entitled-alice"
  bob <- allocateParty "unit-entitled-bob"
  let actions = Map.fromList [("execute", [[alice]])]
  validActorsForRights actions "execute" [alice] === []
  validActorsForRights actions "execute" [bob] === ["the actors " <> show [bob] <> " are not entitled to \"execute\""]
  validActorsForRights actions "cancel" [alice] === ["the actors " <> show [alice] <> " are not entitled to \"cancel\""]

isOpenHasAnInclusiveFloorAndAnExclusiveCeiling : Script ()
isOpenHasAnInclusiveFloorAndAnExclusiveCeiling = do
  let t1 = addRelTime t0 (days 1)
  isOpen t0 t0 (Some t1) === True
  isOpen t1 t0 (Some t1) === False
  isOpen (addRelTime t0 (hours (-1))) t0 None === False
  isOpen t1 t0 None === True

singleNeedsExactlyOneElement : Script ()
singleNeedsExactlyOneElement = do
  singleOptional ([] : [Int]) === None
  singleOptional [1 : Int] === Some 1
  singleOptional [1, 2 : Int] === None

sameOptionalNeedsANonEmptyListOfEqualValues : Script ()
sameOptionalNeedsANonEmptyListOfEqualValues = do
  sameOptional ([] : [Int]) === None
  sameOptional [1, 1 : Int] === Some 1
  sameOptional [1, 2 : Int] === None

isAnyValueRoundTrips : Script ()
isAnyValueRoundTrips = do
  alice <- allocateParty "unit-values-alice"
  let texts = TextMap.fromList [("a", 1.0 : Decimal)]
  fromAnyValue (toAnyValue (3 : Int)) === Some (3 : Int)
  fromAnyValue (toAnyValue (1.5 : Decimal)) === Some (1.5 : Decimal)
  fromAnyValue (toAnyValue ("x" : Text)) === Some ("x" : Text)
  fromAnyValue (toAnyValue True) === Some True
  fromAnyValue (toAnyValue alice) === Some alice
  fromAnyValue (toAnyValue t0) === Some t0
  fromAnyValue (toAnyValue (days 2)) === Some (days 2)
  fromAnyValue (toAnyValue (date 2026 Jan 1)) === Some (date 2026 Jan 1)
  fromAnyValue (toAnyValue [1, 2 : Int]) === Some [1, 2 : Int]
  fromAnyValue (toAnyValue texts) === Some texts
  fromAnyValue (AV_Int 1) === Some (AV_Int 1)

isAnyValueRefusesAnotherKind : Script ()
isAnyValueRefusesAnotherKind = do
  (fromAnyValue (AV_Text "x") : Optional Int) === None
  (fromAnyValue (AV_Int 1) : Optional Text) === None
  (fromAnyValue (AV_List [AV_Int 1, AV_Text "x"]) : Optional [Int]) === None
  (fromAnyValue (AV_Map (TextMap.fromList [("a", AV_Text "x")])) : Optional (TextMap.TextMap Decimal)) === None
