import DA.Action (unless, when)
import DA.List (sort)
import DA.Optional (isSome)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import Daml.Script

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.HoldingV2 as Holding
import qualified Splice.Api.Token.AllocationInstructionV2 as AllocInstr
import qualified Splice.Api.Token.AllocationRequestV2 as AllocReq
import Splice.TokenStandard.Utils (basicAccount, senderSide)

import Splice.Testing.Utils
import qualified Splice.Testing.TokenStandard.RegistryApiV2 as RegistryApi

import Cap.Core.ResolverV1
import Cap.Core.SubmittableV1
import Cap.Auctions.Funding (OneLotBidAllocationRequest)
import Cap.Auctions.OneLotBidV1
import Cap.Auctions.Utils (oneLotSettlement)

import Cap.Auctions.SettlementV1

import Cap.Examples.SealedFirstPrice.Bid
import Cap.Examples.SealedFirstPrice.Settlement
import Cap.Examples.SealedFirstPrice.Lot
import Cap.Examples.SealedFirstPrice.Impostors.ImpostorSettlementFactory
import Cap.Examples.SealedFirstPrice.Impostors.ImpostorAllocation

import Cap.Examples.SealedFirstPrice.Demo.Fixture

data OpenAuction = OpenAuction with
    fixture : Fixture
    mechanism : Mechanism
    auctionCid : ContractId Auction
    seats : [(Party, ContractId AuctionBid)]
    disclosures : Disclosures'

invitedBidders : Fixture -> [Party]
invitedBidders f = [f.alice, f.bob, f.carol]

auctionMechanism : Set.Set Party -> Text -> Text -> ContractId Auction -> Mechanism
auctionMechanism authorities resolverId saleId auctionCid = Mechanism with
  resolver = ResolverKey with
    authorities
    id = resolverId
  resolverCid = Some (coerceContractId auctionCid)
  procedure = firstPriceProcedureName
  id = saleId

openAuction : Text -> Script OpenAuction
openAuction ns = openAuctionWith ns (\f -> pure f.terms)

openAuctionWith : Text -> (Fixture -> Script OneLotAuctionTerms) -> Script OpenAuction
openAuctionWith ns retermsFor = do
  base <- setupAs ns
  terms <- retermsFor base
  let fixture = base with terms
      f = fixture

  paymentD <- paymentCallFor f f.operator
  lotD <- lotCallFor f f.seller
  settleD <- settleDisclosures f
  let disclosures = paymentD <> lotD <> settleD

  lotHoldingCids <- fundSeller f
  now <- getTime
  let lotArg = AllocInstr.AllocationFactory_Allocate with
        settlement = oneLotSettlement f.saleId f.authorities
        allocation = sellerLotAllocation f.terms
        requestedAt = now
        inputHoldingCids = lotHoldingCids
        actors = [f.seller]
        extraArgs = emptyExtraArgs
  lotEc <- RegistryApi.getAllocationFactory f.lot lotArg
  lotResult <- submitWithDisclosures' f.seller lotEc.disclosures $
    exerciseCmd lotEc.factoryCid lotEc.arg
  AllocInstr.AllocationInstructionResult_Completed sellerLotAllocationCid <-
    pure lotResult.output
  let paymentArg = AllocInstr.AllocationFactory_Allocate with
        settlement = oneLotSettlement f.saleId f.authorities
        allocation = sellerPaymentAllocation f.terms
        requestedAt = now
        inputHoldingCids = []
        actors = [f.seller]
        extraArgs = emptyExtraArgs
  paymentEc <- RegistryApi.getAllocationFactory f.amulet paymentArg
  paymentResult <- submitWithDisclosures' f.seller paymentEc.disclosures $
    exerciseCmd paymentEc.factoryCid paymentEc.arg
  AllocInstr.AllocationInstructionResult_Completed sellerPaymentAllocationCid <-
    pure paymentResult.output

  proposalCid <- submit f.operator $ createCmd AuctionProposal with
    terms = f.terms
    authorities = f.authorities
    resolverId = f.resolverId
    saleId = f.saleId
    invited = invitedBidders f
  auctionCid <- submitWithDisclosures' f.seller disclosures $
    exerciseCmd proposalCid AuctionProposal_Accept with
      sellerLotAllocationCid
      sellerPaymentAllocationCid
  let mechanism = auctionMechanism f.authorities f.resolverId f.saleId auctionCid

  seats <- forA (invitedBidders f) $ \p -> do
    cid <- submit f.operator $ createCmd AuctionBid with
      terms = f.terms
      bidderPaymentAccount = basicAccount p
      bidderLotAccount = basicAccount p
      mechanism
      quotes = []
      allocations = []
    pure (p, cid)

  pure OpenAuction with
    fixture; mechanism; auctionCid; seats; disclosures

seatFor : OpenAuction -> Party -> Script (ContractId OneLotBid)
seatFor auction p = case lookup p auction.seats of
  Some cid -> pure (toInterfaceContractId @OneLotBid cid)
  None -> fail "that party was not invited"

requestFunding
  : OpenAuction -> Party -> Decimal -> Script (ContractId AllocReq.AllocationRequest)
requestFunding auction bidder price = do
  seatCid <- seatFor auction bidder
  result <- submit bidder $
    exerciseCmd seatCid OneLotBid_RequestAllocations with
      actors = [bidder]
      quotes = [[Quote with price; quantity = lotAmount]]
      extraArgs = emptyExtraArgs
  case result.requests of
    [cid] -> pure (coerceContractId cid)
    _ -> fail "this format mints a single allocation request"

fundedAmountsOf : AllocReq.AllocationRequestView -> [(Holding.InstrumentId, Decimal)]
fundedAmountsOf rv =
  [ ((Holding.InstrumentId with admin = spec.admin; id = instrumentId), amount)
  | spec <- rv.allocations
  , Some funding <- [spec.nextIterationFunding]
  , (instrumentId, amount) <- TextMap.toList funding
  , amount > 0.0
  ]

acceptsFrom : AllocReq.AllocationRequestView -> Party -> Bool
acceptsFrom rv party = case Map.lookup AllocReq.ARA_Accept rv.availableActions of
  Some groups -> any (elem party) groups
  None -> False

data AllocationCall = AllocationCall with
    factoryCid : ContractId AllocInstr.AllocationFactory
    settlement : Alloc.SettlementInfo
    allocation : Alloc.AllocationSpecification
    inputHoldingCids : [ContractId Holding.Holding]
    extraArgs : ExtraArgs
    disclosures : Disclosures'

allocationCallsFor
  : Fixture -> Party -> ContractId AllocReq.AllocationRequest -> Script [AllocationCall]
allocationCallsFor f bidder requestCid = do
  Some rv <- queryInterfaceContractId @AllocReq.AllocationRequest bidder requestCid
  unless (acceptsFrom rv bidder) $
    fail "the request does not offer this wallet an accept"
  now <- getTime
  forA rv.allocations $ \spec -> do
    let wanted =
          [ instrumentId
          | (instrumentId, _) <- fundedAmountsOf rv
          , instrumentId.admin == spec.admin
          ]
    inputHoldingCids <- concat <$> forA wanted (holdingCids bidder)
    (factoryCid, extraArgs, disclosures) <- askRegistryFor f bidder rv.settlement spec now
    pure AllocationCall with
      factoryCid; settlement = rv.settlement; allocation = spec
      inputHoldingCids; extraArgs; disclosures

askRegistryFor
  : Fixture -> Party -> Alloc.SettlementInfo -> Alloc.AllocationSpecification -> Time
  -> Script (ContractId AllocInstr.AllocationFactory, ExtraArgs, Disclosures')
askRegistryFor f bidder settlement spec now = do
  let arg = AllocInstr.AllocationFactory_Allocate with
        settlement
        allocation = spec
        requestedAt = now
        inputHoldingCids = []
        actors = [bidder]
        extraArgs = emptyExtraArgs
  if spec.admin == f.amulet.dso
    then do
      ec <- RegistryApi.getAllocationFactory f.amulet arg
      pure (ec.factoryCid, ec.arg.extraArgs, ec.disclosures)
    else do
      ec <- RegistryApi.getAllocationFactory f.lot arg
      pure (ec.factoryCid, ec.arg.extraArgs, ec.disclosures)


walletFundCmds
  : [AllocationCall] -> Party -> Time -> ContractId AllocReq.AllocationRequest
  -> Commands [AllocInstr.AllocationInstructionResult_Output]
walletFundCmds calls bidder now requestCid =
  forA calls allocateCmd <* acceptCmd
  where
    allocateCmd call =
      (.output) <$> exerciseCmd call.factoryCid AllocInstr.AllocationFactory_Allocate with
        settlement = call.settlement
        allocation = call.allocation
        requestedAt = now
        inputHoldingCids = call.inputHoldingCids
        extraArgs = call.extraArgs
        actors = [bidder]
    acceptCmd = exerciseCmd requestCid AllocReq.AllocationRequest_Accept with
      actors = [bidder]
      extraArgs = emptyExtraArgs

walletFunds
  : Fixture -> Party -> ContractId AllocReq.AllocationRequest
  -> Script [ContractId Alloc.Allocation]
walletFunds f bidder requestCid = do
  calls <- allocationCallsFor f bidder requestCid
  now <- getTime
  results <- submitWithDisclosures' bidder (mconcat (map (.disclosures) calls))
    (walletFundCmds calls bidder now requestCid)
  forA results $ \result -> case result of
    AllocInstr.AllocationInstructionResult_Completed cid -> pure cid
    _ -> fail "the registry did not complete the allocation in one step"

submitBidCmd
  : ContractId OneLotBid -> Party -> Decimal -> Decimal
  -> [ContractId Alloc.Allocation] -> Commands (ContractId OneLotBid)
submitBidCmd seatCid bidder price quantity allocations =
  exerciseCmd seatCid OneLotBid_Finalize with
    actors = [bidder]
    quotes = [[Quote with price; quantity]]
    allocations
    extraArgs = emptyExtraArgs

fundBid : OpenAuction -> Party -> Decimal -> Script (ContractId OneLotBid)
fundBid auction bidder price = do
  let f = auction.fixture
  _ <- fundBidder f bidder price
  requestCid <- requestFunding auction bidder price
  allocations <- walletFunds f bidder requestCid
  seatCid <- seatFor auction bidder
  submit bidder (submitBidCmd seatCid bidder price lotAmount allocations)

presentationOf : OpenAuction -> [ContractId OneLotBid] -> [ContractId Submittable]
presentationOf _ entries = map coerceContractId entries

resolveCmd : OpenAuction -> [ContractId OneLotBid] -> ExtraArgs -> Commands Resolver_ResolveResult
resolveCmd auction entries ctx =
  exerciseCmd (toInterfaceContractId @Resolver auction.auctionCid) Resolver_Resolve with
    actors = [auction.fixture.operator]
    mechanism = auction.mechanism
    submittables = presentationOf auction entries
    extraArgs = ctx

resolveDisclosures : OpenAuction -> Script Disclosures'
resolveDisclosures auction = do
  let f = auction.fixture
  allocs <- queryInterface @Alloc.Allocation f.operator
  allocD <- mconcat <$> forA [cid | (cid, Some _) <- allocs] (allocationDisclosures f)
  pure (auction.disclosures <> allocD)


resolveContext : OpenAuction -> Script ExtraArgs
resolveContext auction = do
  let f = auction.fixture
  allocs <- queryInterface @Alloc.Allocation f.operator
  ctxs <- forA [cid | (cid, Some _) <- allocs] (cancelContextFor f)
  pure ExtraArgs with
    context = ChoiceContext with
      values = mconcat (map (\c -> c.choiceContext.values) ctxs)
    meta = emptyMetadata

runResolve : OpenAuction -> [ContractId OneLotBid] -> Script Resolver_ResolveResult
runResolve auction entries = do
  ds <- resolveDisclosures auction
  ctx <- resolveContext auction
  submitWithDisclosures' auction.fixture.operator ds (resolveCmd auction entries ctx)

runResolveMustFail : OpenAuction -> [ContractId OneLotBid] -> Script ()
runResolveMustFail auction entries = do
  ds <- resolveDisclosures auction
  ctx <- resolveContext auction
  submitMustFail (actAs auction.fixture.operator <> discloseMany' ds)
    (resolveCmd auction entries ctx)

settlementOf' : Resolver_ResolveResult -> ContractId AuctionSettlement
settlementOf' result = case result.created of
  [cid] -> coerceContractId cid
  _ -> error "the resolve minted no single settlement"

runSettle : OpenAuction -> ContractId AuctionSettlement -> Script Settlement_SettleResult
runSettle auction settlementCid = do
  ds <- resolveDisclosures auction
  ctx <- settleContext auction.fixture
  submitWithDisclosures' auction.fixture.operator ds $
    exerciseCmd (toInterfaceContractId @Settlement settlementCid) Settlement_Settle with
      actors = [auction.fixture.operator]
      extraArgs = ctx

class Visible t where
  isVisibleTo : Party -> ContractId t -> Script Bool

instance Visible OneLotBid where
  isVisibleTo p cid = isSome <$> queryInterfaceContractId @OneLotBid p cid

instance Visible Auction where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible AuctionSettlement where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible AuctionBid where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible Alloc.Allocation where
  isVisibleTo p cid = isSome <$> queryInterfaceContractId @Alloc.Allocation p cid

instance Visible Holding.Holding where
  isVisibleTo p cid = isSome <$> queryInterfaceContractId @Holding.Holding p cid

sees : Visible t => Party -> ContractId t -> Script ()
sees p cid = do
  visible <- isVisibleTo p cid
  unless visible $
    fail (show p <> " should see " <> show cid <> " but does not")

cannotSee : Visible t => Party -> ContractId t -> Script ()
cannotSee p cid = do
  visible <- isVisibleTo p cid
  when visible $
    fail (show p <> " should not see " <> show cid <> " but does")

visibleTo : Party -> Script [Text]
visibleTo p = do
  proposals <- query @AuctionProposal p
  auctions <- query @Auction p
  bids <- query @AuctionBid p
  sales <- query @AuctionSettlement p
  requests <- query @OneLotBidAllocationRequest p
  holdings <- queryInterface @Holding.Holding p
  allocations <- queryInterface @Alloc.Allocation p
  pure $ sort $ concat
    [ map (show . fst) proposals
    , map (show . fst) auctions
    , map (show . fst) bids
    , map (show . fst) sales
    , map (show . fst) requests
    , map (show . fst) holdings
    , map (show . fst) allocations
    ]

lotAllocationOf : OpenAuction -> Script (ContractId Alloc.Allocation)
lotAllocationOf auction = do
  Some a <- queryContractId auction.fixture.seller auction.auctionCid
  pure a.sellerLotAllocationCid

bidAllocationOf : Fixture -> ContractId OneLotBid -> Script (ContractId Alloc.Allocation)
bidAllocationOf f bidCid = do
  Some bid <- queryContractId f.operator (fromInterfaceContractId @AuctionBid bidCid)
  case bid.allocations of
    paymentCid :: _ -> pure paymentCid
    [] -> fail "this seat holds no payment allocation"

impostorFactoryFor : Fixture -> Script (ContractId Alloc.SettlementFactory)
impostorFactoryFor f =
  toInterfaceContractId <$> submit f.operator (createCmd ImpostorSettlementFactory with
    operator = f.operator
    claimedAdmin = f.terms.lot.instrument.admin)


whoSeesWhat : Script ()
whoSeesWhat = do
  auction <- openAuction "sees"
  let f = auction.fixture

  f.alice `sees` auction.auctionCid
  f.bob `sees` auction.auctionCid
  f.carol `sees` auction.auctionCid
  f.seller `sees` auction.auctionCid
  f.dave `cannotSee` auction.auctionCid

  aliceSeat <- seatFor auction f.alice
  bobSeat <- seatFor auction f.bob
  carolSeat <- seatFor auction f.carol

  sellerBeforeBidding <- visibleTo f.seller

  setTime f.terms.entryClosesAt
  aliceBid <- fundBid auction f.alice 100.0
  bobBid <- fundBid auction f.bob 60.0
  aliceAllocation <- bidAllocationOf f aliceBid
  bobAllocation <- bidAllocationOf f bobBid

  sellerAfterBidding <- visibleTo f.seller
  sellerAfterBidding === sellerBeforeBidding

  f.alice `sees` aliceBid
  f.bob `cannotSee` aliceBid
  f.carol `cannotSee` aliceBid
  f.seller `cannotSee` aliceBid
  f.bob `cannotSee` aliceAllocation
  f.alice `cannotSee` bobAllocation
  f.seller `cannotSee` aliceAllocation

  setTime f.terms.biddingClosesAt
  result <- runResolve auction [aliceBid, bobBid, carolSeat]
  result.verdict === V_Decided None

  let settlementCid = settlementOf' result
  f.alice `sees` settlementCid
  f.bob `cannotSee` settlementCid
  f.carol `cannotSee` settlementCid

  _ <- runSettle auction settlementCid

  sellerPaid <- balanceOf f.seller f.terms.payment
  sellerPaid === 100.0
  aliceLot <- balanceOf f.alice f.terms.lot.instrument
  aliceLot === lotAmount
  alicePaid <- balanceOf f.alice f.terms.payment
  alicePaid === 0.0
  bobRefunded <- unlockedBalanceOf f.bob f.terms.payment
  bobRefunded === 60.0
  sellerLot <- balanceOf f.seller f.terms.lot.instrument
  sellerLot === 0.0

lotGoesToTheHighestPresentedBid : Script ()
lotGoesToTheHighestPresentedBid = do
  auction <- openAuction "highest"
  let f = auction.fixture

  carolSeat <- seatFor auction f.carol
  lotAllocationCid <- lotAllocationOf auction

  setTime f.terms.entryClosesAt
  aliceBid <- fundBid auction f.alice 100.0
  bobBid <- fundBid auction f.bob 60.0
  bobAllocation <- bidAllocationOf f bobBid

  lockedLot <- lockedBalanceOf f.seller f.terms.lot.instrument
  lockedLot === lotAmount

  setTime f.terms.biddingClosesAt
  result <- runResolve auction [aliceBid, bobBid, carolSeat]
  result.verdict === V_Decided None
  _ <- runSettle auction (settlementOf' result)

  alicePaid <- balanceOf f.alice f.terms.payment
  alicePaid === 0.0
  sellerPaid <- balanceOf f.seller f.terms.payment
  sellerPaid === 100.0
  aliceLot <- balanceOf f.alice f.terms.lot.instrument
  aliceLot === lotAmount

  f.bob `cannotSee` bobAllocation
  bobLocked <- lockedBalanceOf f.bob f.terms.payment
  bobLocked === 0.0
  bobReturned <- unlockedBalanceOf f.bob f.terms.payment
  bobReturned === 60.0
  bobLot <- balanceOf f.bob f.terms.lot.instrument
  bobLot === 0.0

  f.seller `cannotSee` lotAllocationCid
  f.operator `cannotSee` auction.auctionCid
  runResolveMustFail auction [bobBid, carolSeat]




settlementRunsThroughTheFactoriesTheTermsName : Script ()
settlementRunsThroughTheFactoriesTheTermsName = do
  -- terms naming the real lot settlement factory
  honest <- openAuction "registry"
  let hf = honest.fixture
  impostorCid <- impostorFactoryFor hf

  claimedAdmin <- submit hf.operator $
    exerciseCmd impostorCid Alloc.SettlementFactory_PublicFetch with actors = [hf.operator]
  claimedAdmin.admin === hf.terms.lot.instrument.admin
  assertMsg "the impostor is not the factory the terms name"
    (impostorCid /= hf.terms.lotSettleFactory)

  bobSeat <- seatFor honest hf.bob
  carolSeat <- seatFor honest hf.carol
  setTime hf.terms.entryClosesAt
  aliceBid <- fundBid honest hf.alice 100.0
  setTime hf.terms.biddingClosesAt

  honestResult <- runResolve honest [aliceBid, bobSeat, carolSeat]
  honestResult.verdict === V_Decided None
  _ <- runSettle honest (settlementOf' honestResult)
  honestSellerPaid <- balanceOf hf.seller hf.terms.payment
  honestSellerPaid === 100.0
  honestWinnerLot <- balanceOf hf.alice hf.terms.lot.instrument
  honestWinnerLot === lotAmount

  -- the same auction on terms naming the impostor
  hostile <- openAuctionWith "hostile" $ \f -> do
    cid <- impostorFactoryFor f
    pure f.terms with
      lotSettleFactory = cid
  let xf = hostile.fixture

  xBobSeat <- seatFor hostile xf.bob
  xCarolSeat <- seatFor hostile xf.carol
  setTime xf.terms.entryClosesAt
  xBid <- fundBid hostile xf.alice 100.0
  [(hostileFactoryCid, _)] <- query @ImpostorSettlementFactory xf.operator
  [(_, hostileAuction)] <- query @Auction xf.seller
  hostileAuction.terms.lotSettleFactory
    === toInterfaceContractId @Alloc.SettlementFactory hostileFactoryCid
  [(_, signedBid)] <- query @AuctionBid xf.alice
  signedBid.terms.lotSettleFactory
    === toInterfaceContractId @Alloc.SettlementFactory hostileFactoryCid

  setTime xf.terms.biddingClosesAt
  xResult <- runResolve hostile [xBid, xBobSeat, xCarolSeat]
  xResult.verdict === V_Decided None

  _ <- runSettle hostile (settlementOf' xResult)

  xSellerPaid <- balanceOf xf.seller xf.terms.payment
  xSellerPaid === 100.0
  xWinnerLot <- balanceOf xf.alice xf.terms.lot.instrument
  xWinnerLot === 0.0

aBidderCannotBlockTheSale : Script ()
aBidderCannotBlockTheSale = do
  auction <- openAuction "block"
  let f = auction.fixture
  carolSeat <- seatFor auction f.carol
  setTime f.terms.entryClosesAt
  aliceBid <- fundBid auction f.alice 100.0
  bobBid <- fundBid auction f.bob 60.0
  aliceAllocation <- bidAllocationOf f aliceBid
  bobAllocation <- bidAllocationOf f bobBid
  setTime f.terms.biddingClosesAt

  aliceCtx <- cancelContextFor f aliceAllocation
  bobCtx <- cancelContextFor f bobAllocation

  -- a bid cannot be archived alone: the auction authorities are signatories
  submitMustFail f.alice $
    archiveCmd (fromInterfaceContractId @AuctionBid aliceBid)
  submitMustFail f.bob $
    archiveCmd (fromInterfaceContractId @AuctionBid bobBid)

  -- the seat offers no withdraw action, so no one is entitled to it
  submitMustFailContaining "the actors are entitled to withdraw" (actAs f.alice) $
    exerciseCmd aliceBid OneLotBid_Withdraw with
      actors = [f.alice]
      extraArgs = emptyExtraArgs
  submitMustFailContaining "the actors are entitled to withdraw" (actAs f.bob) $
    exerciseCmd bobBid OneLotBid_Withdraw with
      actors = [f.bob]
      extraArgs = emptyExtraArgs

  -- the bid has not reached expiresAt, so it cannot be expired
  submitMustFailContaining "the bid has expired" (actAs f.alice) $
    exerciseCmd aliceBid OneLotBid_Expire with
      actors = [f.alice]
      extraArgs = emptyExtraArgs
  submitMustFailContaining "the bid has expired" (actAs f.bob) $
    exerciseCmd bobBid OneLotBid_Expire with
      actors = [f.bob]
      extraArgs = emptyExtraArgs

  -- only the settlement executors may cancel the allocation, not the bidder
  submitMustFailContaining
    "'actors' does not have the same elements as one of 'allowed actors'."
    (actAs f.alice <> discloseMany' aliceCtx.disclosures)
    (exerciseCmd aliceAllocation Alloc.Allocation_Cancel with
      actors = [f.alice]
      extraArgs = ExtraArgs with context = aliceCtx.choiceContext; meta = emptyMetadata)
  submitMustFailContaining
    "'actors' does not have the same elements as one of 'allowed actors'."
    (actAs f.bob <> discloseMany' bobCtx.disclosures)
    (exerciseCmd bobAllocation Alloc.Allocation_Cancel with
      actors = [f.bob]
      extraArgs = ExtraArgs with context = bobCtx.choiceContext; meta = emptyMetadata)


  -- the allocation is committed and before its deadline, so it cannot be withdrawn
  submitMustFailContaining
    "Cannot withdraw a committed allocation before its settlement deadline"
    (actAs f.alice <> discloseMany' aliceCtx.disclosures)
    (exerciseCmd aliceAllocation Alloc.Allocation_Withdraw with
      actors = [f.alice]
      extraArgs = ExtraArgs with context = aliceCtx.choiceContext; meta = emptyMetadata)
  submitMustFailContaining
    "Cannot withdraw a committed allocation before its settlement deadline"
    (actAs f.bob <> discloseMany' bobCtx.disclosures)
    (exerciseCmd bobAllocation Alloc.Allocation_Withdraw with
      actors = [f.bob]
      extraArgs = ExtraArgs with context = bobCtx.choiceContext; meta = emptyMetadata)

  result <- runResolve auction [aliceBid, bobBid, carolSeat]
  result.verdict === V_Decided None
  let settlementCid = settlementOf' result

  bobRefunded <- unlockedBalanceOf f.bob f.terms.payment
  bobRefunded === 60.0
  f.bob `cannotSee` bobAllocation

  awardCtx <- cancelContextFor f aliceAllocation
  -- after the award the winner still cannot cancel its allocation: only the executors may
  submitMustFailContaining
    "'actors' does not have the same elements as one of 'allowed actors'."
    (actAs f.alice <> discloseMany' awardCtx.disclosures)
    (exerciseCmd aliceAllocation Alloc.Allocation_Cancel with
      actors = [f.alice]
      extraArgs = ExtraArgs with context = awardCtx.choiceContext; meta = emptyMetadata)
  -- nor withdraw it: still committed, still before the deadline
  submitMustFailContaining
    "Cannot withdraw a committed allocation before its settlement deadline"
    (actAs f.alice <> discloseMany' awardCtx.disclosures)
    (exerciseCmd aliceAllocation Alloc.Allocation_Withdraw with
      actors = [f.alice]
      extraArgs = ExtraArgs with context = awardCtx.choiceContext; meta = emptyMetadata)

  -- the settlement cannot be archived alone: the authorities and seller sign it
  submitMustFail f.alice $ archiveCmd settlementCid
  -- the winner is not entitled to cancel the settlement
  submitMustFailContaining "the actors are entitled to cancel" (actAs f.alice) $
    exerciseCmd (toInterfaceContractId @Settlement settlementCid) Settlement_Cancel with
      actors = [f.alice]
      extraArgs = emptyExtraArgs
  -- the settlement has not expired, so it cannot be expired
  submitMustFailContaining "the settlement has expired" (actAs f.alice) $
    exerciseCmd (toInterfaceContractId @Settlement settlementCid) Settlement_Expire with
      actor = f.alice

  _ <- runSettle auction settlementCid
  sellerPaid <- balanceOf f.seller f.terms.payment
  sellerPaid === 100.0
  aliceLot <- balanceOf f.alice f.terms.lot.instrument
  aliceLot === lotAmount



settlementRejectsAnImpostorAllocation : Script ()
settlementRejectsAnImpostorAllocation = do
  f <- setupAs "impostor"
  now <- getTime

  let leg = Alloc.TransferLeg with
        transferLegId = "payment"
        sender = basicAccount f.alice
        receiver = basicAccount f.seller
        amount = 100.0
        instrumentId = f.terms.payment.id
        meta = emptyMetadata
      settlement = Alloc.SettlementInfo with
        executors = [f.operator]
        id = f.saleId
        cid = None
        meta = emptyMetadata

  -- signed by Alice, but its view claims that admin
  impostorAllocationCid <- fmap toInterfaceContractId $ submit f.alice $
    createCmd ImpostorAllocation with
      owner = f.alice
      settlement
      allocation = Alloc.AllocationSpecification with
        admin = f.terms.payment.admin
        authorizer = basicAccount f.alice
        transferLegSides = [senderSide leg]
        settlementDeadline = Some f.terms.expiresAt
        nextIterationFunding = None
        committed = True
        meta = emptyMetadata
      createdAt = now

  let batch = SettlementBatch with
        legs = [leg]
        allocations =
          [ Alloc.FinalizedAllocation with
              allocationCid = impostorAllocationCid
              extraTransferLegSides = []
              nextIterationFunding = None ]
        factoryCid = f.terms.paymentSettleFactory

  settlementCid <- submit (actAs f.operator <> actAs f.seller) $
    createCmd AuctionSettlement with
      terms = f.terms
      authorities = f.authorities
      saleId = f.saleId
      winner = f.alice
      batches = [batch]
      opensAt = now

  submitMustFailContaining "the allocation is signed by the admin it names"
    (actAs f.operator) $
    exerciseCmd (toInterfaceContractId @Settlement settlementCid) Settlement_Settle with
      actors = [f.operator]
      extraArgs = emptyExtraArgs
