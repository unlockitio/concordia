module Cap.Examples.SealedFirstPrice.Lot where

import DA.Foldable (forA_)
import DA.List (sort, unique)
import qualified DA.List.Total as Total
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc

import Splice.Util (require)
import Splice.TokenStandard.Utils (receiverSide, senderSide)

import Cap.Core.Types (AuthenticKey (..), Mechanism (..))
import Cap.Core.Utils (requireClosed, requireMechanism)
import Cap.Auctions.OneLotBidV1
import Cap.Auctions.SettlementV1 (SettlementBatch (..))
import Cap.Auctions.Utils
  ( lotLeg, paymentLeg, sellerOf, bidderOf, oneLotSettlement
  , fundingOneInstrumentAllocation, receivingAllocation )

import Cap.Examples.SealedFirstPrice.Bid
import Cap.Examples.SealedFirstPrice.Settlement

firstPriceProcedureName : Text
firstPriceProcedureName = ""

data AuctionResult = AuctionResult
  with
    settlementCid : Optional (ContractId AuctionSettlement)
  deriving (Eq, Show)

template Auction
  with
    terms : OneLotAuctionTerms
    authorities : Set.Set Party
    resolverId : Text
    invited : [Party]
    sellerLotAllocationCid : ContractId Alloc.Allocation
    sellerPaymentAllocationCid : ContractId Alloc.Allocation
  where
    signatory Set.toList authorities <> [sellerOf terms]
    observer invited

    choice Auction_Resolve : AuctionResult
      with
        mechanism : Mechanism
        bidCids : [ContractId OneLotBid]
        extraArgs : ExtraArgs
      controller Set.toList authorities
      do
        requireMechanism (AuthenticKey with authorities; id = resolverId) (coerceContractId self)
          firstPriceProcedureName mechanism
        resolveFirstPrice this mechanism bidCids extraArgs

resolveFirstPrice
  : Auction
  -> Mechanism
  -> [ContractId OneLotBid]
  -> ExtraArgs
  -> Update AuctionResult
resolveFirstPrice auction mechanism bidCids resolveArgs = do
  let terms = auction.terms
  now <- getTime
  requireClosed "the bidding window is closed" now terms.biddingClosesAt

  -- check participation
  require "a resolution presents at least one bid" (not (null bidCids))
  require "the presented bids are distinct" (unique bidCids)
  let saleId = mechanism.id
  seats <- forA bidCids $ \cid -> do
    b <- fetch cid
    let bv = view b
    require "every presented bid belongs to this sale" (bv.mechanism == mechanism)
    require "every presented seat was opened on the seller's terms"
      (bv.terms == terms)
    require "every presented bid is signed by the bidder it names"
      (null bv.quotes || bidderOf bv `elem` signatory b)
    pure (cid, bv)

  require "every invited bidder is presented"
    (sort [bidderOf bv | (_, bv) <- seats] == sort auction.invited)

  -- compute outcome
  let quoted = [(cid, bv, q) | (cid, bv) <- seats, [[q]] <- [bv.quotes]]
      winning = Total.maximumOn (\(_, _, q) -> q.price) quoted
      awardedCid = fmap (\(cid, _, _) -> cid) winning

  settlementCid <- case winning of
    None -> pure None
    Some (winnerCid, winner, award) -> do
      require "the award meets the seller's reserve"
        (meetsReserve terms.direction terms.reserve award.price)
      (winnerPaymentAllocationCid, winnerLotAllocationCid) <-
        case winner.allocations of
          [paymentCid, lotCid] -> pure (paymentCid, lotCid)
          _ -> abort "the winning seat holds no pair of allocations"
      let pLeg = paymentLeg winner award.price
          lLeg = lotLeg winner award.quantity
          finalized cid side = Alloc.FinalizedAllocation with
            allocationCid = cid
            extraTransferLegSides = [side]
            nextIterationFunding = None
      settlementCid <- create AuctionSettlement with
        terms
        authorities = auction.authorities
        saleId
        winner = bidderOf winner
        opensAt = now
        batches =
          [ SettlementBatch with
              legs = [pLeg]
              allocations =
                [ finalized winnerPaymentAllocationCid (senderSide pLeg)
                , finalized auction.sellerPaymentAllocationCid (receiverSide pLeg)
                ]
              factoryCid = terms.paymentSettleFactory
          , SettlementBatch with
              legs = [lLeg]
              allocations =
                [ finalized auction.sellerLotAllocationCid (senderSide lLeg)
                , finalized winnerLotAllocationCid (receiverSide lLeg)
                ]
              factoryCid = terms.lotSettleFactory
          ]
      exercise (fromInterfaceContractId @AuctionBid winnerCid) AuctionBid_Close
      pure (Some settlementCid)

  -- release the rest
  forA_ [cid | (cid, _) <- seats, Some cid /= awardedCid] $ \cid ->
    exercise cid OneLotBid_Release with
      actors = Set.toList auction.authorities
      extraArgs = resolveArgs

  pure AuctionResult with settlementCid

template AuctionProposal
  with
    terms : OneLotAuctionTerms
    authorities : Set.Set Party
    resolverId : Text
    saleId : Text
    invited : [Party]
  where
    signatory Set.toList authorities
    observer sellerOf terms

    ensure terms.direction == Forward
      && not (null invited)
      && unique invited
      && notElem (sellerOf terms) invited

    choice AuctionProposal_Accept : ContractId Auction
      with
        sellerLotAllocationCid : ContractId Alloc.Allocation
        sellerPaymentAllocationCid : ContractId Alloc.Allocation
      controller sellerOf terms
      do
        now <- getTime
        require "the lot is locked before the entry window closes"
          (now < terms.entryClosesAt)
        lotAlloc <- fetch sellerLotAllocationCid
        let lotView = view lotAlloc
        require "the lot allocation is the one these terms imply"
          (lotView.allocation == sellerLotAllocation terms)
        require "the lot allocation is scoped to this auction"
          (lotView.settlement == oneLotSettlement saleId authorities)
        require "the lot allocation is signed by its instrument admin"
          (lotView.allocation.admin `elem` signatory lotAlloc)
        paymentAlloc <- fetch sellerPaymentAllocationCid
        let paymentView = view paymentAlloc
        require "the payment allocation is the one these terms imply"
          (paymentView.allocation == sellerPaymentAllocation terms)
        require "the payment allocation is scoped to this auction"
          (paymentView.settlement == oneLotSettlement saleId authorities)
        require "the payment allocation is signed by its instrument admin"
          (paymentView.allocation.admin `elem` signatory paymentAlloc)
        create Auction with
          terms; authorities; resolverId; invited
          sellerLotAllocationCid; sellerPaymentAllocationCid


sellerLotAllocation : OneLotAuctionTerms -> Alloc.AllocationSpecification
sellerLotAllocation terms =
  fundingOneInstrumentAllocation terms.lot.instrument terms.sellerLotAccount terms.expiresAt terms.lot.amount

sellerPaymentAllocation : OneLotAuctionTerms -> Alloc.AllocationSpecification
sellerPaymentAllocation terms =
  receivingAllocation terms.payment terms.sellerPaymentAccount terms.expiresAt
