module Cap.Examples.SealedFirstPrice.LotV1 where

import DA.Foldable (forA_)
import DA.List (sort, unique)
import qualified DA.List.Total as Total
import qualified DA.Map as Map
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc

import Splice.Util (require)
import Splice.TokenStandard.Utils (receiverSide, senderSide)

import Cap.Core.Utils (orAbort, requireClosed)
import Cap.Core.ResolverV1
import Cap.Core.SubmittableV1
import Cap.Auctions.OneLotBidV1
import Cap.Auctions.SettlementV1 (SettlementBatch (..))
import Cap.Auctions.Utils (lotLeg, paymentLeg)

import Cap.Examples.SealedFirstPrice.BidV1
import Cap.Examples.SealedFirstPrice.SettlementV1
import Cap.Examples.SealedFirstPrice.TermsV1

firstPriceProcedureName : Text
firstPriceProcedureName = ""

template AuctionLot
  with
    terms : OneLotAuctionTerms
    invited : [Party]
    sellerLotAllocationCid : ContractId Alloc.Allocation
    sellerPaymentAllocationCid : ContractId Alloc.Allocation
  where
    signatory Set.toList terms.authorities <> [sellerOf terms]
    observer invited

    interface instance Resolver for AuctionLot where
      view = ResolverView with
        authorities = terms.authorities
        id = terms.saleId
        expiresAt = Some terms.expiresAt
        meta = emptyMetadata

      procedures = Map.fromList
        [(firstPriceProcedureName, firstPrice this)]

firstPrice : AuctionLot -> Procedure
firstPrice lot = Procedure with
  resolvers = [Set.toList lot.terms.authorities]
  resolve = resolveFirstPrice lot

resolveFirstPrice
  : AuctionLot
  -> ContractId Resolver
  -> [(ContractId Submittable, Submittable)]
  -> ExtraArgs
  -> Update Resolver_ResolveResult
resolveFirstPrice lot self cast _ = do
  let terms = lot.terms
  now <- getTime
  requireClosed "the bidding window is closed" now terms.biddingClosesAt

  -- check participation 
  seats <- forA cast $ \(cid, s) -> do
    b <- orAbort "only seats are presented to this procedure" (fromInterface @OneLotBid s)
    let bv = view b
    require "every presented seat was opened on the seller's terms"
      (bv.terms == terms)
    require "every presented bid is signed by the bidder it names"
      (null bv.quotes || bidderOf bv.bidderPaymentAccount `elem` signatory s)
    pure (coerceContractId cid : ContractId OneLotBid, bv)

  require "every invited bidder is presented"
    (sort [bidderOf bv.bidderPaymentAccount | (_, bv) <- seats] == sort lot.invited)

  -- compute outcome
  let quoted = [(cid, bv, q) | (cid, bv) <- seats, [q] <- [bv.quotes]]
      winning = Total.maximumOn (\(_, _, q) -> q.price) quoted
      awardedCid = fmap (\(cid, _, _) -> cid) winning

  (verdict, created) <- case winning of
    None -> pure (V_Lapsed None, [])
    Some (winnerCid, winner, award) -> do
      require "the award meets the seller's reserve"
        (meetsReserve terms.direction terms.reserve award.price)
      winnerPaymentAllocationCid <-
        orAbort "the winning seat holds no payment allocation" winner.paymentAllocation
      winnerLotAllocationCid <-
        orAbort "the winning seat holds no lot allocation" winner.lotAllocation
      let pLeg = paymentLeg terms winner.bidderPaymentAccount award.price
          lLeg = lotLeg terms winner.bidderLotAccount award.quantity
          finalized cid side = Alloc.FinalizedAllocation with
            allocationCid = cid
            extraTransferLegSides = [side]
            nextIterationFunding = None
      settlementCid <- create AuctionSettlement with
        terms
        winner = bidderOf winner.bidderPaymentAccount
        opensAt = now
        batches =
          [ SettlementBatch with
              leg = pLeg
              sender = finalized winnerPaymentAllocationCid (senderSide pLeg)
              receiver = finalized lot.sellerPaymentAllocationCid (receiverSide pLeg)
              factory = terms.registries.paymentSettle
          , SettlementBatch with
              leg = lLeg
              sender = finalized lot.sellerLotAllocationCid (senderSide lLeg)
              receiver = finalized winnerLotAllocationCid (receiverSide lLeg)
              factory = terms.registries.lotSettle
          ]
      exercise (fromInterfaceContractId @AuctionBid winnerCid) AuctionBid_Close
      pure (V_Accepted None, [coerceContractId settlementCid])

  -- release the rest
  forA_ [cid | (cid, _) <- seats, Some cid /= awardedCid] $ \cid ->
    exercise cid OneLotBid_Release with
      actors = Set.toList terms.authorities
      extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

  archive self
  pure Resolver_ResolveResult with
    verdict
    created
    meta = emptyMetadata

template AuctionLotProposal
  with
    terms : OneLotAuctionTerms
    invited : [Party]
  where
    signatory Set.toList terms.authorities
    observer sellerOf terms

    ensure terms.direction == Forward
      && not (null invited)
      && unique invited
      && notElem (sellerOf terms) invited

    choice AuctionLotProposal_Accept : ContractId AuctionLot
      with
        sellerLotAllocationCid : ContractId Alloc.Allocation
        sellerPaymentAllocationCid : ContractId Alloc.Allocation
      controller sellerOf terms
      do
        now <- getTime
        require "the lot is locked before the entry window closes"
          (now < terms.entryClosesAt)
        lotView <- view <$> fetch sellerLotAllocationCid
        require "the lot allocation is the one these terms imply"
          (lotView.allocation == sellerLotAllocation terms)
        require "the lot allocation is scoped to this auction"
          (lotView.settlement == settlementOf terms)
        paymentView <- view <$> fetch sellerPaymentAllocationCid
        require "the payment allocation is the one these terms imply"
          (paymentView.allocation == sellerPaymentAllocation terms)
        require "the payment allocation is scoped to this auction"
          (paymentView.settlement == settlementOf terms)
        create AuctionLot with
          terms; invited; sellerLotAllocationCid; sellerPaymentAllocationCid
