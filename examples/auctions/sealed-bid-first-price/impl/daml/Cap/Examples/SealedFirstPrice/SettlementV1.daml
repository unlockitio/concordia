module Cap.Examples.SealedFirstPrice.SettlementV1 where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1

import Cap.Core.Utils (ExecutionCore (..))
import Cap.Auctions.OneLotBidV1 (OneLotAuctionTerms)
import Cap.Auctions.SettlementV1

import Cap.Examples.SealedFirstPrice.TermsV1

template AuctionSettlement
  with
    terms : OneLotAuctionTerms
    winner : Party
    batches : [SettlementBatch]
    opensAt : Time
  where
    signatory Set.toList terms.authorities <> [sellerOf terms]
    observer winner

    ensure not (null batches)

    interface instance Settlement for AuctionSettlement where
      view = SettlementView with
        core = ExecutionCore with
          authorities = terms.authorities
          executors = [Set.toList terms.authorities]
          opensAt
          expiresAt = Some terms.expiresAt
          meta = emptyMetadata
        settlement = settlementOf terms
        batches
        meta = emptyMetadata

      settlement_cancelImpl _ =
        abort "this auction cannot be cancelled"
