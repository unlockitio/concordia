module Cap.Examples.FirstPrice.ResolverV1 where

import DA.Foldable (forA_)
import DA.List (maximumOn, sort, unique)
import qualified DA.Map as Map
import DA.Optional (isSome, mapOptional)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1

import Splice.Util (require)

import Cap.Core.Utils (requireClosed)
import Cap.Core.ResolverV1
import Cap.Core.SubmittableV1
import Cap.Auctions.OneLotBidV1

import Cap.Examples.FirstPrice.LotV1

firstPriceProcedureName : Text
firstPriceProcedureName = ""

template AuctionResolver
  with
    operator : Party
    auctionId : Text
    invited : [Party]
  where
    signatory operator
    observer invited

    ensure not (null invited)
        && unique invited
        && not (operator `elem` invited)

    interface instance Resolver for AuctionResolver where
      view = ResolverView with
        authorities = Set.fromList [operator]
        submittablesIssuers = [[operator]]
        id = auctionId
        expiresAt = None
        meta = emptyMetadata

      procedures = Map.fromList
        [(firstPriceProcedureName, firstPrice operator invited)]

firstPrice : Party -> [Party] -> Procedure
firstPrice operator invited = Procedure with
  resolvers = [[operator]]
  resolve = resolveFirstPrice operator invited

resolveAfterSubmission : [Submittable] -> Time -> Update ()
resolveAfterSubmission ss now =
  forA_ ss $ \s ->
    requireClosed "every presented submittable is closed for submission"
      now (view s).closesAt

resolveFirstPrice
  : Party
  -> [Party]
  -> ContractId Resolver
  -> [(ContractId Submittable, Submittable)]
  -> ExtraArgs
  -> Update Resolver_ResolveResult
resolveFirstPrice operator invited self cast extraArgs = do
  now <- getTime
  resolveAfterSubmission (map snd cast) now
  let seats = mapOptional seatEntry cast

  result <- case mapOptional quoteEntry cast of
    [] -> do
      releaseTheRest operator [] cast
      pure Resolver_ResolveResult with
        verdict = V_Lapsed None
        created = []
        meta = emptyMetadata

    quoted -> do
      let (winnerCid, award) = maximumOn (\(_, q) -> q.price) quoted
      (lotCid, lot) <- orAbort "no lot authorization was presented"
        (find isLot cast)
      lv <- fetch (coerceContractId lotCid : ContractId AuctionLot)
      require "the resolver's audience is not the lot's invited bidders"
        (sort lv.invited == sort invited)
      awardResult <- exercise (coerceContractId lotCid : ContractId AuctionLot)
        AuctionLot_Award with
        winnerCid
        presented = seats
        awarded = [award]
        extraArgs

      releaseTheRest operator
        [lotCid, coerceContractId winnerCid] cast
      pure Resolver_ResolveResult with
        verdict = V_Accepted None
        created = awardResult.created
        meta = emptyMetadata

  archive self
  pure result

seatEntry : (ContractId Submittable, Submittable) -> Optional (ContractId OneLotBid)
seatEntry (cid, s) =
  const (coerceContractId cid) <$> fromInterface @OneLotBid s

quoteEntry : (ContractId Submittable, Submittable) -> Optional (ContractId OneLotBid, Quote)
quoteEntry (cid, s) = do
  b <- fromInterface @OneLotBid s
  case (view b).quotes of
    [q] -> Some (coerceContractId cid, q)
    _ -> None

isLot : (ContractId Submittable, Submittable) -> Bool
isLot (_, s) = isSome (fromInterface @AuctionLot s)

releaseTheRest
  : Party -> [ContractId Submittable]
  -> [(ContractId Submittable, Submittable)] -> Update ()
releaseTheRest operator alreadyReleased cast =
  forA_ [ cid | (cid, s) <- cast
              , not (cid `elem` alreadyReleased)
              , isSome (fromInterface @OneLotBid s) ] $ \cid ->
    exercise (coerceContractId cid : ContractId OneLotBid) OneLotBid_Release with
      actors = [operator]
      extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
