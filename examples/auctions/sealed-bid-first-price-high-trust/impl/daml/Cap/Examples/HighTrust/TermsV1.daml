module Cap.Examples.HighTrust.TermsV1 where

import qualified DA.Set as Set
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.HoldingV2 as Holding

import Splice.TokenStandard.Utils (regularAccountOwner)

import Cap.Auctions.OneLotBidV1 (OneLotAuctionTerms, OneLotBidView, Quote)
import Cap.Auctions.Utils (saleSettlement)

sellerOf : OneLotAuctionTerms -> Party
sellerOf terms = regularAccountOwner terms.sellerLotAccount


settlementOf : Text -> Set.Set Party -> OneLotAuctionTerms -> [Party] -> Alloc.SettlementInfo
settlementOf saleId authorities terms extras =
  saleSettlement saleId (Set.toList authorities <> (sellerOf terms :: extras))


preLotSettlementOf : Text -> Set.Set Party -> OneLotAuctionTerms -> Alloc.SettlementInfo
preLotSettlementOf saleId authorities terms =
  (settlementOf saleId authorities terms []) with id = saleId <> "/pre-lot"


sellerLotAllocation : OneLotAuctionTerms -> Alloc.AllocationSpecification
sellerLotAllocation terms = Alloc.AllocationSpecification with
  admin = terms.lot.instrument.admin
  authorizer = terms.sellerLotAccount
  transferLegSides = []
  settlementDeadline = Some terms.expiresAt
  nextIterationFunding = funding terms.lot.instrument.id terms.lot.amount
  committed = True
  meta = emptyMetadata

bidderPaymentAllocation : OneLotBidView -> [Quote] -> Alloc.AllocationSpecification
bidderPaymentAllocation bv quotes = Alloc.AllocationSpecification with
  admin = bv.terms.payment.admin
  authorizer = bv.bidderPaymentAccount
  transferLegSides = []
  settlementDeadline = Some bv.terms.expiresAt
  nextIterationFunding = funding bv.terms.payment.id (foldl max 0.0 (map (.price) quotes))
  committed = True
  meta = emptyMetadata

receiverAllocation
  : Party -> Holding.Account -> Time -> [Alloc.TransferLegSide] -> Alloc.AllocationSpecification
receiverAllocation admin receiver deadline sides = Alloc.AllocationSpecification with
  admin
  authorizer = receiver
  transferLegSides = sides
  settlementDeadline = Some deadline
  nextIterationFunding = None
  committed = True
  meta = emptyMetadata


funding : Text -> Decimal -> Optional (TextMap.TextMap Decimal)
funding instrumentId amount = Some (TextMap.fromList [(instrumentId, amount)])
