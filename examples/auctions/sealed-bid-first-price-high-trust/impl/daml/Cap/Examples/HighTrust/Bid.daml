module Cap.Examples.HighTrust.Bid where

import qualified DA.Map as Map
import DA.Optional (optionalToList)
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.AllocationInstructionV2 as AllocInstr
import qualified Splice.Api.Token.HoldingV2 as Holding

import Splice.Util (require)
import Splice.TokenStandard.Utils
  ( nonIteratedAllocation
  , receiverSide
  , regularAccountOwner
  , regularAccountParties
  , senderSide
  , textMapValues
  )

import Cap.Core.Utils (orAbort, requireOpen, single)
import Cap.Core.SubmittableV1
import Cap.Auctions.OneLotBidV1
import Cap.Auctions.Registry (AllocationFactoryCall)
import Cap.Auctions.SettlementV1 (SettlementBatch (..))
import Cap.Auctions.Utils
  ( lotLeg
  , paymentLeg
  )

import Cap.Examples.HighTrust.Settlement
import Cap.Examples.HighTrust.Terms



template AuctionInvitation
  with
    terms : OneLotAuctionTerms
    bidderPaymentAccount : Holding.Account
    bidderLotAccount : Holding.Account
    mechanism : Mechanism
  where
    signatory Set.toList (authoritiesOf mechanism) <> [sellerOf terms]
    observer bidderOf bidderPaymentAccount

    ensure terms.direction == Forward

    choice AuctionInvitation_Accept : ContractId AuctionBid
      controller bidderOf bidderPaymentAccount
      do
        now <- getTime
        require "the seat is taken before the seating window closes"
          (now < terms.entryClosesAt)
        create AuctionBid with
          terms; bidderPaymentAccount; bidderLotAccount; mechanism
          quotes = []
          paymentAllocation = None

template AuctionBid
  with
    terms : OneLotAuctionTerms
    bidderPaymentAccount : Holding.Account
    bidderLotAccount : Holding.Account
    mechanism : Mechanism
    quotes : [Quote]
    paymentAllocation : Optional (ContractId Alloc.Allocation)
  where
    signatory Set.toList (authoritiesOf mechanism) <> [bidderOf bidderPaymentAccount]

    ensure terms.direction == Forward
      && case (quotes, paymentAllocation) of
        ([], None) -> True
        ([q], Some _) -> q.quantity == 1.0
        _ -> False

    choice AuctionBid_Restamp : ContractId AuctionBid
      with
        newMechanism : Mechanism
      controller Set.toList (authoritiesOf mechanism)
      do
        now <- getTime
        require "a seat is restamped before bidding opens"
          (now < terms.entryClosesAt)
        create this with mechanism = newMechanism

    choice AuctionBid_Award : [AnyContractId]
      with
        awarded : [Quote]
        lotAllocation : ContractId Alloc.Allocation
        extraArgs : ExtraArgs
      controller Set.toList (authoritiesOf mechanism) <> [sellerOf terms]
      do
        now <- getTime
        requireOpen "the bidding window is closed and the terms have not expired"
          now terms.biddingClosesAt (Some terms.expiresAt)
        requireQuotes "an award" terms.lot awarded
        require "the award is within what this bid quoted at that price"
          (awardWithinQuotes terms.direction [quotes | not (null quotes)] awarded)
        require "the award meets the reserve"
          (all (\a -> meetsReserve terms.direction terms.reserve a.price) awarded)
        award <- orAbort "this format awards a single quote" (single awarded)

        paymentFactory <- exercise terms.registries.paymentAllocate.factoryCid
          AllocInstr.AllocationFactory_PublicFetch with
            actors = regularAccountParties bidderPaymentAccount
        require "the payment allocation factory is administered by the payment admin"
          (paymentFactory.admin == terms.payment.admin)
        lotFactory <- exercise terms.registries.lotAllocate.factoryCid
          AllocInstr.AllocationFactory_PublicFetch with
            actors = regularAccountParties terms.sellerLotAccount
        require "the lot allocation factory is administered by the lot admin"
          (lotFactory.admin == terms.lot.instrument.admin)

        sellerLotView <- view <$> fetch lotAllocation
        require "the lot allocation matches the auction terms"
          (sellerLotView.allocation == sellerLotAllocation terms)

        bidderPaymentCid <- orAbort "this seat holds no committed payment allocation"
          paymentAllocation

        let settlement = settlementOf mechanism.id (authoritiesOf mechanism) terms
                           [bidderOf bidderPaymentAccount]
            pLeg = paymentLeg terms bidderPaymentAccount award.price
            lLeg = lotLeg terms bidderLotAccount award.quantity

        lotAllocationCid <- reallocate
          terms.registries.lotAllocate
          lotAllocation
          sellerLotView
          settlement
          [senderSide lLeg]
          None

        bidderPaymentView <- view <$> fetch bidderPaymentCid
        paymentAllocationCid <- reallocate
          terms.registries.paymentAllocate
          bidderPaymentCid
          bidderPaymentView
          settlement
          [senderSide pLeg]
          None
      
        sellerPaymentCid <- allocateOneStep
          terms.registries.paymentAllocate
          settlement
          (receiverAllocation terms.payment.admin terms.sellerPaymentAccount
            terms.expiresAt [receiverSide pLeg])
          []

        winnerLotCid <- allocateOneStep
          terms.registries.lotAllocate
          settlement
          (receiverAllocation terms.lot.instrument.admin bidderLotAccount
            terms.expiresAt [receiverSide lLeg])
          []

        now <- getTime

        settlementCid <- create AuctionSettlement with
          terms
          authorities = authoritiesOf mechanism
          saleId = mechanism.id
          winner = bidderOf bidderPaymentAccount
          opensAt = now
          batches =
            [ SettlementBatch with
                legs = [pLeg]
                allocations = map nonIteratedAllocation
                  [paymentAllocationCid, sellerPaymentCid]
                factory = terms.registries.paymentSettle
            , SettlementBatch with
                legs = [lLeg]
                allocations = map nonIteratedAllocation
                  [lotAllocationCid, winnerLotCid]
                factory = terms.registries.lotSettle
            ]

        pure [coerceContractId settlementCid]

    interface instance Submittable for AuctionBid where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata

    interface instance OneLotBid for AuctionBid where
      view = OneLotBidView with
        terms
        availableActions = Map.fromList $
          (if null quotes
             then (BA_Finalize, [[bidderOf bidderPaymentAccount]])
             else (BA_Custom "award", [Set.toList (authoritiesOf mechanism) <> [sellerOf terms]]))
          :: [(BA_Release, [Set.toList (authoritiesOf mechanism)])]
        bidderPaymentAccount
        bidderLotAccount
        quotes = [quotes | not (null quotes)]
        allocations = optionalToList paymentAllocation
        meta = emptyMetadata

      oneLotBid_requestAllocationsImpl _ _ =
        abort "this format does not publish allocation requests"

      oneLotBid_finalizeImpl self arg = do
        require "this seat holds no bid yet" (null quotes)
        submitted <-
          orAbort "this format takes a single alternative" (single arg.quotes)
        paymentCid <- orAbort "a bid names the allocation it pays from"
          (single arg.allocations)
        let bv = view (toInterface @OneLotBid this)
        paymentView <- view <$> fetch paymentCid
        require "the payment allocation is the one this bid implies"
          (paymentView.allocation == bidderPaymentAllocation bv submitted)
        archive self
        toInterfaceContractId <$>
          create this with
            quotes = submitted
            paymentAllocation = Some paymentCid

      oneLotBid_withdrawImpl _ _ =
        abort "a bid cannot be withdrawn after seeing the field quotes"

      oneLotBid_releaseImpl self _ = do
        archive self
        released <- forA (optionalToList paymentAllocation) $ \cid -> do
          paymentView <- view <$> fetch cid
          _ <- exercise cid Alloc.Allocation_Cancel with
            actors = paymentView.settlement.executors
            extraArgs = terms.registries.paymentAllocate.cancelArgs
          pure cid
        pure OneLotBid_ReleaseResult with released; meta = emptyMetadata

      oneLotBid_expireImpl self _ = do
        archive self
        pure OneLotBid_ExpireResult with meta = emptyMetadata

bidderOf : Holding.Account -> Party
bidderOf = regularAccountOwner

authoritiesOf : Mechanism -> Set.Set Party
authoritiesOf mechanism = mechanism.resolver.authorities

allocateOneStep
  : AllocationFactoryCall
  -> Alloc.SettlementInfo
  -> Alloc.AllocationSpecification
  -> [ContractId Holding.Holding]
  -> Update (ContractId Alloc.Allocation)
allocateOneStep factory settlement allocation inputHoldingCids = do
  now <- getTime
  result <- exercise factory.factoryCid AllocInstr.AllocationFactory_Allocate with
    settlement
    allocation
    requestedAt = now
    inputHoldingCids
    extraArgs = factory.allocateArgs
    actors = regularAccountParties allocation.authorizer
  case result.output of
    AllocInstr.AllocationInstructionResult_Completed cid -> pure cid
    AllocInstr.AllocationInstructionResult_Pending _ ->
      abort "the registry returned a pending allocation instruction; this format needs a one-step allocation"
    AllocInstr.AllocationInstructionResult_Failed ->
      abort "the registry failed to create the allocation"

reallocate
  : AllocationFactoryCall
  -> ContractId Alloc.Allocation
  -> Alloc.AllocationView
  -> Alloc.SettlementInfo
  -> [Alloc.TransferLegSide]
  -> Optional (TextMap.TextMap Decimal)
  -> Update (ContractId Alloc.Allocation)
reallocate
  factory allocationCid current settlement transferLegSides nextIterationFunding = do
    let allocation = current.allocation with
          transferLegSides = transferLegSides
          nextIterationFunding = nextIterationFunding
    result <- exercise allocationCid Alloc.Allocation_Cancel with
      actors = current.settlement.executors
      extraArgs = factory.cancelArgs
    let released = concat (textMapValues result.authorizerHoldingCids)
    if null released
      then abort "the cancelled allocation released no holdings to reallocate"
      else allocateOneStep factory settlement allocation released
