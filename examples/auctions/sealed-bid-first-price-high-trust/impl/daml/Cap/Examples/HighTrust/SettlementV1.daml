module Cap.Examples.HighTrust.SettlementV1 where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1

import qualified DA.Map as Map

import Cap.Core.Utils (ExecutionAction (..), ExecutionCore (..))
import Cap.Auctions.OneLotBidV1 (OneLotAuctionTerms)
import Cap.Auctions.SettlementV1

import Cap.Examples.HighTrust.TermsV1 (sellerOf, settlementOf)

template AuctionSettlement
  with
    terms : OneLotAuctionTerms
    winner : Party
    batches : [SettlementBatch]
    opensAt : Time
  where
    signatory Set.toList terms.authorities <> [sellerOf terms, winner]

    ensure not (null batches)

    interface instance Settlement for AuctionSettlement where
      view = SettlementView with
        core = ExecutionCore with
          authorities = Set.insert (sellerOf terms) (Set.insert winner terms.authorities)
          availableActions = Map.fromList [(EA_Execute, [Set.toList terms.authorities])]
          opensAt
          expiresAt = Some terms.expiresAt
          meta = emptyMetadata
        settlement = settlementOf terms [winner]
        batches
        meta = emptyMetadata

      settlement_cancelImpl _ =
        abort "this auction cannot be cancelled"
