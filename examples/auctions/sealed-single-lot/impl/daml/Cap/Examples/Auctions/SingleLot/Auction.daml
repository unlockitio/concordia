module Cap.Examples.Auctions.SingleLot.Auction where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (isSome)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.Api.Token.HoldingV2 (Account (..))

import Splice.Util (HasCheckedFetch (..))

import Cap.Core.AuthenticKeyV1 (AuthenticKey (..))
import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Core.Checks (Ignored, requireMet)
import Cap.Core.Resolution (fetchGroup)
import Cap.Core.Time (validClosed)
import Cap.Auctions.Types (AuctionSchedule (..), AuctionTerms, Funding (..))
import Cap.Auctions.Bid (Bid, Bid_Close (..))
import Cap.Auctions.Funding (SettleBatchContext, cancelAllocations, ignoreConflictingBids, settlementOf)
import Cap.Auctions.SingleLot
  ( PricingMechanism, clearAndSettleSingleLotFromEmptyLegsAllocations, expectSingleLot, nativePricingMechanisms )

import Cap.Examples.Auctions.SingleLot.Bid (SingleLotBid)



supportedMechanisms : [PricingMechanism]
supportedMechanisms = nativePricingMechanisms

accountSigner : Account -> Optional Party
accountSigner account = case account.owner of
  Some owner -> Some owner
  None -> account.provider

principalSigners : Map Party Funding -> [Party]
principalSigners principalFundings =
  dedup [signer | funding <- Map.values principalFundings, Some signer <- [accountSigner funding.account]]

data SingleLotAuction_ResolveResult = SingleLotAuction_ResolveResult
  with
    settled : [Alloc.SettlementFactory_SettleBatchResult]
    cancelled : [Alloc.AllocationResult]
    ignoredBids : Ignored SingleLotBid
  deriving (Eq, Show)

template SingleLotAuction
  with
    authorities : Set Party
    resolverId : Text
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    principalFundings : Map Party Funding
  where
    signatory Set.toList authorities, principalSigners principalFundings

    ensure
      not (Map.null principalFundings)
        && all (\funding -> isSome (accountSigner funding.account)) (Map.values principalFundings)

    choice SingleLotAuction_Resolve : SingleLotAuction_ResolveResult
      with
        bidCids : [ContractId SingleLotBid]
        settleBatchContexts : Map Party SettleBatchContext
        cancelContexts : Map (ContractId Alloc.Allocation) ExtraArgs
        extraArgs : ExtraArgs
      controller Set.toList authorities
      do
        now <- getTime
        requireMet (validClosed "the bidding window" schedule.biddingClosesAt now)
        singleLotTerms <- expectSingleLot terms
        presented <- fetchGroup this self [] [] resolutionInfo bidCids
        (keptBids, ignoredBids) <- ignoreConflictingBids principalFundings presented
        let settlement = settlementOf resolutionInfo terms.allocationTerms.executors
        result <- clearAndSettleSingleLotFromEmptyLegsAllocations
          supportedMechanisms resolutionInfo settlement singleLotTerms principalFundings keptBids
          settleBatchContexts
        cancelled <- cancelAllocations settlement cancelContexts result.unsettled
        forA_ (map fst keptBids <> map fst ignoredBids) $ \cid ->
          exercise (toInterfaceContractId @Bid cid) Bid_Close with
            actors = Set.toList authorities
            extraArgs
        pure SingleLotAuction_ResolveResult with
          settled = result.settled
          cancelled
          ignoredBids


-- | The key resolutions name this auction by: its authorities, without the
-- principal's signers, and its resolver id.
instance HasCheckedFetch SingleLotAuction AuthenticKey where
  contractGroupId auction = AuthenticKey with
    authorities = auction.authorities
    id = auction.resolverId
