module Cap.Examples.Auctions.DutchSingleLot.Auction where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (isSome)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.AllocationV2 as Alloc
import Splice.Api.Token.HoldingV2 (Account (..))
import Splice.Util (require)

import Cap.Core.Types (AuthenticKey (..), ResolutionInfo)
import Cap.Core.Utils (Ignored, requireResolvedBy)
import Cap.Auctions.Types (AuctionSchedule (..), AuctionTerms, Funding (..), HasSingleLotQuotes (..))
import Cap.Auctions.Bid (Bid, Bid_Close (..))
import Cap.Auctions.Funding (SettleBatchContext, cancelAllocations, fetchAndIgnoreConflictingBids, settlementOf)
import Cap.Auctions.SingleLot
  ( PricingMechanism, clearAndSettleSingleLotFromEmptyLegsAllocations, expectSingleLot
  , payAsBidMechanism, uniformPriceMechanism
  )

import Cap.Examples.Auctions.DutchSingleLot.Bid (DutchBid)
import Cap.Auctions.Clock (PriceClock)


supportedMechanisms : [PricingMechanism]
supportedMechanisms = [payAsBidMechanism, uniformPriceMechanism]

accountSigner : Account -> Optional Party
accountSigner account = case account.owner of
  Some owner -> Some owner
  None -> account.provider

principalSigners : Map Party Funding -> [Party]
principalSigners principalFundings =
  dedup [signer | funding <- Map.values principalFundings, Some signer <- [accountSigner funding.account]]

data DutchAuction_ResolveResult = DutchAuction_ResolveResult
  with
    settled : [Alloc.SettlementFactory_SettleBatchResult]
    cancelled : [Alloc.AllocationResult]
    ignoredBids : Ignored DutchBid
  deriving (Eq, Show)

template DutchAuction
  with
    authorities : Set Party
    resolverId : Text
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    clock : PriceClock
    principalFundings : Map Party Funding
  where
    signatory Set.toList authorities, principalSigners principalFundings

    ensure
      not (Map.null principalFundings)
        && all (\funding -> isSome (accountSigner funding.account)) (Map.values principalFundings)

    choice DutchAuction_Resolve : DutchAuction_ResolveResult
      with
        bidCids : [ContractId DutchBid]
        settleBatchContexts : Map Party SettleBatchContext
        cancelContexts : Map (ContractId Alloc.Allocation) ExtraArgs
        extraArgs : ExtraArgs
      controller Set.toList authorities
      do
        requireResolvedBy (AuthenticKey with authorities; id = resolverId) (coerceContractId self) resolutionInfo
        singleLotTerms <- expectSingleLot terms
        (keptBids, ignoredBids) <- fetchAndIgnoreConflictingBids principalFundings bidCids
        now <- getTime
        let claimed = sum [quote.amount | (_, bid) <- keptBids, quote <- singleLotQuotes bid]
        require "the bidding window is closed or the claims cover the supply"
          (now >= schedule.biddingClosesAt || claimed >= singleLotTerms.lotTerms.supply)
        result <- clearAndSettleSingleLotFromEmptyLegsAllocations
          supportedMechanisms resolutionInfo singleLotTerms principalFundings keptBids
          settleBatchContexts
        cancelled <- cancelAllocations (settlementOf resolutionInfo) cancelContexts result.unsettled
        forA_ (map fst keptBids <> map fst ignoredBids) $ \cid ->
          exercise (toInterfaceContractId @Bid cid) Bid_Close with
            actors = Set.toList authorities
            extraArgs
        pure DutchAuction_ResolveResult with
          settled = result.settled
          cancelled
          ignoredBids
