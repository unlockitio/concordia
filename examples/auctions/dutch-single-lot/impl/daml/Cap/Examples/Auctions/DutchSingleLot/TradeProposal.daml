module Cap.Examples.Auctions.DutchSingleLot.TradeProposal where

import qualified DA.Map as Map
import DA.Optional (isSome)
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Core.Authorization (validActorsForRights)
import Cap.Core.Checks (requireMet)
import Cap.Core.Time (validBefore, validExpired)
import Cap.Auctions.Types (AuctionSchedule, AuctionTerms (..))
import Cap.Auctions.TradeProposal
import Cap.Auctions.Funding (requireValidPrincipalFunding, settlementOf)
import Cap.Auctions.Terms (validAuctionSchedule, validAuctionTerms)
import Cap.Auctions.SingleLot (pricingMechanismOf)

import Cap.Examples.Auctions.DutchSingleLot.Auction (DutchAuction (..), accountSigner, supportedMechanisms)
import Cap.Auctions.Clock (PriceClock, clockMeta, validDutchClockDeadline, validDutchClock)


template DutchTradeProposal
  with
    authorities : Set Party
    resolverId : Text
    principal : Party
    resolutionInfo : ResolutionInfo
    terms : AuctionTerms
    schedule : AuctionSchedule
    clock : PriceClock
    acceptBefore : Time
  where
    signatory Set.toList authorities
    observer principal

    ensure
      isSome (pricingMechanismOf supportedMechanisms resolutionInfo)
        && null (validAuctionTerms terms <> validAuctionSchedule schedule)
        && case Map.values terms.lots of
             [lotTerms] ->
               null (validDutchClock terms.direction lotTerms.reservePrice clock)
                 && null (validDutchClockDeadline terms.direction lotTerms.reservePrice clock
                           schedule.biddingOpensAt schedule.biddingClosesAt)
             _ -> False

    interface instance TradeProposal for DutchTradeProposal where
      view = TradeProposalView with
        resolutionInfo; terms; schedule; acceptBefore
        availableActions = Map.fromList
          [ (SPA_Accept, [[principal]])
          , (SPA_Reject, [[principal]])
          , (SPA_Withdraw, [Set.toList authorities])
          ]
        meta = clockMeta clock

      tradeProposal_acceptImpl _ arg = do
        let v = (view (toInterface @TradeProposal this))
        now <- getTime
        requireMet (validActorsForRights v.availableActions SPA_Accept arg.actors
          <> validBefore "the acceptance deadline" v.acceptBefore now
          <> validAuctionTerms v.terms <> validAuctionSchedule v.schedule)
        require "every principal account is the principal's"
          (all (\funding -> accountSigner funding.account == Some principal) (Map.values arg.fundings))
        requireValidPrincipalFunding (settlementOf resolutionInfo terms.allocationTerms.executors) terms schedule arg.fundings
        auctionCid <- create DutchAuction with
          authorities; resolverId; resolutionInfo; terms; schedule; clock
          principalFundings = arg.fundings
        pure TradeProposal_AcceptResult with
          trade = coerceContractId auctionCid
          meta = emptyMetadata

      tradeProposal_rejectImpl _ arg = do
        requireMet (validActorsForRights (view (toInterface @TradeProposal this)).availableActions SPA_Reject arg.actors)
        pure TradeProposal_RejectResult with meta = emptyMetadata

      tradeProposal_withdrawImpl _ arg = do
        requireMet (validActorsForRights (view (toInterface @TradeProposal this)).availableActions SPA_Withdraw arg.actors)
        pure TradeProposal_WithdrawResult with meta = emptyMetadata

      tradeProposal_expireImpl _ _ = do
        now <- getTime
        requireMet (validExpired "the proposal" (Some (view (toInterface @TradeProposal this)).acceptBefore) now)
        pure TradeProposal_ExpireResult with meta = emptyMetadata
