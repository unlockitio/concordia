-- =============================================================================
-- OffboardAndCompensate — a governance action the base package has never seen:
-- offboard an SV and pay them from the reserve, atomically. Two
-- committed targets — more than the base `GovOutcome` can even express.
-- =============================================================================
module Cap.BabyDso.Extension.OffboardAndCompensate where

import Prelude hiding (Action)

import qualified DA.Map as Map
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Cap.Core.CheckedFetchV1 (require)
import Cap.Core.MechanismV1 (Mechanism)
import Cap.Core.OutcomeV1
import Cap.Governance.ActionV1
import Cap.Governance.ActionUtil (isolatedTargetsExecute, editTarget)
import Cap.Governance.OutcomeV1
import Cap.Governance.TargetV1 (TargetRef)
import Cap.Governance.TargetUtil (driftAborts, noDrift)

import Cap.BabyDso.CapVersion.AmuletRules (AmuletRules (..), amuletRulesKey)
import Cap.BabyDso.CapVersion.DsoRules (DsoRules (..), dsoRulesKey)

-- | The action: proposer-signed, opaque to the funnel that carries it.
template OffboardAndCompensate
  with
    dso      : Party
    org      : Text
    proposer : Party
    member   : Party    -- the SV to offboard
    amount   : Decimal  -- amount drawn from the reserve
  where
    signatory proposer
    observer dso

    interface instance Action for OffboardAndCompensate where
      view = ActionView with
        -- rules is identity-only; reserve records the state token (payout is non-idempotent).
        targets = Map.fromList
          [ (dsoRulesKey dso org, False)
          , (amuletRulesKey dso, True) ]
        meta = emptyMetadata

      action_issueOutcomeImpl selfCid arg = do
        archive (fromInterfaceContractId @OffboardAndCompensate selfCid)
        cid <- create OffboardAndCompensateOutcome with
          dso; org; member; amount
          source = arg.source
          commitments = arg.committedTargets
          executeAfter = arg.executeAfter
          executeUntil = arg.executeUntil
        pure Action_IssueOutcomeResult with
          outcomeCids = [toInterfaceContractId @GovernanceOutcome cid]
          meta = emptyMetadata

-- | The approved action, carrying its own drift policy and effect.
template OffboardAndCompensateOutcome
  with
    dso          : Party
    org          : Text
    member       : Party
    amount       : Decimal
    source       : ContractId Mechanism
    commitments  : [TargetRef]
    executeAfter : Time
    executeUntil : Optional Time
  where
    signatory dso

    interface instance Outcome for OffboardAndCompensateOutcome where
      view = OutcomeView with
        authorities = Set.singleton dso
        source; executeAfter; executeUntil
        meta = emptyMetadata

      isExecutor _ = True

    interface instance GovernanceOutcome for OffboardAndCompensateOutcome where
      view = GovernanceOutcomeView with committedTargets = commitments

      -- One effect per committed target, matched by key: rules (identity-only),
      -- reserve (records the state token — any drift refuses).
      governanceOutcome_executeImpl ctxs _ = isolatedTargetsExecute
        (Map.fromList
          [ ( dsoRulesKey dso org
            , ( noDrift
              , editTarget @DsoRules $ \r -> do
                  require "There is more than one sv" (Map.size r.svs > 1)
                  case Map.lookup member r.svs of
                    None -> fail "Not a sv"
                    Some name -> pure r with
                      svs = Map.delete member r.svs
                      offboardedSvs = Map.insert member name r.offboardedSvs ) )
          , ( amuletRulesKey dso
            , ( driftAborts
              , editTarget @AmuletRules $ \r -> do
                  require "Reserve covers the amount" (r.reserve >= amount)
                  pure r with reserve = r.reserve - amount ) )
          ])
        ctxs
