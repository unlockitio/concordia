-- =============================================================================
-- VoteRequest — Splice's deliberate-governance workflow as a CONTAINER BALLOT:
-- ONE authority-signed contract accumulating every SV's vote against the
-- standing `DsoMechanism`, recreated on each cast. It is the decision's whole
-- record — a `Submittable` and a `Ballot` — resolved by the mechanism's vote
-- `Resolution` (which reads the window and electorate off it).
-- =============================================================================
module Cap.BabyDso.CapVersion.VoteRequest where

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (AnyValue (..), emptyMetadata)
import Cap.Core.CheckedFetchV1 (require)
import Cap.Core.MechanismV1 (Mechanism)
import Cap.Core.SubmittableV1
import Cap.Governance.ActionUtil (TypedAction)
import Cap.Governance.BallotV1
import Cap.Governance.TargetV1 (TargetRef)
import Cap.Governance.TargetUtil (fetchTargetFromContext)

import Cap.BabyDso.CapVersion.Common (svListKey)
import Cap.BabyDso.CapVersion.DsoRules (DsoRules, GovAction, dsoRulesKey)

-- | Decode the opaque `Ballot_Cast.vote`: a binary vote rides `AV_Bool`.
decodeVote : AnyValue -> Update Bool
decodeVote (AV_Bool b) = pure b
decodeVote _ = fail "vote is not a boolean"

-- | Tally decoder over the container: a cast request yields its whole vote map,
-- an uncast one `[]`. Pairs with `Cap.Governance.Tallies.quorateMajorityAll`.
decodeVotes : Submittable -> [Bool]
decodeVotes s
  | (view s).state /= S_Full = []
  | Some vr <- fromInterface @VoteRequest s = Map.values vr.votes
  | otherwise = []

template VoteRequest
  with
    dso                : Party
    org                : Text
    proposer           : Party
    mechanism          : ContractId Mechanism  -- the standing DsoMechanism this decision resolves through
    action             : TypedAction GovAction
    commitments        : [TargetRef]  -- target keys + optional recorded state tokens, in binding order; voters approve them with the action
    snapshot           : Set Party    -- the electorate at creation; quorum denominator
    votes              : Map Party Bool
    nonce              : Text          -- unique per vote; the decision's identity on the standing governor
    submissionOpensAt  : Time
    submissionClosesAt : Time          -- Splice's voteBefore
    executeAfter       : Time          -- timelock; MUST be >= submissionClosesAt
    executeUntil       : Time          -- deadline fixed onto the issued outcome
    expiresAt          : Time
  where
    signatory dso
    observer snapshot
    ensure submissionClosesAt > submissionOpensAt
        && executeAfter >= submissionClosesAt
        && executeUntil > executeAfter
        && expiresAt > submissionClosesAt

    interface instance Submittable for VoteRequest where
      view = SubmittableView with
        mechanism
        authorities = Set.singleton dso
        slot = None                    -- quorate, not exact-cover
        state = if Map.null votes then S_Empty else S_Full
        meta = emptyMetadata

    interface instance Ballot for VoteRequest where
      view = BallotView with
        governor = mechanism
        voters = snapshot               -- closed: only snapshot members cast
        expiresAt

      -- Splice's cast-time actor validation: admit the LIVE SV list from the
      -- context and refuse a caster no longer on it. The snapshot still rules
      -- the tally, so an earlier cast keeps counting.
      ballot_castImpl arg = do
        v <- decodeVote arg.vote
        rules <- fetchTargetFromContext @DsoRules (dsoRulesKey dso org) svListKey arg.extraArgs.context
        require "Caster is a sv" (arg.voter `Map.member` rules.svs)
        cid <- create this with votes = Map.insert arg.voter v votes
        pure (toInterfaceContractId @Ballot cid)

      ballot_withdrawImpl arg = do
        cid <- create this with votes = Map.delete arg.voter votes
        pure (toInterfaceContractId @Ballot cid)

      ballot_consumeImpl _ = pure (Ballot_ConsumeResult with meta = emptyMetadata)
