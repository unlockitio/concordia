-- =============================================================================
-- GovOutcome — an approved native `GovAction`, implemented as a
-- cap-governance `GovernanceOutcome` (which `requires` cap-core `Outcome`).
-- =============================================================================
module Cap.BabyDso.CapVersion.GovOutcome where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Cap.Core.MechanismV1 (Mechanism)
import Cap.Core.OutcomeV1
import Cap.Governance.ActionUtil
import Cap.Governance.OutcomeV1
import Cap.Governance.TargetV1 (TargetRef)

import Cap.BabyDso.CapVersion.DsoRules

template GovOutcome
  with
    dso          : Party
    org          : Text
    source       : ContractId Mechanism   -- the mechanism whose resolution issued this
    action       : GovAction              -- the approved native payload
    commitments  : [TargetRef]     -- the targets and state tokens the approvers bound, in binding order
    executeAfter : Time                   -- the timelock, fixed from the governor
    executeUntil : Time                   -- mandatory deadline: no undated outcome
  where
    signatory dso

    interface instance Outcome for GovOutcome where
      view = OutcomeView with
        authorities = Set.singleton dso
        source
        executeAfter
        executeUntil = Some executeUntil
        meta = emptyMetadata

      -- Broad executor set for liveness: execution acts with the dso signature
      -- regardless of who triggers it, and every effect is fixed and
      -- window-guarded, so who fires it cannot affect safety.
      isExecutor _ = True

    -- The spec-driven shell: drift routing and execution both delegate to the
    -- payload's `govActionSpec`.
    interface instance GovernanceOutcome for GovOutcome where
      view = GovernanceOutcomeView with committedTargets = commitments

      governanceOutcome_executeImpl ctxs _ = nativeActionExecute (govActionSpec (DsoCtx dso org) action) ctxs

-- | The implementer for native data actions: the per-target spec, and minting
-- the impl's own `GovOutcome` (an extension mints its own via `Action_IssueOutcome`).
instance NativeAction DsoCtx GovAction where
  actionSpec = govActionSpec
  issueNativeOutcome ctx a arg = do
    executeUntil <- case arg.executeUntil of
      Some u -> pure u
      None -> fail "GovOutcome requires an execution deadline"
    cid <- create GovOutcome with
      dso = ctx.dso; org = ctx.org; source = arg.source; action = a
      commitments = arg.committedTargets; executeAfter = arg.executeAfter; executeUntil
    pure [toInterfaceContractId @GovernanceOutcome cid]
