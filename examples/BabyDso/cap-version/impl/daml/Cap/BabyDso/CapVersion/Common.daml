module Cap.BabyDso.CapVersion.Common where

import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..))
import Cap.Governance.TargetV1 (Target)

-- | Context key under which the live target(s) to act on reach the
-- atomic resolution — Splice's `amuletRulesCid` analogue.
targetsKey : Text
targetsKey = "cap.final.targets"

-- | Context key under which a caster delivers the live `DsoRules` for the
-- SV list (and cooldown) check in `ballot_castImpl`.
svListKey : Text
svListKey = "cap.final.svList"

-- | Context key naming the live `DsoRules` a standing resolution admits its
-- claims against.
rulesKey : Text
rulesKey = "cap.final.dsoRules"

-- | Context key carrying the electorate claim (`AV_List` of `AV_Party`) the
-- confirmation tally counts against; read from the live `DsoRules` the executor presents.
svsKey : Text
svsKey = "cap.final.svs"

-- | Context key naming the `OpenMiningRound` a round advance rolls.
roundKey : Text
roundKey = "cap.final.round"

-- | Splice's supermajority threshold
requiredNumVotes : Int -> Int
requiredNumVotes numSvs = ceiling (intToDecimal (numSvs + f + 1) / 2.0)
  where f = floor (intToDecimal (numSvs - 1) / 3.0)

-- | Read the targets the close choice put in the choice context (under
-- `targetsKey`). Aborts if absent or malformed; the close choice is trusted to
-- name the committed target(s).
readTargets : ChoiceContext -> Update [ContractId Target]
readTargets ctx = case TextMap.lookup targetsKey ctx.values of
  Some (AV_List avs) -> forA avs decodeCid
  _ -> abort "resolve: extraArgs.context lacks the target list"
  where
    decodeCid (AV_ContractId cid) = pure (coerceContractId cid)
    decodeCid _ = abort "resolve: a target entry is not a contract id"

-- | Read one contract id stored under `key`.
readCid : Text -> ChoiceContext -> Update (ContractId t)
readCid key ctx = case TextMap.lookup key ctx.values of
  Some (AV_ContractId cid) -> pure (coerceContractId cid)
  _ -> abort ("resolve: extraArgs.context lacks a contract id under " <> key)

-- | The electorate claim under `svsKey`, pure — the confirmation tally's
-- denominator. Meaningful because the executor read it from the live `DsoRules`.
readSvsClaim : ChoiceContext -> [Party]
readSvsClaim ctx = case TextMap.lookup svsKey ctx.values of
  Some (AV_List avs) -> [p | AV_Party p <- avs]
  _ -> []
