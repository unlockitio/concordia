-- =============================================================================
-- DsoMechanism — the standing mechanism, and the single contract that holds
-- every choice the SVs exercise to make a decision. It is itself a PERSISTENT
-- `Governor` (`standing = True`): the confirmation-threshold, the price-median,
-- and the deliberate-vote workflows are three decisions with different tallies,
-- all resolved through the same fixed `Governor_Resolve`. The vote presents its
-- `VoteRequest` container as the one submittable, keyed by its nonce.
-- =============================================================================
module Cap.BabyDso.CapVersion.DsoMechanism where

import DA.Foldable (forA_)
import DA.List (sort)
import DA.Optional (fromOptional, mapOptional)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.Text
import qualified DA.TextMap as TextMap
import DA.Time (RelTime, addRelTime)

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyMetadata)
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), require, fetchReferenceData)
import Cap.Core.MechanismV1
import Cap.Core.SubmittableV1
import Cap.Core.Policies (noWithdraw)
import Cap.Governance.ActionV1 (Action_IssueOutcome (..), AnyAction (..))
import Cap.Governance.ActionUtil (TypedAction, anyActionBuildRefs, anyActionIssueOutcome, spendAndExecute)
import Cap.Governance.TargetV1 (Target)
import Cap.Governance.TargetUtil (fetchTargetFromContext)
import Cap.Governance.BallotV1 (Ballot, Ballot_Consume (..))
import Cap.Governance.GovernorV1
import Cap.Governance.Tallies (median, quorateMajorityAll)

import Cap.BabyDso.CapVersion.Common
import Cap.BabyDso.CapVersion.DsoRules (DsoRules, DsoCtx (..), GovAction, encodeGovDecision, dsoRulesKey)
import Cap.BabyDso.CapVersion.GovOutcome ()  -- the `NativeAction DsoCtx GovAction` instance
import Cap.BabyDso.CapVersion.Confirmation
import Cap.BabyDso.CapVersion.AmuletPriceVote
import Cap.BabyDso.CapVersion.VoteRequest (VoteRequest (..), decodeVotes)

-- | The round whose price the standing vote sets — a minimal stand-in for
-- Splice's `OpenMiningRound`.
template OpenMiningRound
  with
    dso         : Party
    round       : Int
    amuletPrice : Decimal
    opensAt     : Time
  where
    signatory dso

-- | The standing round-advance decision (disjoint from every `GA_`-prefixed
-- native encoding).
advanceDecision : AnyAction
advanceDecision = AA_Native (AV_Text "advance-round")

-- | Fetch one organization's rules by cid, proving ownership.
fetchOrgRules : Party -> Text -> ContractId DsoRules -> Update DsoRules
fetchOrgRules dso org cid = do
  rules <- fetch cid
  require "Rules belong to this organization" (rules.dso == dso && rules.org == org)
  pure rules

-- | Require `party` is a current SV; `role` names it in the error.
requireSv : Text -> Party -> DsoRules -> Update ()
requireSv role party rules = require (role <> " is a sv") (party `Map.member` rules.svs)

template DsoMechanism
  with
    dso     : Party
    org     : Text    -- the one organization this mechanism's choices govern
    opensAt : Time    -- genesis: the standing window opens here and never closes
  where
    signatory dso

    interface instance Mechanism for DsoMechanism where
      view = MechanismView with
        authorities = Set.singleton dso
        size = None
        submissionOpensAt = opensAt
        submissionClosesAt = None
        expiresAt = None
        meta = emptyMetadata

      submittableAllowed _ = pure ()
      resolutionAllowed _  = pure ()
      withdrawAllowed now  = noWithdraw (toInterface @Mechanism this) now

    -- === The standing governor: two decision kinds, two tallies ==============

    interface instance Governor for DsoMechanism where
      -- Persistent: at-most-once is spend-based — an approval spends its
      -- confirmations (`onResolved`), an advance its round; the price votes
      -- are standing and re-admitted every round by design.
      view = GovernorView with meta = emptyMetadata; standing = True

      isWithdrawer _ _ = False

      -- Every submittable declares its decision so the fixed body isolates this
      -- mechanism's decisions from each other: a confirmation carries its own; a
      -- vote request its nonce; a price vote belongs to the standing round-advance.
      decisionOf s
        | Some c <- fromInterface @Confirmation s = Some (contractGroupId c)
        | Some vr <- fromInterface @VoteRequest s = Some (ForDecision with action = AA_Native (AV_Text vr.nonce); commitments = vr.commitments)
        | Some _ <- fromInterface @AmuletPriceVote s = Some (ForDecision with action = advanceDecision; commitments = [])
        | otherwise = None

      -- Dispatched on the action once: the round advance, a deliberate vote, and
      -- a confirmed action are three decisions, each its own admit / tally /
      -- issue / onResolved.
      resolutionFor action
        | action == Some advanceDecision = advanceResolution
        | Some (AA_Native (AV_Text t)) <- action, "vote:" `DA.Text.isPrefixOf` t = voteResolution
        | otherwise = confirmationResolution
        where
          -- The single presented `VoteRequest` container — the decision's whole
          -- record, its window and electorate read off it.
          theVR subs = case [vr | Some vr <- map (fromInterface @VoteRequest) subs] of
            (vr :: _) -> vr
            [] -> error "no vote request presented"

          -- Deliberate vote: the container carries the window (the standing
          -- mechanism view cannot), a quorate-majority close over its vote map,
          -- and atomic execution on approval.
          voteResolution = Resolution with
            isResolver = \p -> p == dso
            admit = \_ admitted _ -> do
              now <- getTime
              require "vote is not yet closed" (now >= (theVR (map snd admitted)).submissionClosesAt)
            tally = \subs _ ->
              let vr = theVR subs
              in quorateMajorityAll (requiredNumVotes (Set.size vr.snapshot)) decodeVotes subs
            issue = \mechanism commitments option admitted extraArgs ->
              let vr = theVR admitted
              in anyActionIssueOutcome (DsoCtx dso org) vr.action Action_IssueOutcome with
                   actors = [dso]; source = mechanism; committedTargets = commitments
                   winningOption = option; executeAfter = vr.executeAfter
                   executeUntil = Some vr.executeUntil; extraArgs
            onResolved = \outcome scids extraArgs -> case outcome of
              RO_Approved outcomeCids _ -> do
                targets <- readTargets extraArgs.context
                spendAndExecute scids outcomeCids [dso] targets extraArgs
                pure emptyMetadata
              _ -> pure emptyMetadata
          -- Advance: exact cover of the live SV list, median of the priced
          -- votes (none priced = carry), no outcome, roll the round.
          advanceResolution = Resolution with
            isResolver = \p -> p == dso
            admit = \_ admitted extraArgs -> do
              rules <- fetchTargetFromContext @DsoRules (dsoRulesKey dso org) rulesKey extraArgs.context
              voters <- forA admitted $ \(_, s) -> case fromInterface @AmuletPriceVote s of
                Some v -> pure v.voter
                None -> abort "presented submittable is not a price vote"
              require "Every sv voted exactly once" (sort voters == sort (Map.keys rules.svs))
            tally = \subs _ ->
              let priceOf s = fromInterface @AmuletPriceVote s >>= (.price)
              in case mapOptional priceOf subs of
                   [] -> VApproved None
                   ps -> VApproved (Some (AV_Decimal (median ps)))
            issue = \_ _ _ _ _ -> pure []
            onResolved = \outcome _ extraArgs -> do
              roundCid <- readCid @OpenMiningRound roundKey extraArgs.context
              prev <- fetch roundCid
              require "Round belongs to this dso" (prev.dso == dso)
              archive roundCid
              now <- getTime
              let newPrice = case outcome of
                    RO_Approved _ (Some (AV_Decimal p)) -> p
                    _ -> prev.amuletPrice
              _ <- create OpenMiningRound with
                dso; round = prev.round + 1; amuletPrice = newPrice; opensAt = now
              pure emptyMetadata

          -- Confirmed action: every submittable an unexpired confirmation,
          -- supermajority of the electorate claim, issue the payload, spend
          -- the confirmations and execute on approval.
          confirmationResolution = Resolution with
            isResolver = \p -> p == dso
            admit = \_ admitted _ -> do
              now <- getTime
              -- All admitted are this decision's confirmations — the fixed
              -- `decisionOf` isolation guarantees it — so only expiry is left.
              forA_ admitted $ \(_, s) -> case fromInterface @Confirmation s of
                Some c -> require "Confirmation has not expired" (now < c.expiresAt)
                None -> pure ()
            tally = \subs extraArgs ->
              let svs = readSvsClaim extraArgs.context
                  confirmers = Set.fromList
                    [c.confirmer | Some c <- map (fromInterface @Confirmation) subs, c.confirmer `elem` svs]
              in if Set.size confirmers >= requiredNumVotes (length svs)
                   then VApproved None
                   else VLapsed
            issue = \mechanism commitments option admitted extraArgs -> do
              typed <- case mapOptional (fromInterface @Confirmation) admitted of
                (c :: _) -> pure c.action
                [] -> abort "no confirmation to issue from"
              rules <- fetchTargetFromContext @DsoRules (dsoRulesKey dso org) rulesKey extraArgs.context
              now <- getTime
              anyActionIssueOutcome (DsoCtx dso org) typed Action_IssueOutcome with
                actors = [dso]; source = mechanism; committedTargets = commitments
                winningOption = option; executeAfter = now
                executeUntil = Some (addRelTime now rules.config.actionConfirmationTimeout); extraArgs
            onResolved = \outcome scids extraArgs -> case outcome of
              RO_Approved outcomeCids _ -> do
                targets <- readTargets extraArgs.context
                spendAndExecute scids outcomeCids [dso] targets extraArgs
                pure emptyMetadata
              _ -> abort "not enough current svs confirmed the action"

      governor_withdrawImpl _ = abort "the standing governor has no withdrawable decision"

    -- === The voting workflow's mint choice (Splice: DsoRules_RequestVote) ========

    -- | A current SV opens a vote: the request container mints with the
    -- requester's YES auto-inserted (Splice's auto-accept). The state token is
    -- read on-ledger here, never proposer-supplied; the window comes from
    -- config, with a zero timelock (Splice's execute-at-close).
    nonconsuming choice DsoMechanism_RequestVote : ContractId VoteRequest
      with
        sv                 : Party
        action             : TypedAction GovAction
        dsoRulesCid        : ContractId DsoRules
        targets            : [ContractId Target]  -- one per binding, in binding order; only those recording a state token are read
        voteRequestTimeout : Optional RelTime     -- None = config's default
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Proposer" sv rules
        commitments <- anyActionBuildRefs (DsoCtx dso org) action [dso] targets
        now <- getTime
        let timeout = fromOptional rules.config.voteRequestTimeout voteRequestTimeout
        let closesAt = addRelTime now timeout
        create VoteRequest with
          dso; org; proposer = sv
          mechanism = toInterfaceContractId @Mechanism self
          action; commitments
          snapshot = Set.fromList (Map.keys rules.svs)
          votes = Map.fromList [(sv, True)]
          nonce = "vote:" <> show sv <> "@" <> show now
          submissionOpensAt = now
          submissionClosesAt = closesAt
          executeAfter = closesAt
          executeUntil = addRelTime closesAt timeout
          expiresAt = addRelTime closesAt timeout

    -- === The voting workflow's close choice (Splice: DsoRules_CloseVoteRequest) ==

    -- | Dso signature resolves the vote as a decision of the STANDING governor:
    -- the container is the one presented submittable, its nonce the decision.
    nonconsuming choice DsoMechanism_CloseVoteRequest : Governor_ResolveResult
      with
        sv          : Party
        requestCid  : ContractId VoteRequest
        dsoRulesCid : ContractId DsoRules
        targets     : [ContractId Target]
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Closer" sv rules
        vr <- fetch requestCid
        exercise (toInterfaceContractId @Governor self) Governor_Resolve with
          resolver = dso
          action = Some (AA_Native (AV_Text vr.nonce))
          commitments = vr.commitments
          submittables = [toInterfaceContractId @Submittable requestCid]
          extraArgs = ExtraArgs with
            context = ChoiceContext with
              values = TextMap.fromList
                [ (targetsKey, AV_List (map (AV_ContractId . coerceContractId) targets))
                , (rulesKey, AV_ContractId (coerceContractId dsoRulesCid))
                ]
            meta = emptyMetadata


    -- === The confirmation workflow (Splice: DsoRules_ConfirmAction) ============

    -- | A current SV mints its dso-signed confirmation — authority propagation
    -- through this choice, no signing ceremony. One transaction per confirmer.
    nonconsuming choice DsoMechanism_ConfirmAction : ContractId Confirmation
      with
        sv          : Party
        action      : TypedAction GovAction
        dsoRulesCid : ContractId DsoRules
        targets     : [ContractId Target]  -- one per binding, in binding order; only those recording a state token are read
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Confirmer" sv rules
        commitments <- anyActionBuildRefs (DsoCtx dso org) action [dso] targets
        now <- getTime
        create Confirmation with
          dso; mechanism = toInterfaceContractId @Mechanism self
          confirmer = sv; action; commitments
          expiresAt = addRelTime now rules.config.actionConfirmationTimeout

    -- | Threshold execution (Splice: DsoRules_ExecuteConfirmedAction), as a
    -- resolution of the STANDING governor: same contract, confirmation tally.
    -- The decision's commitments are whatever its confirmers agreed on — read
    -- off the first; `decisionOf` isolation proves the rest match.
    nonconsuming choice DsoMechanism_ExecuteConfirmedAction : Governor_ResolveResult
      with
        sv               : Party
        confirmationCids : [ContractId Confirmation]
        dsoRulesCid      : ContractId DsoRules
        targets          : [ContractId Target]  -- one per binding, in binding order
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Executor" sv rules
        first <- case confirmationCids of
          (cid :: _) -> fetch cid
          [] -> fail "no confirmations presented"
        exercise (toInterfaceContractId @Governor self) Governor_Resolve with
          resolver = dso
          action = Some (encodeGovDecision first.action)
          commitments = first.commitments
          submittables = map (toInterfaceContractId @Submittable) confirmationCids
          extraArgs = ExtraArgs with
            context = ChoiceContext with
              values = TextMap.fromList
                [ (targetsKey, AV_List (map (AV_ContractId . coerceContractId) targets))
                , (rulesKey, AV_ContractId (coerceContractId dsoRulesCid))
                , (svsKey, AV_List (map AV_Party (Map.keys rules.svs)))
                ]
            meta = emptyMetadata

    -- === The price-vote workflow (Splice: amulet price + round advance) ========

    -- | Mint an SV's standing price slot, unpriced.
    nonconsuming choice DsoMechanism_RegisterPriceVote : ContractId AmuletPriceVote
      with
        sv          : Party
        dsoRulesCid : ContractId DsoRules
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Registrant" sv rules
        now <- getTime
        create AmuletPriceVote with
          dso; org; mechanism = toInterfaceContractId @Mechanism self
          voter = sv; state = S_Empty; price = None; lastUpdatedAt = now

    -- | The recurring resolution (Splice: DsoRules_AdvanceOpenMiningRounds +
    -- fetchMedianAmuletPrice), as the STANDING governor's other decision: the
    -- median tally over the standing votes, exact cover proven against the
    -- LIVE SV list, the round rolled atomically.
    nonconsuming choice DsoMechanism_AdvanceRound : Governor_ResolveResult
      with
        sv          : Party
        roundCid    : ContractId OpenMiningRound
        voteCids    : [ContractId AmuletPriceVote]
        dsoRulesCid : ContractId DsoRules
      controller sv
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        requireSv "Advancer" sv rules
        exercise (toInterfaceContractId @Governor self) Governor_Resolve with
          resolver = dso
          action = Some advanceDecision
          commitments = []
          submittables = map (toInterfaceContractId @Submittable) voteCids
          extraArgs = ExtraArgs with
            context = ChoiceContext with
              values = TextMap.fromList
                [ (rulesKey, AV_ContractId (coerceContractId dsoRulesCid))
                , (roundKey, AV_ContractId (coerceContractId roundCid))
                ]
            meta = emptyMetadata

    -- | Tear down the stale standing vote of an offboarded SV, through the
    -- ballot's own authority choice (`Ballot_Consume`).
    nonconsuming choice DsoMechanism_GcPriceVote : ()
      with
        actor       : Party
        voteCid     : ContractId AmuletPriceVote
        dsoRulesCid : ContractId DsoRules
      controller actor
      do
        rules <- fetchOrgRules dso org dsoRulesCid
        let group = ForMechanism with mechanism = toInterfaceContractId @Mechanism self
        vote <- fetchReferenceData group voteCid
        require "Voter is no longer a sv" (not (vote.voter `Map.member` rules.svs))
        _ <- exercise (toInterfaceContractId @Ballot voteCid) Ballot_Consume with
          extraArgs = ExtraArgs with
            context = ChoiceContext with values = TextMap.empty
            meta = emptyMetadata
        pure ()
