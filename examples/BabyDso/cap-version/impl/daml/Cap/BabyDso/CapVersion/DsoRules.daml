-- =============================================================================
-- DsoRules — the GOVERNED state (SV list + config).
-- =============================================================================

module Cap.BabyDso.CapVersion.DsoRules where

import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time (RelTime)

import Splice.Api.Token.MetadataV1 (AnyValue (..), emptyMetadata)
import Cap.Core.CheckedFetchV1 (require)
import Cap.Core.Patchable (applySetState, Patchable (..), SetState)
import Cap.Governance.ActionV1 (AnyAction (..))
import Cap.Governance.ActionUtil (ActionSpec, TargetEntry (..), TypedAction (..), editTarget)
import Cap.Governance.TargetV1
import Cap.Governance.TargetUtil (driftAborts, noDrift)

import Cap.BabyDso.CapVersion.AmuletRules


-- | The delta an approved action applies — shared by the voting and
-- confirmation workflows. This is the payload of the library's
-- `TypedAction GovAction`; the open case (`Extension`) carries an `Action`
-- contract from a package this one has never seen.
data GovAction
  = GA_OffboardSv OffboardSv
  | GA_AddSv AddSv
  | GA_SetConfig (SetState DsoRulesConfig)
      -- ^ Whole-config replacement, patched field-wise onto fresh state
  | GA_SetAmuletPrice with
      newPrice : Decimal
      -- ^ Price write on the `AmuletRules` target; its approval records the
      -- state token read at proposal, and drift beyond the policy tolerance aborts.
  | GA_SetTransferFee with
      newFee : Decimal
      -- ^ Fee write on the `AmuletRules` target, committed by key only: any drift
      -- is accepted, the write lands on fresh state.
  | GA_PayFromReserve with
      amount : Decimal
      -- ^ Payout from the `AmuletRules` reserve, recording the state token under
      -- the strict policy: non-idempotent, so any drift since approval aborts.
  deriving (Eq, Show)

-- | The mechanism-supplied spec context: which dso and organization the
-- payload's targets belong to.
data DsoCtx = DsoCtx with
    dso : Party
    org : Text

-- | Encode a decision for `Governor_Resolve`: an extension is its proposal
-- cid; a native payload rides its `show` (injective, and only ever compared
-- for equality — never decoded back).
encodeGovDecision : TypedAction GovAction -> AnyAction
encodeGovDecision (Extension cid) = AA_Extension cid
encodeGovDecision (Native a) = AA_Native (AV_Text (show a))


data OffboardSv = OffboardSv with
    sv : Party
  deriving (Eq, Show)

data AddSv = AddSv with
    newSvParty : Party
    newSvName  : Text
  deriving (Eq, Show)

-- | Baby analogue of Splice's `DsoRulesConfig`. `Patchable` so two config votes
-- that touch different fields compose instead of last-write-wins.
data DsoRulesConfig = DsoRulesConfig with
    actionConfirmationTimeout : RelTime
    voteCooldownTime : RelTime
    voteRequestTimeout : RelTime
  deriving (Eq, Show)

instance Patchable DsoRulesConfig where
  patch new base current = DsoRulesConfig with
    actionConfirmationTimeout =
      patch new.actionConfirmationTimeout base.actionConfirmationTimeout current.actionConfirmationTimeout
    voteCooldownTime =
      patch new.voteCooldownTime base.voteCooldownTime current.voteCooldownTime
    voteRequestTimeout =
      patch new.voteRequestTimeout base.voteRequestTimeout current.voteRequestTimeout

template DsoRules
  with
    dso           : Party
    org           : Text   -- distinguishes organizations sharing the dso party (for demo only)
    svs           : Map.Map Party Text
    offboardedSvs : Map.Map Party Text
    config        : DsoRulesConfig
  where
    signatory dso

    -- Identity-only target: one DsoRules per (dso, org), so `id = org`.
    -- Approved actions are deltas applied to the fresh state, so no state token.
    interface instance Target for DsoRules where
      view = TargetView with
        authorities = Set.singleton dso
        id = org
        stateToken = None
        meta = emptyMetadata

-- | The identifying key of one organization's `DsoRules` target.
dsoRulesKey : Party -> Text -> ForTarget
dsoRulesKey dso org = ForTarget with authorities = Set.singleton dso; id = org


-- | The per-action dispatch, shared by both workflows: each payload's whole
-- governance meaning as a library `ActionSpec` (target, state token, drift policy,
-- effect). Extension actions never reach it — they carry their own spec.
govActionSpec : DsoCtx -> GovAction -> ActionSpec
govActionSpec ctx action = case action of
  GA_OffboardSv arg -> onDsoRules $ \r -> do
    require "There is more than one sv" (Map.size r.svs > 1)
    case Map.lookup arg.sv r.svs of
      None -> fail "Not a sv"
      Some name -> pure r with
        svs = Map.delete arg.sv r.svs
        offboardedSvs = Map.insert arg.sv name r.offboardedSvs

  GA_AddSv arg -> onDsoRules $ \r -> do
    require "SV party has not yet operated a node"
      (not (arg.newSvParty `Map.member` r.svs || arg.newSvParty `Map.member` r.offboardedSvs))
    require "SV is not currently onboarded"
      (arg.newSvName `notElem` Map.values r.svs)
    pure r with svs = Map.insert arg.newSvParty arg.newSvName r.svs

  GA_SetConfig change -> onDsoRules $ \r -> pure r with config = applySetState change r.config

  GA_SetAmuletPrice {newPrice} ->
    onAmuletRules True (priceDriftWithin 1.0) $ \r -> pure r with amuletPrice = newPrice

  GA_SetTransferFee {newFee} ->
    onAmuletRules False noDrift $ \r -> pure r with transferFee = newFee

  GA_PayFromReserve {amount} ->
    onAmuletRules True driftAborts $ \r -> do
      require "Reserve covers the payout" (r.reserve >= amount)
      pure r with reserve = r.reserve - amount
  where
    onDsoRules f = Map.fromList
      [ ( dsoRulesKey ctx.dso ctx.org
        , TargetEntry with pinsState = False; policy = noDrift; effect = editTarget @DsoRules f ) ]
    onAmuletRules pinsState policy f = Map.fromList
      [ ( amuletRulesKey ctx.dso
        , TargetEntry with pinsState; policy; effect = editTarget @AmuletRules f ) ]
