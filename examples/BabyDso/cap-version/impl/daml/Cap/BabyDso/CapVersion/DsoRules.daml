-- =============================================================================
-- DsoRules — the GOVERNED state (SV list + config) and nothing else: a
-- cap-governance `Target`. It churns freely (every applied action
-- archives and recreates it); every choice the SVs exercise to make a decision 
-- lives on `DsoMechanism`, which reads this contract fresh by cid.
-- =============================================================================

module Cap.BabyDso.CapVersion.DsoRules where

import DA.Action (void)
import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time (RelTime)

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Cap.Core.CheckedFetchV1 (require)
import Cap.Core.Patchable (applySetState, Patchable (..), SetState)
import Cap.Governance.TargetV1
import Cap.Governance.TargetUtil (mutateTarget)
import Cap.Governance.TargetPolicies (driftAborts)

import Cap.BabyDso.CapVersion.AmuletRules



-- | The delta an approved action applies to `DsoRules` — shared by the voting
-- and confirmation workflows (Splice splits the two action sets; the shapes are
-- what this example demonstrates, so one set serves both).
data GovAction
  = GA_OffboardSv OffboardSv
  | GA_AddSv AddSv
  | GA_SetConfig (SetState DsoRulesConfig)
      -- ^ Whole-config replacement, patched field-wise onto fresh state —
      -- Splice's `DsoRules_SetConfig` pattern.
  | GA_SetAmuletPrice with
      newPrice : Decimal
      -- ^ Price write on the `AmuletRules` target; its approval pins the state
      -- token read at proposal, and drift beyond the policy tolerance aborts.
  | GA_SetTransferFee with
      newFee : Decimal
      -- ^ Fee write on the `AmuletRules` target, identity-pinned: any drift is
      -- accepted, the write lands on fresh state.
  | GA_PayFromReserve with
      amount : Decimal
      -- ^ Payout from the `AmuletRules` reserve, state-pinned under the strict
      -- policy: non-idempotent, so any drift since approval aborts.
  deriving (Eq, Show)

-- | The whole governance meaning of one action: the target it applies to,
-- whether its approval pins the state seen, its drift policy, and its effect.
data ActionSpec = ActionSpec with
    targetKey : ForTarget
    pinsState : Bool
    onDrift : CheckedTarget -> Update ()
    effect : CheckedTarget -> ContractId Target -> Update ()


data OffboardSv = OffboardSv with
    sv : Party
  deriving (Eq, Show)

data AddSv = AddSv with
    newSvParty : Party
    newSvName  : Text
  deriving (Eq, Show)

-- | Baby analogue of Splice's `DsoRulesConfig`. `Patchable` so two config votes
-- that touch different fields compose instead of last-write-wins.
data DsoRulesConfig = DsoRulesConfig with
    actionConfirmationTimeout : RelTime
    voteCooldownTime : RelTime
    voteRequestTimeout : RelTime
  deriving (Eq, Show)

instance Patchable DsoRulesConfig where
  patch new base current = DsoRulesConfig with
    actionConfirmationTimeout =
      patch new.actionConfirmationTimeout base.actionConfirmationTimeout current.actionConfirmationTimeout
    voteCooldownTime =
      patch new.voteCooldownTime base.voteCooldownTime current.voteCooldownTime
    voteRequestTimeout =
      patch new.voteRequestTimeout base.voteRequestTimeout current.voteRequestTimeout

template DsoRules
  with
    dso           : Party
    org           : Text   -- distinguishes organizations sharing the dso party
    svs           : Map.Map Party Text
    offboardedSvs : Map.Map Party Text
    config        : DsoRulesConfig
  where
    signatory dso

    -- Identity-only target: one DsoRules per (dso, org), so `id = org`.
    -- Approved actions are deltas applied to the fresh state, so no state token.
    interface instance Target for DsoRules where
      view = TargetView with
        authorities = Set.singleton dso
        id = org
        stateToken = None
        meta = emptyMetadata

-- | The identifying key of one organization's `DsoRules` target.
dsoRulesKey : Party -> Text -> ForTarget
dsoRulesKey dso org = ForTarget with authorities = Set.singleton dso; id = org


-- | The single per-action dispatch, shared by both workflows; adding an action
-- is adding one case here. `org` names the organization whose `DsoRules` a
-- rules action applies to; amulet actions ignore it.
actionSpec : Party -> Text -> GovAction -> ActionSpec
actionSpec dso org action = case action of
  GA_OffboardSv arg -> onDsoRules $ \r -> do
    require "There is more than one sv" (Map.size r.svs > 1)
    case Map.lookup arg.sv r.svs of
      None -> fail "Not a sv"
      Some name -> pure r with
        svs = Map.delete arg.sv r.svs
        offboardedSvs = Map.insert arg.sv name r.offboardedSvs

  GA_AddSv arg -> onDsoRules $ \r -> do
    require "SV party has not yet operated a node"
      (not (arg.newSvParty `Map.member` r.svs || arg.newSvParty `Map.member` r.offboardedSvs))
    require "SV is not currently onboarded"
      (arg.newSvName `notElem` Map.values r.svs)
    pure r with svs = Map.insert arg.newSvParty arg.newSvName r.svs

  GA_SetConfig change -> onDsoRules $ \r -> pure r with config = applySetState change r.config
  
  GA_SetAmuletPrice {newPrice} ->
    (onAmuletRules $ \r -> pure r with amuletPrice = newPrice) with
      pinsState = True; onDrift = priceDriftWithin 1.0

  GA_SetTransferFee {newFee} -> onAmuletRules $ \r -> pure r with transferFee = newFee

  GA_PayFromReserve {amount} ->
    (onAmuletRules $ \r -> do
      require "Reserve covers the payout" (r.reserve >= amount)
      pure r with reserve = r.reserve - amount) with
      pinsState = True
  where
    onDsoRules f = ActionSpec with
      targetKey = dsoRulesKey dso org
      pinsState = False
      onDrift = driftAborts
      effect = \c tcid -> void (mutateTarget @DsoRules c tcid f)
    onAmuletRules f = ActionSpec with
      targetKey = amuletRulesKey dso
      pinsState = False
      onDrift = driftAborts
      effect = \c tcid -> void (mutateTarget @AmuletRules c tcid f)