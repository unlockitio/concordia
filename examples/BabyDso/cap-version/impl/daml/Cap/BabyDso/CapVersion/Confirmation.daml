-- =============================================================================
-- Confirmation — Splice's operational-quorum artifact.
-- =============================================================================
module Cap.BabyDso.CapVersion.Confirmation where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), require)
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1 (Mechanism)

import Cap.BabyDso.CapVersion.DsoRules (GovAction)

-- | Decision identity for the standing confirmation workflow: the mechanism, the
-- action VALUE, and the state token the confirmer saw (None for identity-pinned
-- actions). State-pinned confirmations aggregate only per observed state.
data ForDecision = ForDecision
  with
    mechanism : ContractId Mechanism
    action : GovAction
    seenToken : Optional Text
  deriving (Eq, Show)

template Confirmation
  with
    dso       : Party
    mechanism : ContractId Mechanism   -- the standing DsoMechanism
    confirmer : Party
    action    : GovAction
    seenToken : Optional Text          -- target token read at confirm time; None for identity-pinned actions
    expiresAt : Time
  where
    signatory dso
    observer confirmer

    interface instance Submittable for Confirmation where
      view = SubmittableView with
        mechanism = mechanism
        authorities = Set.singleton dso
        slot = None
        state = S_Full         -- minted cast: existence is the confirmation
        meta = emptyMetadata

    -- | Anyone with visibility archives an expired confirmation (Splice's
    -- `Confirmation_Expire`). Effect-free, because the caller is arbitrary.
    choice Confirmation_Expire : ()
      with
        actor : Party
      controller actor
      do
        now <- getTime
        require "confirmation is past its expiry" (now >= expiresAt)

instance HasCheckedFetch Confirmation ForDecision where
  contractGroupId c = ForDecision with mechanism = c.mechanism; action = c.action; seenToken = c.seenToken
