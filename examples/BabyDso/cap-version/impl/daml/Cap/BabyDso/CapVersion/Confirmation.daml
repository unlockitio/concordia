-- =============================================================================
-- Confirmation — Splice's operational-quorum artifact. Decision identity —
-- mechanism, action VALUE, and the commitments the confirmer saw — is proven
-- at resolution: the fixed admission binds the mechanism, and `decisionOf`
-- plus the fixed isolation match action and commitments. Confirmations that record a state token
-- aggregate only per observed state.
-- =============================================================================
module Cap.BabyDso.CapVersion.Confirmation where

import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Cap.Core.CheckedFetchV1 (HasCheckedFetch (..), require)
import Cap.Core.SubmittableV1
import Cap.Core.MechanismV1 (Mechanism)

import Cap.Governance.ActionUtil (TypedAction)
import Cap.Governance.GovernorV1 (ForDecision (..))
import Cap.Governance.TargetV1 (TargetRef)

import Cap.BabyDso.CapVersion.DsoRules (GovAction, encodeGovDecision)

template Confirmation
  with
    dso         : Party
    mechanism   : ContractId Mechanism   -- the standing DsoMechanism
    confirmer   : Party
    action      : TypedAction GovAction
    commitments : [TargetRef]            -- targets committed at confirm time, in binding order
    expiresAt   : Time
  where
    signatory dso
    observer confirmer

    interface instance Submittable for Confirmation where
      view = SubmittableView with
        mechanism = mechanism
        authorities = Set.singleton dso
        slot = None
        state = S_Full         -- minted cast: existence is the confirmation
        meta = emptyMetadata

    -- | Anyone with visibility archives an expired confirmation (Splice's
    -- `Confirmation_Expire`). Effect-free, because the caller is arbitrary.
    choice Confirmation_Expire : ()
      with
        actor : Party
      controller actor
      do
        now <- getTime
        require "confirmation is past its expiry" (now >= expiresAt)

-- | The one home of a confirmation's decision identity: which action, against
-- which commitments. `decisionOf` returns it and the fixed isolation compares it
-- to the resolve's pair; the mechanism component is the fixed admission's (`ForMechanism`).
instance HasCheckedFetch Confirmation ForDecision where
  contractGroupId c = ForDecision with
    action = encodeGovDecision c.action
    commitments = c.commitments
