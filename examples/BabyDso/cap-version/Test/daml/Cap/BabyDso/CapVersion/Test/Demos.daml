-- Demos for the cap-version Baby-DSO. Every demo_* script is described in
-- DEMOS.md and shares `setup`.
module Cap.BabyDso.CapVersion.Test.Demos where

import Prelude hiding (Action)

import DA.Assert ((===))
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import DA.Time (days, minutes)
import Daml.Script

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyMetadata)
import Cap.Core.Patchable (SetState (..))
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.ActionUtil (TypedAction (..))
import Cap.Governance.BallotV1 (Ballot, Ballot_Cast (..))
import Cap.Governance.GovernorV1 (Governor_ResolveResult)
import Cap.Governance.TargetV1 (Target)

import Cap.BabyDso.CapVersion.AmuletPriceVote (AmuletPriceVote)
import Cap.BabyDso.CapVersion.AmuletRules
import Cap.BabyDso.CapVersion.DsoMechanism
import Cap.BabyDso.CapVersion.Common (svListKey)
import Cap.BabyDso.CapVersion.Confirmation
import Cap.BabyDso.CapVersion.DsoRules
import Cap.BabyDso.CapVersion.VoteRequest (VoteRequest (..))

import Cap.BabyDso.Extension.OffboardAndCompensate (OffboardAndCompensate (..))

-- --- shared fixture: one dso, four SVs, DsoRules, AmuletRules, the mechanism ----

data Setup = Setup with
    dso : Party
    sv1 : Party
    sv2 : Party
    sv3 : Party
    sv4 : Party
    mechanism : ContractId DsoMechanism
    round : ContractId OpenMiningRound

setup : Script Setup
setup = do
  sv1 <- allocateParty "sv1"
  sv2 <- allocateParty "sv2"
  sv3 <- allocateParty "sv3"
  sv4 <- allocateParty "sv4"
  dso <- allocateParty "dso"
  now <- getTime
  _ <- submit dso $ createCmd DsoRules with
    dso
    org = "org1"
    svs = Map.fromList [(sv1, "sv1"), (sv2, "sv2"), (sv3, "sv3"), (sv4, "sv4")]
    offboardedSvs = Map.empty
    config = DsoRulesConfig with
      actionConfirmationTimeout = minutes 5
      voteCooldownTime = minutes 1
      voteRequestTimeout = days 7
  _ <- submit dso $ createCmd AmuletRules with dso; amuletPrice = 10.0; transferFee = 0.1; reserve = 100.0
  mechanism <- submit dso $ createCmd DsoMechanism with dso; org = "org1"; opensAt = now
  round <- submit dso $ createCmd OpenMiningRound with dso; round = 0; amuletPrice = 10.0; opensAt = now
  pure Setup with dso; sv1; sv2; sv3; sv4; mechanism; round

-- | The live DsoRules of the setup organization (its cid changes on every
-- applied DsoRules action).
getRules : Setup -> Script (ContractId DsoRules, DsoRules)
getRules s = do
  [(cid, r)] <- queryFilter @DsoRules s.dso (\r -> r.org == "org1")
  pure (cid, r)

-- | The live AmuletRules (its cid changes on every applied AmuletRules action).
getAmuletRules : Setup -> Script (ContractId AmuletRules, AmuletRules)
getAmuletRules s = do
  [(cid, r)] <- query @AmuletRules s.dso
  pure (cid, r)

-- --- voting-mechanism helpers ------------------------------------------------

-- | The live DsoRules delivered in the cast context (the SV-list check).
ctxWithRules : ContractId DsoRules -> ExtraArgs
ctxWithRules rules = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList
      [(svListKey, AV_ContractId (coerceContractId (toInterfaceContractId @Target rules)))]
  meta = emptyMetadata

-- | The live target of a native action's one binding (demo 5's extension
-- action presents its two explicitly).
targetsForAction : Setup -> GovAction -> Script [ContractId Target]
targetsForAction s action = do
  key <- case Map.keys (govActionSpec (DsoCtx s.dso "org1") action) of
    [k] -> pure k
    _ -> fail "native actions bind exactly one target"
  if key == amuletRulesKey s.dso
    then do (ar, _) <- getAmuletRules s; pure [toInterfaceContractId @Target ar]
    else do (rules, _) <- getRules s; pure [toInterfaceContractId @Target rules]

-- | Opens a vote: the request, the requester's yes, and every voting right
-- mint in one transaction (the choice's Splice-style auto-accept).
requestVote : Setup -> Party -> GovAction -> Script (ContractId VoteRequest)
requestVote s sv action = do
  (rules, _) <- getRules s
  targets <- targetsForAction s action
  submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_RequestVote with
    sv
    action = Native action
    dsoRulesCid = rules
    targets
    voteRequestTimeout = None

-- | Opens a vote on an extension action: same choice, the action arrives as an
-- `Action` contract. Targets in this proposal's binding order (rules, reserve).
requestExtension : Setup -> Party -> ContractId Action -> Script (ContractId VoteRequest)
requestExtension s sv actionCid = do
  (rules, _) <- getRules s
  (ar, _) <- getAmuletRules s
  submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_RequestVote with
    sv
    action = Extension actionCid
    dsoRulesCid = rules
    targets = [toInterfaceContractId @Target rules, toInterfaceContractId @Target ar]
    voteRequestTimeout = None

-- | Both workflows share the one `Ballot_Cast` choice: an `AV_Bool` casts a
-- `Vote`, an `AV_Decimal` prices an `AmuletPriceVote`.
castBallot : Setup -> Party -> ContractId Ballot -> AnyValue -> Script (ContractId Ballot)
castBallot s voter bcid v = do
  (rules, _) <- getRules s
  submit (actAs [voter] <> readAs [s.dso]) $ exerciseCmd bcid Ballot_Cast with
    voter; vote = v; extraArgs = ctxWithRules rules

-- | Cast into the request container, returning its live successor cid (the
-- cast recreates it). A non-snapshot caster is refused by the fixed choice.
castVote : Setup -> Party -> ContractId VoteRequest -> Bool -> Script (ContractId VoteRequest)
castVote s voter req accept =
  fromInterfaceContractId @VoteRequest <$>
    castBallot s voter (toInterfaceContractId @Ballot req) (AV_Bool accept)

castVoteFail : Setup -> Party -> ContractId VoteRequest -> Bool -> Script ()
castVoteFail s voter req accept = do
  (rules, _) <- getRules s
  submitMustFail (actAs [voter] <> readAs [s.dso]) $
    exerciseCmd (toInterfaceContractId @Ballot req) Ballot_Cast with
      voter; vote = AV_Bool accept; extraArgs = ctxWithRules rules

-- | The live targets the request committed to, by their keys, in order.
targetsFor : Setup -> ContractId VoteRequest -> Script [ContractId Target]
targetsFor s req = do
  Some vr <- queryContractId s.dso req
  forA vr.commitments $ \c ->
    if c.targetKey == amuletRulesKey s.dso
      then do (ar, _) <- getAmuletRules s; pure (toInterfaceContractId @Target ar)
      else do (rules, _) <- getRules s; pure (toInterfaceContractId @Target rules)

-- | Close, presenting the request container and its committed target.
closeVote : Setup -> Party -> ContractId VoteRequest -> Script Governor_ResolveResult
closeVote s sv req = do
  (rules, _) <- getRules s
  targets <- targetsFor s req
  submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_CloseVoteRequest with
    sv
    requestCid = req
    dsoRulesCid = rules
    targets

closeVoteFail : Setup -> Party -> ContractId VoteRequest -> Script ()
closeVoteFail s sv req = do
  (rules, _) <- getRules s
  targets <- targetsFor s req
  submitMustFail (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_CloseVoteRequest with
    sv
    requestCid = req
    dsoRulesCid = rules
    targets

-- =============================================================================
-- Demo 1 — the voting mechanism, on `GA_SetConfig` (DEMOS.md)
-- =============================================================================

demo_voting : Script ()
demo_voting = do
  s <- setup
  outsider <- allocateParty "outsider"
  (_, r0) <- getRules s

  -- sv1 opens a SetConfig vote (the requester's yes is auto-inserted)
  let cfgA = r0.config with voteCooldownTime = minutes 2
  reqA <- requestVote s s.sv1 (GA_SetConfig (SetState with new = cfgA; base = r0.config))

  -- a non-SV cannot cast
  castVoteFail s outsider reqA True

  -- two more yes reach the supermajority (3 of 4); the close resolves, issues
  -- the outcome, and executes it on DsoRules in one transaction
  reqA <- castVote s s.sv2 reqA True
  reqA <- castVote s s.sv3 reqA True
  passTime (days 7)
  _ <- closeVote s s.sv1 reqA
  (_, r1) <- getRules s
  r1.config.voteCooldownTime === minutes 2

  -- two concurrent config votes against the same base, touching different
  -- fields: both closes land, the second patches onto the first
  let cfgB = r1.config with actionConfirmationTimeout = minutes 10
  let cfgC = r1.config with voteCooldownTime = minutes 3
  reqB <- requestVote s s.sv1 (GA_SetConfig (SetState with new = cfgB; base = r1.config))
  reqC <- requestVote s s.sv1 (GA_SetConfig (SetState with new = cfgC; base = r1.config))
  reqB <- castVote s s.sv2 reqB True
  reqB <- castVote s s.sv3 reqB True
  reqC <- castVote s s.sv2 reqC True
  reqC <- castVote s s.sv3 reqC True
  passTime (days 7)
  _ <- closeVote s s.sv1 reqB
  _ <- closeVote s s.sv1 reqC
  (_, r2) <- getRules s
  r2.config.actionConfirmationTimeout === minutes 10
  r2.config.voteCooldownTime === minutes 3

  -- a payout that records the state token, approved by vote at price 10.0
  let payout = GA_PayFromReserve with amount = 25.0
  reqP <- requestVote s s.sv1 payout
  reqP <- castVote s s.sv2 reqP True
  reqP <- castVote s s.sv3 reqP True

  -- meanwhile the confirmation mechanism moves the price
  let reprice = GA_SetAmuletPrice with newPrice = 10.5
  [x1, x2, x3] <- forA [s.sv1, s.sv2, s.sv3] $ \sv -> confirm s sv reprice
  execute s s.sv1 reprice [x1, x2, x3]

  -- the stale approval cannot execute: the whole close aborts (driftAborts)
  passTime (days 7)
  closeVoteFail s s.sv1 reqP

-- --- confirmation-mechanism helpers --------------------------------------------

confirm : Setup -> Party -> GovAction -> Script (ContractId Confirmation)
confirm s sv action = do
  (rules, _) <- getRules s
  targets <- targetsForAction s action
  submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_ConfirmAction with
    sv; action = Native action; dsoRulesCid = rules; targets

-- The group's committed state is read off the first presented confirmation, so
-- the caller just names the confirmations to aggregate.
execute : Setup -> Party -> GovAction -> [ContractId Confirmation] -> Script ()
execute s sv action confirmationCids = do
  (rules, _) <- getRules s
  targets <- targetsForAction s action
  _ <- submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_ExecuteConfirmedAction with
    sv; confirmationCids; dsoRulesCid = rules; targets
  pure ()

executeFail : Setup -> Party -> GovAction -> [ContractId Confirmation] -> Script ()
executeFail s sv action confirmationCids = do
  (rules, _) <- getRules s
  targets <- targetsForAction s action
  submitMustFail (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_ExecuteConfirmedAction with
    sv; confirmationCids; dsoRulesCid = rules; targets

-- =============================================================================
-- Demo 2 — the confirmation mechanism (DEMOS.md)
-- =============================================================================

demo_confirmation : Script ()
demo_confirmation = do
  s <- setup

  -- a key-only action: replay-tolerant by declaration
  let grant = GA_SetTransferFee with newFee = 0.2

  -- two of four confirmations: below the threshold (3)
  d1 <- confirm s s.sv1 grant
  d2 <- confirm s s.sv2 grant
  executeFail s s.sv1 grant [d1, d2]

  -- every SV confirms; three execute the action and are consumed
  d3 <- confirm s s.sv3 grant
  d4 <- confirm s s.sv4 grant
  execute s s.sv1 grant [d1, d2, d3]
  (_, ar) <- getAmuletRules s
  ar.transferFee === 0.2

  -- spent confirmations cannot be presented again
  executeFail s s.sv1 grant [d1, d2, d3]

  -- key-only commitment: the leftover confirmation plus two fresh ones execute the
  -- same action a second time (just like splice)
  d1' <- confirm s s.sv1 grant
  d2' <- confirm s s.sv2 grant
  execute s s.sv2 grant [d4, d1', d2']

  -- four actions that record the state token, every confirmation gathered at price 10.0 (see setup)
  let priceA = GA_SetAmuletPrice with newPrice = 10.5
  let priceB = GA_SetAmuletPrice with newPrice = 15.0
  let priceC = GA_SetAmuletPrice with newPrice = 20.0
  let payout = GA_PayFromReserve with amount = 25.0

  -- get all confirmations for all actions
  [a1, a2, a3] <- forA [s.sv1, s.sv2, s.sv3] $ \sv -> confirm s sv priceA
  [b1, b2, b3, b4] <- forA [s.sv1, s.sv2, s.sv3, s.sv4] $ \sv -> confirm s sv priceB
  [c1, c2, c3] <- forA [s.sv1, s.sv2, s.sv3] $ \sv -> confirm s sv priceC
  [p1, p2, p3] <- forA [s.sv1, s.sv2, s.sv3] $ \sv -> confirm s sv payout

  -- every confirmation above recorded the price its confirmers saw: 10.0

  -- priceA executes on the state its confirmers saw
  execute s s.sv1 priceA [a1, a2, a3]
  (_, ar) <- getAmuletRules s
  ar.amuletPrice === 10.5

  -- the payout is under the strict policy: the same 0.5 drift that priceB
  -- tolerates below aborts it
  executeFail s s.sv1 payout [p1, p2, p3]

  -- priceB was approved at 10.0; the live price is 10.5, within the drift
  -- policy tolerance its `actionSpec` declares (1.0): it executes
  execute s s.sv1 priceB [b1, b2, b3]
  (_, ar) <- getAmuletRules s
  ar.amuletPrice === 15.0

  -- priceC was approved at 10.0; the live price is 15.0, beyond the tolerance:
  -- the drift policy refuses it
  executeFail s s.sv1 priceC [c1, c2, c3]

  -- recorded state token: the leftover (b4, at 10.0) cannot aggregate with fresh
  -- confirmations recording the new state (f1/f2 at 15.0) — from either group's
  -- side the checked fetch rejects the mismatch.
  f1 <- confirm s s.sv1 priceB
  f2 <- confirm s s.sv2 priceB
  executeFail s s.sv2 priceB [b4, f1, f2]
  executeFail s s.sv2 priceB [f1, b4, f2]

  -- re-approved against the live state, the payout executes
  [p1', p2', p3'] <- forA [s.sv1, s.sv2, s.sv3] $ \sv -> confirm s sv payout
  execute s s.sv1 payout [p1', p2', p3']
  (_, ar) <- getAmuletRules s
  ar.reserve === 75.0

-- --- median-mechanism helpers ------------------------------------------------

registerPriceVote : Setup -> Party -> Script (ContractId AmuletPriceVote)
registerPriceVote s sv = do
  (rules, _) <- getRules s
  submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_RegisterPriceVote with
    sv; dsoRulesCid = rules

priceVote : Setup -> Party -> ContractId AmuletPriceVote -> Decimal -> Script (ContractId AmuletPriceVote)
priceVote s voter vcid p =
  fromInterfaceContractId @AmuletPriceVote <$>
    castBallot s voter (toInterfaceContractId @Ballot vcid) (AV_Decimal p)

advanceRound : Setup -> Party -> [ContractId AmuletPriceVote] -> Script ()
advanceRound s sv voteCids = do
  (rules, _) <- getRules s
  [(rnd, _)] <- query @OpenMiningRound s.dso
  _ <- submit (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_AdvanceRound with
    sv; roundCid = rnd; voteCids; dsoRulesCid = rules
  pure ()

advanceRoundFail : Setup -> Party -> [ContractId AmuletPriceVote] -> Script ()
advanceRoundFail s sv voteCids = do
  (rules, _) <- getRules s
  [(rnd, _)] <- query @OpenMiningRound s.dso
  submitMustFail (actAs [sv] <> readAs [s.dso]) $ exerciseCmd s.mechanism DsoMechanism_AdvanceRound with
    sv; roundCid = rnd; voteCids; dsoRulesCid = rules

-- =============================================================================
-- Demo 3 — the median mechanism, on the standing price votes (DEMOS.md)
-- =============================================================================

demo_median : Script ()
demo_median = do
  s <- setup

  -- every SV registers its standing, unpriced vote
  [v1, v2, v3, v4] <- forA [s.sv1, s.sv2, s.sv3, s.sv4] $ registerPriceVote s

  -- three SVs price their votes; sv4 stays unpriced (covers, does not count)
  v1 <- priceVote s s.sv1 v1 1.0
  v2 <- priceVote s s.sv2 v2 2.0
  v3 <- priceVote s s.sv3 v3 3.0

  -- a cherry-picked subset cannot advance the round
  advanceRoundFail s s.sv1 [v1, v2, v3]
  advanceRoundFail s s.sv1 [v1, v2, v3, v3]

  -- the full set advances to the median
  advanceRound s s.sv1 [v1, v2, v3, v4]
  [(_, rnd)] <- query @OpenMiningRound s.dso
  rnd.round === 1
  rnd.amuletPrice === 2.0

-- =============================================================================
-- Demo 4 — two organizations, one authority party (DEMOS.md)
-- =============================================================================

demo_two_organizations : Script ()
demo_two_organizations = do
  s <- setup
  now <- getTime
  (_, r0) <- getRules s

  -- org1 approves a SetConfig vote
  let cfgX = r0.config with voteCooldownTime = minutes 2
  reqX <- requestVote s s.sv1 (GA_SetConfig (SetState with new = cfgX; base = r0.config))
  reqX <- castVote s s.sv2 reqX True
  reqX <- castVote s s.sv3 reqX True

  -- a second organization under the SAME dso authority party
  rules2 <- submit s.dso $ createCmd DsoRules with
    dso = s.dso
    org = "org2"
    svs = Map.fromList [(s.sv1, "sv1"), (s.sv2, "sv2"), (s.sv3, "sv3"), (s.sv4, "sv4")]
    offboardedSvs = Map.empty
    config = r0.config with voteCooldownTime = minutes 9
  mechanism2 <- submit s.dso $ createCmd DsoMechanism with dso = s.dso; org = "org2"; opensAt = now
  reqY <- submit (actAs [s.sv1] <> readAs [s.dso]) $ exerciseCmd mechanism2 DsoMechanism_RequestVote with
    sv = s.sv1
    action = Native (GA_SetConfig (SetState with new = cfgX; base = r0.config))
    dsoRulesCid = rules2
    targets = [toInterfaceContractId @Target rules2]
    voteRequestTimeout = None
  passTime (days 7)

  -- replay 1: close org1's request container through org2's mechanism —
  -- refused: the container binds its mechanism by contract identity
  submitMustFail (actAs [s.sv1] <> readAs [s.dso]) $ exerciseCmd mechanism2 DsoMechanism_CloseVoteRequest with
    sv = s.sv1
    requestCid = reqX
    dsoRulesCid = rules2
    targets = [toInterfaceContractId @Target rules2]

  -- replay 2: close org2's request container through org1's mechanism —
  -- refused symmetrically
  closeVoteFail s s.sv1 reqY

  -- the honest close under org1 lands unchanged; org2 never moves
  _ <- closeVote s s.sv1 reqX
  (_, r1) <- getRules s
  r1.config.voteCooldownTime === minutes 2
  [(_, o2)] <- queryFilter @DsoRules s.dso (\r -> r.org == "org2")
  o2.config.voteCooldownTime === minutes 9

-- =============================================================================
-- Demo 5 — an action from a new package, base packages untouched (DEMOS.md)
-- =============================================================================

demo_extension : Script ()
demo_extension = do
  s <- setup

  -- the proposal comes from a package the deployed base has never seen
  prop <- submit s.sv1 $ createCmd OffboardAndCompensate with
    dso = s.dso; org = "org1"; proposer = s.sv1; member = s.sv4; amount = 25.0
  req <- requestExtension s s.sv1 (toInterfaceContractId @Action prop)

  -- the same container, casts, and close as every other vote
  req <- castVote s s.sv2 req True
  req <- castVote s s.sv3 req True
  passTime (days 7)
  _ <- closeVote s s.sv1 req

  -- both committed targets moved in one transaction; the proposal is consumed
  (_, r1) <- getRules s
  assert (not (s.sv4 `Map.member` r1.svs))
  assert (s.sv4 `Map.member` r1.offboardedSvs)
  (_, ar1) <- getAmuletRules s
  ar1.reserve === 75.0
  props <- query @OffboardAndCompensate s.sv1
  props === []

  -- a second severance, its reserve binding's state token at price 10.0; the
  -- confirmation workflow moves the price before the close, so the extension's
  -- own driftAborts refuses the stale approval — same rails as the native actions
  prop2 <- submit s.sv1 $ createCmd OffboardAndCompensate with
    dso = s.dso; org = "org1"; proposer = s.sv1; member = s.sv3; amount = 10.0
  req2 <- requestExtension s s.sv1 (toInterfaceContractId @Action prop2)
  req2 <- castVote s s.sv2 req2 True
  let reprice = GA_SetAmuletPrice with newPrice = 10.5
  [x1, x2] <- forA [s.sv1, s.sv2] $ \sv -> confirm s sv reprice
  execute s s.sv1 reprice [x1, x2]
  passTime (days 7)
  closeVoteFail s s.sv1 req2
  (_, r2) <- getRules s
  assert (s.sv3 `Map.member` r2.svs)
