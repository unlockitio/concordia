module Cap.Examples.BabyDso.Cap.Submission where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (isNone, isSome)

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.SubmittableV1
import Cap.Governance.ActionV1 (Action, Stage (..))
import Cap.Governance.BallotV1
import Cap.Governance.BindingV1
import Cap.Governance.Utils (pinStateAt)

-- all voters must agree
data ProposalTerms = ProposalTerms
  with
    options : [AnyValue]
    actionCid : ContractId Action
    entryClosesAt : Time
    votingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

template SvConfirmation
  with
    dso : Party
    sv : Party
    mechanism : Mechanism
    terms : ProposalTerms
    bindings : Map TargetKey Bind
    confirmed : AnyValue
  where
    signatory dso, sv

    ensure confirmed `elem` terms.options

    interface instance Submittable for SvConfirmation where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata

    interface instance Ballot for SvConfirmation where
      view = BallotView with
        opensAt = terms.entryClosesAt
        closesAt = terms.votingClosesAt
        expiresAt = terms.expiresAt
        bindings
        availableActions = Map.empty
        vote = Some confirmed
        meta = emptyMetadata

      ballot_castImpl _ _ = abort "a confirmation carries its choice from creation"

      ballot_withdrawImpl _ _ = abort "a confirmation cannot be withdrawn"

      ballot_expireImpl self _ = do
        archive self
        pure Ballot_ExpireResult with meta = emptyMetadata

      ballot_consumeImpl self _ = do
        archive self
        pure Ballot_ConsumeResult with meta = emptyMetadata

template SvBallot
  with
    dso : Party
    sv : Party
    mechanism : Mechanism
    terms : ProposalTerms
    bindings : Map TargetKey Bind
    vote : Optional AnyValue
  where
    signatory dso
    observer sv

    interface instance Submittable for SvBallot where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata

    interface instance Ballot for SvBallot where
      view = BallotView with
        opensAt = terms.entryClosesAt
        closesAt = terms.votingClosesAt
        expiresAt = terms.expiresAt
        bindings
        availableActions = Map.fromList
          [ (BA_Cast, [[sv]])
          , (BA_Withdraw, [[sv]])
          ]
        vote
        meta = emptyMetadata

      ballot_castImpl self arg = do
        require "this ballot carries no vote yet" (isNone vote)
        action <- fetch terms.actionCid
        pinned <- pinStateAt Submission arg.targets (view action).bindSpec
        archive self
        toInterfaceContractId @Ballot <$>
          create this with vote = Some arg.vote; bindings = pinned

      ballot_withdrawImpl self _ = do
        require "this ballot carries a vote to withdraw" (isSome vote)
        archive self
        _ <- create this with vote = None
        pure Ballot_WithdrawResult with meta = emptyMetadata

      ballot_expireImpl self _ = do
        archive self
        pure Ballot_ExpireResult with meta = emptyMetadata

      ballot_consumeImpl self _ = do
        archive self
        pure Ballot_ConsumeResult with meta = emptyMetadata
