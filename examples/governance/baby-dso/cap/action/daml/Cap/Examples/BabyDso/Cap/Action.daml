module Cap.Examples.BabyDso.Cap.Action where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Optional (whenSome)
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.Utils (ExecutionCore (..), orAbort)
import Cap.Governance.ActionV1
import Cap.Governance.BindingV1
import Cap.Governance.ExecutableV1
import Cap.Governance.Utils (DriftPolicy, holds, typed)

import Cap.Examples.BabyDso.Cap.Ans
import Cap.Examples.BabyDso.Cap.Config


template FeeUpdate
  with
    dso : Party
    transferFee : Decimal
    entryFee : Decimal
    core : ExecutionCore
    bindings : Map TargetKey Bind
    outcome : Optional AnyValue
  where
    signatory dso
    observer concat (concat (Map.values core.availableActions))

    interface instance Executable for FeeUpdate where
      view = ExecutableView with core; bindings; outcome

      executable_cancelImpl _ = abort "this execution cannot be cancelled"

      executable_executeImpl targets _ = do
        configCid <- boundAuthentic (configTargetKey dso)
          transferFeeUnchanged targets bindings
        ansCid <- boundOpaque ansTargetKey targets bindings
        updatedConfig <- exercise (coerceContractId configCid : ContractId AmuletConfig)
          AmuletConfig_SetFee with newTransferFee = transferFee
        updatedAns <- exercise (coerceContractId ansCid : ContractId AnsRules)
          AnsRules_SetFee with newEntryFee = entryFee
        pure Executable_ExecuteResult with
          created = [coerceContractId updatedConfig, coerceContractId updatedAns]
          meta = emptyMetadata

template SetFeesAction
  with
    dso : Party
    svs : Set Party
  where
    signatory dso
    observer Set.toList svs

    ensure wellFormedAt Genesis (setFeesBindSpec dso)

    interface instance Action for SetFeesAction where
      view = ActionView with
        authorizers = [[dso]]
        bindSpec = setFeesBindSpec dso
        meta = emptyMetadata

      action_authorizeExecutionImpl _ arg = do
        (transferFee, entryFee) <-
          orAbort "the execution carries no fees this action can apply" (arg.outcome >>= feesOf)
        cid <- create FeeUpdate with
          dso; transferFee; entryFee
          bindings = arg.bindings
          core = arg.core
          outcome = arg.outcome
        pure Action_AuthorizeExecutionResult with
          executionCids = [toInterfaceContractId cid]
          meta = emptyMetadata


setFeesBindSpec : Party -> Map TargetKey BindSpec
setFeesBindSpec dso = Map.fromList
  [ ( Authentic (configTargetKey dso)
    , BindSpec with
        state = Some (AsOf with stage = Submission; seen = None)
        cid = AsOf with stage = Execution; seen = None
    )
  , ( Opaque ansTargetKey
    , BindSpec with
        state = None
        cid = AsOf with stage = Execution; seen = None
    )
  ]

entryFeeField : Text
entryFeeField = "entryFee"

ansTargetKey : OpaqueTargetKey
ansTargetKey = OpaqueTargetKey "ans-rules"

decimalAt : Text -> TextMap AnyValue -> Optional Decimal
decimalAt field fields = case TextMap.lookup field fields of
  Some (AV_Decimal value) -> Some value
  _ -> None

transferFeeUnchanged : DriftPolicy
transferFeeUnchanged = typed sameFee
  where
    sameFee : TextMap AnyValue -> TextMap AnyValue -> Bool
    sameFee pinned current =
      case (TextMap.lookup transferFeeField pinned, TextMap.lookup transferFeeField current) of
        (Some a, Some b) -> a == b
        _ -> False

feesOf : AnyValue -> Optional (Decimal, Decimal)
feesOf (AV_Map fields) =
  case (decimalAt transferFeeField fields, decimalAt entryFeeField fields) of
    (Some transferFee, Some entryFee) -> Some (transferFee, entryFee)
    _ -> None
feesOf _ = None

boundAuthentic
  : AuthenticTargetKey -> DriftPolicy -> Map TargetKey AnyContractId
  -> Map TargetKey Bind -> Update AnyContractId
boundAuthentic key policy currentTargets bindings = do
  bind <- orAbort "the execution does not bind this target"
    (Map.lookup (Authentic key) bindings)
  cid <- orAbort "the bound target was not presented"
    (Map.lookup (Authentic key) currentTargets)
  presented <- fetchCheckedTarget key (coerceContractId cid)
  require "the target no longer satisfies the bind"
    (holds policy bind (Bind with state = (view presented).state; cid = Some cid))
  pure cid


boundOpaque
  : OpaqueTargetKey -> Map TargetKey AnyContractId -> Map TargetKey Bind
  -> Update AnyContractId
boundOpaque key currentTargets bindings = do
  bind <- orAbort "the execution does not bind this target"
    (Map.lookup (Opaque key) bindings)
  case bind.cid of
    Some pinned -> do
      whenSome (Map.lookup (Opaque key) currentTargets) $ \presented ->
        require "the presented target is the one the bind pins" (presented == pinned)
      pure pinned
    None -> orAbort "the bound target was not presented"
      (Map.lookup (Opaque key) currentTargets)
