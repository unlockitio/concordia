module Cap.Examples.BabyDro.Demo where

import DA.Assert ((===))
import DA.NonEmpty (NonEmpty(..))
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import qualified Splice.Api.Token.MetadataV1 as Metadata
import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.DemoNames
import Canton.Network.Credentials.V1
import Cap.Examples.BabyDro.Registry
import Cap.Examples.BabyDro.Dispute

consortium : Party -> Party -> Party -> Script (ContractId Consortium)
consortium a b c = submit a $ createCmd Consortium with
  founder = a
  members = Set.fromList [a, b, c]
  motions = []
  openCases = []
  ballots = []
  rulings = []

state : Party -> ContractId Consortium -> Script Consortium
state party cid = do
  Some value <- queryContractId party cid
  pure value

propose : Party -> ContractId Consortium -> Membership -> Script (ContractId Consortium)
propose proposer cid proposal = submit proposer $ exerciseCmd cid ProposeMembership with proposer; proposal

membershipVote : Party -> ContractId Consortium -> Membership -> Script (ContractId Consortium)
membershipVote voter cid proposal = submit voter $ exerciseCmd cid VoteMembership with voter; proposal

enact : Party -> ContractId Consortium -> Membership -> Script (ContractId Consortium)
enact enactor cid proposal = submit enactor $ exerciseCmd cid EnactMembership with enactor; proposal

open : Party -> ContractId Consortium -> Party -> Script (ContractId Consortium)
open disputer cid otherRegistry = submit disputer $ exerciseCmd cid OpenDispute with
  disputer; caseId = "case-one"; name = "shared"; otherRegistry; reason = "competing claims"

vote : Party -> ContractId Consortium -> Decision -> Script (ContractId Consortium)
vote voter cid decision = submit voter $ exerciseCmd cid VoteDispute with voter; caseId = "case-one"; decision

rule : Party -> ContractId Consortium -> Decision -> Script (ContractId Consortium)
rule issuer cid decision = submit issuer $ exerciseCmd cid IssueRuling with issuer; caseId = "case-one"; decision

follow : Party -> ContractId Consortium -> Script (ContractId Consortium)
follow registry cid = submit registry $ exerciseCmd cid AcknowledgeFollow with registry; caseId = "case-one"

nameCredential : Party -> Party -> Text -> Time -> CredentialView
nameCredential admin subject name now = CredentialView with
  id = Some ("urn:babydro:" <> name)
  credentialTypes = ["VerifiableCredential", "DemoPartyName"]
  issuer = W3C_VC_Identifier_Party admin
  validFrom = Some now
  validUntil = Some (addRelTime now (days 180))
  credentialSubject = NonEmpty (CredentialSubject
    (Some (W3C_VC_Identifier_Party subject))
    (TextMap.fromList [("demo.example/name", Metadata.AV_Text name)])) []
  holders = []
  anchorers = NonEmpty admin []

register : Party -> Party -> Text -> Time -> Script (ContractId DemoCredential)
register admin subject name now = do
  factory <- submit admin $ createCmd DemoCredentialRegistryFactory with
    registryAdminParty = admin; anchorers = NonEmpty admin []
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  request <- submit subject $ createCmd DemoNameRequest with
    applicant = subject; registryAdmin = admin; name
    credential = nameCredential admin subject name now
    registration
  issued <- submit admin $ exerciseCmd request DemoNameRequest_AcceptAsRegistryIssued with
    factory = toInterfaceContractId @CredentialRegistryFactory factory
  pure (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)

active : Party -> ContractId DemoCredential -> Script Bool
active party cid = do
  result <- queryContractId party cid
  pure (result /= None)

-- The consortium decides disputes; each registry retains control of its CIPs-owned claims.
-- One ordered consumer journey, using the CIPs-owned contracts throughout.
journey : Script ()
journey = script do
  a <- allocateParty "registry-a"
  b <- allocateParty "registry-b"
  c <- allocateParty "registry-c"
  newcomer <- allocateParty "registry-new"
  loser <- allocateParty "claimant-b"
  now <- getTime
  -- Founding registries start the governance membership that can admit and remove members.
  initial <- consortium a b c
  before <- state a initial
  Set.size before.members === 3
  -- A proposal alone cannot admit a registry; another member must support it.
  let admission = Admit newcomer
  proposed <- propose a initial admission
  submitMustFail a $ exerciseCmd proposed EnactMembership with enactor = a; proposal = admission
  supported <- membershipVote b proposed admission
  admitted <- enact a supported admission
  afterAdmission <- state a admitted
  Set.member newcomer afterAdmission.members === True

  -- Each CIPs registry issues its own claims; only "shared" conflicts.
  -- The unrelated names establish the boundary of any later registry action.
  first <- register a a "shared" now
  second <- register b loser "shared" now
  unrelatedA <- register a a "unrelated" now
  unrelatedB <- register b loser "another" now
  isActive <- active a first
  isActive === True
  isActive <- active b second
  isActive === True
  isActive <- active a unrelatedA
  isActive === True
  isActive <- active b unrelatedB
  isActive === True

  -- A member opens the competing-claim case against the other member registry.
  disputed <- open a admitted b
  pending <- state a disputed
  length pending.openCases === 1
  -- One dispute vote is insufficient; a second member backs KeepFirst before ruling.
  oneVote <- vote a disputed KeepFirst
  submitMustFail a $ exerciseCmd oneVote IssueRuling with issuer = a; caseId = "case-one"; decision = KeepFirst
  twoVotes <- vote c oneVote KeepFirst
  ruled <- rule c twoVotes KeepFirst
  -- The ruling records a governance decision, not a CIPs credential mutation.
  isActive <- active a first
  isActive === True
  isActive <- active b second
  isActive === True
  result <- state a ruled
  map (.decision) result.rulings === [KeepFirst]
  map (Set.size . (.followedBy)) result.rulings === [0]

  -- Each registry acknowledges follow separately; registry b archives its own losing claim.
  -- Acknowledgment itself does not archive either credential.
  followedA <- follow a ruled
  isActive <- active b second
  isActive === True
  _ <- submit b $ exerciseCmd (toInterfaceContractId @Credential second) Credential_ArchiveAsAnchorers
  followedB <- follow b followedA
  complete <- state a followedB
  map (Set.size . (.followedBy)) complete.rulings === [2]
  isActive <- active a first
  isActive === True
  isActive <- active b second
  isActive === False
  isActive <- active a unrelatedA
  isActive === True
  isActive <- active b unrelatedB
  isActive === True

  -- Removing the newcomer requires a separate membership vote; existing names survive.
  let removal = Remove newcomer
  removalProposed <- propose b followedB removal
  submitMustFail b $ exerciseCmd removalProposed EnactMembership with enactor = b; proposal = removal
  removalVoted <- membershipVote c removalProposed removal
  removed <- enact b removalVoted removal
  final <- state a removed
  Set.member newcomer final.members === False
  isActive <- active a unrelatedA
  isActive === True
  isActive <- active b unrelatedB
  isActive === True

-- Negative membership checks: outsiders cannot propose, vote, or enact, and
-- even a member cannot enact admission or removal before another vote.
membershipAuthorization : Script ()
membershipAuthorization = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  outsider <- allocateParty "outsider"
  other <- allocateParty "other-outsider"
  cid <- consortium a b c
  submitMustFail outsider $ exerciseCmd cid ProposeMembership with proposer = outsider; proposal = Admit outsider
  proposed <- propose a cid (Admit outsider)
  submitMustFail outsider $ exerciseCmd proposed VoteMembership with voter = outsider; proposal = Admit outsider
  submitMustFail outsider $ exerciseCmd proposed EnactMembership with enactor = outsider; proposal = Admit outsider
  submitMustFail a $ exerciseCmd proposed EnactMembership with enactor = a; proposal = Admit outsider
  approved <- membershipVote b proposed (Admit outsider)
  admitted <- enact a approved (Admit outsider)
  submitMustFail other $ exerciseCmd admitted ProposeMembership with proposer = other; proposal = Remove a
  proposedRemoval <- propose a admitted (Remove outsider)
  submitMustFail other $ exerciseCmd proposedRemoval EnactMembership with enactor = other; proposal = Remove outsider
  submitMustFail a $ exerciseCmd proposedRemoval EnactMembership with enactor = a; proposal = Remove outsider
  approvedRemoval <- membershipVote c proposedRemoval (Remove outsider)
  final <- enact a approvedRemoval (Remove outsider)
  finalState <- state a final
  Set.member outsider finalState.members === False

-- Negative dispute checks: nonmembers cannot open, vote, rule, or acknowledge;
-- a member cannot dispute an outsider registry or rule after only one vote.
unauthorizedDispute : Script ()
unauthorizedDispute = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  outsider <- allocateParty "outsider"
  cid <- consortium a b c
  submitMustFail outsider $ exerciseCmd cid OpenDispute with
    disputer = outsider; caseId = "case-one"; name = "shared"; otherRegistry = b; reason = "claim"
  submitMustFail a $ exerciseCmd cid OpenDispute with
    disputer = a; caseId = "case-one"; name = "shared"; otherRegistry = outsider; reason = "claim"
  disputed <- open a cid b
  submitMustFail outsider $ exerciseCmd disputed VoteDispute with voter = outsider; caseId = "case-one"; decision = KeepFirst
  one <- vote a disputed KeepFirst
  submitMustFail a $ exerciseCmd one IssueRuling with issuer = a; caseId = "case-one"; decision = KeepFirst
  submitMustFail outsider $ exerciseCmd one IssueRuling with issuer = outsider; caseId = "case-one"; decision = KeepFirst
  two <- vote b one KeepFirst
  ruled <- rule a two KeepFirst
  submitMustFail outsider $ exerciseCmd ruled AcknowledgeFollow with registry = outsider; caseId = "case-one"

caseLifecycleGuards : Script ()
caseLifecycleGuards = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  d <- allocateParty "member-d"
  initial <- consortium a b c
  disputed <- open a initial b
  submitMustFail a $ exerciseCmd initial VoteDispute with voter = a; caseId = "case-one"; decision = KeepFirst
  submitMustFail b $ exerciseCmd disputed OpenDispute with
    disputer = b; caseId = "case-one"; name = "shared"; otherRegistry = a; reason = "duplicate"
  removal <- propose a disputed (Remove b)
  supported <- membershipVote c removal (Remove b)
  submitMustFail a $ exerciseCmd supported EnactMembership with enactor = a; proposal = Remove b
  one <- vote a supported KeepFirst
  two <- vote c one KeepFirst
  ruled <- rule c two KeepFirst
  submitMustFail a $ exerciseCmd ruled OpenDispute with
    disputer = a; caseId = "case-one"; name = "shared"; otherRegistry = b; reason = "reuse"
  submitMustFail a $ exerciseCmd ruled EnactMembership with enactor = a; proposal = Remove b
  followedA <- follow a ruled
  submitMustFail a $ exerciseCmd followedA EnactMembership with enactor = a; proposal = Remove b
  followedB <- follow b followedA
  removed <- enact a followedB (Remove b)
  final <- state a removed
  Set.member b final.members === False
  submitMustFail b $ exerciseCmd removed VoteDispute with voter = b; caseId = "case-one"; decision = KeepFirst
  submitMustFail d $ exerciseCmd removed ProposeMembership with proposer = d; proposal = Admit d

currentElectorate : Script ()
currentElectorate = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  d <- allocateParty "member-d"
  initial <- consortium a b c
  let admission = Admit d
  proposed <- propose a initial admission
  approved <- membershipVote b proposed admission
  admitted <- enact a approved admission
  disputed <- open a admitted b
  one <- vote a disputed KeepFirst
  two <- vote c one KeepFirst
  let removal = Remove c
  removalProposed <- propose a two removal
  removalVoted <- membershipVote b removalProposed removal
  removed <- enact a removalVoted removal
  submitMustFail a $ exerciseCmd removed IssueRuling with issuer = a; caseId = "case-one"; decision = KeepFirst
  replacement <- vote d removed KeepFirst
  ruled <- rule a replacement KeepFirst
  result <- state a ruled
  map (.decision) result.rulings === [KeepFirst]
