module Cap.Examples.BabyDro.Demo where

import DA.Assert ((===))
import DA.NonEmpty (NonEmpty(..))
import qualified DA.Set as Set
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import DA.Time (addRelTime, days)
import Daml.Script
import qualified Splice.Api.Token.MetadataV1 as Metadata
import Canton.Network.Credentials.Demo
import Canton.Network.Credentials.DemoNames
import Canton.Network.Credentials.V1
import Cap.Examples.BabyDro.Registry
import Cap.Examples.BabyDro.Dispute

consortium : Party -> Party -> Party -> Script (ContractId Consortium)
consortium a b c = submit a $ createCmd Consortium with
  founder = a; members = Set.fromList [a, b, c]; policy = SnapshotAtOpen; motions = []; cases = Set.empty

state : Party -> ContractId Consortium -> Script Consortium
state party cid = do
  Some value <- queryContractId party cid
  pure value

propose : Party -> ContractId Consortium -> Proposal -> Script (ContractId Consortium)
propose proposer cid proposal = submit proposer $ exerciseCmd cid ProposeChange with proposer; proposal

approve : Party -> ContractId Consortium -> Proposal -> Script (ContractId Consortium)
approve voter cid proposal = submit voter $ exerciseCmd cid VoteChange with voter; proposal

enact : Party -> ContractId Consortium -> Proposal -> Script (ContractId Consortium)
enact enactor cid proposal = submit enactor $ exerciseCmd cid EnactChange with enactor; proposal

change : Party -> Party -> ContractId Consortium -> Proposal -> Script (ContractId Consortium)
change a b cid proposal = do
  proposed <- propose a cid proposal
  submitMustFail a $ exerciseCmd proposed EnactChange with enactor = a; proposal
  approved <- approve b proposed proposal
  enact a approved proposal

open : Party -> ContractId Consortium -> Party -> Text -> Script (ContractId Consortium, ContractId Case)
open disputer cid otherRegistry caseId = submit disputer $ exerciseCmd cid OpenDispute with
  disputer; caseId; name = "shared"; otherRegistry; reason = "competing claims"

invite : Party -> ContractId Case -> Party -> Script (ContractId DisputeInvitation)
invite authority cid voter = submit authority $ exerciseCmd cid Case_Invite with voter

accept : Party -> ContractId Case -> ContractId DisputeInvitation -> Script (ContractId Case, ContractId Ballot)
accept voter caseCid invitation = submit voter $ exerciseCmd invitation DisputeInvitation_Accept with caseCid

cast : Party -> ContractId Case -> ContractId Ballot -> Decision -> Script (ContractId Case, ContractId Ballot)
cast voter caseCid ballotCid decision = submit voter $ exerciseCmd ballotCid Ballot_Cast with caseCid; vote = decision

resolve : Party -> ContractId Consortium -> ContractId Case -> Decision -> Script (ContractId Ruling)
resolve issuer governance caseCid decision = submit issuer $ exerciseCmd governance Consortium_Resolve with issuer; caseCid; decision

nameCredential : Party -> Party -> Text -> Time -> CredentialView
nameCredential admin subject name now = CredentialView with
  id = Some ("urn:babydro:" <> name)
  credentialTypes = ["VerifiableCredential", "DemoPartyName"]
  issuer = W3C_VC_Identifier_Party admin
  validFrom = Some now
  validUntil = Some (addRelTime now (days 180))
  credentialSubject = NonEmpty (CredentialSubject
    (Some (W3C_VC_Identifier_Party subject))
    (TextMap.fromList [("demo.example/name", Metadata.AV_Text name)])) []
  holders = []
  anchorers = NonEmpty admin []

register : Party -> Party -> Text -> Time -> Script (ContractId DemoCredential)
register admin subject name now = do
  factory <- submit admin $ createCmd DemoCredentialRegistryFactory with
    registryAdminParty = admin; anchorers = NonEmpty admin []
  let registration = RegisteredCredentialView admin now (Some (addRelTime now (days 12))) TextMap.empty
  request <- submit subject $ createCmd DemoNameRequest with
    applicant = subject; registryAdmin = admin; name
    credential = nameCredential admin subject name now
    registration
  issued <- submit admin $ exerciseCmd request DemoNameRequest_AcceptAsRegistryIssued with
    factory = toInterfaceContractId @CredentialRegistryFactory factory
  pure (fromInterfaceContractId @DemoCredential @RegisteredCredential issued)

active : Party -> ContractId DemoCredential -> Script Bool
active party cid = do
  result <- queryContractId party cid
  pure (result /= None)

-- CIPs owns credential state. Governance only issues a ruling and acknowledgements.
journey : Script ()
journey = script do
  a <- allocateParty "registry-a"
  b <- allocateParty "registry-b"
  c <- allocateParty "registry-c"
  claimant <- allocateParty "claimant-b"
  now <- getTime
  -- Found the member-governed consortium; one member cannot admit a fourth.
  initial <- consortium a b c
  newcomer <- allocateParty "registry-new"
  admitted <- change a b initial (MembershipChange (Admit newcomer))
  -- Both CIPs registries issue the same canton.name; unrelated claims also exist.
  first <- register a a "shared" now
  second <- register b claimant "shared" now
  unrelatedA <- register a a "unrelated" now
  unrelatedB <- register b claimant "another" now
  -- Open a separate case with a frozen policy and electorate.
  (openedGovernance, caseCid) <- open a admitted b "case-one"
  Some opened <- queryContractId a caseCid
  opened.policy === SnapshotAtOpen
  Set.size opened.eligible === 4
  -- Founder pre-signs invitations. Each voter accepts and casts in its own
  -- transaction, without exercising Consortium in that transaction tree.
  invitationA <- invite a caseCid a
  (oneCase, ballotA) <- accept a caseCid invitationA
  (votedA, _) <- cast a oneCase ballotA KeepFirst
  submitMustFail a $ exerciseCmd openedGovernance Consortium_Resolve with issuer = a; caseCid = votedA; decision = KeepFirst
  invitationC <- invite a votedA c
  (twoCase, ballotC) <- accept c votedA invitationC
  (votedC, _) <- cast c twoCase ballotC KeepFirst
  -- A ruling does not archive either CIPs claim.
  ruling <- resolve a openedGovernance votedC KeepFirst
  isActive <- active a first
  isActive === True
  isActive <- active b second
  isActive === True
  -- Each registry follows independently; only the losing registry archives
  -- its own credential. The other unrelated claims remain active.
  followedA <- submit a $ exerciseCmd ruling Ruling_Follow with registry = a
  isActive <- active b second
  isActive === True
  _ <- submit b $ exerciseCmd (toInterfaceContractId @Credential second) Credential_ArchiveAsAnchorers
  followedB <- submit b $ exerciseCmd followedA Ruling_Follow with registry = b
  Some finalRuling <- queryContractId a followedB
  Set.size finalRuling.followedBy === 2
  isActive <- active b second
  isActive === False
  isActive <- active a unrelatedA
  isActive === True
  isActive <- active b unrelatedB
  isActive === True

-- Membership and policy both require two CURRENT supporters.
membershipAuthorization : Script ()
membershipAuthorization = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  outsider <- allocateParty "outsider"
  cid <- consortium a b c
  submitMustFail outsider $ exerciseCmd cid ProposeChange with proposer = outsider; proposal = MembershipChange (Admit outsider)
  membership <- propose a cid (MembershipChange (Admit outsider))
  submitMustFail a $ exerciseCmd membership EnactChange with enactor = a; proposal = MembershipChange (Admit outsider)
  submitMustFail outsider $ exerciseCmd membership VoteChange with voter = outsider; proposal = MembershipChange (Admit outsider)
  supported <- approve b membership (MembershipChange (Admit outsider))
  admitted <- enact a supported (MembershipChange (Admit outsider))
  policyMotion <- propose a admitted (PolicyChange CurrentMembership)
  submitMustFail a $ exerciseCmd policyMotion EnactChange with enactor = a; proposal = PolicyChange CurrentMembership
  policySupported <- approve b policyMotion (PolicyChange CurrentMembership)
  updated <- enact a policySupported (PolicyChange CurrentMembership)
  result <- state a updated
  result.policy === CurrentMembership

-- Ballot inventory rejects foreign case CIDs and duplicate voters.
unauthorizedDispute : Script ()
unauthorizedDispute = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  outsider <- allocateParty "outsider"
  cid <- consortium a b c
  submitMustFail outsider $ exerciseCmd cid OpenDispute with disputer = outsider; caseId = "bad"; name = "shared"; otherRegistry = b; reason = "claim"
  submitMustFail a $ exerciseCmd cid OpenDispute with disputer = a; caseId = "bad"; name = "shared"; otherRegistry = outsider; reason = "claim"
  (firstGovernance, first) <- open a cid b "first"
  (secondGovernance, second) <- open b firstGovernance a "second"
  invitation <- invite a first b
  submitMustFail outsider $ exerciseCmd invitation DisputeInvitation_Accept with caseCid = first
  submitMustFail b $ exerciseCmd invitation DisputeInvitation_Accept with caseCid = second
  (registered, ballot) <- accept b first invitation
  submitMustFail b $ exerciseCmd registered Case_RegisterBallot with voter = b; previous = None; replacement = ballot
  foreign <- invite a second c
  (_, foreignBallot) <- accept c second foreign
  submitMustFail b $ exerciseCmd registered Case_RegisterBallot with voter = b; previous = Some ballot; replacement = foreignBallot
  (voted, _) <- cast b registered ballot KeepFirst
  submitMustFail a $ exerciseCmd secondGovernance Consortium_Resolve with issuer = a; caseCid = voted; decision = KeepFirst
  submitMustFail outsider $ exerciseCmd secondGovernance Consortium_Resolve with issuer = outsider; caseCid = voted; decision = KeepFirst

-- Removing a voter after opening does not retarget a snapshot case.
caseLifecycleGuards : Script ()
caseLifecycleGuards = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  d <- allocateParty "member-d"
  initial <- consortium a b c
  admitted <- change a b initial (MembershipChange (Admit d))
  (openedGovernance, disputed) <- open a admitted b "snapshot"
  removal <- change a b openedGovernance (MembershipChange (Remove c))
  after <- state a removal
  Set.member c after.members === False
  invitationA <- invite a disputed a
  (one, ballotA) <- accept a disputed invitationA
  (oneVoted, _) <- cast a one ballotA KeepFirst
  invitationC <- invite a oneVoted c
  (two, ballotC) <- accept c oneVoted invitationC
  (twoVoted, _) <- cast c two ballotC KeepFirst
  ruling <- resolve a removal twoVoted KeepFirst
  Some result <- queryContractId a ruling
  result.decision === KeepFirst

-- CurrentMembership excludes a removed voter's ballot even when already cast;
-- a later policy change leaves this case's frozen policy untouched.
currentElectorate : Script ()
currentElectorate = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  d <- allocateParty "member-d"
  initial <- consortium a b c
  admitted <- change a b initial (MembershipChange (Admit d))
  current <- change a b admitted (PolicyChange CurrentMembership)
  (openedGovernance, disputed) <- open a current b "current"
  invitationA <- invite a disputed a
  (one, ballotA) <- accept a disputed invitationA
  (oneVoted, _) <- cast a one ballotA KeepFirst
  invitationC <- invite a oneVoted c
  (two, ballotC) <- accept c oneVoted invitationC
  (twoVoted, _) <- cast c two ballotC KeepFirst
  removed <- change a b openedGovernance (MembershipChange (Remove c))
  switched <- change a b removed (PolicyChange SnapshotAtOpen)
  Some unchanged <- queryContractId a twoVoted
  unchanged.policy === CurrentMembership
  submitMustFail a $ exerciseCmd switched Consortium_Resolve with issuer = a; caseCid = twoVoted; decision = KeepFirst
  invitationD <- invite a twoVoted d
  (three, ballotD) <- accept d twoVoted invitationD
  (threeVoted, _) <- cast d three ballotD KeepFirst
  ruling <- resolve a switched threeVoted KeepFirst
  Some result <- queryContractId a ruling
  result.decision === KeepFirst

-- A parallel founder-signed consortium without this opening cannot resolve it;
-- the archived predecessor cannot be used either.
inventoryBoundary : Script ()
inventoryBoundary = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  initial <- consortium a b c
  (successor, disputed) <- open a initial b "inventory-boundary"
  invitationA <- invite a disputed a
  (one, ballotA) <- accept a disputed invitationA
  (oneVoted, _) <- cast a one ballotA KeepFirst
  invitationB <- invite a oneVoted b
  (two, ballotB) <- accept b oneVoted invitationB
  (twoVoted, _) <- cast b two ballotB KeepFirst
  parallel <- submit a $ createCmd Consortium with
    founder = a; members = Set.fromList [a, c]; policy = SnapshotAtOpen; motions = []; cases = Set.empty
  submitMustFail a $ exerciseCmd parallel Consortium_Resolve with issuer = a; caseCid = twoVoted; decision = KeepFirst
  submitMustFail a $ exerciseCmd initial Consortium_Resolve with issuer = a; caseCid = twoVoted; decision = KeepFirst
  _ <- resolve a successor twoVoted KeepFirst
  pure ()

-- The founder can counterfeit a parallel consortium with a copied inventory;
-- this is an explicit trust boundary, not an expected LF-level rejection.
founderTrustBoundary : Script ()
founderTrustBoundary = script do
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  initial <- consortium a b c
  (proper, disputed) <- open a initial b "founder-boundary"
  invitationA <- invite a disputed a
  (one, ballotA) <- accept a disputed invitationA
  (oneVoted, _) <- cast a one ballotA KeepFirst
  invitationB <- invite a oneVoted b
  (two, ballotB) <- accept b oneVoted invitationB
  (twoVoted, _) <- cast b two ballotB KeepFirst
  real <- state a proper
  forged <- submit a $ createCmd Consortium with
    founder = a; members = Set.fromList [a, b]; policy = CurrentMembership; motions = []; cases = real.cases
  _ <- resolve a forged twoVoted KeepFirst
  pure ()
