-- SPDX-License-Identifier: Apache-2.0

module Cap.Examples.BabyDro.Registry where

import DA.Set (Set)
import qualified DA.Set as Set

-- Entitlement and dispute decisions only. Name credentials live in the CIPs model.
data Decision = KeepFirst | KeepSecond deriving (Eq, Show)

data Case = Case with
    caseId : Text
    name : Text
    firstRegistry : Party
    secondRegistry : Party
    reason : Text
  deriving (Eq, Show)

data Ballot = Ballot with
    voter : Party
    decision : Decision
  deriving (Eq, Show)

data Ruling = Ruling with
    dispute : Case
    decision : Decision
    followedBy : Set Party
  deriving (Eq, Show)

data Membership = Admit Party | Remove Party deriving (Eq, Show)

data Motion = Motion with
    proposal : Membership
    supporters : Set Party
  deriving (Eq, Show)

template Consortium
  with
    founder : Party
    members : Set Party
    motions : [Motion]
    openCases : [Case]
    ballots : [(Text, Ballot)]
    rulings : [Ruling]
  where
    signatory founder
    observer Set.toList members
    ensure Set.size members >= 2

    choice ProposeMembership : ContractId Consortium
      with
        proposer : Party
        proposal : Membership
      controller proposer
      do
        assertMsg "only members propose" (Set.member proposer members)
        assertMsg "proposal already open" (not (any (\m -> m.proposal == proposal) motions))
        case proposal of
          Admit target -> assertMsg "already entitled" (not (Set.member target members))
          Remove target -> assertMsg "not entitled" (Set.member target members)
        create this with motions = Motion proposal (Set.singleton proposer) :: motions

    choice VoteMembership : ContractId Consortium
      with
        voter : Party
        proposal : Membership
      controller voter
      do
        assertMsg "only members vote" (Set.member voter members)
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown membership proposal"
        assertMsg "member already voted" (not (Set.member voter motion.supporters))
        let replacement = motion with supporters = Set.insert voter motion.supporters
        create this with motions = replacement :: filter (\m -> m.proposal /= proposal) motions

    choice EnactMembership : ContractId Consortium
      with
        enactor : Party
        proposal : Membership
      controller enactor
      do
        assertMsg "only members enact" (Set.member enactor members)
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown membership proposal"
        assertMsg "two current members must approve" (Set.size (Set.intersection members motion.supporters) >= 2)
        updated <- case proposal of
          Admit target -> pure (Set.insert target members)
          Remove target -> do
            assertMsg "cannot remove member with an open case" (not (any (\c -> c.firstRegistry == target || c.secondRegistry == target) openCases))
            assertMsg "cannot remove member with an unfollowed ruling" (not (any (\r -> (r.dispute.firstRegistry == target || r.dispute.secondRegistry == target) && Set.size r.followedBy < 2) rulings))
            pure (Set.delete target members)
        assertMsg "at least two members remain" (Set.size updated >= 2)
        create this with members = updated; motions = filter (\m -> m.proposal /= proposal) motions

    choice OpenDispute : ContractId Consortium
      with
        disputer : Party
        caseId : Text
        name : Text
        otherRegistry : Party
        reason : Text
      controller disputer
      do
        assertMsg "only entitled registries dispute" (Set.member disputer members && Set.member otherRegistry members && disputer /= otherRegistry)
        assertMsg "reason and name required" (reason /= "" && name /= "")
        assertMsg "case id already used" (not (any (\c -> c.caseId == caseId) openCases || any (\r -> r.dispute.caseId == caseId) rulings))
        create this with openCases = Case caseId name disputer otherRegistry reason :: openCases

    choice VoteDispute : ContractId Consortium
      with
        voter : Party
        caseId : Text
        decision : Decision
      controller voter
      do
        assertMsg "only members vote" (Set.member voter members)
        assertMsg "unknown case" (any (\c -> c.caseId == caseId) openCases)
        assertMsg "already voted" (not (any (\(id, b) -> id == caseId && b.voter == voter) ballots))
        create this with ballots = (caseId, Ballot voter decision) :: ballots

    choice IssueRuling : ContractId Consortium
      with
        issuer : Party
        caseId : Text
        decision : Decision
      controller issuer
      do
        assertMsg "only members issue rulings" (Set.member issuer members)
        disputed <- case filter (\c -> c.caseId == caseId) openCases of
          [one] -> pure one
          _ -> abort "unknown case"
        let supporters = [b.voter | (id, b) <- ballots, id == caseId, b.decision == decision, Set.member b.voter members]
        assertMsg "two distinct current votes required" (length supporters >= 2)
        create this with
          openCases = filter (\c -> c.caseId /= caseId) openCases
          ballots = filter (\(id, _) -> id /= caseId) ballots
          rulings = Ruling disputed decision Set.empty :: rulings

    -- This is an acknowledgement, not an operation on the CIPs credential.
    choice AcknowledgeFollow : ContractId Consortium
      with
        registry : Party
        caseId : Text
      controller registry
      do
        ruling <- case filter (\r -> r.dispute.caseId == caseId) rulings of
          [one] -> pure one
          _ -> abort "unknown ruling"
        assertMsg "only case registries follow" (registry == ruling.dispute.firstRegistry || registry == ruling.dispute.secondRegistry)
        assertMsg "already followed" (not (Set.member registry ruling.followedBy))
        let updated = ruling with followedBy = Set.insert registry ruling.followedBy
        create this with rulings = updated :: filter (\r -> r.dispute.caseId /= caseId) rulings
