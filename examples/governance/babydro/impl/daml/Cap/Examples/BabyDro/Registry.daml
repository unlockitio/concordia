module Cap.Examples.BabyDro.Registry where

import Prelude hiding (Action)

import DA.Set (Set)
import qualified DA.Set as Set
import qualified DA.Map as Map
import DA.NonEmpty (NonEmpty(..))
import Splice.Api.Token.MetadataV1 (emptyMetadata, ExtraArgs (..), emptyChoiceContext)
import Splice.Util (fetchChecked)
import Cap.Core.Types (AuthenticKey (..), Snapshot (..), ExecutionAction (..), ExecutionCore (..))
import Cap.Governance.ActionV1
import Cap.Governance.ExecutableV1
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.Utils (mergeSnapshots, requireSameKeys, readState, checkTarget, unchanged, castsOf, agreedAction, agreedSnapshots, consumeBallots, HasState (..), Vote (..))
import Canton.Network.Credentials.DemoNames (canonicalName, credentialHasName, hasPartySubject)
import Canton.Network.Credentials.V1
import Cap.Examples.BabyDro.Dispute

losingClaim : Decision -> ContractId Credential -> ContractId Credential -> ContractId Credential
losingClaim KeepFirst _ second = second
losingClaim KeepSecond first _ = first

data Membership = Admit Party | Remove Party deriving (Eq, Show)

data ActiveCase = ActiveCase with
  opening : ContractId NameDispute
  firstRegistry : Party
  secondRegistry : Party
  name : Text
  firstCredential : ContractId Credential
  secondCredential : ContractId Credential
 deriving (Eq, Ord, Show)

matchesClaim : Text -> Party -> CredentialView -> Bool
matchesClaim name registry credential =
  canonicalName name && credentialHasName name credential && hasPartySubject credential &&
  credential.anchorers == NonEmpty registry []

-- The DRO signs the exact founding terms. Each founder accepts separately;
-- accepted founders sign each successor and therefore authorize the final mint.
template GenesisProposal
  with
    dro : Party
    consortiumId : Text
    founders : Set Party
    policy : ElectoratePolicy
    accepted : Set Party
  where
    signatory dro, Set.toList accepted
    observer Set.toList founders
    ensure consortiumId /= "" && Set.size founders >= 2 && not (Set.member dro founders)
      && Set.isSubsetOf accepted founders

    choice Genesis_Accept : ContractId GenesisProposal
      with founder : Party
      controller founder
      do
        assertMsg "not a founder or already accepted" (Set.member founder founders && not (Set.member founder accepted))
        create this with accepted = Set.insert founder accepted

    choice Genesis_Finalize : ContractId Consortium
      controller dro
      do
        assertMsg "every founder must accept" (accepted == founders)
        create Consortium with dro; consortiumId; members = founders; policy; cases = Set.empty

-- Stable identity is (dro, consortiumId). Without keys it is not globally unique.
template Consortium
  with
    dro : Party
    consortiumId : Text
    members : Set Party
    policy : ElectoratePolicy
    cases : Set ActiveCase
  where
    signatory dro, Set.toList members
    ensure consortiumId /= "" && Set.size members >= 2 && not (Set.member dro members)

    nonconsuming choice ProposeMembership : ContractId MembershipMotion
      with
        proposer : Party
        change : Membership
      controller proposer
      do
        assertMsg "only members propose" (Set.member proposer members)
        case change of
          Admit target -> assertMsg "not a new registry" (target /= dro && not (Set.member target members))
          Remove target -> assertMsg "not a member" (Set.member target members)
        create MembershipMotion with
          dro; consortiumId; consortiumCid = self; members; change
          supporters = Set.singleton proposer; root = None

    nonconsuming choice ProposePolicy : ContractId PolicyMotion
      with
        proposer : Party
        targetPolicy : ElectoratePolicy
      controller proposer
      do
        assertMsg "only members propose a change" (Set.member proposer members && targetPolicy /= policy)
        create PolicyMotion with
          dro; consortiumId; consortiumCid = self; members; targetPolicy
          supporters = Set.singleton proposer; root = None

    choice ApplyRemoval : ContractId Consortium
      with
        target : Party
        authorizedMotion : ContractId MembershipMotion
      controller dro, Set.toList members
      do
        motion <- fetch authorizedMotion
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.change == Remove target && Set.size motion.supporters >= 2)
        assertMsg "at least two members remain" (Set.member target members && Set.size members > 2)
        assertMsg "registry participates in an active dispute" (all (\activeCase -> target /= activeCase.firstRegistry && target /= activeCase.secondRegistry) (Set.toList cases))
        create this with members = Set.delete target members

    choice ApplyPolicy : ContractId Consortium
      with
        targetPolicy : ElectoratePolicy
        authorizedMotion : ContractId PolicyMotion
      controller dro, Set.toList members
      do
        motion <- fetch authorizedMotion
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.targetPolicy == targetPolicy && Set.size motion.supporters >= 2)
        assertMsg "policy already in force" (targetPolicy /= policy)
        create this with policy = targetPolicy

    choice EnactAdmission : ContractId Consortium
      with
        target : Party
        authorizedMotion : ContractId MembershipMotion
        acceptedConsent : ContractId AdmissionConsent
      controller target
      do
        motion <- fetch authorizedMotion
        consent <- fetch acceptedConsent
        assertMsg "consent mismatch" (consent.motionCid == authorizedMotion && consent.consortiumCid == self && consent.target == target)
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.change == Admit target && Set.size motion.supporters >= 2)
        assertMsg "DRO cannot join the registry" (target /= dro && not (Set.member target members))
        create this with members = Set.insert target members

    choice OpenDispute : (ContractId Consortium, ContractId NameDispute)
      with
        disputer : Party
        caseId : Text
        name : Text
        otherRegistry : Party
        reason : Text
        firstCredential : ContractId Credential
        secondCredential : ContractId Credential
      controller disputer
      do
        assertMsg "only entitled registries dispute" (Set.member disputer members && Set.member otherRegistry members && disputer /= otherRegistry)
        assertMsg "reason and name required" (reason /= "" && name /= "" && caseId /= "")
        assertMsg "distinct credential IDs required" (firstCredential /= secondCredential)
        firstView <- view <$> fetch firstCredential
        secondView <- view <$> fetch secondCredential
        assertMsg "first credential does not match the claim and registry" (matchesClaim name disputer firstView)
        assertMsg "second credential does not match the claim and registry" (matchesClaim name otherRegistry secondView)
        firstActionCid <- create ArchiveClaimAction with
          dro; caseToken = caseId; name; firstRegistry = disputer; secondRegistry = otherRegistry
          firstCredential; secondCredential; decision = KeepFirst
        secondActionCid <- create ArchiveClaimAction with
          dro; caseToken = caseId; name; firstRegistry = disputer; secondRegistry = otherRegistry
          firstCredential; secondCredential; decision = KeepSecond
        caseCid <- create NameDispute with
          caseAuthority = dro
          caseToken = caseId
          caseId; name; firstRegistry = disputer; secondRegistry = otherRegistry; reason
          firstCredential; secondCredential
          policy; voters = members; eligible = members; ballots = Map.empty; openingCaseCid = None
          firstAction = toInterfaceContractId firstActionCid; secondAction = toInterfaceContractId secondActionCid
        successor <- create this with cases = Set.insert (ActiveCase caseCid disputer otherRegistry name firstCredential secondCredential) cases
        pure (successor, caseCid)

    choice Consortium_Resolve : ContractId Ruling
      with
        issuer : Party
        caseCid : ContractId NameDispute
        decision : Decision
      controller issuer
      do
        disputed <- fetchChecked dro caseCid
        let opening = case disputed.openingCaseCid of
              None -> caseCid
              Some original -> original
        let activeCase = ActiveCase opening disputed.firstRegistry disputed.secondRegistry disputed.name disputed.firstCredential disputed.secondCredential
        assertMsg "case not opened by this consortium chain" (Set.member activeCase cases)
        assertMsg "only the DRO issues rulings" (issuer == dro)
        let electorate = case disputed.policy of
              SnapshotAtOpen -> disputed.eligible
              CurrentMembership -> Set.intersection disputed.eligible members
        presented <- forA (Map.toList disputed.ballots) $ \(voter, ballotCid) -> do
          ballot <- fetch ballotCid
          assertMsg "foreign ballot in inventory" (ballot.caseAuthority == disputed.caseAuthority && ballot.caseToken == disputed.caseToken && ballot.caseId == disputed.caseId && ballot.voter == voter && ballot.firstAction == disputed.firstAction && ballot.secondAction == disputed.secondAction && ballot.caseState == toAnyValue (stateOf disputed))
          pure (ballotCid, ballot)
        let eligibleBallots = [(cid, ballot) | (cid, ballot) <- presented, Set.member ballot.voter electorate]
        casts <- castsOf Some electorate (map snd eligibleBallots)
        let supporters = Set.fromList [voter | (voter, cast) <- Map.toList casts, cast.vote == Voted decision]
        let opposite = case decision of KeepFirst -> KeepSecond; KeepSecond -> KeepFirst
        let opposing = Set.fromList [voter | (voter, cast) <- Map.toList casts, cast.vote == Voted opposite]
        assertMsg "exactly one decision must qualify" (Set.size supporters >= 2 && Set.size opposing < 2)
        let actionCid = case decision of KeepFirst -> disputed.firstAction; KeepSecond -> disputed.secondAction
        let supportingBallots = [ballot | (_, ballot) <- eligibleBallots, ballot.decision == Some decision]
        agreed <- agreedAction supportingBallots
        assertMsg "ballots authorize another action" (agreed == actionCid)
        ballotSnapshots <- agreedSnapshots supportingBallots
        let losingCredential = losingClaim decision disputed.firstCredential disputed.secondCredential
        let stateKey = disputeKey dro disputed.caseToken
        liveState <- readState @NameDispute stateKey (coerceContractId caseCid)
        assertMsg "ballot state differs from the live case" (ballotSnapshots == Map.fromList [(stateKey, Snapshot with state = liveState; cid = None)])
        now <- getTime
        authorized <- exercise actionCid Action_AuthorizeExecution with
          actors = [dro]
          executionCore = ExecutionCore with
            authorities = Set.singleton dro
            availableActions = Map.fromList [(EA_Execute, [[dro]])]
            opensAt = now
            cancelAfter = now
            expiresAt = None
            meta = emptyMetadata
          outcome = None
          snapshots = ballotSnapshots
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        let [executionCid] = authorized.executionCids
        _ <- exercise executionCid Executable_Execute with
          actors = [dro]
          targetCids = Map.fromList [(claimKey dro, coerceContractId losingCredential), (stateKey, coerceContractId caseCid)]
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        consumeBallots (map fst presented)
        archive disputed.firstAction
        archive disputed.secondAction
        _ <- exercise caseCid NameDispute_Close
        _ <- create this with cases = Set.delete activeCase cases
        create Ruling with
          caseAuthority = disputed.caseAuthority
          caseToken = disputed.caseToken
          caseId = disputed.caseId
          name = disputed.name
          firstRegistry = disputed.firstRegistry
          secondRegistry = disputed.secondRegistry
          decision
          followedBy = Set.empty

claimKey : Party -> AuthenticKey
claimKey dro = AuthenticKey with authorities = Set.singleton dro; id = "losing-credential"

template ArchiveClaimAction
  with
    dro : Party
    caseToken : Text
    name : Text
    firstRegistry : Party
    secondRegistry : Party
    firstCredential : ContractId Credential
    secondCredential : ContractId Credential
    decision : Decision
  where
    signatory [dro, firstRegistry, secondRegistry]

    interface instance Action for ArchiveClaimAction where
      view = ActionView with
        authorizers = [[dro]]
        targets = Map.fromList
          [(claimKey dro, Snapshot with state = None; cid = Some (coerceContractId (losingClaim decision firstCredential secondCredential)))
          ,(disputeKey dro caseToken, Snapshot with state = None; cid = None)]
        meta = emptyMetadata

      action_readStateImpl key cid =
        if key == disputeKey dro caseToken then readState @NameDispute key cid
        else do
          let losingCredential = losingClaim decision firstCredential secondCredential
          assertMsg "wrong credential target" (key == claimKey dro && cid == coerceContractId losingCredential)
          _ <- fetch losingCredential
          pure None

      action_authorizeExecutionImpl _ arg = do
        snapshots <- mergeSnapshots (view (toInterface @Action this)).targets arg.snapshots
        executionCid <- create ArchiveClaimExecution with
          dro; caseToken; name; firstRegistry; secondRegistry; firstCredential; secondCredential; decision
          core = arg.executionCore; snapshots
        pure Action_AuthorizeExecutionResult with
          executionCids = [toInterfaceContractId executionCid]
          meta = emptyMetadata

template ArchiveClaimExecution
  with
    dro : Party
    caseToken : Text
    name : Text
    firstRegistry : Party
    secondRegistry : Party
    firstCredential : ContractId Credential
    secondCredential : ContractId Credential
    decision : Decision
    core : ExecutionCore
    snapshots : Map.Map AuthenticKey Snapshot
  where
    signatory [dro, firstRegistry, secondRegistry]

    interface instance Executable for ArchiveClaimExecution where
      view = ExecutableView with executionCore = core; snapshots; outcome = None

      executable_cancelImpl _ = abort "claim execution cannot be cancelled"

      executable_executeImpl targetCids _ = do
        requireSameKeys snapshots targetCids
        let losingCredential = losingClaim decision firstCredential secondCredential
        assertMsg "wrong frozen credential" (Map.lookup (claimKey dro) targetCids == Some (coerceContractId losingCredential))
        let stateKey = disputeKey dro caseToken
        (_, disputed) <- checkTarget @NameDispute unchanged stateKey snapshots targetCids
        assertMsg "action belongs to another dispute" (disputed.name == name && disputed.firstRegistry == firstRegistry && disputed.secondRegistry == secondRegistry && disputed.firstCredential == firstCredential && disputed.secondCredential == secondCredential)
        _ <- fetch losingCredential
        _ <- exercise losingCredential Credential_ArchiveAsAnchorers
        pure Executable_ExecuteResult with created = []; meta = emptyMetadata

template MembershipMotion
  with
    dro : Party
    consortiumId : Text
    consortiumCid : ContractId Consortium
    members : Set Party
    change : Membership
    supporters : Set Party
    root : Optional (ContractId MembershipMotion)
  where
    signatory dro, Set.toList members
    ensure Set.isSubsetOf supporters members

    choice Membership_Vote : ContractId MembershipMotion
      with voter : Party
      controller voter
      do
        assertMsg "duplicate or ineligible vote" (Set.member voter members && not (Set.member voter supporters))
        let origin = case root of None -> self; Some original -> original
        create this with supporters = Set.insert voter supporters; root = Some origin

    nonconsuming choice Membership_Enact : ContractId Consortium
      with enactor : Party
      controller enactor
      do
        assertMsg "only current members enact" (Set.member enactor members)
        assertMsg "two members must approve" (Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.members == members)
        case change of
          Admit _ -> abort "candidate must accept invitation"
          Remove target -> do
            assertMsg "at least two members remain" (Set.size members > 2)
            exercise consortiumCid ApplyRemoval with target; authorizedMotion = self

    nonconsuming choice Membership_Invite : ContractId AdmissionInvitation
      with inviter : Party
      controller inviter
      do
        assertMsg "only supported admission can invite" (Set.member inviter members && Set.size supporters >= 2)
        target <- case change of Admit party -> pure party; Remove _ -> abort "not admission"
        _ <- fetch consortiumCid
        create AdmissionInvitation with dro; consortiumId; members; target; consortiumCid; motionCid = self

    nonconsuming choice Membership_Admit : ContractId Consortium
      with
        target : Party
        acceptedConsent : ContractId AdmissionConsent
      controller target
      do
        assertMsg "wrong target or insufficient support" (change == Admit target && Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.members == members)
        exercise consortiumCid EnactAdmission with target; authorizedMotion = self; acceptedConsent

template PolicyMotion
  with
    dro : Party
    consortiumId : Text
    consortiumCid : ContractId Consortium
    members : Set Party
    targetPolicy : ElectoratePolicy
    supporters : Set Party
    root : Optional (ContractId PolicyMotion)
  where
    signatory dro, Set.toList members
    ensure Set.isSubsetOf supporters members

    choice Policy_Vote : ContractId PolicyMotion
      with voter : Party
      controller voter
      do
        assertMsg "duplicate or ineligible vote" (Set.member voter members && not (Set.member voter supporters))
        let origin = case root of None -> self; Some original -> original
        create this with supporters = Set.insert voter supporters; root = Some origin

    nonconsuming choice Policy_Enact : ContractId Consortium
      with enactor : Party
      controller enactor
      do
        assertMsg "only members enact" (Set.member enactor members)
        assertMsg "two members must approve" (Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.members == members)
        exercise consortiumCid ApplyPolicy with targetPolicy; authorizedMotion = self

template AdmissionInvitation
  with
    dro : Party
    consortiumId : Text
    members : Set Party
    target : Party
    consortiumCid : ContractId Consortium
    motionCid : ContractId MembershipMotion
  where
    signatory dro, Set.toList members
    observer target

    choice AdmissionInvitation_Accept : ContractId AdmissionConsent
      controller target
      do
        create AdmissionConsent with dro; consortiumId; members; target; consortiumCid; motionCid

template AdmissionConsent
  with
    dro : Party
    consortiumId : Text
    members : Set Party
    target : Party
    consortiumCid : ContractId Consortium
    motionCid : ContractId MembershipMotion
  where
    signatory target
    observer Set.toList members

    nonconsuming choice AdmissionConsent_Finalize : ContractId Consortium
      with enactor : Party
      controller enactor
      do
        assertMsg "only invited members finalize" (Set.member enactor members)
        consortium <- fetch consortiumCid
        motion <- fetch motionCid
        assertMsg "invitation authority or membership changed" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.members == members && motion.consortiumCid == consortiumCid && motion.change == Admit target)
        exercise motionCid Membership_Admit with target; acceptedConsent = self
