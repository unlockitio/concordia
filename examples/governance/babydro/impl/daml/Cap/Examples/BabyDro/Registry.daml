module Cap.Examples.BabyDro.Registry where

import Prelude hiding (Action)

import DA.Set (Set)
import DA.Foldable (forA_)
import qualified DA.Set as Set
import qualified DA.Map as Map
import DA.NonEmpty (NonEmpty(..))
import Splice.Api.Token.MetadataV1 (emptyMetadata, ExtraArgs (..), emptyChoiceContext)
import Splice.Util (fetchChecked)
import Cap.Core.Types (AuthenticKey (..), Snapshot (..), ExecutionAction (..), ExecutionCore (..))
import Cap.Governance.ActionV1
import Cap.Governance.ExecutableV1
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.Utils (mergeSnapshots, requireSameKeys, readState, checkTarget, unchanged, castsOf, agreedAction, agreedSnapshots, consumeBallots, HasState (..), Vote (..))
import Canton.Network.Credentials.DemoNames (canonicalName, credentialHasName, hasPartySubject)
import Canton.Network.Credentials.V1
import Cap.Examples.BabyDro.Dispute
import Cap.Examples.BabyDro.Rights

winnerOf : Decision -> Party -> Party -> Party
winnerOf KeepFirst first _ = first
winnerOf KeepSecond _ second = second
winnerOf (KeepRegistry registry) _ _ = registry

data Membership = Admit Party | Remove Party deriving (Eq, Show)

data ActiveCase = ActiveCase with
  opening : ContractId NameDispute
  firstRegistry : Party
  secondRegistry : Party
  name : Text
  firstCredential : ContractId Credential
  secondCredential : ContractId Credential
  claims : Map.Map Party (ContractId Credential)
   deriving (Eq, Ord, Show)

matchesClaim : Text -> Party -> CredentialView -> Bool
matchesClaim name registry credential =
  canonicalName name && credentialHasName name credential && hasPartySubject credential &&
  credential.anchorers == NonEmpty registry []

-- The DRO signs the exact founding terms. Each founder accepts separately;
-- accepted founders sign each successor and therefore authorize the final mint.
template GenesisProposal
  with
    dro : Party
    consortiumId : Text
    founders : Set Party
    policy : ElectoratePolicy
    accepted : Set Party
  where
    signatory dro, Set.toList accepted
    observer Set.toList founders
    ensure consortiumId /= "" && Set.size founders >= 2 && not (Set.member dro founders)
      && Set.isSubsetOf accepted founders

    choice Genesis_Accept : ContractId GenesisProposal
      with founder : Party
      controller founder
      do
        assertMsg "not a founder or already accepted" (Set.member founder founders && not (Set.member founder accepted))
        create this with accepted = Set.insert founder accepted

    choice Genesis_Finalize : ContractId Consortium
      controller dro
      do
        assertMsg "every founder must accept" (accepted == founders)
        create Consortium with
          dro; consortiumId; policy; cases = Set.empty
          admitted = Map.fromList [(founder, 1) | founder <- Set.toList founders]
          stints = Map.fromList [(founder, 1) | founder <- Set.toList founders]

-- Stable identity is (dro, consortiumId). Without keys it is not globally unique.
--
-- The consortium records *that* a member is entitled and for which stint; it
-- never holds a voting right contract ID. A right minted inside an all-member
-- choice would be disclosed to every member, so entitlement is only invited
-- here and the credential is created in a separate DRO-and-member transaction.
--
-- `stints` keeps the highest stint number ever issued to a party, including
-- parties no longer admitted, so re-admission always allocates a fresh one.
template Consortium
  with
    dro : Party
    consortiumId : Text
    admitted : Map.Map Party Int
    stints : Map.Map Party Int
    policy : ElectoratePolicy
    cases : Set ActiveCase
  where
    signatory dro, Map.keys admitted
    ensure consortiumId /= "" && Map.size admitted >= 2 && Map.lookup dro admitted == None
      && all (\(party, stint) -> Map.lookup party stints == Some stint) (Map.toList admitted)

    -- Decision-free terms only: who may hold a right and until when. No
    -- credential and no route is named, so the all-member witnesses of this
    -- choice learn nothing about the credential that follows.
    nonconsuming choice InviteRight : ContractId VotingRightInvitation
      with
        member : Party
        expiresAt : Time
      controller dro
      do
        now <- getTime
        assertMsg "invitation must expire in the future" (expiresAt > now)
        case Map.lookup member admitted of
          None -> abort "only admitted members receive rights"
          Some stint -> create VotingRightInvitation with dro; consortiumId; member; stint; expiresAt

    nonconsuming choice ProposeMembership : ContractId MembershipMotion
      with
        proposer : Party
        proposerRight : RightRef
        change : Membership
      controller proposer
      do
        requireEntitlement dro consortiumId admitted proposer proposerRight
        case change of
          Admit target -> assertMsg "not a new registry" (target /= dro && not (Map.member target admitted))
          Remove target -> assertMsg "not a member" (Map.member target admitted)
        create MembershipMotion with
          dro; consortiumId; consortiumCid = self; admitted; change
          supporters = Set.singleton proposer; root = None

    nonconsuming choice ProposePolicy : ContractId PolicyMotion
      with
        proposer : Party
        proposerRight : RightRef
        targetPolicy : ElectoratePolicy
      controller proposer
      do
        assertMsg "policy already in force" (targetPolicy /= policy)
        requireEntitlement dro consortiumId admitted proposer proposerRight
        create PolicyMotion with
          dro; consortiumId; consortiumCid = self; admitted; targetPolicy
          supporters = Set.singleton proposer; root = None

    choice ApplyRemoval : ContractId Consortium
      with
        target : Party
        authorizedMotion : ContractId MembershipMotion
      controller dro, Map.keys admitted
      do
        motion <- fetch authorizedMotion
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.change == Remove target && Set.size motion.supporters >= 2)
        assertMsg "at least two members remain" (Map.member target admitted && Map.size admitted > 2)
        assertMsg "registry participates in an active dispute" (all (\activeCase -> Map.lookup target activeCase.claims == None) (Set.toList cases))
        -- The removed member's credential stays live; this contract cannot
        -- archive it. Dropping the party from `admitted` is what retires the
        -- entitlement, and `stints` remembers the stint so a later
        -- re-admission cannot reuse it.
        create this with admitted = Map.delete target admitted

    choice ApplyPolicy : ContractId Consortium
      with
        targetPolicy : ElectoratePolicy
        authorizedMotion : ContractId PolicyMotion
      controller dro, Map.keys admitted
      do
        motion <- fetch authorizedMotion
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.targetPolicy == targetPolicy && Set.size motion.supporters >= 2)
        assertMsg "policy already in force" (targetPolicy /= policy)
        create this with policy = targetPolicy

    choice EnactAdmission : ContractId Consortium
      with
        target : Party
        authorizedMotion : ContractId MembershipMotion
        acceptedConsent : ContractId AdmissionConsent
      controller target
      do
        motion <- fetch authorizedMotion
        consent <- fetch acceptedConsent
        assertMsg "consent mismatch" (consent.motionCid == authorizedMotion && consent.consortiumCid == self && consent.target == target)
        assertMsg "wrong motion" (motion.consortiumCid == self && motion.change == Admit target && Set.size motion.supporters >= 2)
        assertMsg "DRO cannot join the registry" (target /= dro && not (Map.member target admitted))
        -- A fresh stint number, so a right issued during an earlier stint
        -- cannot be presented again after re-admission.
        let stint = optional 1 (+ 1) (Map.lookup target stints)
        create this with
          admitted = Map.insert target stint admitted
          stints = Map.insert target stint stints

    choice OpenDispute : (ContractId Consortium, ContractId NameDispute)
      with
        disputer : Party
        disputerRight : RightRef
        caseId : Text
        name : Text
        otherRegistry : Party
        reason : Text
        firstCredential : ContractId Credential
        secondCredential : ContractId Credential
        additionalClaims : Map.Map Party (ContractId Credential)
      controller disputer
      do
        let members = Set.fromList (Map.keys admitted)
        assertMsg "only entitled registries dispute" (Map.member disputer admitted && Map.member otherRegistry admitted && disputer /= otherRegistry)
        -- Only the submitter proves its own entitlement. A co-participant's
        -- right is its own private credential; demanding it here would force
        -- every opener to read foreign rights.
        requireEntitlement dro consortiumId admitted disputer disputerRight
        assertMsg "reason and name required" (reason /= "" && name /= "" && caseId /= "")
        assertMsg "distinct credential IDs required" (firstCredential /= secondCredential)
        assertMsg "duplicate participant" (Map.lookup disputer additionalClaims == None && Map.lookup otherRegistry additionalClaims == None)
        let claims = Map.insert disputer firstCredential (Map.insert otherRegistry secondCredential additionalClaims)
        assertMsg "all claimants must be admitted members" (all (\registry -> Map.member registry admitted) (Map.keys claims))
        assertMsg "distinct credential IDs required" (Set.size (Set.fromList (map snd (Map.toList claims))) == Map.size claims)
        forA_ (Map.toList claims) $ \(registry, credentialCid) -> do
          credential <- view <$> fetch credentialCid
          assertMsg "credential does not match the claim and registry" (matchesClaim name registry credential)
        actionPairs <- forA (Map.toList claims) $ \(registry, _) -> do
          actionCid <- create ArchiveClaimAction with
            dro; caseToken = caseId; name; claims; winner = registry
          pure (registry, toInterfaceContractId actionCid)
        let actions = Map.fromList actionPairs
        let Some firstAction = Map.lookup disputer actions
        let Some secondAction = Map.lookup otherRegistry actions
        caseCid <- create NameDispute with
          caseAuthority = dro
          caseToken = caseId
          consortiumId; caseId; name; firstRegistry = disputer; secondRegistry = otherRegistry; reason
          firstCredential; secondCredential; claims
          policy; voters = members; eligible = members; admitted; registered = Set.empty; openingCaseCid = None
          firstAction; secondAction; actions
        -- The tally root for this case is minted here, by the consortium, so
        -- the honest resolution path is bound to this exact case from the
        -- start. It is signed by the DRO alone, which is what keeps the ballot
        -- reads it performs out of every member's transaction projection.
        _ <- create DisputeResolver with dro; consortiumId; caseToken = caseId; caseId
        successor <- create this with cases = Set.insert (ActiveCase caseCid disputer otherRegistry name firstCredential secondCredential claims) cases
        pure (successor, caseCid)

    -- The member-visible half of a resolution. It is exercised as a nested
    -- child of the DRO-only tally root, so every consortium member sees this
    -- node and everything below it: the aggregate outcome, the loser archive,
    -- the closed case, the ruling and the successor.
    --
    -- It deliberately fetches no ballot, no voting right and no tally detail.
    -- The only vote-derived input is the decision itself, and the receipt that
    -- states which roll it was tallied over. Members therefore learn the
    -- outcome and trust the DRO's count; they cannot read any decision.
    choice Consortium_PublishRuling : ContractId Ruling
      with
        caseCid : ContractId NameDispute
        decision : Decision
        receiptCid : ContractId TallyReceipt
        -- The case's tally root is spent here. This bounds replay within
        -- the honest resolver flow, but it is not a cryptographic proof of
        -- the count: the DRO can exercise this choice directly and can mint
        -- its own receipt. Members explicitly trust the DRO's tally.
        resolverCid : ContractId DisputeResolver
      controller dro
      do
        receipt <- fetch receiptCid
        resolver <- fetch resolverCid
        disputed <- fetchChecked dro caseCid
        assertMsg "resolver belongs to another case" (resolver.dro == dro && resolver.consortiumId == consortiumId
          && resolver.caseToken == disputed.caseToken && resolver.caseId == disputed.caseId)
        assertMsg "receipt belongs to another case" (receipt.dro == dro && receipt.consortiumId == consortiumId
          && receipt.caseToken == disputed.caseToken && receipt.caseId == disputed.caseId
          && receipt.decision == decision)
        -- A published ruling is always tallied over the case's complete,
        -- authoritative roll of ballot slots. A resolution that omitted an
        -- opposing voter's slot cannot be published through this choice.
        assertMsg "tally roll differs from the case roll" (receipt.roll == disputed.registered)
        let opening = case disputed.openingCaseCid of
              None -> caseCid
              Some original -> original
        let activeCase = ActiveCase opening disputed.firstRegistry disputed.secondRegistry disputed.name disputed.firstCredential disputed.secondCredential disputed.claims
        assertMsg "case not opened by this consortium chain" (Set.member activeCase cases)
        let winner = winnerOf decision disputed.firstRegistry disputed.secondRegistry
        assertMsg "winner not in the frozen claims" (Map.lookup winner disputed.claims /= None)
        assertMsg "receipt names another winner" (receipt.winner == winner)
        let Some actionCid = Map.lookup winner disputed.actions
        let stateKey = disputeKey dro disputed.caseToken
        -- Derived from the live case here, not taken from the caller. The
        -- root separately proved the counted ballots agreed on this same
        -- state, using reads no member witnesses.
        liveState <- readState @NameDispute stateKey (coerceContractId caseCid)
        let snapshots = Map.fromList [(stateKey, Snapshot with state = liveState; cid = None)]
        now <- getTime
        authorized <- exercise actionCid Action_AuthorizeExecution with
          actors = [dro]
          executionCore = ExecutionCore with
            authorities = Set.singleton dro
            availableActions = Map.fromList [(EA_Execute, [[dro]])]
            opensAt = now
            cancelAfter = now
            expiresAt = None
            meta = emptyMetadata
          outcome = None
          snapshots
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        let [executionCid] = authorized.executionCids
        let targets = Map.insert stateKey (coerceContractId caseCid) (Map.fromList [(claimKey dro registry, coerceContractId credential) | (registry, credential) <- Map.toList disputed.claims, registry /= winner])
        _ <- exercise executionCid Executable_Execute with
          actors = [dro]
          targetCids = targets
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        forA_ (map snd (Map.toList disputed.actions)) archive
        _ <- exercise caseCid NameDispute_Close
        -- The receipt and the case's tally root are both spent, so one tally
        -- cannot publish two rulings and a case cannot be resolved twice.
        archive receiptCid
        archive resolverCid
        _ <- create this with cases = Set.delete activeCase cases
        create Ruling with
          caseAuthority = disputed.caseAuthority
          caseToken = disputed.caseToken
          consortiumId = disputed.consortiumId
          caseId = disputed.caseId
          name = disputed.name
          firstRegistry = disputed.firstRegistry
          secondRegistry = disputed.secondRegistry
          decision; winner; participants = Set.fromList (Map.keys disputed.claims)
          electorate = Set.union disputed.voters (Set.fromList (Map.keys admitted))
          followedBy = Set.empty

-- What a tally asserts about itself, for the member-visible half of the
-- resolution and for a later auditor. It carries the roll it counted and the
-- outcome, never a vote.
template TallyReceipt
  with
    dro : Party
    consortiumId : Text
    caseToken : Text
    caseId : Text
    roll : Set Party
    decision : Decision
    winner : Party
  where
    signatory dro

-- The private tally root. Signed by the DRO alone: a transaction rooted here
-- is projected to no member, so the ballot and voting-right reads it performs
-- stay between the DRO and each ballot's own voter. The aggregate reaches the
-- members through the nested `Consortium_PublishRuling` child, which they are
-- informees of, and a Daml projection gives a party the nodes it is informee
-- of plus their descendants, never a sibling subtree.
template DisputeResolver
  with
    dro : Party
    consortiumId : Text
    caseToken : Text
    caseId : Text
  where
    signatory dro
    ensure consortiumId /= "" && caseToken /= "" && caseId /= ""

    -- Nonconsuming here, because the resolver is spent by the member-visible
    -- publishing child instead: that is what makes "one published ruling per
    -- case" a property of the member-observed half of the transaction, not
    -- only of the private root.
    nonconsuming choice Resolver_Resolve : ContractId Ruling
      with
        consortiumCid : ContractId Consortium
        caseCid : ContractId NameDispute
        decision : Decision
        -- Every slot on the case roll, by voter. Not a caller-chosen subset:
        -- the keys must be exactly the roll.
        slots : Map.Map Party (ContractId Ballot)
      controller dro
      do
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId)
        disputed <- fetchChecked dro caseCid
        assertMsg "resolver belongs to another case" (disputed.consortiumId == consortiumId
          && disputed.caseToken == caseToken && disputed.caseId == caseId)
        let opening = case disputed.openingCaseCid of
              None -> caseCid
              Some original -> original
        let activeCase = ActiveCase opening disputed.firstRegistry disputed.secondRegistry disputed.name disputed.firstCredential disputed.secondCredential disputed.claims
        assertMsg "case not opened by this consortium chain" (Set.member activeCase consortium.cases)
        -- The complete authoritative roll, so a resolution cannot silently
        -- omit an opposing voter's slot. The roll only ever grew, through
        -- case-authority-signed invitations.
        assertMsg "presented slots are not exactly the case roll"
          (Map.keys slots == Set.toList disputed.registered)
        let members = Set.fromList (Map.keys consortium.admitted)
        let electorate = case disputed.policy of
              SnapshotAtOpen -> disputed.eligible
              CurrentMembership -> Set.intersection disputed.eligible members
        -- Each slot is bound to this case and this voter. A ballot minted for
        -- another case, carrying another case's actions or another case's
        -- frozen state, or belonging to another voter, is refused here; and a
        -- superseded generation no longer fetches at all, because every cast
        -- and withdrawal consumed its predecessor.
        presented <- forA (Map.toList slots) $ \(voter, ballotCid) -> do
          ballot <- fetch ballotCid
          assertMsg "foreign ballot slot" (ballot.caseAuthority == disputed.caseAuthority && ballot.caseToken == disputed.caseToken && ballot.consortiumId == disputed.consortiumId && ballot.caseId == disputed.caseId && ballot.voter == voter && ballot.firstAction == disputed.firstAction && ballot.secondAction == disputed.secondAction && ballot.actions == disputed.actions && ballot.caseState == toAnyValue (stateOf disputed))
          pure (ballotCid, ballot)
        let eligibleBallots = [(cid, ballot) | (cid, ballot) <- presented, Set.member ballot.voter electorate]
        -- Each ballot carries the right its voter presented when registering.
        -- The DRO signs every right it issued, so it can re-check the live
        -- credential here without any member disclosing a foreign one. An
        -- expired or revoked right fails this check, because the credential
        -- is fetched and its validity window re-read at this ledger time.
        --
        -- The policy freezes who may vote, not which credential counts: the
        -- stint is always checked against the live consortium, so a right
        -- from a finished stint never counts under either policy.
        forA_ eligibleBallots (\(_, ballot) -> requireEntitlement dro consortiumId consortium.admitted ballot.voter ballot.right)
        casts <- castsOf Some electorate (map snd eligibleBallots)
        let winner = winnerOf decision disputed.firstRegistry disputed.secondRegistry
        assertMsg "winner not in the frozen claims" (Map.lookup winner disputed.claims /= None)
        let supporters = Set.fromList [voter | (voter, cast) <- Map.toList casts, case cast.vote of Voted choice -> winnerOf choice disputed.firstRegistry disputed.secondRegistry == winner; Absent -> False; Abstained -> False]
        let opposingQuorum = any (\registry -> registry /= winner && Set.size (Set.fromList [voter | (voter, cast) <- Map.toList casts, case cast.vote of Voted choice -> winnerOf choice disputed.firstRegistry disputed.secondRegistry == registry; Absent -> False; Abstained -> False]) >= 2) (Map.keys disputed.claims)
        assertMsg "exactly one decision must qualify" (Set.size supporters >= 2 && not opposingQuorum)
        let Some actionCid = Map.lookup winner disputed.actions
        let supportingBallots = [ballot | (_, ballot) <- eligibleBallots, case ballot.decision of Some choice -> winnerOf choice disputed.firstRegistry disputed.secondRegistry == winner; None -> False]
        agreed <- agreedAction supportingBallots
        assertMsg "ballots authorize another action" (agreed == actionCid)
        ballotSnapshots <- agreedSnapshots supportingBallots
        let stateKey = disputeKey dro disputed.caseToken
        liveState <- readState @NameDispute stateKey (coerceContractId caseCid)
        assertMsg "ballot state differs from the live case" (ballotSnapshots == Map.fromList [(stateKey, Snapshot with state = liveState; cid = None)])
        -- Every slot is spent, so no vote survives the case it was cast in.
        consumeBallots (map fst presented)
        receiptCid <- create TallyReceipt with
          dro; consortiumId; caseToken; caseId
          roll = disputed.registered; decision; winner
        exercise consortiumCid Consortium_PublishRuling with caseCid; decision; receiptCid; resolverCid = self

claimKey : Party -> Party -> AuthenticKey
claimKey dro registry = AuthenticKey with authorities = Set.singleton dro; id = "losing-credential:" <> show registry

template ArchiveClaimAction
  with
    dro : Party
    caseToken : Text
    name : Text
    claims : Map.Map Party (ContractId Credential)
    winner : Party
  where
    signatory dro, Map.keys claims

    interface instance Action for ArchiveClaimAction where
      view = ActionView with
        authorizers = [[dro]]
        targets = Map.insert (disputeKey dro caseToken) (Snapshot with state = None; cid = None)
          (Map.fromList [(claimKey dro registry, Snapshot with state = None; cid = Some (coerceContractId credential)) | (registry, credential) <- Map.toList claims, registry /= winner])
        meta = emptyMetadata

      action_readStateImpl key cid =
        if key == disputeKey dro caseToken then readState @NameDispute key cid
        else do
          let matches = [credential | (registry, credential) <- Map.toList claims, registry /= winner, key == claimKey dro registry && cid == coerceContractId credential]
          case matches of
            [credential] -> do _ <- fetch credential; pure None
            _ -> abort "wrong credential target"

      action_authorizeExecutionImpl _ arg = do
        snapshots <- mergeSnapshots (view (toInterface @Action this)).targets arg.snapshots
        executionCid <- create ArchiveClaimExecution with
          dro; caseToken; name; claims; winner
          core = arg.executionCore; snapshots
        pure Action_AuthorizeExecutionResult with
          executionCids = [toInterfaceContractId executionCid]
          meta = emptyMetadata

template ArchiveClaimExecution
  with
    dro : Party
    caseToken : Text
    name : Text
    claims : Map.Map Party (ContractId Credential)
    winner : Party
    core : ExecutionCore
    snapshots : Map.Map AuthenticKey Snapshot
  where
    signatory dro, Map.keys claims

    interface instance Executable for ArchiveClaimExecution where
      view = ExecutableView with executionCore = core; snapshots; outcome = None

      executable_cancelImpl _ = abort "claim execution cannot be cancelled"

      executable_executeImpl targetCids _ = do
        requireSameKeys snapshots targetCids
        let losers = [(registry, credential) | (registry, credential) <- Map.toList claims, registry /= winner]
        forA_ losers $ \(registry, credential) ->
          assertMsg "wrong frozen credential" (Map.lookup (claimKey dro registry) targetCids == Some (coerceContractId credential))
        let stateKey = disputeKey dro caseToken
        (_, disputed) <- checkTarget @NameDispute unchanged stateKey snapshots targetCids
        assertMsg "action belongs to another dispute" (disputed.name == name && disputed.claims == claims)
        forA_ losers $ \(_, credential) -> do
          _ <- fetch credential
          _ <- exercise credential Credential_ArchiveAsAnchorers
          pure ()
        pure Executable_ExecuteResult with created = []; meta = emptyMetadata

template MembershipMotion
  with
    dro : Party
    consortiumId : Text
    consortiumCid : ContractId Consortium
    admitted : Map.Map Party Int
    change : Membership
    supporters : Set Party
    root : Optional (ContractId MembershipMotion)
  where
    signatory dro, Map.keys admitted
    ensure Set.isSubsetOf supporters (Set.fromList (Map.keys admitted))

    -- Every supporter proved a live entitlement when it voted, so the enacting
    -- choices do not re-read foreign rights.
    choice Membership_Vote : ContractId MembershipMotion
      with
        voter : Party
        voterRight : RightRef
      controller voter
      do
        assertMsg "duplicate or ineligible vote" (Map.member voter admitted && not (Set.member voter supporters))
        requireEntitlement dro consortiumId admitted voter voterRight
        let origin = case root of None -> self; Some original -> original
        create this with supporters = Set.insert voter supporters; root = Some origin

    nonconsuming choice Membership_Enact : ContractId Consortium
      with
        enactor : Party
        enactorRight : RightRef
      controller enactor
      do
        requireEntitlement dro consortiumId admitted enactor enactorRight
        assertMsg "two members must approve" (Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.admitted == admitted)
        case change of
          Admit _ -> abort "candidate must accept invitation"
          Remove target -> do
            assertMsg "at least two members remain" (Map.size admitted > 2)
            exercise consortiumCid ApplyRemoval with target; authorizedMotion = self

    nonconsuming choice Membership_Invite : ContractId AdmissionInvitation
      with
        inviter : Party
        inviterRight : RightRef
      controller inviter
      do
        assertMsg "only supported admission can invite" (Set.size supporters >= 2)
        requireEntitlement dro consortiumId admitted inviter inviterRight
        target <- case change of Admit party -> pure party; Remove _ -> abort "not admission"
        _ <- fetch consortiumCid
        create AdmissionInvitation with dro; consortiumId; admitted; target; consortiumCid; motionCid = self

    nonconsuming choice Membership_Admit : ContractId Consortium
      with
        target : Party
        acceptedConsent : ContractId AdmissionConsent
      controller target
      do
        assertMsg "wrong target or insufficient support" (change == Admit target && Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.admitted == admitted)
        exercise consortiumCid EnactAdmission with target; authorizedMotion = self; acceptedConsent

template PolicyMotion
  with
    dro : Party
    consortiumId : Text
    consortiumCid : ContractId Consortium
    admitted : Map.Map Party Int
    targetPolicy : ElectoratePolicy
    supporters : Set Party
    root : Optional (ContractId PolicyMotion)
  where
    signatory dro, Map.keys admitted
    ensure Set.isSubsetOf supporters (Set.fromList (Map.keys admitted))

    choice Policy_Vote : ContractId PolicyMotion
      with
        voter : Party
        voterRight : RightRef
      controller voter
      do
        assertMsg "duplicate or ineligible vote" (Map.member voter admitted && not (Set.member voter supporters))
        requireEntitlement dro consortiumId admitted voter voterRight
        let origin = case root of None -> self; Some original -> original
        create this with supporters = Set.insert voter supporters; root = Some origin

    nonconsuming choice Policy_Enact : ContractId Consortium
      with
        enactor : Party
        enactorRight : RightRef
      controller enactor
      do
        requireEntitlement dro consortiumId admitted enactor enactorRight
        assertMsg "two members must approve" (Set.size supporters >= 2)
        consortium <- fetch consortiumCid
        assertMsg "stale or foreign consortium" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.admitted == admitted)
        exercise consortiumCid ApplyPolicy with targetPolicy; authorizedMotion = self

template AdmissionInvitation
  with
    dro : Party
    consortiumId : Text
    admitted : Map.Map Party Int
    target : Party
    consortiumCid : ContractId Consortium
    motionCid : ContractId MembershipMotion
  where
    signatory dro, Map.keys admitted
    observer target

    choice AdmissionInvitation_Accept : ContractId AdmissionConsent
      controller target
      do
        create AdmissionConsent with dro; consortiumId; admitted; target; consortiumCid; motionCid

template AdmissionConsent
  with
    dro : Party
    consortiumId : Text
    admitted : Map.Map Party Int
    target : Party
    consortiumCid : ContractId Consortium
    motionCid : ContractId MembershipMotion
  where
    signatory target
    observer Map.keys admitted

    nonconsuming choice AdmissionConsent_Finalize : ContractId Consortium
      with enactor : Party
      controller enactor
      do
        assertMsg "only invited members finalize" (Map.member enactor admitted)
        consortium <- fetch consortiumCid
        motion <- fetch motionCid
        assertMsg "invitation authority or membership changed" (consortium.dro == dro && consortium.consortiumId == consortiumId && consortium.admitted == admitted && motion.consortiumCid == consortiumCid && motion.change == Admit target)
        exercise motionCid Membership_Admit with target; acceptedConsent = self
