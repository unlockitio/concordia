module Cap.Examples.BabyDro.Registry where

import DA.Set (Set)
import qualified DA.Set as Set
import qualified DA.Map as Map
import Cap.Examples.BabyDro.Dispute

data Membership = Admit Party | Remove Party deriving (Eq, Show)
data Proposal = MembershipChange Membership | PolicyChange ElectoratePolicy deriving (Eq, Show)

data Motion = Motion with
    proposal : Proposal
    supporters : Set Party
  deriving (Eq, Show)

template Consortium
  with
    dro : Party
    members : Set Party
    policy : ElectoratePolicy
    motions : [Motion]
    cases : Set (ContractId Case)
  where
    signatory dro, Set.toList members
    ensure Set.size members >= 2 && not (Set.member dro members)

    choice ProposeChange : ContractId Consortium
      with
        proposer : Party
        proposal : Proposal
      controller proposer
      do
        assertMsg "only members propose" (Set.member proposer members)
        assertMsg "proposal already open" (not (any (\m -> m.proposal == proposal) motions))
        case proposal of
          MembershipChange (Admit target) -> assertMsg "DRO cannot join the registry" (target /= dro && not (Set.member target members))
          MembershipChange (Remove target) -> assertMsg "not entitled" (Set.member target members)
          PolicyChange target -> assertMsg "policy already in force" (target /= policy)
        create this with motions = Motion proposal (Set.singleton proposer) :: motions

    choice VoteChange : ContractId Consortium
      with
        voter : Party
        proposal : Proposal
      controller voter
      do
        assertMsg "only members vote" (Set.member voter members)
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown proposal"
        assertMsg "member already voted" (not (Set.member voter motion.supporters))
        let replacement = motion with supporters = Set.insert voter motion.supporters
        create this with motions = replacement :: filter (\m -> m.proposal /= proposal) motions

    nonconsuming choice InviteAdmission : ContractId AdmissionInvitation
      with
        inviter : Party
        target : Party
      controller inviter
      do
        assertMsg "only members invite" (Set.member inviter members)
        assertMsg "DRO cannot join the registry" (target /= dro && not (Set.member target members))
        let proposal = MembershipChange (Admit target)
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown admission proposal"
        assertMsg "two current members must approve" (Set.size (Set.intersection members motion.supporters) >= 2)
        create AdmissionInvitation with dro; members; target; consortiumCid = self

    choice EnactAdmission : ContractId Consortium
      with
        target : Party
      controller target
      do
        let proposal = MembershipChange (Admit target)
        assertMsg "DRO cannot join the registry" (target /= dro && not (Set.member target members))
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown admission proposal"
        assertMsg "two current members must approve" (Set.size (Set.intersection members motion.supporters) >= 2)
        create this with members = Set.insert target members; motions = filter (\m -> m.proposal /= proposal) motions

    choice EnactChange : ContractId Consortium
      with
        enactor : Party
        proposal : Proposal
      controller enactor
      do
        assertMsg "only members enact" (Set.member enactor members)
        motion <- case filter (\m -> m.proposal == proposal) motions of
          [one] -> pure one
          _ -> abort "unknown proposal"
        assertMsg "two current members must approve" (Set.size (Set.intersection members motion.supporters) >= 2)
        (updated, nextPolicy) <- case proposal of
          MembershipChange (Admit _) -> abort "new member must accept an admission invitation"
          MembershipChange (Remove target) -> pure (Set.delete target members, policy)
          PolicyChange target -> pure (members, target)
        assertMsg "at least two members remain" (Set.size updated >= 2)
        create this with members = updated; policy = nextPolicy; motions = filter (\m -> m.proposal /= proposal) motions

    -- The disputer exercises governance once to open a case. All subsequent
    -- voter transactions act solely on invitations, ballots and the case.
    choice OpenDispute : (ContractId Consortium, ContractId Case)
      with
        disputer : Party
        caseId : Text
        name : Text
        otherRegistry : Party
        reason : Text
      controller disputer
      do
        assertMsg "only entitled registries dispute" (Set.member disputer members && Set.member otherRegistry members && disputer /= otherRegistry)
        assertMsg "reason and name required" (reason /= "" && name /= "" && caseId /= "")
        caseCid <- create Case with
          caseAuthority = dro
          caseToken = caseId
          caseId; name; firstRegistry = disputer; secondRegistry = otherRegistry; reason
          policy; voters = members; eligible = members; ballots = Map.empty; openingCaseCid = None
        successor <- create this with cases = Set.insert caseCid cases
        pure (successor, caseCid)

    choice Consortium_Resolve : ContractId Ruling
      with
        issuer : Party
        caseCid : ContractId Case
        decision : Decision
      controller issuer
      do
        disputed <- fetch caseCid
        let opening = case disputed.openingCaseCid of
              None -> caseCid
              Some original -> original
        assertMsg "case not opened by this consortium chain" (Set.member opening cases)
        assertMsg "case authority mismatch" (disputed.caseAuthority == dro)
        assertMsg "only the DRO issues rulings" (issuer == dro)
        let electorate = case disputed.policy of
              SnapshotAtOpen -> disputed.eligible
              CurrentMembership -> Set.intersection disputed.eligible members
        votes <- forA (Map.toList disputed.ballots) $ \(voter, ballotCid) -> do
          ballot <- fetch ballotCid
          assertMsg "foreign ballot in inventory" (ballot.caseAuthority == disputed.caseAuthority && ballot.caseToken == disputed.caseToken && ballot.caseId == disputed.caseId && ballot.voter == voter)
          pure (voter, ballot.decision)
        let supporters = Set.fromList [voter | (voter, Some vote) <- votes, vote == decision, Set.member voter electorate]
        assertMsg "two eligible votes required" (Set.size supporters >= 2)
        create Ruling with
          caseAuthority = disputed.caseAuthority
          caseToken = disputed.caseToken
          caseId = disputed.caseId
          name = disputed.name
          firstRegistry = disputed.firstRegistry
          secondRegistry = disputed.secondRegistry
          decision
          followedBy = Set.empty

template AdmissionInvitation
  with
    dro : Party
    members : Set Party
    target : Party
    consortiumCid : ContractId Consortium
  where
    signatory dro, Set.toList members
    observer target

    choice AdmissionInvitation_Accept : ContractId AdmissionConsent
      controller target
      do
        create AdmissionConsent with dro; members; target; consortiumCid

template AdmissionConsent
  with
    dro : Party
    members : Set Party
    target : Party
    consortiumCid : ContractId Consortium
  where
    signatory target
    observer Set.toList members

    choice AdmissionConsent_Finalize : ContractId Consortium
      with
        enactor : Party
      controller enactor
      do
        assertMsg "only invited members finalize" (Set.member enactor members)
        consortium <- fetch consortiumCid
        assertMsg "invitation authority or membership changed" (consortium.dro == dro && consortium.members == members)
        exercise consortiumCid EnactAdmission with target
