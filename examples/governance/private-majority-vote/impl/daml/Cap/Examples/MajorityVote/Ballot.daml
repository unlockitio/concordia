module Cap.Examples.MajorityVote.Ballot where

import Prelude hiding (Action)

import qualified DA.Map as Map
import DA.Optional (isNone, isSome)

import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.Types (ResolutionRef)
import Cap.Core.Utils (requireExpired, requireOpen)
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.Utils (IsBallot (..), Vote (..))

yay : Text
yay = "yay"

nay : Text
nay = "nay"

template PrivateBallot
  with
    operator : Party
    voter : Party
    resolution : ResolutionRef
    actionCid : ContractId Action
    opensAt : Time
    closesAt : Time
    expiresAt : Time
    vote : Optional Text
  where
    signatory [operator, voter]

    ensure optional True (`elem` [yay, nay]) vote

    choice PrivateBallot_Cast : ContractId PrivateBallot
      with
        option : Text
      controller voter
      do
        now <- getTime
        requireOpen "the voting window is open" now opensAt (Some closesAt)
        require "this ballot carries no vote yet" (isNone vote)
        create this with vote = Some option

    choice PrivateBallot_Withdraw : ContractId PrivateBallot
      controller voter
      do
        now <- getTime
        requireOpen "the voting window is open" now opensAt (Some closesAt)
        require "this ballot carries a vote to withdraw" (isSome vote)
        create this with vote = None

    choice PrivateBallot_Expire : ()
      controller operator
      do
        now <- getTime
        requireExpired "the ballot has expired" now (Some expiresAt)

    choice PrivateBallot_Consume : ()
      controller operator
      do pure ()


instance HasCheckedFetch PrivateBallot ResolutionRef where
  contractGroupId ballot = ballot.resolution

instance IsBallot PrivateBallot Text where
  votesOf ballot = Map.fromList [(ballot.voter, optional Absent Voted ballot.vote)]
  snapshotsOf _ = Map.empty
  actionOf ballot = ballot.actionCid
  consume cid = exercise cid PrivateBallot_Consume
