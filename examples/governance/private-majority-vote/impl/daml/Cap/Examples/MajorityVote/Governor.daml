module Cap.Examples.MajorityVote.Governor where

import Prelude hiding (Action)

import DA.Foldable (forA_)
import DA.List (sort)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.Types (AuthenticKey (..), ExecutionAction (..), ExecutionCore (..), Mechanism (..))
import Cap.Core.Utils (IsAnyValue (..), fetchGroup, requireClosed, requireMechanism)
import Cap.Governance.ActionV1
import Cap.Governance.Utils
  ( Tally, Verdict (..), atLeastVotes, commonAction, consumeBallots, rule, voted
  , weighBallotsEqually )

import Cap.Examples.MajorityVote.Ballot

data ProposalTerms = ProposalTerms
  with
    actionCid : ContractId Action
    entryClosesAt : Time
    votingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

majorityProcedureName : Text
majorityProcedureName = "majority"

data ResolveResult = ResolveResult
  with
    verdict : Verdict Text
    created : [AnyContractId]
  deriving (Eq, Show)


template Proposal
  with
    dso : Party
    operator : Party
    mechanism : Mechanism
    electorate : Set Party
    terms : ProposalTerms
    roll : [Party]
  where
    signatory dso
    observer operator :: Set.toList electorate

    nonconsuming choice Proposal_Invite : [ContractId BallotInvitation]
      controller operator
      do
        now <- getTime
        require "invitations are issued before the entry window closes"
          (now < terms.entryClosesAt)
        forA (Set.toList electorate) $ \voter ->
          create BallotInvitation with dso; operator; voter; mechanism

    choice Proposal_Join : ContractId Proposal
      with
        voter : Party
      controller voter, dso
      do
        now <- getTime
        require "a voter joins the roll before the entry window closes"
          (now < terms.entryClosesAt)
        require "only an entitled voter joins the roll"
          (Set.member voter electorate)
        require "a voter joins the roll once" (voter `notElem` roll)
        create this with roll = voter :: roll


template BallotInvitation
  with
    dso : Party
    operator : Party
    voter : Party
    mechanism : Mechanism
  where
    signatory dso, operator
    observer voter

    choice BallotInvitation_Accept : ContractId PrivateBallot
      with
        proposalCid : ContractId Proposal
      controller voter
      do
        proposal <- fetch proposalCid
        require "the invitation and the proposal name one round"
          (proposal.mechanism == mechanism)
        _ <- exercise proposalCid Proposal_Join with voter
        create PrivateBallot with
          operator; voter; mechanism
          actionCid = proposal.terms.actionCid
          opensAt = proposal.terms.entryClosesAt
          closesAt = proposal.terms.votingClosesAt
          expiresAt = proposal.terms.expiresAt
          vote = None


template Governor
  with
    dso : Party
    operator : Party
    electorate : Set Party
    governorId : Text
    expiresAt : Time
  where
    signatory dso
    observer operator :: Set.toList electorate

    nonconsuming choice Governor_Propose : ContractId Proposal
      with
        proposer : Party
        proposalId : Text
        terms : ProposalTerms
      controller proposer
      do
        require "a proposal is raised by a member of the electorate"
          (Set.member proposer electorate)
        create Proposal with
          dso; operator; electorate; terms
          mechanism = Mechanism with
            resolver = governorKey this
            resolverCid = None
            procedure = majorityProcedureName
            id = proposalId
          roll = []

    nonconsuming choice Governor_ResolveMajority : ResolveResult
      with
        proposalCid : ContractId Proposal
        ballotCids : [ContractId PrivateBallot]
        extraArgs : ExtraArgs
      controller operator
      do resolveMajority this self proposalCid ballotCids extraArgs


governorKey : Governor -> AuthenticKey
governorKey rules = AuthenticKey with
  authorities = Set.fromList [rules.dso]
  id = rules.governorId

majorityOf : Decimal -> Tally Text Text
majorityOf electorateSize casts =
  let for = sum [weight | (weight, option) <- voted casts, option == yay]
  in Some (if for > 0.5 * electorateSize then yay else nay)

resolveMajority
  : Governor -> ContractId Governor -> ContractId Proposal -> [ContractId PrivateBallot]
  -> ExtraArgs -> Update ResolveResult
resolveMajority rules self proposalCid ballotCids extraArgs = do
  now <- getTime
  proposal <- fetch proposalCid
  requireMechanism (governorKey rules) (coerceContractId self) majorityProcedureName proposal.mechanism
  require "the proposal is on this governor's electorate" (proposal.electorate == rules.electorate)
  let terms = proposal.terms

  presented <- fetchGroup proposal.mechanism ballotCids
  let (cids, ballots) = unzip presented
  forA_ ballots $ \b -> do
    requireClosed "every presented ballot is closed for voting" now b.closesAt
    require "every ballot votes in the proposal's window"
      (b.opensAt == terms.entryClosesAt
        && b.closesAt == terms.votingClosesAt
        && b.expiresAt == terms.expiresAt)
  action <- commonAction ballots
  require "the ballots vote on the proposal's action" (action == terms.actionCid)

  casts <- weighBallotsEqually Some rules.electorate ballots
  require "the presented ballots cover the roll" (Map.keys casts == sort proposal.roll)
  consumeBallots cids

  let verdict = rule (atLeastVotes 1) (majorityOf (intToDecimal (Set.size rules.electorate))) casts
  created <- case verdict of
    Decided winner | winner == yay -> do
      result <- exercise terms.actionCid Action_AuthorizeExecution with
        actors = [rules.dso]
        executionCore = ExecutionCore with
          authorities = Set.fromList [rules.dso]
          availableActions = Map.fromList
            [(EA_Execute, map (:: []) (Set.toList rules.electorate))]
          opensAt = terms.votingClosesAt
          cancelAt = terms.votingClosesAt
          expiresAt = Some terms.expiresAt
          meta = emptyMetadata
        outcome = Some (toAnyValue winner)
        binds = Map.empty
        extraArgs
      pure (map coerceContractId result.executionCids)
    _ -> pure []

  archive proposalCid
  pure ResolveResult with verdict; created
