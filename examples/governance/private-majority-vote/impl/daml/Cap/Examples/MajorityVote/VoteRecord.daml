module Cap.Examples.MajorityVote.VoteRecord where

import Prelude hiding (Action)

import qualified DA.Map as Map
import DA.Optional (isNone, isSome)

import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.Types (ResolutionInfo)
import Cap.Core.Utils (requireExpired, requireOpen)
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.Utils.VotingRights (partyAsOwnerId)
import Cap.Governance.Utils (IsVoteRecord (..), Vote (..))

yay : Text
yay = "yay"

nay : Text
nay = "nay"

template PrivateVoteRecord
  with
    operator : Party
    voter : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    opensAt : Time
    closesAt : Time
    expiresAt : Time
    vote : Optional Text
  where
    signatory [operator, voter]

    ensure optional True (`elem` [yay, nay]) vote

    choice PrivateVoteRecord_Cast : ContractId PrivateVoteRecord
      with
        option : Text
      controller voter
      do
        now <- getTime
        requireOpen "the voting window is open" now opensAt (Some closesAt)
        require "this vote record carries no vote yet" (isNone vote)
        create this with vote = Some option

    choice PrivateVoteRecord_Withdraw : ContractId PrivateVoteRecord
      controller voter
      do
        now <- getTime
        requireOpen "the voting window is open" now opensAt (Some closesAt)
        require "this vote record carries a vote to withdraw" (isSome vote)
        create this with vote = None

    choice PrivateVoteRecord_Expire : ()
      controller operator
      do
        now <- getTime
        requireExpired "the vote record has expired" now (Some expiresAt)

    choice PrivateVoteRecord_Consume : ()
      controller operator
      do pure ()


instance HasCheckedFetch PrivateVoteRecord ResolutionInfo where
  contractGroupId record = record.resolution

instance IsVoteRecord PrivateVoteRecord Text where
  votesOf record = Map.fromList [(partyAsOwnerId record.voter, optional Absent Voted record.vote)]
  snapshotsOf _ = Map.empty
  actionOf record = Some record.actionCid
  consume cid = exercise cid PrivateVoteRecord_Consume
