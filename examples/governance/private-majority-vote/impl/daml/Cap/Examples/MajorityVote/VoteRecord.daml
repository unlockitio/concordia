module Cap.Examples.MajorityVote.VoteRecord where

import Prelude hiding (Action)

import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Optional (isNone, isSome)

import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.IdentityV1 (Identity (..))
import Cap.Core.ResolutionV1 (ResolutionInfo)
import Cap.Core.Identity (HasIdentities (..))
import Cap.Core.Checks (requireMet)
import Cap.Core.Time (validExpired, validOpen)
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.Vote (IsVoteRecord (..))
import Cap.Governance.Count (Vote (..))

yay : Text
yay = "yay"

nay : Text
nay = "nay"

template PrivateVoteRecord
  with
    operator : Party
    voter : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    opensAt : Time
    closesAt : Time
    expiresAt : Time
    vote : Optional Text
  where
    signatory [operator, voter]

    ensure optional True (`elem` [yay, nay]) vote

    choice PrivateVoteRecord_Cast : ContractId PrivateVoteRecord
      with
        option : Text
      controller voter
      do
        now <- getTime
        requireMet (validOpen "the voting window" opensAt (Some closesAt) now)
        require "this vote record carries no vote yet" (isNone vote)
        create this with vote = Some option

    choice PrivateVoteRecord_Withdraw : ContractId PrivateVoteRecord
      controller voter
      do
        now <- getTime
        requireMet (validOpen "the voting window" opensAt (Some closesAt) now)
        require "this vote record carries a vote to withdraw" (isSome vote)
        create this with vote = None

    choice PrivateVoteRecord_Expire : ()
      controller operator
      do
        now <- getTime
        requireMet (validExpired "the vote record" (Some expiresAt) now)

    choice PrivateVoteRecord_Consume : ()
      controller operator
      do pure ()


instance HasCheckedFetch PrivateVoteRecord ResolutionInfo where
  contractGroupId record = record.resolution

instance HasIdentities PrivateVoteRecord where
  identitiesOf record = Set.singleton (PartyIdentity record.voter)

instance IsVoteRecord PrivateVoteRecord Text (ContractId Action) where
  votesOf record = Map.fromList [(PartyIdentity record.voter, optional Absent Voted record.vote)]
  snapshotsOf _ = Map.empty
  actionOf record = record.actionCid
  consume cid = exercise cid PrivateVoteRecord_Consume
