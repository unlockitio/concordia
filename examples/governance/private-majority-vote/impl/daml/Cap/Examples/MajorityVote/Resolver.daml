module Cap.Examples.MajorityVote.Resolver where

import Prelude hiding (Action)

import DA.Foldable (forA_)
import DA.List (sort)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Util (require)

import Cap.Core.Types (AuthenticKey (..), ExecutionAction (..), ExecutionCore (..), ResolutionInfo (..))
import Cap.Core.Utils (IsAnyValue (..), fetchGroup, requireClosed, requireMetFrom, requireResolvedBy)
import Cap.Governance.ActionV1
import qualified Cap.Governance.VoteTopicV1 as VoteTopicV1
import Cap.Governance.Types (Reason, Vote (..))
import Cap.Governance.Utils.VotingRights (equalWeights, partyAsOwnerId)
import Cap.Governance.Utils
  ( Tally, Verdict (..), atLeastVotes, casts, consumeVoteRecords, decide, decodeTextVote
  , distinctVotersAmongVoteRecords, expectUniformAction, validVoteRecordVoters
  , weightedVotes )

import Cap.Examples.MajorityVote.Ballot

data ProposalTerms = ProposalTerms
  with
    actionCid : ContractId Action
    entryClosesAt : Time
    votingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

majorityMechanismName : Text
majorityMechanismName = "private-majority-vote.majority"

-- | The ChoiceContext key under which a cast through the VoteTopic interface
-- passes the voter's PrivateBallot, as AV_ContractId.
ballotContextKey : Text
ballotContextKey = "private-majority-vote.ballot"

data ResolveResult = ResolveResult
  with
    verdict : Verdict Text
    created : [AnyContractId]
  deriving (Eq, Show)


template Proposal
  with
    dso : Party
    operator : Party
    resolution : ResolutionInfo
    proposer : Party
    subject : Reason
    electorate : Set Party
    terms : ProposalTerms
    roll : [Party]
  where
    signatory dso
    observer operator :: Set.toList electorate

    -- Votes are private: each sits on the voter's own PrivateBallot, which a
    -- cast passes in the choice context. The proposal itself does not change.
    interface instance VoteTopicV1.VoteTopic for Proposal where
      view = VoteTopicV1.VoteTopicView with
        resolution; subject
        proposer = partyAsOwnerId proposer
        action = Some terms.actionCid
        voteBefore = Some terms.votingClosesAt
        effectiveAt = None
        meta = emptyMetadata
      voteTopic_castVoteImpl _ arg = do
        ballotCid <- case TextMap.lookup ballotContextKey arg.extraArgs.context.values of
          Some (AV_ContractId cid) -> pure (coerceContractId cid : ContractId PrivateBallot)
          _ -> abort ("the choice context carries no ballot under " <> ballotContextKey)
        ballot <- fetch ballotCid
        require "the ballot is for this proposal" (ballot.resolution == resolution)
        require "the caster casts on its own ballot" (ballot.voter == arg.caster)
        require "the caster casts for its own OwnerId" (arg.ownerId == partyAsOwnerId arg.caster)
        option <- case decodeTextVote arg.vote of
          Some (Voted option) -> pure option
          _ -> abort "a majority vote is the option yay or nay"
        cid <- exercise ballotCid PrivateBallot_Cast with option
        pure VoteTopicV1.VoteTopic_CastVoteResult with
          created = [coerceContractId cid]
          meta = emptyMetadata

    nonconsuming choice Proposal_Invite : [ContractId BallotInvitation]
      controller operator
      do
        now <- getTime
        require "invitations are issued before the entry window closes"
          (now < terms.entryClosesAt)
        forA (Set.toList electorate) $ \voter ->
          create BallotInvitation with dso; operator; voter; resolution

    choice Proposal_Join : ContractId Proposal
      with
        voter : Party
      controller voter, dso
      do
        now <- getTime
        require "a voter joins the roll before the entry window closes"
          (now < terms.entryClosesAt)
        require "only an entitled voter joins the roll"
          (Set.member voter electorate)
        require "a voter joins the roll once" (voter `notElem` roll)
        create this with roll = voter :: roll


template BallotInvitation
  with
    dso : Party
    operator : Party
    voter : Party
    resolution : ResolutionInfo
  where
    signatory dso, operator
    observer voter

    choice BallotInvitation_Accept : ContractId PrivateBallot
      with
        proposalCid : ContractId Proposal
      controller voter
      do
        proposal <- fetch proposalCid
        require "the invitation and the proposal name one round"
          (proposal.resolution == resolution)
        _ <- exercise proposalCid Proposal_Join with voter
        create PrivateBallot with
          operator; voter; resolution
          actionCid = proposal.terms.actionCid
          opensAt = proposal.terms.entryClosesAt
          closesAt = proposal.terms.votingClosesAt
          expiresAt = proposal.terms.expiresAt
          vote = None


template Resolver
  with
    dso : Party
    operator : Party
    electorate : Set Party
    resolverId : Text
    expiresAt : Time
  where
    signatory dso
    observer operator :: Set.toList electorate

    nonconsuming choice Resolver_Propose : ContractId Proposal
      with
        proposer : Party
        proposalId : Text
        subject : Reason
        terms : ProposalTerms
      controller proposer
      do
        require "a proposal is raised by a member of the electorate"
          (Set.member proposer electorate)
        create Proposal with
          dso; operator; electorate; terms; proposer; subject
          resolution = ResolutionInfo with
            resolver = resolverKey this
            resolverCid = None
            mechanism = majorityMechanismName
            id = proposalId
          roll = []

    nonconsuming choice Resolver_ResolveMajority : ResolveResult
      with
        proposalCid : ContractId Proposal
        ballotCids : [ContractId PrivateBallot]
      controller operator
      do resolveMajority this self proposalCid ballotCids


resolverKey : Resolver -> AuthenticKey
resolverKey resolver = AuthenticKey with
  authorities = Set.fromList [resolver.dso]
  id = resolver.resolverId

majorityOf : Decimal -> Tally Text Text
majorityOf electorateSize casts =
  let for = sum [weight | (option, weight) <- weightedVotes casts, option == yay]
  in Some (if for > 0.5 * electorateSize then yay else nay)

resolveMajority
  : Resolver -> ContractId Resolver -> ContractId Proposal -> [ContractId PrivateBallot]
  -> Update ResolveResult
resolveMajority resolver self proposalCid ballotCids = do
  now <- getTime
  proposal <- fetch proposalCid
  requireResolvedBy (resolverKey resolver) (coerceContractId self) proposal.resolution
  require ("the resolution names the mechanism " <> majorityMechanismName)
    (proposal.resolution.mechanism == majorityMechanismName)
  require "the proposal is on this resolver's electorate" (proposal.electorate == resolver.electorate)
  let terms = proposal.terms

  presented <- fetchGroup proposal.resolution ballotCids
  let (cids, ballots) = unzip presented
  forA_ ballots $ \b -> do
    requireClosed "every presented ballot is closed for voting" now b.closesAt
    require "every ballot votes in the proposal's window"
      (b.opensAt == terms.entryClosesAt
        && b.closesAt == terms.votingClosesAt
        && b.expiresAt == terms.expiresAt)
  require "the ballots vote on the proposal's action" (expectUniformAction ballots == terms.actionCid)

  let voters = Set.fromList (map partyAsOwnerId (Set.toList resolver.electorate))
  requireMetFrom [validVoteRecordVoters voters] [distinctVotersAmongVoteRecords] ballots
  let counted = casts Some (equalWeights voters) ballots
  require "the presented ballots cover the roll" (sort (map (.voter) ballots) == sort proposal.roll)
  consumeVoteRecords cids

  let verdict = decide (atLeastVotes 1) (majorityOf (intToDecimal (Set.size resolver.electorate))) counted
  created <- case verdict of
    Decided winner | winner == yay -> do
      result <- exercise terms.actionCid Action_AuthorizeExecution with
        actors = [resolver.dso]
        executionCore = ExecutionCore with
          authorities = Set.fromList [resolver.dso]
          availableActions = Map.fromList
            [(EA_Execute, map (:: []) (Set.toList resolver.electorate))]
          opensAt = terms.votingClosesAt
          cancelAfter = terms.votingClosesAt
          expiresAt = Some terms.expiresAt
          meta = emptyMetadata
        outcome = Some (toAnyValue winner)
        snapshots = Map.empty
        extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      pure (map coerceContractId result.executionCids)
    _ -> pure []

  archive proposalCid
  pure ResolveResult with verdict; created
