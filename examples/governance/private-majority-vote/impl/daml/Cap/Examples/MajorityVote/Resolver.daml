module Cap.Examples.MajorityVote.Resolver where

import Prelude hiding (Action)

import DA.Foldable (forA_)
import DA.List (sort, unique)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), fetchChecked, require)

import Cap.Core.AuthenticKeyV1 (AuthenticKey (..))
import Cap.Governance.ExecutableV1 (ExecutionTerms (..))
import Cap.Core.IdentityV1 (Identity (..))
import Cap.Core.ResolutionV1 (ResolutionInfo (..))
import Cap.Core.AnyValue (IsAnyValue (..))
import Cap.Core.Checks (requireMet)
import Cap.Core.Time (validClosed)
import Cap.Core.Resolution (requireResolvedBy)
import Cap.Governance.ActionV1
import Cap.Governance.VoteRecordV1 (Reason, Vote (..), VoteRecord, VoteRecordView (..))
import qualified Cap.Governance.ResolverV1 as ResolverV1
import Cap.Governance.Rights (HasWeights (..))
import Cap.Governance.Count (Tally, Verdict (..), atLeastVotes, decide, weightedVotes)
import Cap.Governance.Vote (decodeTextVote)
import Cap.Governance.Resolution (casts, consumeVoteRecords, expectSameAction)

import Cap.Examples.MajorityVote.VoteRecord

data ProposalTerms = ProposalTerms
  with
    actionCid : ContractId Action
    entryClosesAt : Time
    votingClosesAt : Time
    expiresAt : Time
  deriving (Eq, Show)

majorityMechanismName : Text
majorityMechanismName = "private-majority-vote.majority"

-- | The ChoiceContext key under which a cast through Resolver_CastVote
-- passes the voter's PrivateVoteRecord, as AV_ContractId.
voteRecordContextKey : Text
voteRecordContextKey = "private-majority-vote.vote-record"

data ResolveResult = ResolveResult
  with
    verdict : Verdict Text
    created : [AnyContractId]
  deriving (Eq, Show)


template Proposal
  with
    dso : Party
    operator : Party
    resolution : ResolutionInfo
    proposer : Party
    subject : Reason
    electorate : Set Party
    terms : ProposalTerms
    actionId : ActionId -- the action's id, read from terms.actionCid when the proposal is raised
    roll : [Party]
  where
    signatory dso
    observer operator :: Set.toList electorate

    -- The decision. Votes are private: each sits on the voter's own
    -- PrivateVoteRecord, which the resolver counts as its own template, so the
    -- proposal's record carries no votes. Voters vote yay or nay on its one
    -- option.
    interface instance VoteRecord for Proposal where
      view = VoteRecordView with
        resolution
        requester = PartyIdentity proposer
        reason = subject
        options = [actionId]
        voteBefore = Some terms.votingClosesAt
        effectiveAt = None
        votes = Map.empty
        targets = Map.empty
        consumers = [dso]
        meta = emptyMetadata

    nonconsuming choice Proposal_Invite : [ContractId VoteRecordInvitation]
      controller operator
      do
        now <- getTime
        require "invitations are issued before the entry window closes"
          (now < terms.entryClosesAt)
        forA (Set.toList electorate) $ \voter ->
          create VoteRecordInvitation with dso; operator; voter; resolution

    choice Proposal_Join : ContractId Proposal
      with
        voter : Party
      controller voter, dso
      do
        now <- getTime
        require "a voter joins the roll before the entry window closes"
          (now < terms.entryClosesAt)
        require "only an entitled voter joins the roll"
          (Set.member voter electorate)
        require "a voter joins the roll once" (voter `notElem` roll)
        create this with roll = voter :: roll


template VoteRecordInvitation
  with
    dso : Party
    operator : Party
    voter : Party
    resolution : ResolutionInfo
  where
    signatory dso, operator
    observer voter

    choice VoteRecordInvitation_Accept : ContractId PrivateVoteRecord
      with
        proposalCid : ContractId Proposal
      controller voter
      do
        proposal <- fetch proposalCid
        require "the invitation and the proposal name one round"
          (proposal.resolution == resolution)
        _ <- exercise proposalCid Proposal_Join with voter
        create PrivateVoteRecord with
          operator; voter; resolution
          actionCid = proposal.terms.actionCid
          opensAt = proposal.terms.entryClosesAt
          closesAt = proposal.terms.votingClosesAt
          expiresAt = proposal.terms.expiresAt
          vote = None


template Resolver
  with
    dso : Party
    operator : Party
    electorate : Set Party
    resolverId : Text
    expiresAt : Time
  where
    signatory dso
    observer operator :: Set.toList electorate

    nonconsuming choice Resolver_Propose : ContractId Proposal
      with
        proposer : Party
        proposalId : Text
        subject : Reason
        terms : ProposalTerms
      controller proposer
      do
        require "a proposal is raised by a member of the electorate"
          (Set.member proposer electorate)
        action <- fetch terms.actionCid
        create Proposal with
          dso; operator; electorate; terms; proposer; subject
          actionId = (view action).actionId
          resolution = ResolutionInfo with
            resolver = contractGroupId this
            resolverCid = None
            mechanism = majorityMechanismName
            id = proposalId
          roll = []

    nonconsuming choice Resolver_ResolveMajority : ResolveResult
      with
        proposalCid : ContractId Proposal
        recordCids : [ContractId PrivateVoteRecord]
      controller operator
      do resolveMajority this self proposalCid recordCids

    -- Lets a wallet that knows only the interfaces cast on its own private
    -- vote record, which the choice context names. The private records are
    -- not VoteRecords, so a round is resolved with Resolver_ResolveMajority.
    interface instance ResolverV1.Resolver for Resolver where
      view = ResolverV1.ResolverView with
        keyId = resolverId
        mechanisms = [majorityMechanismName]
        meta = emptyMetadata

      resolver_castVoteImpl resolverCid arg = do
        requireResolvedBy this (fromInterfaceContractId @Resolver resolverCid) arg.resolution
        recordCid <- case TextMap.lookup voteRecordContextKey arg.extraArgs.context.values of
          Some (AV_ContractId cid) -> pure (coerceContractId cid : ContractId PrivateVoteRecord)
          _ -> abort ("the choice context carries no vote record under " <> voteRecordContextKey)
        record <- fetch recordCid
        require "the vote record is for this round" (record.resolution == arg.resolution)
        require "the caster casts on its own vote record" (record.voter == arg.caster)
        require "the caster casts for its own identity" (arg.identity == PartyIdentity arg.caster)
        option <- case decodeTextVote arg.vote of
          Some (Voted option) -> pure option
          _ -> abort "a majority vote is the option yay or nay"
        cid <- exercise recordCid PrivateVoteRecord_Cast with option
        pure ResolverV1.Resolver_CastVoteResult with
          created = [coerceContractId cid]
          meta = emptyMetadata

      resolver_resolveImpl _ _ =
        abort "the private vote records are not VoteRecords: resolve with Resolver_ResolveMajority"


instance HasWeights Resolver where
  weightsOf resolver = Map.fromList [(PartyIdentity voter, 1.0) | voter <- Set.toList resolver.electorate]

-- | The key resolutions name this resolver by.
instance HasCheckedFetch Resolver AuthenticKey where
  contractGroupId resolver = AuthenticKey with
    authorities = Set.fromList [resolver.dso]
    id = resolver.resolverId

majorityOf : Decimal -> Tally Text Text
majorityOf electorateSize casts =
  let for = sum [weight | (option, weight) <- weightedVotes casts, option == yay]
  in Some (if for > 0.5 * electorateSize then yay else nay)

resolveMajority
  : Resolver -> ContractId Resolver -> ContractId Proposal -> [ContractId PrivateVoteRecord]
  -> Update ResolveResult
resolveMajority resolver self proposalCid recordCids = do
  now <- getTime
  proposal <- fetch proposalCid
  requireResolvedBy resolver self proposal.resolution
  require ("the resolution names the mechanism " <> majorityMechanismName)
    (proposal.resolution.mechanism == majorityMechanismName)
  require "the proposal is on this resolver's electorate" (proposal.electorate == resolver.electorate)
  let terms = proposal.terms

  -- The records are signed by the operator and the voter, not by the dso the
  -- resolver's key names, so the dso does not see the votes. They are fetched
  -- as this package's own template, not through fetchVoteRecords.
  require "the presented vote records are distinct" (unique recordCids)
  records <- forA recordCids (fetchChecked proposal.resolution)
  forA_ records $ \record -> do
    requireMet (validClosed "the voting window" record.closesAt now)
    require "every vote record votes in the proposal's window"
      (record.opensAt == terms.entryClosesAt
        && record.closesAt == terms.votingClosesAt
        && record.expiresAt == terms.expiresAt)
  require "the vote records vote on the proposal's action" (expectSameAction records == terms.actionCid)

  -- The roll holds each entitled voter once, so covering it exactly admits
  -- only voters with a right, each on one record.
  require "the presented vote records cover the roll" (sort (map (.voter) records) == sort proposal.roll)
  let counted = casts Some (weightsOf resolver) records
  consumeVoteRecords recordCids

  let verdict = decide (atLeastVotes 1) (majorityOf (intToDecimal (Set.size resolver.electorate))) counted
  created <- case verdict of
    Decided winner | winner == yay -> do
      action <- fetch terms.actionCid
      require "the executed action is the option the vote is on" ((view action).actionId == proposal.actionId)
      result <- exercise terms.actionCid Action_AuthorizeExecution with
        actors = [resolver.dso]
        executionTerms = ExecutionTerms with
          authorities = Set.fromList [resolver.dso]
          executors = map (:: []) (Set.toList resolver.electorate)
          cancellers = []
          opensAt = terms.votingClosesAt
          cancelAfter = terms.votingClosesAt
          expiresAt = Some terms.expiresAt
          meta = emptyMetadata
        outcome = Some (toAnyValue winner)
        snapshots = Map.empty
        extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      pure (map coerceContractId result.executionCids)
    _ -> pure []

  archive proposalCid
  pure ResolveResult with verdict; created
