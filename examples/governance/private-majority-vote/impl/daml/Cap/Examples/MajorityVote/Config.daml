module Cap.Examples.MajorityVote.Config where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..))

import Cap.Core.Types (AuthenticKey (..), Snapshot (..), ExecutionCore)
import Cap.Core.Utils (IsAnyValue (..), signedKey)
import Cap.Governance.ActionV1
import Cap.Governance.ExecutableV1
import Cap.Governance.Utils
  ( HasState (..), TargetReader, checkTarget, mergeSnapshots, readState, requireSameKeys )


configId : Text
configId = "config"

configTargetKey : Party -> AuthenticKey
configTargetKey dso = AuthenticKey with
  authorities = Set.fromList [dso]
  id = configId


template Config
  with
    dso : Party
    electorate : Set Party
    setting : Text
  where
    signatory dso
    observer Set.toList electorate

    choice Config_Set : ContractId Config
      with
        newSetting : Text
      controller dso
      do create this with setting = newSetting

instance HasCheckedFetch Config AuthenticKey where
  contractGroupId = signedKey configId

instance HasState Config Text where
  stateOf config = config.setting

readConfigTargets : Party -> TargetReader
readConfigTargets dso key cid
  | key == configTargetKey dso = readState @Config key cid
  | otherwise = abort ("this action names no target " <> show key)


template ConfigUpdate
  with
    dso : Party
    newSetting : Text
    core : ExecutionCore
    snapshots : Map AuthenticKey Snapshot
    outcome : Optional AnyValue
  where
    signatory dso
    observer concat (concat (Map.values core.availableActions))

    interface instance Executable for ConfigUpdate where
      view = ExecutableView with
        executionCore = core
        snapshots
        outcome

      executable_cancelImpl _ = abort "this execution cannot be cancelled"

      executable_executeImpl targetCids _ = do
        requireSameKeys snapshots targetCids
        (configCid, _) <- checkTarget @Config (==) (configTargetKey dso) snapshots targetCids
        updated <- exercise configCid Config_Set with newSetting
        pure Executable_ExecuteResult with
          created = [coerceContractId updated]
          meta = emptyMetadata

template SetConfigAction
  with
    dso : Party
    operator : Party
    electorate : Set Party
    baseSetting : Text
    newSetting : Text
  where
    signatory dso
    observer operator :: Set.toList electorate

    interface instance Action for SetConfigAction where
      view = ActionView with
        authorizers = [[dso]]
        targets = setConfigTargets dso baseSetting
        meta = emptyMetadata

      action_readStateImpl = readConfigTargets dso

      action_authorizeExecutionImpl _ arg = do
        snapshots <- mergeSnapshots (setConfigTargets dso baseSetting) arg.snapshots
        cid <- create ConfigUpdate with
          dso; newSetting
          snapshots
          core = arg.executionCore
          outcome = arg.outcome
        pure Action_AuthorizeExecutionResult with
          executionCids = [toInterfaceContractId cid]
          meta = emptyMetadata


setConfigTargets : Party -> Text -> Map AuthenticKey Snapshot
setConfigTargets dso baseSetting = Map.fromList
  [ (configTargetKey dso, Snapshot with state = Some (toAnyValue baseSetting); cid = None) ]
