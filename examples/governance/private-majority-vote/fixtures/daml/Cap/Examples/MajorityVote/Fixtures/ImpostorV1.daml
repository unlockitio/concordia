module Cap.Examples.MajorityVote.Fixtures.ImpostorV1 where

import DA.Map (Map)
import qualified DA.Map as Map

import Splice.Api.Token.MetadataV1

import Cap.Core.SubmittableV1
import Cap.Governance.BallotV1
import Cap.Examples.MajorityVote.BallotV1 (ProposalTerms)
import Cap.Governance.BindingV1 (Bind, TargetKey)

template ImpostorBallot
  with
    operator : Party
    voter : Party
    mechanism : Mechanism
    terms : ProposalTerms
    bindings : Map TargetKey Bind
    vote : Optional AnyValue
  where
    signatory operator

    interface instance Submittable for ImpostorBallot where
      view = SubmittableView with
        mechanism
        meta = emptyMetadata

    interface instance Ballot for ImpostorBallot where
      view = BallotView with
        opensAt = terms.entryClosesAt
        closesAt = terms.votingClosesAt
        expiresAt = terms.expiresAt
        bindings
        availableActions = Map.empty
        voter
        vote
        meta = emptyMetadata

      ballot_castImpl _ _ = abort "this ballot is an impostor"
      ballot_withdrawImpl _ _ = abort "this ballot is an impostor"
      ballot_expireImpl _ _ = abort "this ballot is an impostor"
      ballot_consumeImpl self _ = do
        archive self
        pure Ballot_ConsumeResult with meta = emptyMetadata
