module Cap.Examples.MajorityVote.Demo.Fixture where

import Prelude hiding (Action)

import DA.Action (unless)
import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import qualified DA.Text as Text
import DA.Time
import Daml.Script

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.MetadataV1 as Meta

import Cap.Core.Types (AuthenticKey (..), ExecutionAction (..), ExecutionCore (..), Mechanism (..))
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.ActionV1 (Action, Action_AuthorizeExecution (..))
import Cap.Governance.ExecutableV1
import Cap.Governance.Types (Bind (..))

import Cap.Examples.MajorityVote.Ballot
import Cap.Examples.MajorityVote.Config
import Cap.Examples.MajorityVote.Resolver

bodyName : Text
bodyName = "body-1"

proposalName : Text
proposalName = "proposal-1"

openingSetting : Text
openingSetting = "sync-a"

proposedSetting : Text
proposedSetting = "sync-b"

noArgs : ExtraArgs
noArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

data Fixture = Fixture with
    dso : Party
    operator : Party
    alice : Party
    bob : Party
    carol : Party
    electorate : Set Party
    resolverCid : ContractId VoteResolver
    proposalCid : ContractId Proposal
    mechanism : Mechanism
    configCid : ContractId Config
    actionCid : ContractId SetConfigAction
    terms : ProposalTerms


setupAs : Text -> Script Fixture
setupAs ns = do
  let party role = "vote-" <> ns <> "-" <> role
  dso <- allocatePartyByHint (PartyIdHint (party "dso"))
  operator <- allocatePartyByHint (PartyIdHint (party "operator"))
  alice <- allocatePartyByHint (PartyIdHint (party "alice"))
  bob <- allocatePartyByHint (PartyIdHint (party "bob"))
  carol <- allocatePartyByHint (PartyIdHint (party "carol"))
  let electorate = Set.fromList [alice, bob, carol]

  now <- getTime
  configCid <- submit dso $ createCmd Config with
    dso; electorate; setting = openingSetting
  actionCid <- submit dso $ createCmd SetConfigAction with
    dso; operator; electorate; baseSetting = openingSetting; newSetting = proposedSetting
  let body = VoteResolver with
        dso; operator; electorate
        resolverId = bodyName
        expiresAt = now `addRelTime` days 10
  resolverCid <- submit dso $ createCmd body

  let mechanism = Mechanism with
        resolver = AuthenticKey with
          authorities = Set.fromList [dso]
          id = bodyName
        resolverCid = None
        procedure = majorityProcedureName
        id = proposalName
      terms = ProposalTerms with
        actionCid = toInterfaceContractId @Action actionCid
        entryClosesAt = now `addRelTime` days 1
        votingClosesAt = now `addRelTime` days 2
        expiresAt = now `addRelTime` days 3

  proposalCid <- submit alice $ exerciseCmd resolverCid VoteResolver_Propose with
    proposer = alice
    proposalId = proposalName
    terms

  _ <- submit operator $ exerciseCmd proposalCid Proposal_Invite

  pure Fixture with ..

presentedTargets : Fixture -> ContractId Config -> Map AuthenticKey Meta.AnyContractId
presentedTargets f configCid = Map.fromList
  [(configTargetKey f.dso, coerceContractId configCid)]

liveProposal : Fixture -> Script (ContractId Proposal)
liveProposal f = do
  proposals <- query @Proposal f.operator
  case [cid | (cid, p) <- proposals, p.mechanism == f.mechanism] of
    [cid] -> pure cid
    _ -> fail "no live proposal on this body"

seat : Fixture -> Party -> Script (ContractId PrivateBallot)
seat f voter = do
  proposalCid <- liveProposal f
  invitations <- query @BallotInvitation voter
  case [cid | (cid, iv) <- invitations, iv.voter == voter, iv.mechanism == f.mechanism] of
    [cid] -> submit voter (exerciseCmd cid BallotInvitation_Accept with proposalCid)
    _ -> fail "that voter holds no invitation on this proposal"

cast : Party -> ContractId PrivateBallot -> Text -> Script (ContractId PrivateBallot)
cast voter ballotCid option =
  submit voter $ exerciseCmd ballotCid PrivateBallot_Cast with option

resolveCmd : Fixture -> [ContractId PrivateBallot] -> Commands ResolveResult
resolveCmd f ballotCids =
  exerciseCmd f.resolverCid VoteResolver_ResolveMajority with
    proposalCid = f.proposalCid
    ballotCids
    extraArgs = noArgs

runResolve : Fixture -> [ContractId PrivateBallot] -> Script ResolveResult
runResolve f ballotCids = submit f.operator (resolveCmd f ballotCids)

submitMustFailContaining : Show a => Text -> Party -> Commands a -> Script ()
submitMustFailContaining expected actor cmds = do
  result <- trySubmit (actAs actor) cmds
  case result of
    Left (FailureStatusError status) -> requireContains status.message
    Left (TruncatedError _ message) -> requireContains message
    Left err -> fail ("the command failed unexpectedly: " <> show err)
    Right value -> fail ("the command succeeded with " <> show value)
  where
    requireContains actual =
      unless (expected `Text.isInfixOf` actual) $
        fail ("expected a failure containing " <> expected <> ", got " <> actual)

executionOf : ResolveResult -> ContractId Executable
executionOf result = case result.created of
  [cid] -> coerceContractId cid
  _ -> error "the resolve minted no single execution"

runExecute : Fixture -> ContractId Config -> ContractId Executable -> Script ()
runExecute f configCid executionCid = do
  _ <- submit f.alice $
    exerciseCmd executionCid Executable_Execute with
      actors = [f.alice]
      targets = presentedTargets f configCid
      extraArgs = noArgs
  pure ()

forgedCore : Fixture -> ExecutionCore
forgedCore f = ExecutionCore with
  authorities = Set.fromList [f.dso]
  availableActions = Map.fromList [(EA_Execute, [[f.operator]])]
  opensAt = f.terms.votingClosesAt
  cancelAt = f.terms.votingClosesAt
  expiresAt = Some f.terms.expiresAt
  meta = emptyMetadata

runIssueMustFail : Fixture -> Party -> ExecutionCore -> Script ()
runIssueMustFail f actor core =
  submitMustFail actor $
    exerciseCmd (toInterfaceContractId @Action f.actionCid) Action_AuthorizeExecution with
      actors = [actor]
      executionCore = core
      outcome = Some (toAnyValue yay)
      binds = configBind f.dso openingSetting
      extraArgs = noArgs


configBind : Party -> Text -> Map AuthenticKey Bind
configBind dso setting = Map.fromList
  [ ( configTargetKey dso
    , Bind with state = Some (toAnyValue setting); cid = None
    )
  ]
