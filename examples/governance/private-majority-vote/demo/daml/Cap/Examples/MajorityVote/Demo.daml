module Cap.Examples.MajorityVote.Demo where

import DA.Action (unless, when)
import DA.Assert ((===))
import DA.List (sort)
import DA.Optional (isSome)
import qualified DA.Set as Set
import DA.Time (addRelTime, days)
import Daml.Script

import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyMetadata)

import Cap.Governance.VoteRecordV1 (Vote (..), VoteRecord)
import qualified Cap.Governance.ResolverV1 as ResolverV1
import Cap.Core.IdentityV1 (Identity (..))
import Cap.Governance.Count (Verdict (..))
import Cap.Governance.Vote (encodeTextVote)

import Cap.Examples.MajorityVote.VoteRecord
import Cap.Examples.MajorityVote.Config
import Cap.Examples.MajorityVote.Resolver

import Cap.Examples.MajorityVote.Demo.Fixture

class Visible t where
  isVisibleTo : Party -> ContractId t -> Script Bool

instance Visible PrivateVoteRecord where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible Resolver where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible Config where
  isVisibleTo p cid = isSome <$> queryContractId p cid

instance Visible ConfigUpdate where
  isVisibleTo p cid = isSome <$> queryContractId p cid

sees : Visible t => Party -> ContractId t -> Script ()
sees p cid = do
  visible <- isVisibleTo p cid
  unless visible $
    fail (show p <> " should see " <> show cid <> " but does not")

cannotSee : Visible t => Party -> ContractId t -> Script ()
cannotSee p cid = do
  visible <- isVisibleTo p cid
  when visible $
    fail (show p <> " should not see " <> show cid <> " but does")

visibleTo : Party -> Script [Text]
visibleTo p = do
  resolvers <- query @Resolver p
  proposals <- query @Proposal p
  records <- query @PrivateVoteRecord p
  configs <- query @Config p
  actions <- query @SetConfigAction p
  updates <- query @ConfigUpdate p
  pure $ sort $ concat
    [ map (show . fst) resolvers
    , map (show . fst) proposals
    , map (show . fst) records
    , map (show . fst) configs
    , map (show . fst) actions
    , map (show . fst) updates
    ]

seesExactly : Party -> [Text] -> Script ()
seesExactly p expected = do
  actual <- visibleTo p
  actual === sort expected

public : Fixture -> [Text]
public f = [show f.configCid, show f.actionCid, show f.resolverCid]

publicToOperator : Fixture -> [Text]
publicToOperator f = [show f.actionCid, show f.resolverCid]

data Round = Round with
    fixture : Fixture
    aliceRecord : ContractId PrivateVoteRecord
    bobRecord : ContractId PrivateVoteRecord
    carolRecord : ContractId PrivateVoteRecord

openRound : Text -> Script Round
openRound ns = do
  base <- setupAs ns
  aliceRecord <- seat base base.alice
  bobRecord <- seat base base.bob
  carolRecord <- seat base base.carol

  proposalCid <- liveProposal base
  let fixture = base with proposalCid
  pure Round with ..

data Cast = Cast with
    alice : ContractId PrivateVoteRecord
    bob : ContractId PrivateVoteRecord
    carol : ContractId PrivateVoteRecord

castAll : Round -> Text -> Text -> Text -> Script Cast
castAll round aliceOption bobOption carolOption = do
  let f = round.fixture
  alice <- cast f.alice round.aliceRecord aliceOption
  bob <- cast f.bob round.bobRecord bobOption
  carol <- cast f.carol round.carolRecord carolOption
  pure Cast with ..

allPresented : Cast -> [ContractId PrivateVoteRecord]
allPresented c = [c.alice, c.bob, c.carol]

settingNow : Fixture -> Script Text
settingNow f = do
  [(_, config)] <- query @Config f.dso
  pure config.setting

whoSeesWhat : Script ()
whoSeesWhat = do
  round <- openRound "sees"
  let f = round.fixture
      pub = public f
      open = show f.proposalCid :: pub
      openToOperator = show f.proposalCid :: publicToOperator f

  f.dso `seesExactly` open
  f.alice `seesExactly` (show round.aliceRecord :: open)
  f.bob `seesExactly` (show round.bobRecord :: open)
  f.carol `seesExactly` (show round.carolRecord :: open)
  f.operator `seesExactly`
    (map show [round.aliceRecord, round.bobRecord, round.carolRecord] <> openToOperator)

  setTime f.terms.entryClosesAt
  votes <- castAll round yay yay nay

  f.bob `cannotSee` votes.alice
  f.carol `cannotSee` votes.alice
  f.dso `cannotSee` votes.alice
  f.operator `sees` votes.alice
  f.dso `seesExactly` open

  setTime f.terms.votingClosesAt
  result <- runResolve f (allPresented votes)
  let executionCid = executionOf result

  f.dso `seesExactly` (show executionCid :: pub)
  f.alice `seesExactly` (show executionCid :: pub)

  f.operator `seesExactly` publicToOperator f

  runExecute f f.configCid executionCid
  [(configCid, config)] <- query @Config f.dso
  config.setting === proposedSetting

  let published = [show configCid, show f.actionCid, show f.resolverCid]
  f.dso `seesExactly` published
  f.alice `seesExactly` published
  f.operator `seesExactly` publicToOperator f

theCountCoversTheElectorate : Script ()
theCountCoversTheElectorate = do
  round <- openRound "cover"
  let f = round.fixture

  setTime f.terms.entryClosesAt
  votes <- castAll round yay yay nay

  setTime f.terms.votingClosesAt
  submitMustFailContaining "the presented vote records cover the roll" f.operator $
    resolveCmd f [votes.alice, votes.carol]
  submitMustFailContaining "the presented vote records cover the roll" f.operator $
    resolveCmd f [votes.alice, votes.bob]

  submitMustFail f.operator $ createCmd PrivateVoteRecord with
    operator = f.operator
    voter = f.alice
    resolution = f.resolution
    actionCid = f.terms.actionCid
    opensAt = f.terms.entryClosesAt
    closesAt = f.terms.votingClosesAt
    expiresAt = f.terms.expiresAt
    vote = None
  submitMustFail (actAs f.dso <> actAs f.operator) $ createCmd PrivateVoteRecord with
    operator = f.operator
    voter = f.alice
    resolution = f.resolution
    actionCid = f.terms.actionCid
    opensAt = f.terms.entryClosesAt
    closesAt = f.terms.votingClosesAt
    expiresAt = f.terms.expiresAt
    vote = None
  submitMustFail f.operator $ createCmd PrivateVoteRecord with
    operator = f.operator
    voter = f.alice
    resolution = f.resolution
    actionCid = f.terms.actionCid
    opensAt = f.terms.entryClosesAt
    closesAt = f.terms.votingClosesAt
    expiresAt = f.terms.expiresAt
    vote = Some nay

  result <- runResolve f (allPresented votes)
  result.verdict === Decided yay

theOperatorCannotSkipTheCount : Script ()
theOperatorCannotSkipTheCount = do
  f <- setupAs "skip"
  now <- getTime

  runIssueMustFail f f.operator (forgedCore f)

  submitMustFail f.operator $ createCmd Resolver with
    dso = f.dso
    operator = f.operator
    electorate = Set.fromList [f.alice]
    resolverId = resolverName
    expiresAt = now `addRelTime` days 10

  setting <- settingNow f
  setting === openingSetting


-- A wallet that knows only the interfaces reads the decision through the
-- VoteRecord interface and casts through the Resolver interface, on the voter's
-- private vote record passed in the choice context. A voter cannot cast on
-- another voter's vote record.
voterCastsThroughTheResolverInterface : Script ()
voterCastsThroughTheResolverInterface = do
  round <- openRound "proposal-interface"
  let f = round.fixture
      proposalCid = toInterfaceContractId @VoteRecord f.proposalCid
      resolverCid = toInterfaceContractId @ResolverV1.Resolver f.resolverCid

  Some proposal <- queryInterfaceContractId f.alice proposalCid
  proposal.resolution.mechanism === majorityMechanismName
  proposal.requester === PartyIdentity f.alice
  proposal.reason === configSubject
  proposal.voteBefore === Some f.terms.votingClosesAt
  length proposal.options === 1

  setTime f.terms.entryClosesAt
  let castOn voter recordCid = exerciseCmd resolverCid ResolverV1.Resolver_CastVote with
        caster = voter
        identity = PartyIdentity voter
        resolution = proposal.resolution
        vote = encodeTextVote (Voted yay)
        reason = None
        extraArgs = ExtraArgs with
          context = ChoiceContext with
            values = TextMap.fromList [(voteRecordContextKey, AV_ContractId (coerceContractId recordCid))]
          meta = emptyMetadata
  submitMustFail f.bob (castOn f.bob round.aliceRecord)
  result <- submit f.bob (castOn f.bob round.bobRecord)

  [created] <- pure result.created
  Some record <- queryContractId f.bob (coerceContractId created : ContractId PrivateVoteRecord)
  record.vote === Some yay
