import qualified DA.Map as Map
import DA.Map (Map)
import DA.List (unique, sortOn)
import DA.Foldable (forA_)
import qualified DA.TextMap as TextMap
import qualified DA.Set as Set
import DA.Set (Set)
import Splice.Api.Token.MetadataV1
import Cap.Core.Types (AuthenticKey (..), ResolutionInfo (..), Snapshot (..), ExecutionAction (..), ExecutionCore (..))
import Cap.Core.Utils (IsAnyValue (..), HasCheckedFetch (..), fetchGroup, signedKey, requireMet)
