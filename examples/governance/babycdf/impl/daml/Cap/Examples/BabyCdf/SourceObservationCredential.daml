-- SPDX-License-Identifier: Apache-2.0
module Cap.Examples.BabyCdf.SourceObservationCredential where

import Canton.Network.Credentials.V1
import DA.List (unique)
import DA.NonEmpty (NonEmpty(..), toList)
import qualified DA.TextMap as TM
import qualified DA.Text as Text
import Splice.Api.Token.MetadataV1 (AnyValue(..), emptyMetadata)

data SourceKind = SourceProposal | SourceMilestone deriving (Eq, Show)
data SourceState = SourceOpen | SourceClosed deriving (Eq, Show)
data Verification = ObservedUnverified | ContentDigestChecked deriving (Eq, Show)
data Observation = Observation with
    number : Int
    kind : SourceKind
    sourceUrl : Text
    title : Text
    bodySha256 : Text
    state : SourceState
    updatedAt : Time
    observedAt : Time
    verification : Verification
    parentPR : Optional Int
    linkEvidence : Text
  deriving (Eq, Show)

repository : Text
repository = "canton-foundation/canton-dev-fund"

hexDigit : Int -> Text
hexDigit n = Text.take 1 (Text.drop n "0123456789abcdef")

jsonText : Text -> Text
jsonText t = "\"" <> Text.intercalate "" (map escape (Text.toCodePoints t)) <> "\""
  where
    escape p = case p of
      34 -> "\\\""
      92 -> "\\\\"
      8 -> "\\b"
      12 -> "\\f"
      10 -> "\\n"
      13 -> "\\r"
      9 -> "\\t"
      _ -> if p < 32 then "\\u00" <> hexDigit (if p < 16 then 0 else 1) <> hexDigit (if p < 16 then p else p - 16)
           else if p >= 55296 && p <= 57343 then error "invalid Unicode scalar"
           else Text.fromCodePoints [p]

-- Daml Time Show is UTC with optional fractional microseconds. Pad to exactly six.
canonicalTime : Time -> Text
canonicalTime t =
  let raw = show t
      base = Text.take 19 raw
      suffix = Text.drop 19 raw
      fraction = if Text.take 1 suffix == "." then Text.take 6 (Text.take (Text.length suffix - 2) (Text.drop 1 suffix) <> "000000") else "000000"
  in base <> "." <> fraction <> "Z"

canonical : Text -> Observation -> Int -> Optional Text -> Text
canonical repo o version previous = "[" <> Text.intercalate ","
  [jsonText "babycdf-source-observation/v2", jsonText repo, show o.number,
   jsonText (if o.kind == SourceProposal then "proposal" else "milestone"),
   jsonText o.title, jsonText o.sourceUrl, jsonText o.bodySha256,
   jsonText (if o.state == SourceOpen then "open" else "closed"),
   jsonText (canonicalTime o.updatedAt), maybe "null" show o.parentPR,
   jsonText o.linkEvidence,
   jsonText (if o.verification == ObservedUnverified then "observed_unverified" else "content_digest_checked"),
   show version, maybe "null" jsonText previous] <> "]"

fingerprintOf : Text -> Observation -> Int -> Optional Text -> Text
fingerprintOf repo o version previous = Text.sha256 (canonical repo o version previous)

validDigest : Text -> Bool
validDigest t = Text.length t == 64 && all (\c -> (c >= 48 && c <= 57) || (c >= 97 && c <= 102)) (Text.toCodePoints t)

validObservation : Observation -> Bool
validObservation o = o.number > 0 && Text.length o.title > 0 && Text.length o.title <= 512
  && validDigest o.bodySha256 && Text.length o.sourceUrl <= 512 && Text.length o.linkEvidence <= 4096
  && o.sourceUrl == "https://github.com/" <> repository <>
     (if o.kind == SourceProposal then "/pull/" else "/issues/") <> show o.number
  && o.updatedAt <= o.observedAt
  && case o.parentPR of
       None -> True
       Some n -> o.kind == SourceMilestone && n > 0 && n /= o.number && o.linkEvidence /= ""

contentDigest : Observation -> Text
contentDigest o = fingerprintOf repository o 1 None

credentialOf : Party -> Text -> Observation -> Int -> Optional Text -> CredentialView
credentialOf opener repo o version previous = CredentialView with
  id = Some ("urn:babycdf:source:" <> repo <> ":" <> show o.number <> ":v" <> show version)
  credentialTypes = ["VerifiableCredential", "BabyCDFSourceObservation",
    if o.kind == SourceProposal then "BabyCDFSourceProposal" else "BabyCDFSourceMilestone"]
  issuer = W3C_VC_Identifier_Party opener
  validFrom = Some o.observedAt
  validUntil = None
  credentialSubject = NonEmpty (CredentialSubject (Some (W3C_VC_Identifier o.sourceUrl)) (TM.fromList
    [("repo",AV_Text repo),("number",AV_Int o.number),
     ("kind",AV_Text (if o.kind == SourceProposal then "proposal" else "milestone")),
     ("title",AV_Text o.title),("url",AV_Text o.sourceUrl),("bodySha256",AV_Text o.bodySha256),
     ("state",AV_Text (if o.state == SourceOpen then "open" else "closed")),
     ("updatedAt",AV_Time o.updatedAt),("parentPR",AV_List (maybe [] (\n -> [AV_Int n]) o.parentPR)),
     ("linkEvidence",AV_Text o.linkEvidence),
     ("verification",AV_Text (if o.verification == ObservedUnverified then "observed_unverified" else "content_digest_checked")),
     ("version",AV_Int version),("previousDigest",AV_List (maybe [] (\d -> [AV_Text d]) previous)),
     ("fingerprint",AV_Text (fingerprintOf repo o version previous))])) []
  credentialSchema = []
  securing = None
  holders = []
  anchorers = NonEmpty opener []

registrationOf : Party -> Observation -> RegisteredCredentialView
registrationOf opener o = RegisteredCredentialView opener o.observedAt None TM.empty

-- Pinned CIPS 8e36c20e5106014efb8348f749d9535afbc48921:
-- cn-credentials-standard/cip-canton-network-credentials-standard.md,
-- Core Credential Fields / Credential Interface Normalization (lines 79-129,270-289).
-- Pinned CIP-credentials invariants (V1): Party issuer is an anchorer,
-- signatories are exactly anchorers ++ holders, each list is unique. This
-- profile additionally fixes required types and exactly one textual subject.
sourceCredentialValid : CredentialView -> Bool
sourceCredentialValid v = partyIssuerIsAnchorer v && credentialStructurallyValid v
  && unique (toList v.anchorers) && unique v.holders
  && elem "VerifiableCredential" v.credentialTypes
  && elem "BabyCDFSourceObservation" v.credentialTypes
  && (elem "BabyCDFSourceProposal" v.credentialTypes || elem "BabyCDFSourceMilestone" v.credentialTypes)
  && case v.credentialSubject of NonEmpty _ [] -> True; _ -> False

sourceSignatories : CredentialView -> [Party]
sourceSignatories v = toList v.anchorers <> v.holders

-- Trust contract: opener is the issuer/trust anchor and may create assertions
-- directly. A registered view is NOT proof of factory issuance. Only revisions
-- exercised through the factory verify predecessor lineage against the ledger;
-- a directly created v2 asserts its previous digest without proving a predecessor.
template SourceObservationCredential
  with
    opener : Party
    repo : Text
    observation : Observation
    fingerprint : Text
    version : Int
    previousDigest : Optional Text
  where
    signatory sourceSignatories (credentialOf opener repo observation version previousDigest)
    ensure sourceCredentialValid (credentialOf opener repo observation version previousDigest)
      && repo == repository && validObservation observation && version > 0
      && (if version == 1 then previousDigest == None else maybe False validDigest previousDigest)
      && fingerprint == fingerprintOf repo observation version previousDigest
    key (opener,repo,observation.number) : (Party,Text,Int)
    maintainer key._1
    interface instance Credential for SourceObservationCredential where
      view = credentialOf opener repo observation version previousDigest
      credential_publicFetchImpl _ _ = pure (credentialOf opener repo observation version previousDigest)
      credential_removeSelfAsHolderImpl _ _ = abort "source credentials have no holders"
      credential_archiveAsAllHoldersImpl _ _ = pure (Credential_ArchiveResult
        (credentialOf opener repo observation version previousDigest) emptyMetadata)
    interface instance RegisteredCredential for SourceObservationCredential where
      view = registrationOf opener observation
      registeredCredential_publicFetchImpl _ _ = pure (RegisteredCredential_PublicFetchResult
        (credentialOf opener repo observation version previousDigest) (registrationOf opener observation))

-- A factory is a narrowly bound issuance request. Exact view equality rejects
-- extra/missing claims and every issuer, holder, anchoring or registration drift.
template SourceObservationFactory
  with
    opener : Party
    repo : Text
    observation : Observation
  where
    signatory opener
    ensure repo == repository && validObservation observation
    interface instance CredentialRegistryFactory for SourceObservationFactory where
      view = CredentialRegistryFactoryView opener (NonEmpty opener [])
      credentialRegistryFactory_anchorImpl _ _ = abort "external source issuers unsupported"
      credentialRegistryFactory_issueImpl _ arg = do
        existing <- lookupByKey @SourceObservationCredential (opener,repo,observation.number)
        (version,previous) <- case existing of
          None -> pure (1,None)
          Some cid -> do
            old <- fetch cid
            assertMsg "source kind is immutable" (old.observation.kind == observation.kind)
            assertMsg "source observed time regressed" (observation.observedAt >= old.observation.observedAt)
            assertMsg "source updated time regressed" (observation.updatedAt >= old.observation.updatedAt)
            assertMsg "source content unchanged" (contentDigest old.observation /= contentDigest observation)
            exercise (toInterfaceContractId @Credential cid) Credential_ArchiveAsAnchorers
            pure (old.version + 1,Some old.fingerprint)
        assertMsg "source credential mapping mismatch" (arg.credential == credentialOf opener repo observation version previous)
        assertMsg "source registration mismatch" (arg.registration == registrationOf opener observation)
        cid <- create SourceObservationCredential with opener; repo; observation; version; previousDigest = previous
                                                       fingerprint = fingerprintOf repo observation version previous
        pure (CredentialRegistryFactory_IssueResult (toInterfaceContractId @RegisteredCredential cid))

issueObservation : Party -> Text -> Observation -> Update ()
issueObservation opener repo observation = do
  existing <- lookupByKey @SourceObservationCredential (opener,repo,observation.number)
  lineage <- case existing of
    None -> pure (Some (1,None))
    Some cid -> do
      old <- fetch cid
      assertMsg "source kind is immutable" (old.observation.kind == observation.kind)
      pure (if contentDigest old.observation == contentDigest observation then None else Some (old.version+1,Some old.fingerprint))
  case lineage of
    None -> pure ()
    Some (version,previous) -> do
      factory <- create SourceObservationFactory with opener; repo; observation
      _ <- exercise (toInterfaceContractId @CredentialRegistryFactory factory) (CredentialRegistryFactory_Issue
        (credentialOf opener repo observation version previous) (registrationOf opener observation))
      archive factory
