module Cap.Examples.BabyCdf.SourceCredentialTest where
import Daml.Script
import DA.Assert
import DA.Date
import DA.Time
import DA.List (unique)
import DA.NonEmpty (NonEmpty(..), toList)
import qualified DA.Text as Text
import qualified DA.TextMap as TM
import Canton.Network.Credentials.V1
import Splice.Api.Token.MetadataV1 (AnyValue(..))
import Cap.Examples.BabyCdf.SourceObservationCredential

sample : Time -> Observation
sample now = Observation 184 SourceProposal
  "https://github.com/canton-foundation/canton-dev-fund/pull/184" "café 😀"
  "4375539f2263c313c68efccaa296d00e561e44e5cb4863dfffd2fed733a8bad8"
  SourceClosed (time (date 2026 Jan 1) 0 0 0) now ObservedUnverified None "linked"

canonicalVectors : Script ()
canonicalVectors = script do
  let o = sample (time (date 2026 Jan 2) 0 0 0)
  fingerprintOf repository o 1 None === "ffe8d1c205e45f8b20a747cd03ac42a9653cd064aff4ffc4a88fba013022ef44"
  jsonText "café 😀\"\\\b\f\n\r\t\NUL\US" === "\"café 😀\\\"\\\\\\b\\f\\n\\r\\t\\u0000\\u001f\""
  canonicalTime (addRelTime o.updatedAt (microseconds 100000)) === "2026-01-01T00:00:00.100000Z"
  canonicalTime (addRelTime o.updatedAt (microseconds 123000)) === "2026-01-01T00:00:00.123000Z"
  canonicalTime (addRelTime o.updatedAt (microseconds 123456)) === "2026-01-01T00:00:00.123456Z"
  contentDigest (o with observedAt = addRelTime o.observedAt (seconds 1)) === contentDigest o
  assert (fingerprintOf repository o 2 (Some (contentDigest o)) /= contentDigest o)

credentialViewsAndFactoryGuards : Script ()
credentialViewsAndFactoryGuards = script do
  opener <- allocateParty "credential-opener"
  outsider <- allocateParty "credential-outsider"
  let o = sample (time (date 2026 Jan 2) 0 0 0)
      expected = credentialOf opener repository o 1 None
      registration = registrationOf opener o
  factory <- submit opener $ createCmd (SourceObservationFactory opener repository o)
  let iface = toInterfaceContractId @CredentialRegistryFactory factory
      issue v r = exerciseCmd iface (CredentialRegistryFactory_Issue v r)
      subject = case expected.credentialSubject of NonEmpty s [] -> s; _ -> error "unexpected subjects"
      bad = [(expected with id = None), (expected with issuer = W3C_VC_Identifier_Party outsider),
             (expected with holders = [outsider]), (expected with anchorers = NonEmpty outsider []),
             (expected with credentialTypes = ["VerifiableCredential"]), (expected with validUntil = Some o.observedAt),
             (expected with credentialSubject = NonEmpty (subject with claims = TM.insert "extra" (AV_Text "bad") subject.claims) [])]
  _ <- mapA (\v -> submitMustFail (actAs [opener,outsider]) (issue v registration)) bad
  submitMustFail opener (issue expected (registration with registeredAt = o.updatedAt))
  result <- submit opener (issue expected registration)
  let cid = fromInterfaceContractId @SourceObservationCredential @RegisteredCredential result.issuedCredential
  Some credential <- queryInterfaceContractId @Credential opener (toInterfaceContractId @Credential cid)
  credential === expected
  Some registered <- queryInterfaceContractId @RegisteredCredential opener result.issuedCredential
  registered === registration
  credential.issuer === W3C_VC_Identifier_Party opener
  toList credential.anchorers === [opener]
  credential.holders === []
  sourceSignatories credential === toList credential.anchorers <> credential.holders
  sourceSignatories credential === [opener]
  assert (unique (toList credential.anchorers) && unique credential.holders)
  assert (sourceCredentialValid credential)
  case credential.credentialSubject of NonEmpty _ [] -> pure (); _ -> abort "expected exactly one subject"
  hidden <- queryContractId outsider cid
  hidden === None
  submitMustFail outsider (exerciseCmd result.issuedCredential (RegisteredCredential_PublicFetch opener outsider))
  submitMustFail opener (issue expected registration)
  let changed = o with title = "revised"
  nextFactory <- submit opener $ createCmd (SourceObservationFactory opener repository changed)
  second <- submit opener $ exerciseCmd (toInterfaceContractId @CredentialRegistryFactory nextFactory)
    (CredentialRegistryFactory_Issue (credentialOf opener repository changed 2 (Some (contentDigest o))) (registrationOf opener changed))
  Some revised <- queryContractId opener (fromInterfaceContractId @SourceObservationCredential @RegisteredCredential second.issuedCredential)
  revised.version === 2
  revised.previousDigest === Some (contentDigest o)
  revised.fingerprint === fingerprintOf repository changed 2 (Some (contentDigest o))
  old <- queryContractId opener cid
  old === None
