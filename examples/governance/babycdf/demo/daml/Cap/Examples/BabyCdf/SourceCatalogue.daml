-- SPDX-License-Identifier: Apache-2.0
module Cap.Examples.BabyCdf.SourceCatalogue
  (module Cap.Examples.BabyCdf.SourceObservationCredential, ScanPhase(..), SourceCheckpoint(..), CommitBatch(..)) where

import Cap.Examples.BabyCdf.SourceObservationCredential

import qualified DA.Text as Text
import qualified DA.Set as Set

data ScanPhase = FullSweep | OverlapSweep deriving (Eq, Show)

-- Full sweeps are mandatory initially and after at most three overlap sweeps.
-- Tokens are opaque, bounded adapter observations, not proof of remote coverage.
-- There is deliberately no missing/deletion/reclassification choice.
template SourceCheckpoint
  with
    opener : Party
    repo : Text
    schema : Text
    highWater : Int
    generation : Int
    phase : ScanPhase
    pageToken : Text
    inProgress : Bool
    completedFullGeneration : Int
    overlapsSinceFull : Int
    scanFingerprint : Text
  where
    signatory opener
    observer opener
    ensure schema == "babycdf-source-observation/v2" && repo == repository && highWater >= 0 && generation >= 0
      && completedFullGeneration >= 0 && completedFullGeneration <= generation
      && overlapsSinceFull >= 0 && overlapsSinceFull <= 3
      && Text.length pageToken <= 512 && Text.length scanFingerprint <= 64
    key (opener, repo) : (Party, Text)
    maintainer key._1

    choice CommitBatch : ContractId SourceCheckpoint
      with
        items : [Observation]
        scanPhase : ScanPhase
        nextToken : Text
        complete : Bool
      controller opener
      do
        assertMsg "batch exceeds 50 items" (length items <= 50)
        assertMsg "duplicate batch number" (Set.size (Set.fromList (map (.number) items)) == length items)
        assertMsg "invalid source observation" (all validObservation items)
        assertMsg "invalid continuation token" (Text.length nextToken <= 512
          && (if complete then nextToken == "" else nextToken /= "" && nextToken /= pageToken))
        assertMsg "cannot change phase during scan" (not inProgress || scanPhase == phase)
        assertMsg "full sweep required" (scanPhase == FullSweep
          || (completedFullGeneration > 0 && overlapsSinceFull < 3))
        _ <- mapA (issueObservation opener repo) items
        let nextGeneration = if inProgress then generation else generation + 1
        create this with
          highWater = foldl max highWater (map (.number) items)
          generation = nextGeneration
          phase = scanPhase
          pageToken = nextToken
          inProgress = not complete
          completedFullGeneration = if complete && scanPhase == FullSweep then nextGeneration else completedFullGeneration
          overlapsSinceFull = if complete then (if scanPhase == FullSweep then 0 else overlapsSinceFull + 1) else overlapsSinceFull
          scanFingerprint = Text.sha256 (show (if inProgress then scanFingerprint else "", map contentDigest items))
