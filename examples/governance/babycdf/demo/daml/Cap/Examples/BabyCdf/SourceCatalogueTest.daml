module Cap.Examples.BabyCdf.SourceCatalogueTest where

import Daml.Script
import DA.Assert
import DA.Time
import qualified DA.Text as Text
import Cap.Examples.BabyCdf.SourceCatalogue
import Cap.Examples.BabyCdf.RuleVote
import Cap.Examples.BabyCdf.Live (sourceCatalogueCounts, sourceCatalogueEvidence)
import Cap.Governance.VoteRecordV1 (VoteRecord)
import Cap.Governance.VoteTopicV1 (VoteTopic)

fails : Show a => Text -> Party -> Commands a -> Script ()
fails expected actor commands = do
  result <- trySubmit actor commands
  case result of
    Left err -> assertMsg (show err) (Text.isInfixOf expected (show err))
    Right _ -> abort "expected rejection"

initial : Party -> SourceCheckpoint
initial opener = SourceCheckpoint opener repository 0 0 FullSweep "" False 0 0 ""

sample : Time -> Int -> SourceKind -> Observation
sample now number kind = Observation with
  number; kind; sourceUrl = "https://github.com/" <> repository <>
    (if kind == SourceProposal then "/pull/" else "/issues/") <> show number
  title = "Actual observed title"; body = "Actual observed body"
  state = SourceOpen; updatedAt = now; observedAt = now
  verification = ObservedUnverified; parentPR = None; linkEvidence = ""

catalogueVotingCounts : Script ()
catalogueVotingCounts = script do
  opener <- allocateParty "count-opener"
  outsider <- allocateParty "count-outsider"
  sourceCatalogueCounts opener >>= (=== (0,0,0,0))
  sourceCatalogueEvidence opener
  now <- getTime
  let observations = [sample now 21 SourceProposal, sample now 22 SourceProposal,
                      sample now 23 SourceMilestone]
  checkpoint <- submit opener $ createCmd (initial opener)
  partial <- submit opener $ exerciseCmd checkpoint CommitBatch with
    items = observations; scanPhase = FullSweep; nextToken = "more"; complete = False
  sourceCatalogueCounts opener >>= (=== (3,3,2,1))
  sourceCatalogueCounts outsider >>= (=== (0,0,0,0))
  sourceCatalogueEvidence opener
  rows <- query @SourceItem opener
  _ <- submit opener $ exerciseCmd partial CommitBatch with
    items = map (\o -> o with observedAt = addRelTime now (seconds 1)) observations
    scanPhase = FullSweep; nextToken = ""; complete = True
  replay <- query @SourceItem opener
  replay === rows
  sourceCatalogueCounts opener >>= (=== (3,3,2,1))
  agendas <- query @AgendaProposal opener
  actions <- query @AgendaAction opener
  topics <- queryInterface @VoteTopic opener
  votes <- queryInterface @VoteRecord opener
  assert (null agendas && null actions && null topics && null votes)

catalogueLifecycle : Script ()
catalogueLifecycle = script do
  opener <- allocateParty "catalogue-opener"
  outsider <- allocateParty "catalogue-outsider"
  now <- getTime
  let pr = sample now 184 SourceProposal
      milestone = (sample now 540 SourceMilestone) with
        parentPR = Some 184; linkEvidence = "Body links to proposal #184"
  before <- query @AgendaProposal opener
  actionsBefore <- query @AgendaAction opener
  checkpoint <- submit opener $ createCmd (initial opener)
  partial <- submit opener $ exerciseCmd checkpoint CommitBatch with
    items = [pr, milestone]; scanPhase = FullSweep; nextToken = "page-2"; complete = False
  Some progress <- queryContractId opener partial
  progress.highWater === 540
  progress.completedFullGeneration === 0
  progress.inProgress === True
  rows <- query @SourceItem opener
  length rows === 2
  assert (all (\(_,x) -> x.version == 1 && x.previousDigest == None
    && x.opener == opener && x.repo == repository
    && x.fingerprint == contentDigest x.observation) rows)
  let [(_,storedMilestone)] = filter (\(_,x) -> x.observation.number == 540) rows
  storedMilestone.observation === milestone
  fails "NotVisible" outsider $ exerciseCmd partial CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = ""; complete = True
  hidden <- query @SourceItem outsider
  hidden === []
  replay <- submit opener $ exerciseCmd partial CommitBatch with
    items = [pr,milestone]; scanPhase = FullSweep; nextToken = ""; complete = True
  replayRows <- query @SourceItem opener
  map fst replayRows === map fst rows
  let edited = pr with title = "Edited older proposal"; body = "Changed body"
  updated <- submit opener $ exerciseCmd replay CommitBatch with
    items = [edited]; scanPhase = OverlapSweep; nextToken = ""; complete = True
  editedRows <- query @SourceItem opener
  let [(_,oldEdit)] = filter (\(_,x) -> x.observation.number == 184) editedRows
  oldEdit.version === 2
  oldEdit.previousDigest === Some (contentDigest pr)
  Some updatedProgress <- queryContractId opener updated
  updatedProgress.highWater === 540
  -- Stale checkpoint cannot create even its first item: entire transaction fails.
  fails "NotActive" opener $ exerciseCmd replay CommitBatch with
    items = [sample now 999 SourceProposal]; scanPhase = FullSweep; nextToken = ""; complete = True
  afterStale <- query @SourceItem opener
  afterStale === editedRows
  fails "duplicate batch number" opener $ exerciseCmd updated CommitBatch with
    items = [edited,edited]; scanPhase = FullSweep; nextToken = ""; complete = True
  let collision = (sample now 184 SourceMilestone)
  fails "source kind is immutable" opener $ exerciseCmd updated CommitBatch with
    items = [sample now 998 SourceProposal,collision]; scanPhase = FullSweep; nextToken = ""; complete = True
  afterCollision <- query @SourceItem opener
  afterCollision === editedRows
  closed <- submit opener $ exerciseCmd updated CommitBatch with
    items = [edited with state = SourceClosed]; scanPhase = FullSweep; nextToken = ""; complete = True
  reopened <- submit opener $ exerciseCmd closed CommitBatch with
    items = [edited]; scanPhase = FullSweep; nextToken = ""; complete = True
  finalRows <- query @SourceItem opener
  let [(_,finalPR)] = filter (\(_,x) -> x.observation.number == 184) finalRows
  finalPR.version === 4
  finalPR.observation.state === SourceOpen
  length finalRows === 2
  Some finalProgress <- queryContractId opener reopened
  finalProgress.highWater === 540
  after <- query @AgendaProposal opener
  actionsAfter <- query @AgendaAction opener
  after === before
  actionsAfter === actionsBefore

fullSweepRequired : Script ()
fullSweepRequired = script do
  opener <- allocateParty "sweep-opener"
  c0 <- submit opener $ createCmd (initial opener)
  fails "full sweep required" opener $ exerciseCmd c0 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  c1 <- submit opener $ exerciseCmd c0 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = ""; complete = True
  c2 <- submit opener $ exerciseCmd c1 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  c3 <- submit opener $ exerciseCmd c2 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  c4 <- submit opener $ exerciseCmd c3 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  fails "full sweep required" opener $ exerciseCmd c4 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  _ <- submit opener $ exerciseCmd c4 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = ""; complete = True
  pure ()


-- Each invalid observation differs from an otherwise valid value in one rule.
observationBounds : Script ()
observationBounds = script do
  opener <- allocateParty "bounds-opener"
  now <- getTime
  let pr = sample now 184 SourceProposal
      ms = sample now 540 SourceMilestone
      huge n = Text.intercalate "" (replicate n "x")
  cp <- submit opener $ createCmd (initial opener)
  let bad = [ pr with title = ""
            , pr with title = huge 513
            , pr with body = huge 32769
            , pr with sourceUrl = huge 513
            , pr with linkEvidence = huge 4097
            , pr with sourceUrl = "https://github.com/" <> repository <> "/issues/184"
            , pr with sourceUrl = "https://github.com/other/repo/pull/184"
            , pr with updatedAt = addRelTime now (seconds 1)
            , pr with parentPR = Some 42; linkEvidence = "linked"
            , ms with parentPR = Some 540; linkEvidence = "linked"
            , ms with parentPR = Some 0; linkEvidence = "linked"
            , ms with parentPR = Some 184; linkEvidence = ""
            ]
  _ <- mapA (\o -> fails "invalid source observation" opener $
    exerciseCmd cp CommitBatch with
      items = [o]; scanPhase = FullSweep; nextToken = ""; complete = True) bad
  fails "batch exceeds 50 items" opener $ exerciseCmd cp CommitBatch with
    items = map (\n -> sample now n SourceProposal) [1..51]
    scanPhase = FullSweep; nextToken = ""; complete = True
  -- Repo whitelist is a separate checkpoint invariant, not a malformed URL.
  fails "Template precondition violated" opener $ createCmd ((initial opener) with repo = "other/repo")
  -- Exact inclusive maxima remain valid and a full 50-item batch is accepted.
  let boundary = pr with title = huge 512; body = huge 32768; linkEvidence = huge 4096
  _ <- submit opener $ exerciseCmd cp CommitBatch with
    items = boundary :: map (\n -> sample now n SourceProposal) [1..49]
    scanPhase = FullSweep; nextToken = ""; complete = True
  rows <- query @SourceItem opener
  length rows === 50

revisionGuards : Script ()
revisionGuards = script do
  opener <- allocateParty "revision-opener"
  now <- getTime
  let old = (sample now 184 SourceProposal) with updatedAt = addRelTime now (seconds (-1))
      later = addRelTime now (seconds 10)
      current = old with title = "new revision"; updatedAt = now; observedAt = later
  cp <- submit opener $ createCmd (initial opener)
  c1 <- submit opener $ exerciseCmd cp CommitBatch with
    items = [old]; scanPhase = FullSweep; nextToken = ""; complete = True
  c2 <- submit opener $ exerciseCmd c1 CommitBatch with
    items = [current]; scanPhase = FullSweep; nextToken = ""; complete = True
  [(cid,stored)] <- query @SourceItem opener
  fails "source content unchanged" opener $ exerciseCmd cid ReviseSourceItem with next = current
  -- Updated time is current; observed time alone regresses, while still >= updated.
  let earlierReceipt = current with title = "receipt regression"; observedAt = now
  fails "source observation time regressed" opener $
    exerciseCmd cid ReviseSourceItem with next = earlierReceipt
  -- Receipt stays current, isolating the updated-time guard.
  let stale = old with observedAt = later
  fails "source updated time regressed" opener $ exerciseCmd c2 CommitBatch with
    items = [stale]; scanPhase = FullSweep; nextToken = ""; complete = True
  [(sameCid,same)] <- query @SourceItem opener
  sameCid === cid
  same === stored
  Some progress <- queryContractId opener c2
  progress.generation === 2

checkpointTransitions : Script ()
checkpointTransitions = script do
  opener <- allocateParty "progress-opener"
  now <- getTime
  let a = sample now 184 SourceProposal
      b = sample now 540 SourceMilestone
      digest previous xs = Text.sha256 (show (previous, map contentDigest xs))
      d1 = digest "" [a]
      d2 = digest d1 [b]
      d3 = digest "" [a]
      d4 = digest "" []
  c0 <- submit opener $ createCmd (initial opener)
  fails "invalid continuation token" opener $ exerciseCmd c0 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = ""; complete = False
  fails "invalid continuation token" opener $ exerciseCmd c0 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = "unexpected"; complete = True
  c1 <- submit opener $ exerciseCmd c0 CommitBatch with
    items = [a]; scanPhase = FullSweep; nextToken = "page2"; complete = False
  Some p1 <- queryContractId opener c1
  (p1.generation,p1.overlapsSinceFull,p1.pageToken,p1.phase,p1.scanFingerprint) ===
    (1,0,"page2",FullSweep,d1)
  (p1.completedFullGeneration,p1.inProgress) === (0,True)
  fails "invalid continuation token" opener $ exerciseCmd c1 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = "page2"; complete = False
  -- Full completion exists on this second partial scan, so phase rejection is
  -- independent of the initial full-sweep-required condition.
  c2 <- submit opener $ exerciseCmd c1 CommitBatch with
    items = [b]; scanPhase = FullSweep; nextToken = ""; complete = True
  Some p2 <- queryContractId opener c2
  (p2.generation,p2.overlapsSinceFull,p2.pageToken,p2.phase,p2.scanFingerprint) ===
    (1,0,"",FullSweep,d2)
  (p2.completedFullGeneration,p2.inProgress) === (1,False)
  c3 <- submit opener $ exerciseCmd c2 CommitBatch with
    items = [a]; scanPhase = OverlapSweep; nextToken = ""; complete = True
  Some p3 <- queryContractId opener c3
  (p3.generation,p3.overlapsSinceFull,p3.pageToken,p3.phase,p3.scanFingerprint) ===
    (2,1,"",OverlapSweep,d3)
  (p3.completedFullGeneration,p3.inProgress) === (1,False)
  c4 <- submit opener $ exerciseCmd c3 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = "next"; complete = False
  Some p4 <- queryContractId opener c4
  (p4.generation,p4.overlapsSinceFull,p4.pageToken,p4.phase,p4.scanFingerprint) ===
    (3,1,"next",FullSweep,d4)
  (p4.completedFullGeneration,p4.inProgress) === (1,True)
  fails "cannot change phase during scan" opener $ exerciseCmd c4 CommitBatch with
    items = []; scanPhase = OverlapSweep; nextToken = ""; complete = True
  c5 <- submit opener $ exerciseCmd c4 CommitBatch with
    items = []; scanPhase = FullSweep; nextToken = ""; complete = True
  Some p5 <- queryContractId opener c5
  (p5.generation,p5.overlapsSinceFull,p5.pageToken,p5.phase,p5.scanFingerprint) ===
    (3,0,"",FullSweep,digest d4 [])
  (p5.completedFullGeneration,p5.inProgress,p5.highWater) === (3,False,540)
