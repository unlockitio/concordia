module Cap.Examples.BabyCdf.BootstrapFactoryTest where
import Daml.Script
import DA.Assert
import DA.Time
import DA.Foldable (forA_)
import qualified DA.Set as Set
import Cap.Examples.BabyCdf.Live
import Cap.Examples.BabyCdf.Rights
import Cap.Examples.BabyCdf.RuleVote

allSevenRegistered : Script ()
allSevenRegistered = script do
 state <- bootstrap (BootstrapInput "factory-seven" 5 ruleRefV1 ruleRefV2)
 direct <- query @DirectVotingRight state.opener
 registered <- query @RegisteredVotingRight state.opener
 invitations <- query @VotingRightInvitation state.opener
 factories <- query @VotingRightFactory state.opener
 length direct === 0
 length registered === 7
 length invitations === 0
 length factories === 1
 length state.credentials === 7
 Some governor <- queryContractId state.opener state.governor
 Set.size governor.permanent === 5
 Set.size governor.alternates === 2
 let [(factoryCid,factory)] = factories
 Set.fromList factory.members === Set.union governor.permanent governor.alternates
 forA_ registered $ \(_,right) -> do
   right.cdf === state.opener
   right.registryAdmin === state.opener
   right.registeredAt === right.issuedAt
   right.expiresAt === addRelTime right.issuedAt (hours 12)
   right.registrationExpiresAt === Some right.expiresAt
 now <- getTime
 invitation <- submit state.opener $ createCmd VotingRightInvitation with
   cdf = state.opener; consortiumId = governor.consortiumId
   member = state.member; expiresAt = addRelTime now (hours 12)
 submitMustFail state.opener $ exerciseCmd invitation AcceptRegistered with factory = toInterfaceContractId factoryCid
 pure ()
