module Cap.Examples.BabyCdf.ManualExistingMilestoneTest where
import Daml.Script
import DA.Assert
import DA.Time
import qualified DA.List
import qualified DA.Text as Text
import Cap.Examples.BabyCdf.Live
import Cap.Examples.BabyCdf.RuleVote
import Cap.Examples.BabyCdf.SourceAgenda
import Cap.Examples.BabyCdf.SourceAgendaFixtures
import Cap.Examples.BabyCdf.ManualIdentityTest (manualRefuses)
import Cap.Governance.VoteTopicV1 (VoteTopic)
import qualified Cap.Examples.BabyCdf.SourceObservationCredential as Source

-- `query` returns rows in no guaranteed order, and the order it happens to
-- use depends on contract ids. Sorting by contract id makes an inventory
-- comparison order-independent while still comparing every field.
byCid : [(ContractId a, b)] -> [(ContractId a, b)]
byCid = DA.List.sortOn (show . fst)

manualExistingMilestonePending : Script ()
manualExistingMilestonePending = script do
  let runId = "manual-existing-milestone"
  state <- bootstrap (BootstrapInput runId 5 ruleRefV1 ruleRefV2)
  (grantSource,grantSubject) <- fixtureSource state.opener False
  now <- getTime
  grant <- submit state.opener $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.opener; roundId = runId <> ":pr184"; agenda = Grant grantSubject
    baseVersion = 0; closesAt = addRelTime now (seconds 60); source = Some grantSource
    primaryRights = presentedRights state.core state.credentials
  _ <- proposalVote runId
  None <- queryContractId state.opener grant
  grantApprovals <- query @ApprovedGrantProposal state.opener
  length grantApprovals === 1
  (blocked,subject) <- fixtureSource state.opener True
  sources <- query @Source.SourceObservationCredential state.opener
  let [stored] = [s | (_,s) <- sources, s.observation.number == 540]
      pin = DeliveryPin "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" stored.observation.bodySha256 123 now
      source = blocked with pin; previousRound = None
  milestone <- submit state.opener $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.opener; roundId = runId <> ":milestone540"; agenda = Milestone subject
    baseVersion = 0; closesAt = addRelTime now (hours 2); source = Some source
    primaryRights = presentedRights state.core state.credentials
  Some selected <- queryContractId state.opener milestone
  topicsBefore <- queryInterface @VoteTopic state.opener
  assert (any (\(ref,view) -> ref == toInterfaceContractId @VoteTopic milestone && (case view of Some _ -> True; None -> False)) topicsBefore)
  actionsBefore <- query @AgendaAction state.opener
  receiptsBefore <- query @AgendaRoundReceipt state.opener
  sourcesBefore <- query @Source.SourceObservationCredential state.opener
  first <- milestoneVote runId
  assert (not (Text.isInfixOf "PENDING" first))
  afterVote <- getTime
  afterVote === now
  None <- queryContractId state.opener milestone
  topicsAfter <- queryInterface @VoteTopic state.opener
  assert (all (\(ref,_) -> ref /= toInterfaceContractId @VoteTopic milestone) topicsAfter)
  approvals <- query @ApprovedMilestone state.opener
  let [approved] = [a | (_,a) <- approvals, a.sourceSnapshot.roundId == selected.roundId]
  selected.sourceSnapshot === Some approved.sourceSnapshot
  manualRefuses (milestoneVote runId)
  approvalsAfter <- query @ApprovedMilestone state.opener
  approvalsAfter === approvals
  receiptsAfter <- query @AgendaRoundReceipt state.opener
  -- Compared as an inventory, not as an ordered list: `query` gives no
  -- ordering guarantee, so sorting by contract id keeps this a strict
  -- "nothing was created or archived" check without depending on the order
  -- the participant happens to return rows in.
  byCid receiptsAfter === byCid receiptsBefore
  sourcesAfter <- query @Source.SourceObservationCredential state.opener
  byCid sourcesAfter === byCid sourcesBefore
  actionsAfter <- query @AgendaAction state.opener
  assert (all (\(ref,_) -> ref `elem` map fst actionsBefore) actionsAfter)
  proposalsAfter <- query @AgendaProposal state.opener
  assert (null proposalsAfter)
