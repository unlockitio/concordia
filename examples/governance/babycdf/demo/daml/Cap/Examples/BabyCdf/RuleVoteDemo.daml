import DA.Foldable (forA_)
import DA.List (sort, unique)
import qualified DA.List
import qualified DA.Map as Map
import qualified DA.Set as Set
import DA.Time (addRelTime, hours, minutes)
import Daml.Script hiding (AnyContractId)
import Cap.Examples.BabyCdf.LiveVote (coreQuorum)
import Cap.Governance.ExecutableV1
import Cap.Governance.ResolverV1
import Cap.Governance.VoteRecordV1
import Cap.Governance.VoteTopicV1 (VoteTopic)
import Cap.Governance.Types
import qualified DA.TextMap as TextMap
import Splice.Api.Token.MetadataV1 (ExtraArgs (..), ChoiceContext (..), AnyValue (..), emptyChoiceContext, emptyMetadata)
import qualified Cap.Governance.Utils.Count as Count
import Cap.Examples.BabyCdf.RuleVote
import Cap.Examples.BabyCdf.SourceAgendaFixtures
import Cap.Examples.BabyCdf.SourceAgenda
import Cap.Examples.BabyCdf.PrimaryRightsFixture
import Cap.Examples.BabyCdf.Rights

ruleReferencesAreValidated : Script ()
ruleReferencesAreValidated = do
  validRuleRef ruleRefV1 === True
  validRuleRef ruleRefV2 === True
  validRuleRef (ruleRefV1 with sha256 = "bad") === False

assemblyAttendanceIsSelfRegistered : Script ()
assemblyAttendanceIsSelfRegistered = do
  opener <- allocateParty "assembly-opener"
  p1 <- allocateParty "assembly-permanent-1"
  p2 <- allocateParty "assembly-permanent-2"
  p3 <- allocateParty "assembly-permanent-3"
  p4 <- allocateParty "assembly-permanent-4"
  p5 <- allocateParty "assembly-permanent-5"
  a1 <- allocateParty "assembly-alternate-1"
  a2 <- allocateParty "assembly-alternate-2"
  adviser <- allocateParty "assembly-adviser"
  outsider <- allocateParty "assembly-outsider"
  now <- getTime
  let permanent = Set.fromList [p1, p2, p3, p4, p5]
      alternates = Set.fromList [a1, a2]
      advisers = Set.singleton adviser
      opensAt = now `addRelTime` hours 1
      closesAt = now `addRelTime` hours 2
  assembly <- submit opener $ createCmd RuleAssembly with
    opener; permanent; alternates; advisers; opensAt; closesAt
  submitMustFail p1 $ exerciseCmd assembly RegisterAttendance with attendee = p1
  setTime opensAt
  submitMustFail outsider $ exerciseCmd assembly RegisterAttendance with attendee = outsider
  submitMustFail opener $ exerciseCmd assembly RegisterAttendance with attendee = p1
  adviserCid <- submit adviser $ exerciseCmd assembly RegisterAttendance with attendee = adviser
  a2Cid <- submit a2 $ exerciseCmd assembly RegisterAttendance with attendee = a2
  setTime (opensAt `addRelTime` minutes 15)
  a1Cid <- submit a1 $ exerciseCmd assembly RegisterAttendance with attendee = a1
  duplicateA2 <- submit a2 $ exerciseCmd assembly RegisterAttendance with attendee = a2
  p1Cid <- submit p1 $ exerciseCmd assembly RegisterAttendance with attendee = p1
  Some unchanged <- queryContractId p1 assembly
  unchanged.opensAt === opensAt
  submitMustFail opener $ exerciseCmd assembly ResolveAttendance with
    attendanceCids = [adviserCid, a2Cid, a1Cid, p1Cid]
  setTime closesAt
  submitMustFail p2 $ exerciseCmd assembly RegisterAttendance with attendee = p2
  submitMustFail opener $ exerciseCmd assembly ResolveAttendance with
    attendanceCids = [adviserCid, a2Cid, a2Cid, p1Cid]
  submitMustFail opener $ exerciseCmd assembly ResolveAttendance with
    attendanceCids = [adviserCid, a2Cid, duplicateA2, p1Cid]
  resolved <- submit opener $ exerciseCmd assembly ResolveAttendance with
    attendanceCids = [p1Cid, a1Cid, adviserCid, a2Cid]
  Some attendance <- queryContractId a1 resolved
  attendance.attendees === [adviser, a2, a1, p1]
  attendance.alternatePriority === [a2, a1]
  attendance.assemblyQuorumMet === True
  second <- submit opener $ createCmd RuleAssembly with
    opener; permanent; alternates; advisers; opensAt; closesAt
  submitMustFail opener $ exerciseCmd second ResolveAttendance with
    attendanceCids = [adviserCid, a2Cid]
  noQuorum <- submit opener $ exerciseCmd second ResolveAttendance with attendanceCids = []
  Some emptyAttendance <- queryContractId opener noQuorum
  emptyAttendance.assemblyQuorumMet === False

extra : ExtraArgs
extra = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- Proposal authority is independent of voting membership: the opener can
-- propose without acquiring a ballot or changing the five-primary electorate.
proposerAuthorization : Script ()
proposerAuthorization = do
  opener <- allocateParty "authorization-opener"
  a <- allocateParty "authorization-member-a"
  b <- allocateParty "authorization-member-b"
  c <- allocateParty "authorization-member-c"
  d <- allocateParty "authorization-member-d"
  e <- allocateParty "authorization-member-e"
  f <- allocateParty "authorization-alternate-f"
  g <- allocateParty "authorization-alternate-g"
  outsider <- allocateParty "authorization-outsider"
  let permanent = Set.fromList [a,b,c,d,e]
      alternates = Set.fromList [f,g]
      members = eligible permanent alternates
  governor <- submit opener $ createCmd AgendaGovernor with
    opener; consortiumId = "authorization-cdf"; permanent; alternates
  now <- getTime
  primaryRights <- fixturePrimaryRights opener governor
  (sourceRequest,pinnedSubject) <- fixtureSource opener False
  let proposal proposer roundId = exerciseCmd governor ProposeAgenda with
        proposer; roundId; agenda = Grant pinnedSubject; baseVersion = 0; source = Some sourceRequest
        closesAt = now `addRelTime` hours 1; primaryRights
      checkProposal proposer roundId = do
        cid <- submit (actAs proposer <> readAs opener) $ proposal proposer roundId
        Some created <- queryContractId opener cid
        created.proposer === proposer
        created.members === members
        Set.size created.members === 5
        Set.member opener created.members === False
        ballots <- submit opener $ exerciseCmd cid InviteBallots
        length ballots === 5
        voters <- forA ballots $ \ballot -> do
          Some recorded <- queryContractId opener ballot
          pure recorded.voter
        Set.fromList voters === members
  checkProposal opener "opener"
  checkProposal a "permanent"
  checkProposal f "alternate"
  -- Supply opener read authority so rejection is not a visibility accident.
  submitMultiMustFail [outsider] [opener] $ proposal outsider "outsider"
  Some unchanged <- queryContractId opener governor
  unchanged.permanent === permanent
  unchanged.alternates === alternates

-- Consumer path exercises actual CAP Action authorization and Executable
-- execution; the Java fixture remains advisory and does not read this ledger.
capRuleAndSeparateApprovals : Script ()
capRuleAndSeparateApprovals = do
  _ <- capRuleAndSeparateApprovalsWithMilestone
  pure ()

capRuleAndSeparateApprovalsWithMilestone : Script ()
capRuleAndSeparateApprovalsWithMilestone = do
  opener <- allocateParty "demo-opener"
  a <- allocateParty "member-a"
  b <- allocateParty "member-b"
  c <- allocateParty "member-c"
  d <- allocateParty "member-d"
  e <- allocateParty "member-e"
  f <- allocateParty "alternate-f"
  g <- allocateParty "alternate-g"
  outsider <- allocateParty "outsider"
  adviser <- allocateParty "adviser"
  foreignCdf <- allocateParty "foreign-cdf"
  now <- getTime
  governor <- submit opener $ createCmd AgendaGovernor with
    opener; consortiumId = "demo-cdf"; permanent = Set.fromList [a,b,c,d,e]; alternates = Set.fromList [f,g]
  factory <- submit opener $ createCmd VotingRightFactory with cdf = opener; members = [a,b,c,d,e,f,g]
  let issueFrom cdf factoryCid consortiumId member expiresAt registered = do
        invitation <- submit cdf $ createCmd VotingRightInvitation with
          cdf; consortiumId; member; expiresAt
        if registered then do
          cid <- submit member $ exerciseCmd invitation AcceptRegistered with factory = factoryCid
          pure (member, RegisteredRight cid)
        else do
          cid <- submit member $ exerciseCmd invitation AcceptDirect
          pure (member, DirectRight cid)
      issue member registered =
        issueFrom opener (toInterfaceContractId factory) "demo-cdf" member (now `addRelTime` hours 12) registered
  ra <- issue a False
  rb <- issue b True
  rc <- issue c False
  rd <- issue d True
  re <- issue e False
  let primaryRights = [ra,rb,rc,rd,re]
  rf <- issue f True
  rg <- issue g False
  -- A second live credential for the same member: duplicates can exist on the
  -- ledger and are only rejected where they are presented at resolution.
  (_, duplicateA) <- issue a True
  adviserRight <- issue adviser False
  outsiderRight <- issue outsider False
  (_, expiringC) <- issueFrom opener (toInterfaceContractId factory) "demo-cdf" c
    (now `addRelTime` minutes 30) False
  foreignFactory <- submit foreignCdf $ createCmd VotingRightFactory with
    cdf = foreignCdf; members = [a,b,c]
  (_, foreignA) <- issueFrom foreignCdf (toInterfaceContractId foreignFactory) "demo-cdf" a
    (now `addRelTime` hours 12) True
  (_, otherConsortiumB) <- issueFrom opener (toInterfaceContractId factory) "other-cdf" b
    (now `addRelTime` hours 12) False
  registry <- submit opener $ createCmd RuleRegistry with
    opener; members = Set.fromList [a,b,c,d,e,f,g]; version = 0
  let propose proposer roundId original baseVersion = do
        opened <- getTime
        (agenda,source) <- sourceForAgenda opener original
        submit (actAs proposer <> readAs opener) $ exerciseCmd governor ProposeAgenda with
          proposer; roundId; agenda; baseVersion; source; closesAt = opened `addRelTime` hours 1; primaryRights
      invite proposal = submit opener $ exerciseCmd proposal InviteBallots
      cast voter cid option = submit voter $ exerciseCmd cid CastAgendaVote with option
      resolve proposal ballots rights = submit opener $ exerciseCmd governor ResolveAgenda with
        proposalCid = proposal; ballotCids = ballots; rights
      execute cid targets = submit opener $ exerciseCmd cid Executable_Execute with
        actors = [opener]; targetCids = targets; extraArgs = extra
  submitMustFail outsider $ exerciseCmd governor ProposeAgenda with
    proposer = outsider; roundId = "outsider"; agenda = Grant proposalSubject
    baseVersion = 0; source = None; closesAt = now `addRelTime` hours 1; primaryRights
  first <- propose a "rule-v1" (Architecture (RuleDraft "architecture-review" 1 "interfaces" ruleRefV1)) 0
  -- A second architecture agenda fixes the same base version before either
  -- executes. Its resolved execution must fail against the advanced registry.
  stale <- propose b "rule-v1-stale" (Architecture (RuleDraft "architecture-review" 1 "stale" ruleRefV1)) 0
  [ta,tb,tc,td,te] <- invite stale
  ta1 <- cast a ta (Count.Voted Yes)
  tb1 <- cast b tb (Count.Voted Yes)
  tc1 <- cast c tc (Count.Voted Yes)
  ballots <- invite first
  let [ba, bb, bc, bd, be] = ballots
  let castExtra = ExtraArgs with
        context = ChoiceContext (TextMap.fromList [("babycdf/proposal", AV_ContractId (coerceContractId first)),
          ("babycdf/invited-ballot", AV_ContractId (coerceContractId ba))])
        meta = emptyMetadata
  Some firstProposal <- queryContractId a first
  let genericCastWith caster ownerId resolution action extraArgs =
        exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_CastVote with
          caster; ownerId; resolution; action; extraArgs
          vote = encodeRuleVote (Count.Voted Yes); reason = None
      firstResolution = agendaResolution opener "rule-v1"
      firstAction = Some firstProposal.actionCid
      noInvitation = ExtraArgs with
        context = ChoiceContext (TextMap.singleton "babycdf/proposal" (AV_ContractId (coerceContractId first)))
        meta = emptyMetadata
  submitMustFail a $ genericCastWith a (partyToText a) firstResolution firstAction noInvitation
  submitMustFail outsider $ genericCastWith outsider (partyToText outsider) firstResolution firstAction castExtra
  submitMustFail a $ genericCastWith a (partyToText a) (agendaResolution opener "wrong-round") firstAction castExtra
  submitMustFail a $ genericCastWith a (partyToText a) firstResolution None castExtra
  submitMustFail a $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_CastVote with
    caster = a; ownerId = "another-owner"; resolution = agendaResolution opener "rule-v1"
    vote = encodeRuleVote (Count.Voted Yes); action = Some firstProposal.actionCid
    reason = None; extraArgs = castExtra
  genericCast <- submit a $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_CastVote with
    caster = a; ownerId = partyToText a; resolution = agendaResolution opener "rule-v1"
    vote = encodeRuleVote (Count.Voted Yes)
    action = Some firstProposal.actionCid
    reason = None; extraArgs = castExtra
  let [rawVotedA] = genericCast.created
      votedA = coerceContractId rawVotedA : ContractId AgendaBallot
  submitMustFail a $ genericCastWith a (partyToText a) firstResolution firstAction castExtra
  let votedExtra = ExtraArgs with
        context = ChoiceContext (TextMap.fromList [("babycdf/proposal", AV_ContractId (coerceContractId first)), ("babycdf/invited-ballot", AV_ContractId (coerceContractId votedA))])
        meta = emptyMetadata
  submitMustFail a $ genericCastWith a (partyToText a) firstResolution firstAction votedExtra
  oldInvitation <- queryContractId opener ba
  assert (case oldInvitation of None -> True; Some _ -> False)
  liveForA <- query @AgendaBallot opener
  length [() | (_, ballot) <- liveForA, ballot.roundId == "rule-v1", ballot.voter == a] === 1
  submitMustFail a $ exerciseCmd votedA CastAgendaVote with option = Count.Voted Yes
  submitMustFail b $ exerciseCmd bb CastAgendaVote with option = Count.Absent
  votedB <- cast b bb (Count.Voted Yes)
  submitMustFail opener $ exerciseCmd governor ResolveAgenda with
    proposalCid = first; ballotCids = [votedA,votedB,bc,bd,be]; rights = [ra,rb]
  abstained <- cast c bc (Count.Voted Yes)
  setTime (now `addRelTime` hours 1)
  let resolveFirst rights = submitMustFail opener $ exerciseCmd governor ResolveAgenda with
        proposalCid = first; ballotCids = [votedA,votedB,abstained,bd,be]; rights
  -- Both of a's credentials are live at the same time: this package does not
  -- prevent duplicate issuance, it only refuses to count two for one voter.
  liveDirect <- query @DirectVotingRight a
  liveRegistered <- query @RegisteredVotingRight a
  length [() | (_, r) <- liveDirect, r.member == a] === 1
  length [() | (_, r) <- liveRegistered, r.member == a, r.cdf == opener] === 1
  resolveFirst [ra, (a, duplicateA), rb, rc]
  resolveFirst [(a, duplicateA), ra, rb, rc]
  resolveFirst [ra, ra, rb, rc]
  -- A participating voter without a presented credential, and a presented
  -- credential for a voter who did not take part.
  resolveFirst [ra, rb]
  resolveFirst [ra, rb, rc, rg]
  -- Advisers and outsiders hold no voting credential this round.
  resolveFirst [ra, rb, rc, adviserRight]
  resolveFirst [ra, rb, rc, outsiderRight]
  resolveFirst [ra, rb, outsiderRight]
  -- Wrong holder: b's credential presented as a's.
  resolveFirst [(a, snd rb), rb, rc]
  -- Wrong issuer and wrong consortium claim.
  resolveFirst [(a, foreignA), rb, rc]
  resolveFirst [ra, (b, otherConsortiumB), rc]
  -- Expired at the intended resolution time, even though it was valid earlier.
  resolveFirst [ra, rb, (c, expiringC)]
  Resolution verdict executions <- resolve first [votedA,votedB,abstained,bd,be] [ra,rb,rc]
  verdict === Count.Decided Yes
  forA_ [votedA,votedB,abstained,bd,be] $ \cid -> do
    consumed <- queryContractId opener cid
    assert (case consumed of None -> True; Some _ -> False)
  Resolution _ [staleExecution] <- resolve stale [ta1,tb1,tc1,td,te] [ra,rb,rc]
  let [execution] = executions
      target cid = Map.fromList [(registryKey opener, coerceContractId cid)]
  submitMustFail outsider $ exerciseCmd execution Executable_Execute with
    actors = [outsider]; targetCids = target registry; extraArgs = extra
  executed <- execute execution (target registry)
  let [nextRegistry, ruleCid] = executed.created
  submitMustFail opener $ exerciseCmd staleExecution Executable_Execute with
    actors = [opener]
    targetCids = target (coerceContractId nextRegistry : ContractId RuleRegistry)
    extraArgs = extra
  Some active <- queryContractId a (coerceContractId ruleCid : ContractId EffectiveRule)
  active.draft.version === 1
  application <- submit a $ exerciseCmd (coerceContractId ruleCid : ContractId EffectiveRule) ApplyRule with
    subject = proposalSubject; reviewer = a
  Some applied <- queryContractId a application
  applied.draft.ruleRef === ruleRefV1
  applied.findings === []
  second <- propose b "rule-v2" (Architecture (RuleDraft "architecture-review" 2 "migration" ruleRefV2)) 1
  [sa,sb,sc,sd,se] <- invite second
  sa1 <- cast a sa (Count.Voted Yes)
  sb1 <- cast b sb (Count.Voted Yes)
  sc1 <- cast c sc (Count.Voted Yes)
  current <- getTime
  setTime (current `addRelTime` hours 1)
  Resolution _ [secondExec] <- resolve second [sa1,sb1,sc1,sd,se] [ra,rb,rc]
  submitMustFail opener $ exerciseCmd secondExec Executable_Execute with
    actors = [opener]; targetCids = target registry; extraArgs = extra
  updated <- execute secondExec (target (coerceContractId nextRegistry : ContractId RuleRegistry))
  let [_, secondRule] = updated.created
  milestoneReview <- submit b $ exerciseCmd (coerceContractId secondRule : ContractId EffectiveRule) ApplyRule with
    subject = milestoneSubject; reviewer = b
  Some reviewed <- queryContractId b milestoneReview
  reviewed.draft.ruleRef === ruleRefV2
  reviewed.findings === []
  grant <- propose a "grant" (Grant proposalSubject) 0
  [ga,gb,gc,gd,ge] <- invite grant
  ga1 <- cast a ga (Count.Voted Yes)
  gb1 <- cast b gb (Count.Voted Yes)
  gc1 <- cast c gc (Count.Voted Yes)
  current <- getTime
  setTime (current `addRelTime` hours 1)
  -- Resolve through the generic interface using a signed, typed request;
  -- it must execute the same credential-backed strict resolution path.
  request <- submit opener $ createCmd AgendaResolverRequest with
    opener; proposalCid = grant; rights = [ra,rb,rc]
  let requestExtra = ExtraArgs with
        context = ChoiceContext (TextMap.singleton "babycdf/request" (AV_ContractId (coerceContractId request)))
        meta = emptyMetadata
  submitMustFail a $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_Resolve with
    actors = [a]; resolution = agendaResolution opener "grant"
    voteRecordCids = map (toInterfaceContractId @VoteRecord) [ga1,gb1,gc1,gd,ge]
    extraArgs = requestExtra
  wrongRequest <- submit opener $ createCmd AgendaResolverRequest with
    opener; proposalCid = grant; rights = [ra,rb,rc]
  submitMustFail opener $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_Resolve with
    actors = [opener]; resolution = agendaResolution opener "another-proposal"
    voteRecordCids = map (toInterfaceContractId @VoteRecord) [ga1,gb1,gc1,gd,ge]
    extraArgs = ExtraArgs with
      context = ChoiceContext (TextMap.singleton "babycdf/request" (AV_ContractId (coerceContractId wrongRequest)))
      meta = emptyMetadata
  generic <- submit opener $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_Resolve with
    actors = [opener]; resolution = agendaResolution opener "grant"
    voteRecordCids = map (toInterfaceContractId @VoteRecord) [ga1,gb1,gc1,gd,ge]
    extraArgs = requestExtra
  generic.status === RS_Decided
  consumedRequest <- queryContractId opener request
  assert (case consumedRequest of None -> True; Some _ -> False)
  submitMustFail opener $ exerciseCmd (toInterfaceContractId @Resolver governor) Resolver_Resolve with
    actors = [opener]; resolution = agendaResolution opener "grant"
    voteRecordCids = map (toInterfaceContractId @VoteRecord) [ga1,gb1,gc1,gd,ge]
    extraArgs = requestExtra
  let [grantExec] = generic.executions
  grantResult <- execute grantExec Map.empty
  let [grantCid] = grantResult.created
  Some approvedGrant <- queryContractId a (coerceContractId grantCid : ContractId ApprovedGrantProposal)
  approvedGrant.proposal.kind === "proposal"
  submitMustFail a $ exerciseCmd governor ProposeAgenda with
    proposer = a; roundId = "unpinned"; agenda = Milestone milestoneSubject
    baseVersion = 0; source = None; closesAt = current `addRelTime` hours 2; primaryRights
  milestone <- propose f "milestone" (Milestone illustrativeMilestone) 0
  [ma,mb,mc,md,me] <- invite milestone
  ma1 <- cast a ma (Count.Voted Yes)
  mb1 <- cast b mb (Count.Voted No)
  mc1 <- cast c mc Count.Abstained
  current <- getTime
  setTime (current `addRelTime` hours 1)
  Resolution split noExecution <- resolve milestone [ma1,mb1,mc1,md,me] [ra,rb,rc]
  split === Count.Undecided
  noExecution === []
  -- Missing delivery evidence is blocked, never an illustrative executable approval.
  later <- propose f "milestone-blocked" (Milestone illustrativeMilestone) 0
  Some blockedProposal <- queryContractId opener later
  submit opener $ archiveCmd later
  -- This legacy return value is removed below; no approval CID is fabricated.

  -- Quorum of three core members, offline. This mirrors exactly what the live
  -- journey does in steps 2-4 and in step 6 case 2, so the behaviour the demo
  -- narrates is proven here without a network, a container or wall-clock time.
  let permanentList = [a, b, c, d, e]
      alternateList = [f, g]
      allCredentials = [ra, rb, rc, rd, re, rf, rg]
      three = coreQuorum 3 permanentList
      two = coreQuorum 2 permanentList
  -- Selection comes from the permanent membership, never from ballot order.
  -- An alternate must never appear in it, however the party IDs happen to
  -- sort, which is the mistake "just take the first three ballots" makes.
  length three === 3
  unique three === True
  forA_ three $ \voter -> do
    assert (voter `elem` permanentList)
    assert (not (voter `elem` alternateList))
  -- Deterministic and prefix-stable: the smaller selection is the start of the
  -- larger one, so the no-quorum round is the same round one voter lighter.
  two === take 2 three
  length two === 2
  -- Selecting more than the committee holds returns what exists rather than
  -- inventing a voter, and a non-positive count selects nobody.
  coreQuorum 9 permanentList === sort permanentList
  coreQuorum 0 permanentList === []
  let presentedFor voters = [(m, r) | (m, r) <- allCredentials, m `elem` voters]
  length (presentedFor three) === 3
  length (presentedFor two) === 2

  -- All five primary ballots exist, three are cast YES, two stay Absent,
  -- and only the three participants present a credential.
  quorate <- propose a "core-quorum-three" (Grant proposalSubject) 0
  quorateBallots <- invite quorate
  length quorateBallots === 5
  loadedQuorate <- forA quorateBallots $ \cid -> do
    Some ballot <- queryContractId opener cid
    pure (cid, ballot)
  -- Every member of the electorate holds exactly one ballot in the round.
  Set.fromList (map ((.voter) . snd) loadedQuorate) === Set.fromList permanentList
  castQuorate <- forA loadedQuorate $ \(cid, ballot) ->
    if ballot.voter `elem` three then cast ballot.voter cid (Count.Voted Yes) else pure cid
  -- Exactly two primary ballots remain uncast and record Absent on the ledger.
  absentVotes <- forA [cid | (cid, ballot) <- loadedQuorate, not (ballot.voter `elem` three)] $ \cid -> do
    Some untouched <- queryContractId opener cid
    pure untouched.vote
  length absentVotes === 2
  forA_ absentVotes (=== Count.Absent)
  current <- getTime
  setTime (current `addRelTime` hours 1)
  -- Presenting the whole electorate's credentials in a three-voter round is
  -- itself a refusal: the count demands one credential per participant, so the
  -- projection is a requirement and not a convenience.
  submitMustFail opener $ exerciseCmd governor ResolveAgenda with
    proposalCid = quorate; ballotCids = castQuorate; rights = allCredentials
  -- Dropping a participant's credential is refused for the same reason.
  submitMustFail opener $ exerciseCmd governor ResolveAgenda with
    proposalCid = quorate; ballotCids = castQuorate; rights = presentedFor two
  Resolution quorateVerdict quorateExecutions <-
    resolve quorate castQuorate (presentedFor three)
  quorateVerdict === Count.Decided Yes
  length quorateExecutions === 1

  -- OPERATION-ORDER REGRESSION.
  --
  -- Each evidence snapshot in the live journey is labelled with a moment
  -- ("after ballots issued, before any cast"), and a label is only true if the
  -- operation really has happened by then. A previous revision took that
  -- snapshot before `InviteBallots` executed. Asserting the label, or the
  -- source order, would not have caught it; these assertions instead QUERY the
  -- ledger at each stage with the same interface queries the live evidence
  -- block uses, so a regression in operation order changes a NUMBER here
  -- rather than only a word in a log.
  --
  -- SCOPE NOTE. The live steps now run ONE round at a time: step 2 proposes,
  -- votes, resolves and executes a single agenda before anything else starts.
  -- The two-round section below is therefore an offline QUERY-SEMANTICS test
  -- (how counts accumulate and dedup across concurrently visible rounds), NOT
  -- a model of the live workflow; `singleRoundStages` immediately after it is
  -- the one that mirrors the live sequence. Nothing here should be read as
  -- evidence that the live journey interleaves two rounds, because it does
  -- not.
  let voteRecordsVisibleTo witnessList = do
        rows <- concat <$> forA witnessList (\w -> queryInterface @VoteRecord w)
        let uniqueRows = DA.List.dedupOn (show . fst) rows
            decoded = concat [Map.values view.votes | (_, Some view) <- uniqueRows]
            countOf wanted = length
              [() | v <- decoded, Some d <- [decodeRuleVote v], d == wanted]
        pure (length uniqueRows, countOf (Count.Voted Yes), countOf Count.Absent)
      witnesses = [opener, a]
      topicsVisible = do
        rows <- concat <$> forA witnesses (\w -> queryInterface @VoteTopic w)
        pure (length (DA.List.dedupOn (show . fst) rows))

  -- Stage A: nothing of this round exists yet. The count is 0 because no
  -- record has been created, NOT because anything was consumed.
  (before, _, _) <- voteRecordsVisibleTo witnesses
  before === 0

  orderA <- propose a "order-round-a" (Grant proposalSubject) 0
  orderB <- propose b "order-round-b" (Grant proposalSubject) 0
  topicsAfterPropose <- topicsVisible
  topicsAfterPropose === 2

  -- Stage B: issuance only. Both rounds issue 7 ballots, all Absent, and no
  -- YES exists yet. This is exactly the moment the live snapshot claims.
  issuedA <- invite orderA
  length issuedA === 5
  (afterFirstIssue, yesFirstIssue, absentFirstIssue) <- voteRecordsVisibleTo witnesses
  afterFirstIssue === 5
  yesFirstIssue === 0
  absentFirstIssue === 5
  issuedB <- invite orderB
  length issuedB === 5
  (afterBothIssued, yesBothIssued, absentBothIssued) <- voteRecordsVisibleTo witnesses
  afterBothIssued === 10
  yesBothIssued === 0
  absentBothIssued === 10

  -- Stage C: casting. Three core YES per round, four Absent per round.
  castA <- forA (zip issuedA [0, 1, 2, 3, 4, 5, 6]) $ \(cid, _) -> do
    Some ballot <- queryContractId opener cid
    if ballot.voter `elem` three then cast ballot.voter cid (Count.Voted Yes) else pure cid
  (afterCastA, yesCastA, absentCastA) <- voteRecordsVisibleTo witnesses
  afterCastA === 10
  yesCastA === 3
  absentCastA === 7
  castB <- forA (zip issuedB [0, 1, 2, 3, 4, 5, 6]) $ \(cid, _) -> do
    Some ballot <- queryContractId opener cid
    if ballot.voter `elem` three then cast ballot.voter cid (Count.Voted Yes) else pure cid
  (afterCastB, yesCastB, absentCastB) <- voteRecordsVisibleTo witnesses
  afterCastB === 10
  yesCastB === 6
  absentCastB === 4

  -- Stage D: resolution consumes the records it counted. Exactly three
  -- credentials are presented, one per participant.
  current <- getTime
  setTime (current `addRelTime` hours 1)
  Resolution orderVerdictA _ <- resolve orderA castA (presentedFor three)
  orderVerdictA === Count.Decided Yes
  (afterResolveA, _, _) <- voteRecordsVisibleTo witnesses
  afterResolveA === 5
  Resolution orderVerdictB _ <- resolve orderB castB (presentedFor three)
  orderVerdictB === Count.Decided Yes
  (afterResolveB, yesAfterResolve, absentAfterResolve) <- voteRecordsVisibleTo witnesses
  -- Zero now, and for a different reason than at stage A: these records were
  -- consumed by the resolves just observed. The count alone cannot tell the
  -- two cases apart, which is why the live narration does not explain a zero
  -- except where a resolve was actually observed.
  afterResolveB === 0
  yesAfterResolve === 0
  absentAfterResolve === 0
  -- Both zeros are equal as numbers; the stages that produced them are not.
  before === afterResolveB

  -- SINGLE-ROUND SEQUENCE, mirroring the live steps.
  --
  -- One agenda, carried from proposal to execution with nothing else open, so
  -- the counts a listener sees in the live run are the counts asserted here.
  (cleanStart, _, _) <- voteRecordsVisibleTo witnesses
  cleanStart === 0
  soloTopicsBefore <- topicsVisible
  soloTopicsBefore === 0
  solo <- propose a "single-round" (Grant proposalSubject) 0
  soloTopicsOpen <- topicsVisible
  soloTopicsOpen === 1
  soloIssued <- invite solo
  length soloIssued === 5
  (soloAfterIssue, soloYesIssue, soloAbsentIssue) <- voteRecordsVisibleTo witnesses
  soloAfterIssue === 5
  soloYesIssue === 0
  soloAbsentIssue === 5
  soloCast <- forA soloIssued $ \cid -> do
    Some ballot <- queryContractId opener cid
    if ballot.voter `elem` three then cast ballot.voter cid (Count.Voted Yes) else pure cid
  (soloAfterCast, soloYesCast, soloAbsentCast) <- voteRecordsVisibleTo witnesses
  soloAfterCast === 5
  soloYesCast === 3
  soloAbsentCast === 2
  current <- getTime
  setTime (current `addRelTime` hours 1)
  Resolution soloVerdict soloExecutions <- resolve solo soloCast (presentedFor three)
  soloVerdict === Count.Decided Yes
  length soloExecutions === 1
  (soloAfterResolve, _, _) <- voteRecordsVisibleTo witnesses
  soloAfterResolve === 0
  soloTopicsAfter <- topicsVisible
  soloTopicsAfter === 0
  -- Only one round was ever open, so the step's counts cannot be confused
  -- with a second agenda's.
  case soloExecutions of
    [soloExec] -> do
      soloResult <- execute soloExec Map.empty
      length soloResult.created === 1
    _ -> abort "expected one execution"

  -- STALE RULE CHANGE (optional round 1), as a real drift refusal.
  --
  -- An Architecture agenda pins the registry state it was written against, so
  -- an agenda proposed with baseVersion 1 while the registry has already moved
  -- to v2 cannot be applied. This asserts the governed semantics the optional
  -- round demonstrates: the vote SUCCEEDS and the EXECUTION is refused, and
  -- the refusal is snapshot drift on a freshly created execution, not a
  -- replay of a consumed contract.
  -- The live registry is read from the ledger: earlier rounds in this script
  -- have already advanced and replaced it, so a remembered CID would be stale
  -- for the wrong reason and would prove nothing about snapshot drift.
  liveRegistryRows <- query @RuleRegistry opener
  let [(bumpedRegistry, atV2)] = DA.List.dedupOn (show . fst) liveRegistryRows
  -- This script's earlier rounds already took the rule book to v2.
  atV2.version === 2
  -- Now the stale agenda: baseVersion 1 against a live v2 registry.
  staleAgenda <- propose a "stale-after-v2"
    (Architecture (RuleDraft "architecture-review" 2 "stale attempt" ruleRefV2)) 1
  staleIssued <- invite staleAgenda
  length staleIssued === 5
  staleCast <- forA staleIssued $ \cid -> do
    Some ballot <- queryContractId opener cid
    if ballot.voter `elem` three then cast ballot.voter cid (Count.Voted Yes) else pure cid
  (staleRecords, staleYes, staleAbsent) <- voteRecordsVisibleTo witnesses
  staleRecords === 5
  staleYes === 3
  staleAbsent === 2
  currentStale <- getTime
  setTime (currentStale `addRelTime` hours 1)
  -- The VOTE succeeds: three core YES, exactly three credentials presented.
  Resolution staleVerdict staleExecutions <- resolve staleAgenda staleCast (presentedFor three)
  staleVerdict === Count.Decided Yes
  length staleExecutions === 1
  -- The EXECUTION is refused, on the current registry, for snapshot drift.
  case staleExecutions of
    [staleExec] -> submitMustFail opener $ exerciseCmd staleExec Executable_Execute with
      actors = [opener]; targetCids = target bumpedRegistry; extraArgs = extra
    _ -> abort "expected one execution"
  -- The rule book is untouched by the refusal.
  Some afterRefusal <- queryContractId opener bumpedRegistry
  afterRefusal.version === 2

  -- The same round one voter short: two core members, five absent. Nothing is
  -- rejected and nothing fails; the count answers Lapsed with no executions.
  short <- propose a "core-quorum-two" (Grant proposalSubject) 0
  shortBallots <- invite short
  length shortBallots === 5
  loadedShort <- forA shortBallots $ \cid -> do
    Some ballot <- queryContractId opener cid
    pure (cid, ballot)
  castShort <- forA loadedShort $ \(cid, ballot) ->
    if ballot.voter `elem` two then cast ballot.voter cid (Count.Voted Yes) else pure cid
  current <- getTime
  setTime (current `addRelTime` hours 1)
  Resolution shortVerdict shortExecutions <- resolve short castShort (presentedFor two)
  shortVerdict === Count.Lapsed
  shortExecutions === []
  pure ()

ruleReferenceLocationIsOpaque : Script ()
ruleReferenceLocationIsOpaque = do
  validRuleRef (ruleRefV1 with location = "https://example.org/another/rule.json") === True
