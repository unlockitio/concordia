module Cap.Examples.BabyCdf.ManualExistingRoundTest where

import Daml.Script
import DA.Assert
import DA.Time
import Cap.Examples.BabyCdf.Live
import Cap.Examples.BabyCdf.RuleVote
import Cap.Examples.BabyCdf.SourceAgendaFixtures
import Cap.Examples.BabyCdf.SourceAgenda
import qualified Cap.Examples.BabyCdf.SourceObservationCredential as Source
import qualified DA.Text as Text
import qualified DA.Set as Set
import qualified Cap.Governance.Utils.Count as Count
import Cap.Examples.BabyCdf.LiveVote (coreQuorum)

manualExistingProposalPending : Script ()
manualExistingProposalPending = script do
  let runId = "manual-existing-proposal-pending"
  state <- bootstrap (BootstrapInput runId 5 ruleRefV1 ruleRefV2)
  _ <- ruleVoteWith setTime runId
  (_,anchor) <- findAnchorAtLeast runId 2
  (source,subject) <- fixtureSource state.opener False
  now <- getTime
  proposal <- submit state.opener $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.opener; roundId = runId <> ":existing-pr184"; agenda = Grant subject
    baseVersion = 0; closesAt = addRelTime now (hours 2); source = Some source
  before <- query @AgendaProposal state.opener
  actionsBefore <- query @AgendaAction state.opener
  receiptsBefore <- query @AgendaRoundReceipt state.opener
  credentialsBefore <- query @Source.SourceObservationCredential state.opener
  first <- proposalVote runId
  second <- proposalVote runId
  first === second
  after <- query @AgendaProposal state.opener
  actionsAfter <- query @AgendaAction state.opener
  assert (length before == length after && all (\row -> row `elem` after) before)
  assert (length actionsBefore == length actionsAfter && all (\row -> row `elem` actionsAfter) actionsBefore)
  receiptsAfter <- query @AgendaRoundReceipt state.opener
  assert (length receiptsBefore == length receiptsAfter && all (\row -> row `elem` receiptsAfter) receiptsBefore)
  credentialsAfter <- query @Source.SourceObservationCredential state.opener
  assert (length credentialsBefore == length credentialsAfter && all (\row -> row `elem` credentialsAfter) credentialsBefore)
  Some selected <- queryContractId state.opener proposal
  ballots <- query @AgendaBallot state.opener
  length [b | (_,b) <- ballots, b.roundId == selected.roundId] === 7
  setTime (addRelTime now (hours 2))
  checkpoints <- query @ManualRoundPending state.opener
  let [(checkpoint,_)] = [(ref,p) | (ref,p) <- checkpoints, p.proposalCid == proposal]
      voters = coreQuorum quorumSize anchor.core
      rights = presentedRights voters anchor.credentials
      voted = [ref | (ref,b) <- ballots, b.roundId == selected.roundId]
  _ <- submit state.opener $ exerciseCmd checkpoint ResolveManualRound with
    governorCid = state.governor; ballotCids = voted; rights
  _ <- proposalVote runId
  _ <- proposalVote runId
  None <- queryContractId state.opener proposal
  approvals <- query @ApprovedGrantProposal state.opener
  let [approved] = [a | (_,a) <- approvals, a.sourceSnapshot.roundId == selected.roundId]
  selected.sourceSnapshot === Some approved.sourceSnapshot
  finalReceipts <- query @AgendaRoundReceipt state.opener
  finalActions <- query @AgendaAction state.opener
  finalCredentials <- query @Source.SourceObservationCredential state.opener
  assert (length receiptsBefore == length finalReceipts && all (\row -> row `elem` finalReceipts) receiptsBefore)
  assert (length credentialsBefore == length finalCredentials && all (\row -> row `elem` finalCredentials) credentialsBefore)
  assert (all (\(ref,_) -> ref `elem` map fst actionsBefore) finalActions)
  pure ()
