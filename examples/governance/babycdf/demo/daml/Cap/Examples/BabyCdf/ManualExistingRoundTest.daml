module Cap.Examples.BabyCdf.ManualExistingRoundTest where
import Daml.Script
import DA.Assert
import DA.Time
import Cap.Examples.BabyCdf.Live
import Cap.Examples.BabyCdf.RuleVote
import Cap.Examples.BabyCdf.SourceAgendaFixtures
import Cap.Examples.BabyCdf.ManualIdentityTest (manualRefuses)
import Cap.Governance.VoteTopicV1 (VoteTopic)
import qualified Cap.Examples.BabyCdf.SourceObservationCredential as Source
import qualified DA.Text as Text

manualExistingProposalPending : Script ()
manualExistingProposalPending = script do
  let runId = "manual-existing-proposal-early"
  state <- bootstrap (BootstrapInput runId 5 ruleRefV1 ruleRefV2)
  (source,subject) <- fixtureSource state.opener False
  now <- getTime
  proposal <- submit state.opener $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.opener; roundId = runId <> ":existing-pr184"; agenda = Grant subject
    baseVersion = 0; closesAt = addRelTime now (hours 2); source = Some source
    primaryRights = presentedRights state.core state.credentials
  Some selected <- queryContractId state.opener proposal
  topicsBefore <- queryInterface @VoteTopic state.opener
  assert (any (\(ref,view) -> ref == toInterfaceContractId @VoteTopic proposal && (case view of Some _ -> True; None -> False)) topicsBefore)
  actionsBefore <- query @AgendaAction state.opener
  receiptsBefore <- query @AgendaRoundReceipt state.opener
  credentialsBefore <- query @Source.SourceObservationCredential state.opener
  first <- proposalVote runId
  assert (not (Text.isInfixOf "PENDING" first))
  afterVote <- getTime
  afterVote === now
  None <- queryContractId state.opener proposal
  topicsAfter <- queryInterface @VoteTopic state.opener
  assert (all (\(ref,_) -> ref /= toInterfaceContractId @VoteTopic proposal) topicsAfter)
  approvals <- query @ApprovedGrantProposal state.opener
  let [approved] = [a | (_,a) <- approvals, a.sourceSnapshot.roundId == selected.roundId]
  selected.sourceSnapshot === Some approved.sourceSnapshot
  manualRefuses (proposalVote runId)
  approvalsAfter <- query @ApprovedGrantProposal state.opener
  approvalsAfter === approvals
  receiptsAfter <- query @AgendaRoundReceipt state.opener
  receiptsAfter === receiptsBefore
  credentialsAfter <- query @Source.SourceObservationCredential state.opener
  credentialsAfter === credentialsBefore
  actionsAfter <- query @AgendaAction state.opener
  assert (all (\(ref,_) -> ref `elem` map fst actionsBefore) actionsAfter)
  proposalsAfter <- query @AgendaProposal state.opener
  assert (null proposalsAfter)
  ballots <- query @AgendaBallot state.opener
  assert (null [b | (_,b) <- ballots, b.roundId == selected.roundId])
