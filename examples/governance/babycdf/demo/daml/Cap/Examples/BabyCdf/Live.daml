data BootstrapInput = BootstrapInput with
  userName : Text
  windowSeconds : Int
  initialRuleRef : RuleRef
  proposedRuleRef : RuleRef
    deriving (Eq, Show)

data ConfiguredBootstrapInput = ConfiguredBootstrapInput with
  input : BootstrapInput
  credentialValiditySeconds : Int
    deriving (Eq, Show)

bootstrapConfigured : ConfiguredBootstrapInput -> Script LiveState
bootstrapConfigured configured = bootstrapWithValidity configured.credentialValiditySeconds configured.input

data LiveState = LiveState with
  member : Party
  opener : Party
  governor : ContractId AgendaGovernor
  userName : Text
  verifiedRights : [UserRight]
  intakeUserName : Text
  intakeVerifiedRights : [UserRight]
  registry : ContractId RuleRegistry
  rule : ContractId EffectiveRule
  credentials : [(Party, RightRef)]
  -- The committee's permanent members, read from the AgendaGovernor itself.
  -- Carried as state so every later step selects voters from the real
  -- membership rather than from ballot order, which includes alternates.
  core : [Party]
  windowSeconds : Int
  step : Int
    deriving (Eq, Show)

template DemoAnchor
  with
    opener : Party
    demoRunId : Text
    member : Party
    governor : ContractId AgendaGovernor
    userName : Text
    registry : ContractId RuleRegistry
    rule : ContractId EffectiveRule
    credentials : [(Party, RightRef)]
    core : [Party]
    windowSeconds : Int
    proposedRuleRef : RuleRef
    step : Int
  where
    signatory opener
    observer member

bootstrap : BootstrapInput -> Script LiveState
bootstrap = bootstrapWithValidity (30 * 24 * 60 * 60)

bootstrapWithValidity : Int -> BootstrapInput -> Script LiveState
bootstrapWithValidity validitySeconds input = do
  assert (validitySeconds >= 3600 && validitySeconds <= 365 * 24 * 60 * 60 && validitySeconds % 3600 == 0)
  stepHeading 1 "SETUP AND CREDENTIALS"
  -- INITIAL STATE for step 1 is a special case, and is reported honestly as
  -- one. No demo party exists yet, so there is no witness to scope a
  -- contract query to: querying "all known parties" for contracts would be a
  -- visibility claim this script cannot make. What CAN be observed before any
  -- allocation is the participant's party and user lists, so only those are
  -- reported, and the demo scope is stated as not yet allocated. A later
  -- INITIAL STATE, from step 2 onward, is a real scoped contract query.
  phase 1 "INITIAL STATE"
  startingParties <- listKnownParties
  startingUsers <- listAllUsers
  evidenceLine 1 ("Participant before setup: parties known " <> show (length startingParties)
    <> ", ledger users " <> show (length startingUsers)
    <> " [participant-level counts, not a contract query]")
  evidenceLine 1 "No demo scope allocated yet: no committee, no credentials, no rule book."
  evidenceLine 1 ("This is a fresh-run statement only. If a previous run's parties are still "
    <> "present on this participant they are included in the counts above; "
    <> "contract-level INITIAL STATE begins at step 2.")
  phase 1 "SANDBOX NOTICE"
  business 1 "All parties, committees and rules here are invented for this sandbox."
  business 1 "No Canton Foundation authority. Nothing decided here binds anyone."
  phase 1 "COMMITTEE"
  business 1 "Electorate: 7 members - 5 permanent (core) + 2 alternates."
  business 1 "Alternates vote in their own name; they are not stand-ins."
  business 1 ("Quorum (attendance): at least " <> show quorumSize <> " of 7 must take part.")
  business 1 "Majority (of votes cast): one option needs at least half."
  business 1 ("Steps 2-4 run the realistic case: " <> show quorumSize
    <> " core YES, " <> show absentSize <> " ABSENT. Quorum met exactly.")
  debug "[STEP 1] allocating synthetic parties and governor; sandbox only"
  (member, governor) <- bootstrapAdvisoryGovernor
  Some contract <- queryContractId member governor
  -- The core membership is read from the governor contract, never assumed from
  -- ballot order: AgendaBallot order follows party IDs, in which an alternate
  -- can precede a permanent member.
  let core = coreQuorum (Set.size contract.permanent) (Set.toList contract.permanent)
  assert (length core == 5)
  evidenceLine 1 "[SETUP-SUMMARY] SANDBOX: synthetic committee and rules; no Foundation authority."
  evidenceLine 1 ("[SETUP-SUMMARY] COMMITTEE: opener " <> name contract.opener <> "; core " <> show (map name (Set.toList contract.permanent)) <> "; alternates " <> show (map name (Set.toList contract.alternates)))
  forA_ (Set.toList (Set.union contract.permanent contract.alternates)) $ \party ->
    action 1 ("allocate party " <> who party) "allocated"
  action 1 ("allocate party " <> who contract.opener) "allocated (demo opener)"
  action 1 (who contract.opener <> " creates AgendaGovernor (consortium "
    <> contract.consortiumId <> ", 5 permanent + 2 alternates)") ("AgendaGovernor " <> cid governor)
  assert (input.windowSeconds >= 5 && input.windowSeconds <= 300)
  let members = Set.union contract.permanent contract.alternates
  factory <- submit contract.opener $ createCmd VotingRightFactory with
    cdf = contract.opener; members = Set.toList members
  action 1 (who contract.opener <> " creates VotingRightFactory (7 members)")
    ("VotingRightFactory " <> cid factory)
  phase 1 "CREDENTIALS"
  business 1 ("Each member receives one personal voting credential, valid " <> show validitySeconds <> " seconds.")
  business 1 "All seven use the voting-right factory and registry. Five primary seats vote; two substitutes have no independent votes."
  now <- getTime
  credentials <- forA (Set.toList members) $ \voter -> do
    invitation <- submit contract.opener $ createCmd VotingRightInvitation with
      cdf = contract.opener; consortiumId = contract.consortiumId
      member = voter; expiresAt = now `addRelTime` seconds validitySeconds
    action 1 (who contract.opener <> " creates VotingRightInvitation for "
      <> who voter <> " (expires in " <> show validitySeconds <> " seconds)") ("VotingRightInvitation " <> cid invitation)
    accepted <- submit voter $ exerciseCmd invitation AcceptRegistered with factory = toInterfaceContractId factory
    business 1 (name voter <> ": credential accepted (registry).")
    action 1 (who voter <> " exercises VotingRightInvitation.AcceptRegistered on " <> cid invitation
      <> " (via factory " <> cid factory <> ")") ("RegisteredVotingRight " <> cid accepted)
    pure (voter, RegisteredRight accepted)
  evidenceLine 1 ("[SETUP-SUMMARY] CREDENTIALS: " <> show (length credentials) <> " invitations accepted; direct " <> show (length [() | (_,DirectRight _) <- credentials]) <> "; registered " <> show (length [() | (_,RegisteredRight _) <- credentials]) <> "; validity " <> show validitySeconds <> " seconds; five primary votes; substitute assignment PENDING.")
  debug "[STEP 1] direct and registered unit voting credentials issued to seven members"
  business 1 "All 7 credentialed, 1 vote each."
  business 1 "Credentials are re-checked when a result is counted, not only when issued."
  initialRegistry <- submit contract.opener $ createCmd RuleRegistry with
    opener = contract.opener; members; version = 0
  action 1 (who contract.opener <> " creates RuleRegistry (version 0)")
    ("RuleRegistry " <> cid initialRegistry)
  (registry, rule) <- submit contract.opener $ exerciseCmd initialRegistry ActivateRule with
    draft = RuleDraft "architecture-review" 1 "initial sandbox rule" input.initialRuleRef
  action 1 (who contract.opener <> " exercises RuleRegistry.ActivateRule on " <> cid initialRegistry
    <> " (architecture-review v1)")
    ("RuleRegistry " <> cid registry <> "; EffectiveRule " <> cid rule)
  debug "[STEP 1] EffectiveRule v1 is a sandbox seed created by the opener, not a voted or Foundation rule"
  phase 1 "RULE BOOK"
  business 1 "architecture-review v1 is now in force."
  business 1 "Caveat: v1 is an UNVOTED seed placed by the organiser, not a Foundation rule."
  business 1 "The first rule actually voted on is v2, in step 2."
  evidenceLine 1 "[SETUP-SUMMARY] RULEBOOK: architecture-review v1 active; UNVOTED sandbox seed, not Foundation authority; step 2 is the first voted rule."
  userId <- validateUserId input.userName
  -- Every template queried by the readers is signed by the opener.
  -- These are provisioned user rights, not an authentication boundary on an
  -- unauthenticated demo endpoint. Reader entrypoints remain textual-only.
  let required = [CanReadAs contract.opener]
  phase 1 "AGENT RIGHTS"
  business 1 "Watching agents get exactly 1 right: readAs organiser; no actAs."
  createUser (User userId (Some contract.opener)) required
  actual <- listUserRights userId
  assert (length actual == length required && all (`elem` actual) required)
  debug ("[STEP 1] dedicated user rights verified: " <> show actual)
  -- CanActAs includes read access; no redundant explicit CanReadAs is needed.
  let intakeUserName = input.userName <> "-intake"
  intakeUserId <- validateUserId intakeUserName
  let intakeRequired = [CanActAs contract.opener]
  createUser (User intakeUserId (Some contract.opener)) intakeRequired
  intakeActual <- listUserRights intakeUserId
  assert (length intakeActual == length intakeRequired && all (`elem` intakeActual) intakeRequired)
  evidenceLine 1 "[SETUP-SUMMARY] ACCESS: Reviewer user: CanReadAs opener; Intake user: CanActAs opener; members retain their own cast authority (unauthenticated sandbox)."
  outcomeLine 1 "Provisioned opener-only reader and separate Intake user; Intake submission is not implemented here."
  let state = LiveState with
        member; opener = contract.opener; governor
        userName = input.userName
        verifiedRights = actual
        intakeUserName
        intakeVerifiedRights = intakeActual
        registry; rule; credentials; core
        windowSeconds = input.windowSeconds
        step = 1
  anchor <- submit contract.opener $ createCmd DemoAnchor with
    opener = contract.opener; demoRunId = input.userName; member; governor
    userName = input.userName; registry; rule; credentials; core
    windowSeconds = input.windowSeconds; proposedRuleRef = input.proposedRuleRef; step = 1
  action 1 (who contract.opener <> " creates DemoAnchor (run " <> input.userName <> ", step 1)")
    ("DemoAnchor " <> cid anchor)
  -- Setup evidence: what the ledger holds once the committee exists. This is
  -- the baseline every later step's counts are read against.
  let witnesses = [contract.opener, member]
  phase 1 "LEDGER EVIDENCE"
  evidenceLine 1 ("After setup" <> evidenceScope)
  parties <- listKnownParties
  users <- listAllUsers
  directRows <- concat <$> forA witnesses (\p -> query @DirectVotingRight p)
  registeredRows <- concat <$> forA witnesses (\p -> query @RegisteredVotingRight p)
  registryRows <- concat <$> forA witnesses (\p -> query @RuleRegistry p)
  e <- governanceEvidence witnesses
  evidenceLine 1 ("Parties known: " <> show (length parties)
    <> "; ledger users: " <> show (length users))
  evidenceLine 1 ("VotingRights active: " <> show e.rights
    <> " (direct " <> show (distinctCount directRows)
    <> ", registered " <> show (distinctCount registeredRows) <> ")")
  evidenceLine 1 ("Resolver (governor) active: " <> show e.resolvers
    <> "; RuleRegistry active: " <> show (distinctCount registryRows))
  evidenceLine 1 ("Agent read-only rights verified: " <> show (length actual)
    <> " (no actAs)")
  evidenceLine 1 ("[SETUP-SUMMARY] SETUP: governor " <> show e.resolvers <> "; registry " <> show (distinctCount registryRows) <> " ready.")
  evidenceLine 1 ("[SETUP-SUMMARY] INITIAL PENDING: topics " <> show e.topics <> "; vote records " <> show e.records <> ".")
  finalState 1 witnesses
    "committee of 7 credentialed (5 direct-or-registered permanent + 2 alternates), governor created, architecture-review v1 seeded (unvoted), agent rights verified read-only."
  pure state

-- Bounded wall-clock wait. An unbounded poll of getTime cannot distinguish a
-- window that is still open from a clock that never advances, so each tick is
-- printed and the budget is finite: a stalled clock aborts instead of hanging.
waitUntilClosed : Time -> Script ()
waitUntilClosed closes = waitTick closes 0

maxWaitTicks : Int
maxWaitTicks = 600

waitTick : Time -> Int -> Script ()
waitTick closes tick = do
  now <- getTime
  if now >= closes then debug ("[TIMING] window closed at " <> show now)
  else if tick >= maxWaitTicks then
    abort ("window did not close within " <> show maxWaitTicks
      <> " ticks; last observed time " <> show now <> " target " <> show closes)
  else do
    if tick % 10 == 0 then
      debug ("[TIMING] waiting tick " <> show tick <> " now " <> show now
        <> " closes " <> show closes)
    else pure ()
    sleep (seconds 1)
    waitTick closes (tick + 1)

extra : ExtraArgs
extra = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- The governance rule in force is Count.decide (atLeastPresent 3)
-- (shareOfVotes 1 2): at least three of the electorate must be present, and
-- one option must hold at least half the weight actually voted. These two
-- numbers are the demo's reading of that rule, not a change to it; nothing
-- here is passed to the governor, which applies its own compiled rule.

-- | Attendance threshold: how many members must take part at all.
quorumSize : Int
quorumSize = 3

-- | How many of the electorate stay away in the positive story.
absentSize : Int
absentSize = 5 - quorumSize

-- | A round where quorum is deliberately missed, for optional round 3.
belowQuorumSize : Int
belowQuorumSize = quorumSize - 1

-- | Issues one ballot per member of the electorate, and nothing else.
--
-- Deliberately separate from casting. A LEDGER EVIDENCE snapshot taken
-- "after ballots issued, before any cast" is only true if issuance has
-- already happened at that point, so issuance must be its own statement that
-- the caller sequences before the snapshot. Folding it into the casting
-- helper put the snapshot before `InviteBallots` ever ran, which made the
-- label describe a moment that had not occurred.
inviteBallotsFor : Int -> Party -> ContractId AgendaProposal
  -> Script [ContractId AgendaBallot]
inviteBallotsFor step opener proposalRef = do
  ballots <- submit opener $ exerciseCmd proposalRef InviteBallots
  action step (who opener <> " exercises AgendaProposal.InviteBallots on " <> cid proposalRef)
    (show (length ballots) <> " AgendaBallot contracts")
  pure ballots

-- | Casts YES on exactly the named voters' ballots and leaves every other
-- ballot of the round untouched and Absent.
--
-- Three properties matter and are enforced here rather than left to the
-- caller:
--
--   * every named voter must actually hold a ballot in this round, so a
--     mis-specified voter aborts instead of quietly producing a smaller
--     turnout than the narration claims;
--   * the full electorate's ballots are returned, cast and uncast alike,
--     because ResolveAgenda requires records covering exactly the electorate;
--   * only the voters who were present are returned in the credential
--     projection, because ResolveAgenda requires exactly one presented
--     credential per participating voter.
--
-- The uncast ballots are returned as they are. An AgendaBallot created by
-- InviteBallots already carries vote = Absent, so an untouched ballot is a
-- genuine on-ledger record of a member who did not take part, which is what
-- makes "4 absent" a ledger fact rather than a narrator's claim.
castYesBy : Int -> Party -> [Party] -> [ContractId AgendaBallot] -> Text
  -> Script [ContractId AgendaBallot]
castYesBy step opener voters ballots label = do
  loaded <- forA ballots $ \ballotCid -> do
    Some ballot <- queryContractId opener ballotCid
    pure (ballotCid, ballot)
  let holders = map ((.voter) . snd) loaded
  forA_ voters $ \voter ->
    if voter `elem` holders then pure ()
    else abort ("selected voter holds no ballot in this round: " <> show voter)
  forA loaded $ \(ballotCid, ballot) ->
    if ballot.voter `elem` voters then do
      voteNarration step (name ballot.voter <> ": YES (core)")
      cast <- submit ballot.voter $ exerciseCmd ballotCid CastAgendaVote with option = Count.Voted Yes
      action step (who ballot.voter <> " exercises AgendaBallot.CastAgendaVote on " <> cid ballotCid
        <> " -> Voted Yes; subject: " <> label) ("new ballot " <> cid cast)
      pure cast
    else do
      voteNarration step (name ballot.voter <> ": ABSENT (no cast; not an abstention, not a NO)")
      action step ("no cast for ballot " <> cid ballotCid <> " held by " <> who ballot.voter)
        "Absent (ballot left uncast)"
      pure ballotCid

-- | The credentials of exactly the members who took part.
--
-- ResolveAgenda demands one presented credential per participating eligible
-- voter and no more, so presenting all seven in a three-voter round is itself
-- a refusal. The projection is derived from the voter list, never hard-coded.
presentedRights : [Party] -> [(Party, RightRef)] -> [(Party, RightRef)]
presentedRights voters credentials = [(m, r) | (m, r) <- credentials, m `elem` voters]

-- [ACTION] logging. These helpers only format and print; they never alter a
-- submission, a check or an assertion. One line per individual ledger action,
-- so `... | grep ACTION` is a complete list of what touched the ledger.

-- Readable display name plus a short party ID: "member-a (party member-a-9b39…)".
-- The party ID is "<display-name>-<suffix>::<fingerprint>"; keep the readable
-- display name whole (it contains hyphens, e.g. "member-a") by cutting only at
-- the last hyphen before the namespace separator.
who : Party -> Text
who party =
  let stripped = Text.replace "'" "" (show party)
      local = Text.takeWhile (/= ":") stripped
      segments = Text.splitOn "-" local
      name = case segments of
        [] -> local
        _ -> Text.intercalate "-" (DA.List.take (length segments - 1) segments)
  in (if local `elem` ["jonathan-ieu","heslin-zenith","shaul-da","ali-abrar","EduardoFromTheFuture","Jatinp26","alexatdrw"] then local else name) <> " (party " <> abbreviate 20 stripped <> ")"

-- The readable display name alone, without the party ID. Presentation lines
-- name members; the full party ID belongs in the technical [ACTION] record.
name : Party -> Text
name party =
  let stripped = Text.replace "'" "" (show party)
      local = Text.takeWhile (/= ":") stripped
      segments = Text.splitOn "-" local
      handles = ["jonathan-ieu","heslin-zenith","shaul-da","ali-abrar","EduardoFromTheFuture","Jatinp26","alexatdrw"]
  in if local `elem` handles then local else case segments of
    [] -> local
    _ -> Text.intercalate "-" (DA.List.take (length segments - 1) segments)

-- Contract IDs are long; show enough to correlate and no more.
abbreviate : Int -> Text -> Text
abbreviate keep value =
  if Text.length value <= keep then value else Text.take keep value <> "\x2026"

cid : ContractId a -> Text
cid reference = abbreviate 12 (show reference)

-- An action that succeeded.
action : Int -> Text -> Text -> Script ()
action step what result =
  debug ("[STEP " <> show step <> "][ACTION] " <> what <> " \x2192 " <> result)

-- An action the demo expects the participant to refuse.
rejected : Int -> Text -> Text -> Script ()
rejected step what err =
  debug ("[STEP " <> show step <> "][ACTION][REJECTED] " <> what
    <> " \x2192 participant error: " <> err <> " (BLOCKED as expected)")

-- [BUSINESS], [VOTE], [DECISION], [RESULT] and [EXPECTED-REFUSAL] narration.
-- These helpers hold exactly the same contract as the [ACTION] helpers above:
-- they only format and print. None of them submits anything, reads anything,
-- changes a window, a credential, a tally, an assertion or a criterion, so
-- deleting every call would leave the executable governance behaviour
-- identical. They exist so that a reader who is not a Daml engineer can follow
-- what is being decided, by whom, and what it does and does not mean, while
-- the [ACTION] and [TIMING] lines stay the exact technical record they were.

-- Plain-English context: what is happening and why it matters.
business : Int -> Text -> Script ()
business step line = debug ("[STEP " <> show step <> "][BUSINESS] " <> line)

-- One line per individual member vote, saying who votes and on what.
voteNarration : Int -> Text -> Script ()
voteNarration step line = debug ("[STEP " <> show step <> "][VOTE] " <> line)

-- The collective decision of the members, as distinct from what it activates.
decision : Int -> Text -> Script ()
decision step line = debug ("[STEP " <> show step <> "][DECISION] " <> line)

-- What the ledger now records as a consequence of that decision.
outcomeLine : Int -> Text -> Script ()
outcomeLine step line = debug ("[STEP " <> show step <> "][RESULT] " <> line)

-- A refusal the demo is deliberately provoking: what should stop it, and what
-- actually stopped it, which are not always the same boundary.
expectedRefusal : Int -> Text -> Script ()
expectedRefusal step line =
  debug ("[STEP " <> show step <> "][EXPECTED-REFUSAL] " <> line)

-- Step and phase headings. Same log-only contract as every helper above: they
-- format and print, nothing more. ASCII '#' only, no box-drawing and no
-- arrows, because the terminal that showed this demo rendered non-ASCII as
-- escapes. The blank line before a heading is what makes the sections
-- scannable on a projector.

-- The banner that opens a step, matching a deck slide title.
stepHeading : Int -> Text -> Script ()
stepHeading step title =
  debug ("[STEP " <> show step <> "][PHASE] \n################ STEP " <> show step
    <> ": " <> title <> " ################")

-- A phase within a step: PROPOSAL, VOTING, RESOLUTION, EXECUTION and so on.
phase : Int -> Text -> Script ()
phase step title =
  debug ("[STEP " <> show step <> "][PHASE] \n########## " <> title <> " ##########")

-- One LEDGER EVIDENCE line. Unlike every other narration helper, the text it
-- prints is derived from a ledger query the caller just performed, so it is an
-- observation rather than a claim. The helper itself still only formats.
evidenceLine : Int -> Text -> Script ()
evidenceLine step line = debug ("[STEP " <> show step <> "][EVIDENCE] " <> line)

-- Active-contract counts read from the ledger, at the moment of the call.
--
-- Scope, stated explicitly because a count without a scope is not evidence:
-- every query below runs as the demo opener and the demo member together, and
-- those two are signatory/observer on everything this demo creates. A contract
-- visible to neither would not be counted, and this is never claimed to be a
-- participant-wide inventory.
--
-- Contract IDs are deduplicated across the two parties: the same contract is
-- visible to both, so a naive sum would double-count it. `queryInterface`
-- returns the interface's own contract IDs, which is what makes the dedup
-- correct for interface counts too.
--
-- Only ACTIVE contracts are reported, and the wording says so. A consumed
-- ballot or an archived proposal is simply absent; nothing here infers an
-- archival count, because Daml Script offers no active/archived history query
-- and inventing one from absence would overclaim.

-- | Distinct contracts in query rows gathered from several parties.
--
-- The same contract is visible to both witnesses, so the rows must be
-- deduplicated by contract ID or every count would be doubled. Contract IDs
-- are compared by their rendered form, which is injective for a CID.
--
-- A plain function over rows the caller already fetched, rather than a generic
-- query helper: Daml's type variables are not scoped into a function body, so
-- a `forall i. ... queryInterface @i` helper cannot be written here. Keeping
-- the query at the call site also keeps each one visible and auditable.
distinctCount : [(ContractId a, b)] -> Int
distinctCount rows = length (DA.List.dedup (map (show . fst) rows))

-- | Every governance interface count, plus the decoded VoteRecord tally.
--
-- One fresh ledger read per interface, per witness party, deduplicated. The
-- vote breakdown is decoded from each record's own on-ledger interface view,
-- so "3 YES, 4 ABSENT" is what the ledger holds rather than what the script
-- intended to cast.
data GovernanceEvidence = GovernanceEvidence with
    topics : Int
    records : Int
    yes : Int
    no : Int
    absent : Int
    rights : Int
    resolvers : Int
    actions : Int
    executables : Int
  deriving (Eq, Show)

governanceEvidence : [Party] -> Script GovernanceEvidence
governanceEvidence parties = do
  topicRows <- concat <$> forA parties (\p -> queryInterface @VoteTopic p)
  recordRows <- concat <$> forA parties (\p -> queryInterface @VoteRecord p)
  rightRows <- concat <$> forA parties (\p -> queryInterface @VotingRights p)
  resolverRows <- concat <$> forA parties (\p -> queryInterface @Resolver p)
  actionRows <- concat <$> forA parties (\p -> queryInterface @ActionV1.Action p)
  executableRows <- concat <$> forA parties (\p -> queryInterface @Executable p)
  -- Dedup the records themselves before decoding, so a vote is not tallied
  -- twice because two parties can see the same ballot.
  let uniqueRecords = DA.List.dedupOn (show . fst) recordRows
      votes = concat [Map.values view.votes | (_, Some view) <- uniqueRecords]
      tally wanted = length [() | vote <- votes, Some decoded <- [decodeRuleVote vote], decoded == wanted]
  pure GovernanceEvidence with
    topics = distinctCount topicRows
    records = length uniqueRecords
    yes = tally (Count.Voted Yes)
    no = tally (Count.Voted No)
    absent = tally Count.Absent
    rights = distinctCount rightRows
    resolvers = distinctCount resolverRows
    actions = distinctCount actionRows
    executables = distinctCount executableRows

-- | What exists at the entry to a step, before anything is mutated.
--
-- Printed immediately after the step banner and before the first submission,
-- so a listener knows the starting position rather than inferring it. Every
-- number is a fresh query; the business meaning is stated alongside it rather
-- than left as a bare count.
initialState : Int -> [Party] -> Script ()
initialState step parties = do
  phase step "INITIAL STATE"
  evidenceLine step ("What exists at entry to step " <> show step <> evidenceScope)
  ruleRows <- concat <$> forA parties (\p -> query @EffectiveRule p)
  grantRows <- concat <$> forA parties (\p -> query @ApprovedGrantProposal p)
  milestoneRows <- concat <$> forA parties (\p -> query @ApprovedMilestone p)
  anchorRows <- concat <$> forA parties (\p -> query @DemoAnchor p)
  e <- governanceEvidence parties
  let versions = DA.List.dedup (map (\(_, r) -> r.draft.version)
        (DA.List.dedupOn (show . fst) ruleRows))
      steps = DA.List.dedup (map (\(_, a) -> a.step)
        (DA.List.dedupOn (show . fst) anchorRows))
      grants = distinctCount grantRows
      milestones = distinctCount milestoneRows
  -- Rule book: which version governs the decisions this step is about.
  evidenceLine step ("Rule book: architecture-review active versions " <> show versions
    <> " (EffectiveRule active: " <> show (distinctCount ruleRows) <> ")")
  -- Electorate and the thresholds that will be applied.
  evidenceLine step ("Electorate: VotingRights active " <> show e.rights
    <> " of 7; quorum needs " <> show quorumSize <> " present; majority is half of votes cast")
  -- Governance machinery that must exist for a round to be possible.
  evidenceLine step ("Governor (Resolver) active: " <> show e.resolvers
    <> "; open rounds (VoteTopic) active: " <> show e.topics
    <> "; vote records active: " <> show e.records)
  evidenceLine step ("Pending authorisations: Action active " <> show e.actions
    <> "; Executable active " <> show e.executables)
  -- Outcomes so far, in business terms rather than as bare counts.
  evidenceLine step ("Approvals so far: grant proposal "
    <> (if grants == 0 then "NOT approved" else "approved (" <> show grants <> ")")
    <> "; milestone "
    <> (if milestones == 0 then "NOT accepted" else "accepted (" <> show milestones <> ")"))
  evidenceLine step ("Run marker: DemoAnchor active " <> show (distinctCount anchorRows)
    <> " at step " <> show steps)

-- | What exists when a step finishes, plus what this step actually changed.
--
-- The "what changed" line is supplied by the caller from outcomes it observed,
-- never derived by diffing counts: a count cannot attribute a change.
finalState : Int -> [Party] -> Text -> Script ()
finalState step parties changed = do
  phase step "FINAL STATE"
  evidenceLine step ("What exists at exit from step " <> show step <> evidenceScope)
  ruleRows <- concat <$> forA parties (\p -> query @EffectiveRule p)
  grantRows <- concat <$> forA parties (\p -> query @ApprovedGrantProposal p)
  milestoneRows <- concat <$> forA parties (\p -> query @ApprovedMilestone p)
  anchorRows <- concat <$> forA parties (\p -> query @DemoAnchor p)
  e <- governanceEvidence parties
  let versions = DA.List.dedup (map (\(_, r) -> r.draft.version)
        (DA.List.dedupOn (show . fst) ruleRows))
      steps = DA.List.dedup (map (\(_, a) -> a.step)
        (DA.List.dedupOn (show . fst) anchorRows))
  evidenceLine step ("Rule book: active versions " <> show versions
    <> "; grant approvals " <> show (distinctCount grantRows)
    <> "; milestone approvals " <> show (distinctCount milestoneRows))
  evidenceLine step ("Open rounds: " <> show e.topics
    <> "; vote records: " <> show e.records
    <> "; pending Action " <> show e.actions
    <> "; pending Executable " <> show e.executables)
  evidenceLine step ("Run marker: DemoAnchor at step " <> show steps)
  evidenceLine step ("What changed: " <> changed)

-- | The governance-interface snapshot printed around a voting phase.
--
-- Every number is a fresh ledger read. The label says "active" throughout,
-- because that is all these queries can honestly establish: a consumed ballot
-- is simply absent, and this cannot prove it ever existed. The history
-- commands named in the scope line are what corroborate that.
votingEvidence : Int -> [Party] -> Text -> Script ()
votingEvidence step parties moment = do
  phase step "LEDGER EVIDENCE"
  evidenceLine step (moment <> evidenceScope)
  e <- governanceEvidence parties
  evidenceLine step ("VoteTopic active: " <> show e.topics
    <> "; Resolver active: " <> show e.resolvers)
  -- A zero must not be explained, because a count cannot say WHY it is zero.
  -- Before issuance and after resolution both read 0, and claiming
  -- "consumed when counted" before any ballot existed would be a false
  -- inference from absence. The neutral wording states only what was
  -- observed; the consumption explanation belongs to the caller that just
  -- observed a resolve, and is printed there.
  evidenceLine step ("VoteRecord active: " <> show e.records
    <> (if e.records == 0 then " (no active records visible in this scope)"
        else " (" <> show e.yes <> " YES, " <> show e.no <> " NO, "
          <> show e.absent <> " ABSENT)"))
  evidenceLine step ("VotingRights active: " <> show e.rights)
  evidenceLine step ("Action active: " <> show e.actions
    <> "; Executable active: " <> show e.executables)

-- | The post-resolution snapshot, plus the one explanation a zero can carry.
--
-- This is the only place that attributes a zero to consumption, and it may do
-- so because the caller has just observed `ResolveAgenda` succeed on records
-- it had already counted. The explanation cites the two surrounding snapshots
-- rather than inferring anything from the number itself.
resolutionEvidence : Int -> [Party] -> Text -> Script ()
resolutionEvidence step parties moment = do
  votingEvidence step parties moment
  evidenceLine step ("The records counted in the snapshot above were consumed by the "
    <> "resolve just observed; compare the before-casting and after-casting snapshots "
    <> "for what they held. Archived contracts: ./ledger.sh archived")

-- | The outcome-side snapshot: what the decisions actually produced.
outcomeEvidence : Int -> [Party] -> Text -> Script ()
outcomeEvidence step parties moment = do
  phase step "LEDGER EVIDENCE"
  evidenceLine step (moment <> evidenceScope)
  ruleRows <- concat <$> forA parties (\p -> query @EffectiveRule p)
  grantRows <- concat <$> forA parties (\p -> query @ApprovedGrantProposal p)
  milestoneRows <- concat <$> forA parties (\p -> query @ApprovedMilestone p)
  anchorRows <- concat <$> forA parties (\p -> query @DemoAnchor p)
  executableRows <- concat <$> forA parties (\p -> queryInterface @Executable p)
  let versions = DA.List.dedup (map (\(_, r) -> r.draft.version)
        (DA.List.dedupOn (show . fst) ruleRows))
      steps = DA.List.dedup (map (\(_, a) -> a.step)
        (DA.List.dedupOn (show . fst) anchorRows))
  evidenceLine step ("EffectiveRule active: " <> show (distinctCount ruleRows)
    <> " (versions " <> show versions <> "); Executable active: "
    <> show (distinctCount executableRows))
  evidenceLine step ("ApprovedGrantProposal active: " <> show (distinctCount grantRows)
    <> "; ApprovedMilestone active: " <> show (distinctCount milestoneRows))
  evidenceLine step ("DemoAnchor active: " <> show (distinctCount anchorRows)
    <> " (at step " <> show steps <> ")")

-- The scope every evidence block carries. A count without a scope is not
-- evidence, and an active count is not a history: the corroborating commands
-- are named so a sceptic can check the archived side for themselves.
evidenceScope : Text
evidenceScope = " [active now; visible to opener+member; dedup by CID. "
  <> "History: ./ledger.sh archived | history]"

-- | Coupon-side evidence for step 5, including the amounts.
--
-- The DSO is the witness here because the unclaimed pot is DSO-visible, while
-- the allocated coupon is visible to its beneficiary; both are queried and the
-- scope says so rather than implying one party sees everything.
couponEvidence : Int -> Party -> Party -> Text -> Script ()
couponEvidence step dso beneficiary moment = do
  phase step "LEDGER EVIDENCE"
  evidenceLine step (moment <> " [active now; visible to DSO+beneficiary; dedup by CID]")
  unclaimedRows <- concat <$> forA [dso] (\p -> query @UnclaimedDevelopmentFundCoupon p)
  couponRows <- concat <$> forA [dso, beneficiary] (\p -> query @DevelopmentFundCoupon p)
  roundRows <- concat <$> forA [dso] (\p -> query @OpenMiningRound p)
  rulesRows <- concat <$> forA [dso] (\p -> query @AmuletRules p)
  let unclaimed = DA.List.dedupOn (show . fst) unclaimedRows
      coupons = DA.List.dedupOn (show . fst) couponRows
  evidenceLine step ("AmuletRules active: " <> show (distinctCount rulesRows)
    <> "; OpenMiningRound active: " <> show (distinctCount roundRows))
  evidenceLine step ("UnclaimedDevelopmentFundCoupon active: " <> show (length unclaimed)
    <> " (amounts " <> show (map (\(_, c) -> c.amount) unclaimed) <> ")")
  evidenceLine step ("DevelopmentFundCoupon active: " <> show (length coupons)
    <> " (amounts " <> show (map (\(_, c) -> c.amount) coupons) <> ")")

-- A readable name for a voting round, for narration only. Round identifiers
-- are "<runId>:<suffix>", and the run ID is noise to a human listener, so the
-- suffix is translated into the words the demo uses out loud. This is a pure
-- text function over a round ID the caller already holds: it performs no
-- query, so naming a round costs no extra ledger read.
roundName : Text -> Text
roundName roundId =
  let suffix = case DA.List.last (Text.splitOn ":" roundId) of
        name -> name
  in case suffix of
    "rule-v2" -> "rule change"
    "stale" -> "duplicate"
    "grant" -> "grant"
    "illustrative-milestone" -> "milestone"
    "blocked-foreign" -> "bad-credential test"
    "blocked-quorum" -> "quorum test"
    "blocked-double" -> "double-vote test"
    _ -> suffix

-- Only a daml-prim Text crosses the JSON boundary. State/CIDs are fetched
-- from a unique signed anchor on this participant, never coerced from JSON.
ruleVote : Text -> Script Text
ruleVote = ruleVoteWith (const (pure ()))

ruleVoteWith : (Time -> Script ()) -> Text -> Script Text
ruleVoteWith closeWindow runId = do
  parties <- listKnownParties
  anchors <- concat <$> forA parties (\p -> query @DemoAnchor p.party)
  let unique = [(cid, anchor) | (cid, anchor) <- anchors, anchor.demoRunId == runId]
  -- The same anchor may be visible to multiple parties; select by CID.
  let cids = DA.List.dedup (map fst unique)
  assert (length cids == 1)
  let [anchorCid] = cids
      [anchor] = take 1 [a | (cid,a) <- unique, cid == anchorCid]
      state = anchor
  assert (state.step == 1)
  action 2 ("query unique DemoAnchor for run " <> runId)
    ("DemoAnchor " <> cid anchorCid <> " at step " <> show state.step)
  stepHeading 2 "RULE GOVERNANCE"
  let witnesses = [state.opener, state.member]
  initialState 2 witnesses
  phase 2 "PROPOSAL"
  business 2 "Rule architecture-review: v1 -> v2."
  Some activeRule <- queryContractId state.member state.rule
  business 2 ("Rule v" <> show activeRule.draft.version <> " (document " <> activeRule.draft.ruleRef.location <> ", sha " <> DA.Text.take 12 activeRule.draft.ruleRef.sha256 <> ") is active.")
  business 2 ("The vote proposes v2 (document " <> state.proposedRuleRef.location <> ", sha " <> DA.Text.take 12 state.proposedRuleRef.sha256 <> ").")
  business 2 "The proposal document does not change; only the rule does."
  business 2 "Voters select a pre-published rule version; they cannot author rule text."
  business 2 ("Entitled: 7. Turning up: " <> show quorumSize <> " core members.")
  debug "[STEP 2] proposing rule v2; host submits as synthetic opener/voters, not agent user"
  debug "[STEP 2] clause interpretation is off-ledger; agents print the verified runtime document."
  debug "[STEP 2] rule references identify documents, not compiled clause content."
  now <- getTime
  debug ("[TIMING] first proposal " <> show now <> " windowSeconds=" <> show state.windowSeconds)
  let closesAt = now `addRelTime` seconds state.windowSeconds
      propose roundId = do
        created <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
          proposer = state.member; roundId; agenda = Architecture (RuleDraft "architecture-review" 2 "live v2" state.proposedRuleRef)
          baseVersion = 1; source = None; closesAt; primaryRights = presentedRights state.core state.credentials
        action 2 (who state.member <> " exercises AgendaGovernor.ProposeAgenda (round " <> roundId
          <> ", architecture-review v2, baseVersion 1)") ("AgendaProposal " <> cid created)
        pure created
  business 2 "ONE round this step, start to finish: propose, vote, close, count, apply."
  -- A single agenda. The stale-decision safety check used to be a second,
  -- interleaved round opened here, which made the step hard to follow; it is
  -- now its own self-contained round in step 6.
  proposal <- propose (runId <> ":rule-v2")
  let voters = coreQuorum quorumSize state.core
  assert (length voters == quorumSize)
  phase 2 "VOTING"
  business 2 "Ballots issued to all 7. Uncast ballots stay on the ledger as the record of absence."
  business 2 ("Voting: " <> show quorumSize <> " core YES, " <> show absentSize
    <> " ABSENT. The voters are read from the governor's permanent set, not ballot order.")
  -- Issuance and casting are separate statements, in that order, so the
  -- snapshot between them is taken when the ballots genuinely exist and none
  -- has been cast.
  issued <- inviteBallotsFor 2 state.opener proposal
  votingEvidence 2 witnesses "After ballots issued, before any cast"
  ballots <- castYesBy 2 state.opener voters issued "on moving architecture-review from v1 to v2."
  lastCast <- getTime
  debug ("[TIMING] last cast " <> show lastCast)
  debug ("[STEP 2] expected tally " <> show quorumSize <> " Yes / 0 No / 0 abstentions / "
    <> show absentSize <> " absent; waiting for close plus 3s margin")
  votingEvidence 2 witnesses "After casting"
  business 2 ("Tally: " <> show quorumSize <> " YES, 0 NO, " <> show absentSize
    <> " ABSENT. Nothing is decided until the window closes.")
  pure ()
  resolving <- getTime
  debug ("[TIMING] resolve " <> show resolving)
  phase 2 "RESOLUTION"
  business 2 "Window closed. Counting is a separate act from applying the result."
  business 2 "All 7 ballots presented (exact electorate); credentials only for the 3 who voted."
  let rights = presentedRights voters state.credentials
      resolve label proposalRef votes = do
        outcome@(Resolution verdict executions) <- submit state.opener $ exerciseCmd state.governor ResolveAgenda with
          proposalCid = proposalRef; ballotCids = votes; rights
        action 2 (who state.opener <> " exercises AgendaGovernor.ResolveAgenda (" <> label <> ", "
          <> show (length votes) <> " ballots, " <> show (length rights) <> " credentials)")
          (show verdict <> "; " <> show (length executions) <> " execution(s)")
        pure outcome
  assert (length rights == quorumSize)
  Resolution verdict [execution] <- resolve "rule-v2" proposal ballots
  assert (verdict == Count.Decided Yes)
  decision 2 ("APPROVED - " <> show quorumSize <> " YES, 0 NO, " <> show absentSize
    <> " ABSENT. Quorum " <> show quorumSize <> "/" <> show quorumSize <> "; majority "
    <> show quorumSize <> "/" <> show quorumSize <> ".")
  decision 2 ("Caveat: " <> show quorumSize <> " YES carried because nobody voted NO. "
    <> "It is not a rule that " <> show quorumSize <> " YES always wins.")
  decision 2 "This authorises execution; the rule book has not moved yet."
  resolutionEvidence 2 witnesses "After RESOLUTION"
  let targets cid = Map.singleton (registryKey state.opener) (coerceContractId cid)
  Some before <- queryContractId state.opener state.registry
  assert (before.version == 1)
  phase 2 "EXECUTION"
  business 2 "Rule book confirmed still at v1. Applying the decision now."
  result <- submit state.opener $ exerciseCmd execution Executable_Execute with
    actors = [state.opener]; targetCids = targets state.registry; extraArgs = extra
  action 2 (who state.opener <> " exercises Executable_Execute on " <> cid execution
    <> " (target RuleRegistry " <> cid state.registry <> ")")
    (show (length result.created) <> " contracts created")
  let [registryRaw,ruleRaw] = result.created
      registry = coerceContractId registryRaw : ContractId RuleRegistry
      rule = coerceContractId ruleRaw : ContractId EffectiveRule
  Some after <- queryContractId state.opener registry
  assert (after.version == 2)
  debug "[STEP 2] EffectiveRule now v2; outcome Decided Yes"
  outcomeLine 2 "Rule v2 active. Reviews from here are judged against the voted rule."
  outcomeLine 2 ("Same proposal: expected Reviewer REJECT (v1) -> APPROVE (v2). "
    <> "Expected, not observed: this script does not read the agent's output.")
  outcomeEvidence 2 witnesses "After EXECUTION"
  debug "[STEP 2] the voted rule changed, so the agent re-evaluates the SAME pinned proposal and its verdict flips to APPROVE"
  debug "[STEP 2] watch terminal 1: the reviewer prints fail/REJECT under v1, then all-pass/APPROVE under v2"
  outcomeLine 2 "The stale-decision safety check is now a separate optional round:"
  outcomeLine 2 "  ./run-demo.sh opt-step 1   (proposes a v1-based change after v2 is active)"
  _ <- submit state.opener $ archiveCmd anchorCid
  action 2 (who state.opener <> " archives DemoAnchor " <> cid anchorCid) "archived"
  advanced <- submit state.opener $ createCmd DemoAnchor with
    opener = state.opener; demoRunId = runId; member = state.member; governor = state.governor
    userName = state.userName; registry; rule; credentials = state.credentials
    core = state.core; windowSeconds = state.windowSeconds; proposedRuleRef = state.proposedRuleRef; step = 2
  action 2 (who state.opener <> " creates DemoAnchor (step 2)") ("DemoAnchor " <> cid advanced)
  debug "[STEP 2] signed DemoAnchor advanced to step 2"
  finalState 2 witnesses
    "architecture-review advanced v1 -> v2 by 3 core YES / 4 ABSENT; one round, resolved and executed."
  pure "step 2 complete"

-- `expected` is the step that must already be recorded; the query is labelled
-- with the step now starting (expected + 1) so the line reads in context.
findAnchor : Text -> Int -> Script (ContractId DemoAnchor, DemoAnchor)
findAnchor runId expected = do
  parties <- listKnownParties
  found <- concat <$> forA parties (\p -> query @DemoAnchor p.party)
  let matches = [(cid,a) | (cid,a) <- found, a.demoRunId == runId]
      cids = DA.List.dedup (map fst matches)
  assert (length cids == 1)
  let [found] = cids
      [anchor] = take 1 [a | (c,a) <- matches, c == found]
  assert (anchor.step == expected)
  -- One line for the whole lookup: it is a query, not a ledger mutation.
  action (expected + 1) ("query unique DemoAnchor for run " <> runId)
    ("DemoAnchor " <> cid found <> " at step " <> show anchor.step)
  pure (found,anchor)

-- | Finds the run's anchor at or after a minimum step, without advancing it.
--
-- The optional rounds are read-only with respect to the main journey: they
-- need at least the committee (bootstrap); staleRuleChange additionally needs
-- active v2 (step 2). They must not move the anchor or break the next main step.
-- The main `findAnchor` keeps its exact-step guard; this is a separate,
-- additive lookup rather than a relaxation of it.
findAnchorAtLeast : Text -> Int -> Script (ContractId DemoAnchor, DemoAnchor)
findAnchorAtLeast runId minimum = do
  parties <- listKnownParties
  found <- concat <$> forA parties (\p -> query @DemoAnchor p.party)
  let matches = [(cid,a) | (cid,a) <- found, a.demoRunId == runId]
      cids = DA.List.dedup (map fst matches)
  assert (length cids == 1)
  let [anchorRef] = cids
      [anchor] = take 1 [a | (c,a) <- matches, c == anchorRef]
  if anchor.step >= minimum then pure ()
  else abort ("optional round needs the run at step " <> show minimum
    <> " or later; the anchor is at step " <> show anchor.step)
  pure (anchorRef, anchor)

advance : ContractId DemoAnchor -> DemoAnchor -> Int -> Script ()
advance reference anchor next = do
  _ <- submit anchor.opener $ archiveCmd reference
  action next (who anchor.opener <> " archives DemoAnchor " <> cid reference) "archived"
  created <- submit anchor.opener $ createCmd (anchor with step = next)
  action next (who anchor.opener <> " creates DemoAnchor (step " <> show next <> ")")
    ("DemoAnchor " <> cid created)

-- | OPTIONAL ROUND 1: a rule change that is legitimately decided and then
-- refused at execution, because it was written against a superseded rule book.
--
-- Run with `./run-demo.sh opt-step 1`, after step 2 has activated v2.
--
-- What fails here, precisely. The proposal is accepted, the ballots are
-- genuine, the vote is real and the count returns Decided Yes: nothing about
-- the members' decision is invalid, and nothing is reversed. What fails is the
-- EXECUTION, because an Architecture agenda pins the registry state it was
-- written against (`agendaTargets` snapshots `baseVersion`), and executing it
-- requires that snapshot to still match the live registry. This agenda is
-- proposed with baseVersion 1 while the registry is already at 2, so the
-- snapshot has drifted and the execution is refused.
--
-- This is a real drift refusal, not an artefact: the agenda is newly proposed
-- here, its own execution contract is fresh and unconsumed, and no contract ID
-- from step 2 is replayed. It does not move the run anchor, so the main
-- journey can continue afterwards.
staleRuleChange : Text -> Script Text
staleRuleChange runId = do
  (_, state) <- findAnchorAtLeast runId 2
  stepHeading 0 "OPTIONAL ROUND 1: STALE RULE CHANGE"
  let witnesses = [state.opener, state.member]
  initialState 0 witnesses
  -- The live registry and rule are read from the ledger, not from the anchor,
  -- so this round acts on the current state rather than a remembered one.
  registryRows <- concat <$> forA witnesses (\p -> query @RuleRegistry p)
  let liveRegistries = DA.List.dedupOn (show . fst) registryRows
  case liveRegistries of
    [(registryRef, registry)] -> do
      if registry.version >= 2 then pure ()
        else abort ("optional round 1 needs architecture-review v2 active; the registry is at v"
          <> show registry.version <> ". Run step 2 first.")
      phase 0 "PROPOSAL"
      business 0 ("The rule book is at v" <> show registry.version <> ".")
      business 0 "A member proposes a change written against v1: a legitimate but outdated request."
      business 0 "Nothing stops it being proposed or voted on. The question is whether it can be APPLIED."
      now <- getTime
      let closesAt = now `addRelTime` seconds state.windowSeconds
      debug ("[TIMING] optional round 1 opens " <> show now)
      proposal <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
        proposer = state.member; roundId = runId <> ":opt-stale"
        agenda = Architecture (RuleDraft "architecture-review" 2 "stale v2 attempt" state.proposedRuleRef)
        baseVersion = 1; source = None; closesAt; primaryRights = presentedRights state.core state.credentials
      action 0 (who state.member <> " exercises AgendaGovernor.ProposeAgenda (round " <> runId
        <> ":opt-stale, architecture-review v2, baseVersion 1 while live registry is v"
        <> show registry.version <> ")") ("AgendaProposal " <> cid proposal)
      phase 0 "VOTING"
      let voters = coreQuorum quorumSize state.core
          rights = presentedRights voters state.credentials
      assert (length voters == quorumSize && length rights == quorumSize)
      business 0 ("Ballots issued to all 7; " <> show quorumSize <> " core YES, "
        <> show absentSize <> " ABSENT, exactly as in the main rounds.")
      issued <- inviteBallotsFor 0 state.opener proposal
      votingEvidence 0 witnesses "After ballots issued, before any cast"
      voted <- castYesBy 0 state.opener voters issued
        "on an outdated v1-based rule change (optional round)"
      votingEvidence 0 witnesses "After casting"
      waitUntilClosed closesAt
      sleep (seconds 3)
      phase 0 "RESOLUTION"
      business 0 "The window has closed. The count runs exactly as it does in a main round."
      Resolution verdict executions <- submit state.opener $ exerciseCmd state.governor ResolveAgenda with
        proposalCid = proposal; ballotCids = voted; rights
      action 0 (who state.opener <> " exercises AgendaGovernor.ResolveAgenda ("
        <> show (length voted) <> " ballots, " <> show (length rights) <> " credentials)")
        (show verdict <> "; " <> show (length executions) <> " execution(s)")
      assert (verdict == Count.Decided Yes)
      decision 0 ("APPROVED - " <> show quorumSize <> " YES, 0 NO, " <> show absentSize
        <> " ABSENT. The decision itself is valid and is not in question.")
      resolutionEvidence 0 witnesses "After RESOLUTION"
      case executions of
        [execution] -> do
          phase 0 "EXPECTED REJECTION"
          business 0 ("The agenda pinned registry state v1; the live registry is v"
            <> show registry.version <> ".")
          expectedRefusal 0 "Expected: applying a decision written against a superseded rule book must be refused."
          expectedRefusal 0 "What is refused is the EXECUTION, not the vote: no ballot or verdict is undone."
          let targets reference = Map.singleton (registryKey state.opener)
                (coerceContractId reference)
          outcome <- trySubmit state.opener $ exerciseCmd execution Executable_Execute with
            actors = [state.opener]; targetCids = targets registryRef; extraArgs = extra
          case outcome of
            Left err -> do
              rejected 0 (who state.opener <> " exercises Executable_Execute on the optional "
                <> "stale execution " <> cid execution <> " (snapshot v1 vs live v"
                <> show registry.version <> ")") (show err)
              debug "[STEP OPT-1] BLOCKED as expected: snapshot drift on the registry target"
              expectedRefusal 0 "Actual: REJECTED. The target had drifted from the snapshot the agenda pinned."
              expectedRefusal 0 "Reason unverified by code; the full participant error is in the technical log."
            Right _ -> abort "the stale execution unexpectedly succeeded"
        _ -> abort "expected exactly one execution from an affirmative resolve"
      -- The rule book must be untouched by the refusal.
      Some stillThere <- queryContractId state.opener registryRef
      assert (stillThere.version == registry.version)
      finalState 0 witnesses
        ("the round was APPROVED but NOT applied; rule book still at v"
          <> show stillThere.version
          <> ". The run anchor is unchanged, so the main journey can continue.")
      pure "optional round 1 complete"
    _ -> abort ("expected exactly one visible RuleRegistry; found "
      <> show (length liveRegistries))

-- Match opener-signed ledger evidence; ledger state cannot identify the external client.
validateIntake : Party -> Text -> Agenda -> Time -> [AgendaProposal] -> [(ContractId AgendaAction, AgendaAction)] -> Bool
validateIntake opener roundId agenda now proposals actions = case proposals of
  [p] -> p.roundId == roundId && p.opener == opener && p.proposer == opener
    && addRelTime now (seconds 10) <= p.closesAt
    && case [a | (cid,a) <- actions, toInterfaceContractId cid == p.actionCid] of
      [a] -> a.opener == opener && a.agenda == agenda && a.baseVersion == 0
      _ -> False
  _ -> False

-- Wait for matching opener-signed evidence; never fall back to script submission.
intakeTimedOut : Int -> [AgendaProposal] -> Bool
intakeTimedOut remaining proposals = remaining <= 0 && null proposals

awaitIntake : Party -> Text -> Agenda -> Int -> Script (ContractId AgendaProposal, Time)
awaitIntake opener roundId agenda remaining = do
  proposals <- query @AgendaProposal opener
  let matches = [(cid,p) | (cid,p) <- proposals, p.roundId == roundId]
  case matches of
    [(proposal,p)] -> do
      actions <- query @AgendaAction opener
      now <- getTime
      assertMsg "Intake evidence mismatch or less than 10 seconds remain before voting"
        (validateIntake opener roundId agenda now [p] actions)
      pure (proposal,p.closesAt)
    [] -> if intakeTimedOut remaining [] then abort "Java Intake did not open requested round within bounded wait"
      else do
        sleep (seconds 1)
        awaitIntake opener roundId agenda (remaining - 1)
    _ -> abort "duplicate Intake round"

intakeRequest : Party -> Text -> Text -> Text -> Int -> Agenda -> SourceAgendaRequest -> IntakeRequest
intakeRequest opener runId sourceKey roundId windowSeconds agenda source = IntakeRequest with
  opener; runId; sourceKey; roundId; windowSeconds; agenda; source; baseVersion = 0

requestIntake : DemoAnchor -> Text -> Text -> Text -> Agenda -> Script (ContractId AgendaProposal, Time)
requestIntake state runId sourceKey roundId agenda = do
  existing <- query @IntakeRequest state.opener
  assert (null existing)
  rounds <- query @AgendaProposal state.opener
  assert (null [p | (_,p) <- rounds, p.roundId == roundId])
  assertMsg "Intake voting window must exceed minimum remaining budget" (state.windowSeconds >= 15)
  (boundAgenda,Some source) <- sourceForAgenda state.opener agenda
  _ <- submit state.opener $ createCmd (intakeRequest state.opener runId sourceKey roundId state.windowSeconds boundAgenda source)
  debug ("[INTAKE] waiting for Java opener bridge round " <> roundId)
  awaitIntake state.opener roundId boundAgenda 120

-- Active opener-visible candidate observations, not a remote snapshot or authority.
sourceCatalogueCounts : Party -> Script (Int, Int, Int, Int)
sourceCatalogueCounts opener = do
  rows <- query @Cap.Examples.BabyCdf.SourceCatalogue.SourceObservationCredential opener
  let items = [item | (_, item) <- rows, item.opener == opener]
  let keys = Set.fromList [(item.opener, item.repo, item.observation.number) | item <- items]
  let proposals = length [item | item <- items, item.observation.kind == Cap.Examples.BabyCdf.SourceCatalogue.SourceProposal]
  let milestones = length [item | item <- items, item.observation.kind == Cap.Examples.BabyCdf.SourceCatalogue.SourceMilestone]
  pure (length items, Set.size keys, proposals, milestones)

sourceCatalogueEvidence : Party -> Script ()
sourceCatalogueEvidence opener = do
  (active, keys, proposals, milestones) <- sourceCatalogueCounts opener
  debug ("[EVIDENCE] SourceObservationCredential active contracts=" <> show active
    <> "; distinct keys=" <> show keys
    <> "; SourceProposal=" <> show proposals <> "; SourceMilestone=" <> show milestones)
  debug "[EVIDENCE] Active now; visible to opener only; distinct (opener, repository, number) keys. Zero is valid while ingestion may still be running. Sync completeness unknown."
  debug "[EVIDENCE] Persisted candidate observations carry observed/updated provenance, not a verified GitHub snapshot. Catalogue items are separate from the two curated governed subjects; ingestion creates no voting authority."

template ManualRoundPending
  with
    opener : Party
    runId : Text
    proposalCid : ContractId AgendaProposal
    snapshot : SourceAgendaSnapshot
  where
    signatory opener
    ensure runId /= "" && validSnapshot snapshot && snapshot.opener == opener && executablePin snapshot.pin

    choice ResolveManualRound : ContractId ManualRoundResolved
      with
        governorCid : ContractId AgendaGovernor
        ballotCids : [ContractId AgendaBallot]
        rights : [(Party, RightRef)]
      controller opener
      do
        proposal <- fetch proposalCid
        assertMsg "Manual checkpoint must retain the selected source snapshot."
          (proposal.opener == opener && proposal.sourceSnapshot == Some snapshot)
        resolution <- exercise governorCid ResolveAgenda with proposalCid; ballotCids; rights
        assertMsg "Manual round was not approved." (resolution.verdict == Count.Decided Yes)
        assertMsg "Manual round must produce exactly one execution." (length resolution.executions == 1)
        create ManualRoundResolved with opener; runId; proposalCid; snapshot
                                        executions = resolution.executions

template ManualRoundResolved
  with
    opener : Party
    runId : Text
    proposalCid : ContractId AgendaProposal
    snapshot : SourceAgendaSnapshot
    executions : [ContractId Executable]
  where
    signatory opener
    ensure runId /= "" && validSnapshot snapshot && snapshot.opener == opener
      && executablePin snapshot.pin && length executions == 1

    choice ExecuteManualRound : ContractId ManualRoundCompleted
      controller opener
      do
        let [execution] = executions
        result <- exercise execution Executable_Execute with
          actors = [opener]; targetCids = Map.empty; extraArgs = extra
        assertMsg "Manual execution must create exactly one approval." (length result.created == 1)
        create ManualRoundCompleted with opener; runId; proposalCid; snapshot; executions

template ManualRoundCompleted
  with
    opener : Party
    runId : Text
    proposalCid : ContractId AgendaProposal
    snapshot : SourceAgendaSnapshot
    executions : [ContractId Executable]
  where
    signatory opener
    ensure runId /= "" && validSnapshot snapshot && snapshot.opener == opener
      && executablePin snapshot.pin && length executions == 1

manualRoundBallots : Party -> ContractId AgendaProposal -> AgendaProposal -> Script [(ContractId AgendaBallot, AgendaBallot)]
manualRoundBallots opener proposalCid proposal = do
  now <- getTime
  visible <- query @AgendaBallot opener
  let relevant = [(ref,b) | (ref,b) <- visible,
        b.roundId == proposal.roundId || b.actionCid == proposal.actionCid]
  if null relevant then do
    assertMsg "Existing round has no ballots and is already closed; do not reopen it." (now < proposal.closesAt)
    _ <- submit opener $ exerciseCmd proposalCid InviteBallots
    refreshed <- query @AgendaBallot opener
    validateManualRoundBallots proposal [(ref,b) | (ref,b) <- refreshed,
      b.roundId == proposal.roundId || b.actionCid == proposal.actionCid]
  else validateManualRoundBallots proposal relevant

validateManualRoundBallots : AgendaProposal -> [(ContractId AgendaBallot, AgendaBallot)] -> Script [(ContractId AgendaBallot, AgendaBallot)]
validateManualRoundBallots proposal ballots = do
  let voters = map (\(_,b) -> b.voter) ballots
  assertMsg "Existing round requires exactly one ballot per eligible member; partial or duplicate invitations cannot be retried."
    (length voters == Set.size proposal.members && Set.fromList voters == proposal.members)
  assertMsg "Existing ballots must match the selected opener, round, action and deadline exactly."
    (all (\(_,b) -> b.opener == proposal.opener && b.roundId == proposal.roundId
      && b.actionCid == proposal.actionCid && b.closesAt == proposal.closesAt) ballots)
  pure ballots

castManualMissing : Party -> [Party] -> AgendaProposal -> [(ContractId AgendaBallot, AgendaBallot)] -> Script [ContractId AgendaBallot]
castManualMissing opener voters proposal ballots = do
  now <- getTime
  let holders = map (\(_,b) -> b.voter) ballots
  assertMsg "Selected voters must be actual ballot holders." (all (\v -> v `elem` holders) voters)
  assertMsg "Existing votes conflict with this manual tally; nothing was cast."
    (all (\(_,b) -> if b.voter `elem` voters
      then b.vote == Count.Absent || b.vote == Count.Voted Yes
      else b.vote == Count.Absent) ballots)
  assertMsg "Selected voter has not cast and the round is expired; nothing was cast."
    (now < proposal.closesAt || all (\(_,b) -> not (b.voter `elem` voters) || b.vote == Count.Voted Yes) ballots)
  forA ballots $ \(ref,b) ->
    if b.voter `elem` voters then
      if b.vote == Count.Absent then do
        assertMsg "Selected voter has not cast and the round is expired; do not reopen or extend it." (now < proposal.closesAt)
        submit b.voter $ exerciseCmd ref CastAgendaVote with option = Count.Voted Yes
      else do
        assertMsg "Existing selected vote conflicts with the requested YES; never recast." (b.vote == Count.Voted Yes)
        pure ref
    else do
      assertMsg "Unselected ballot is not absent; refuse to substitute a different tally." (b.vote == Count.Absent)
      pure ref

manualProposalPin : SourceAgendaSnapshot -> Bool
manualProposalPin snapshot = case snapshot.pin of
  ProposalPin head files -> case proposalPin of
    ProposalPin expectedHead expectedFiles -> head == expectedHead && files == expectedFiles
    _ -> False
  _ -> False

manualIdentityValid : Party -> Set.Set Party -> Text -> Bool -> AgendaProposal -> SourceAgendaSnapshot -> AgendaAction -> [AgendaRoundReceipt] -> Bool
manualIdentityValid opener electorate expectedUrl milestone proposal snapshot action receipts =
  proposal.opener == opener && proposal.proposer == opener && proposal.members == electorate
  && proposal.subject.url == expectedUrl && proposal.subject.body == snapshot.fingerprint
  && snapshot.originalProposal == 184 && snapshot.observation.sourceUrl == expectedUrl
  && validSnapshot snapshot && executablePin snapshot.pin && snapshot.roundId == proposal.roundId
  && (if milestone then case snapshot.pin of DeliveryPin _ _ _ _ -> True; _ -> False
      else manualProposalPin snapshot)
  && action.opener == opener && action.members == proposal.members && action.sourceSnapshot == Some snapshot
  && agendaSnapshotConsistent opener action.agenda (Some snapshot)
  && length [r | r <- receipts, r.opener == opener, r.proposer == proposal.proposer,
       r.roundId == proposal.roundId, r.actionCid == proposal.actionCid,
       r.sourceSnapshot == Some snapshot, r.agenda == action.agenda, r.baseVersion == action.baseVersion] == 1
  && (case action.agenda of Milestone subject -> milestone && subject.url == expectedUrl
                            Grant subject -> not milestone && subject.url == expectedUrl
                            _ -> False)

manualCanResume : Time -> AgendaProposal -> [Party] -> [(ContractId AgendaBallot, AgendaBallot)] -> Bool
manualCanResume now proposal voters ballots =
  now < proposal.closesAt || (not (null ballots)
    && all (\v -> any (\(_,b) -> b.voter == v && b.vote == Count.Voted Yes) ballots) voters)

manualExistingRound : Text -> Int -> Bool -> Script Text
manualExistingRound runId step milestone = do
  (_,state) <- findAnchorAtLeast runId 2
  let opener = state.opener
      expectedUrl = "https://github.com/canton-foundation/canton-dev-fund/"
        <> (if milestone then "issues/540" else "pull/184")
  Some governor <- queryContractId opener state.governor
  let electorate = governor.permanent
  if milestone then do
    approvals <- query @ApprovedGrantProposal opener
    assertMsg "Milestone #540 requires an actual pinned approval of PR184."
      (any (\(_,a) -> a.opener == opener && a.proposal.url == "https://github.com/canton-foundation/canton-dev-fund/pull/184"
        && a.sourceSnapshot.originalProposal == 184 && validSnapshot a.sourceSnapshot
        && manualProposalPin a.sourceSnapshot
        && a.proposal.contentVersion == a.sourceSnapshot.fingerprint
        && a.members == electorate) approvals)
  else pure ()
  completed <- query @ManualRoundCompleted opener
  resolved <- query @ManualRoundResolved opener
  pending <- query @ManualRoundPending opener
  let matches s = s.originalProposal == 184 && s.observation.sourceUrl == expectedUrl
      done = [(c,p) | (c,p) <- completed, p.runId == runId && matches p.snapshot]
      ready = [(c,p) | (c,p) <- resolved, p.runId == runId && matches p.snapshot]
      waiting = [(c,p) | (c,p) <- pending, p.runId == runId && matches p.snapshot]
  assertMsg "Ambiguous manual phase checkpoints; select and investigate the exact round."
    (length done + length ready + length waiting <= 1)
  if not (null done) then pure "complete: authoritative manual execution checkpoint; nothing repeated"
  else if not (null ready) then do
    let [(ref,_)] = ready
    _ <- submit opener $ exerciseCmd ref ExecuteManualRound
    pure "complete: resumed recorded execution without recasting or resolving again"
  else do
    proposals <- query @AgendaProposal opener
    actions <- query @AgendaAction opener
    receipts <- query @AgendaRoundReceipt opener
    let eligible = [(ref,p,s) | (ref,p) <- proposals, p.opener == opener,
          p.proposer == opener, p.members == electorate, p.subject.url == expectedUrl,
          Some s <- [p.sourceSnapshot], matches s, validSnapshot s, executablePin s.pin,
          p.subject.body == s.fingerprint,
          s.roundId == p.roundId,
          (if milestone then case s.pin of DeliveryPin _ _ _ _ -> True; _ -> False
           else manualProposalPin s),
          (actionRef,a) <- actions, toInterfaceContractId actionRef == p.actionCid,
          a.opener == opener, a.members == p.members, a.sourceSnapshot == Some s,
          manualIdentityValid opener electorate expectedUrl milestone p s a (map snd receipts),
          agendaSnapshotConsistent opener a.agenda (Some s),
          length [r | (_,r) <- receipts, r.opener == opener, r.proposer == p.proposer,
            r.roundId == p.roundId, r.actionCid == p.actionCid,
            r.sourceSnapshot == Some s, r.agenda == a.agenda, r.baseVersion == a.baseVersion] == 1,
          (case a.agenda of Milestone subject -> milestone && subject.url == expectedUrl
                            Grant subject -> not milestone && subject.url == expectedUrl
                            _ -> False)]
        selected = if null waiting then eligible else
          [(ref,p,s) | (ref,p,s) <- eligible, (_,checkpoint) <- waiting,
            ref == checkpoint.proposalCid && s == checkpoint.snapshot]
    assertMsg "Expected exactly one existing verified pinned round; missing, invalid or ambiguous evidence. Supply an unambiguous existing round; no fallback or opening is permitted."
      (length selected == 1)
    let [(proposalCid,proposal,snapshot)] = selected
        voters = coreQuorum quorumSize state.core
        rights = presentedRights voters state.credentials
    assertMsg "Manual vote retains the seven-member electorate and actual selected credential holders."
      (Set.size proposal.members == 5 && length voters == quorumSize && length rights == quorumSize
        && all (\v -> Set.member v proposal.members) voters)
    assertMsg "Checkpoint must retain the exact previously selected proposal."
      (all (\(_,p) -> p.proposalCid == proposalCid && p.snapshot == snapshot) waiting)
    beforeMutation <- getTime
    existingBallots <- query @AgendaBallot opener
    let existingRound = [(ref,b) | (ref,b) <- existingBallots,
          b.roundId == proposal.roundId || b.actionCid == proposal.actionCid]
    assertMsg "Expired round has missing selected votes; no checkpoint, invitation or cast was created."
      (manualCanResume beforeMutation proposal voters existingRound)
    if null existingRound then pure ()
    else do
      _ <- validateManualRoundBallots proposal existingRound
      assertMsg "Existing votes conflict with this manual tally; no checkpoint or cast was created."
        (all (\(_,b) -> if b.voter `elem` voters
          then b.vote == Count.Absent || b.vote == Count.Voted Yes
          else b.vote == Count.Absent) existingRound)
    checkpoint <- if null waiting then
      submit opener $ createCmd ManualRoundPending with opener; runId; proposalCid; snapshot
      else do
        let [(ref,_)] = waiting
        pure ref
    ballots <- manualRoundBallots opener proposalCid proposal
    voted <- castManualMissing opener voters proposal ballots
    now <- getTime
    actualBallots <- mapA (queryContractId opener) voted
    let yesVoters = Set.fromList [ballot.voter | Some ballot <- actualBallots, ballot.voter `Set.member` proposal.members, ballot.vote == Count.Voted Yes]
    if now < proposal.closesAt && Set.size yesVoters < 3 then do
      debug ("[STEP " <> show step <> "] PENDING: existing round " <> proposal.roundId
        <> " requires three distinct primary YES votes; resume this same round without reopening or recasting.")
      pure ("PENDING: " <> proposal.roundId <> "; fewer than three primary YES votes")
    else do
      debug "Resolution requires independently still-valid holder credentials; expired bootstrap rights are not renewed by this command."
      resolvedCid <- submit opener $ exerciseCmd checkpoint ResolveManualRound with
        governorCid = state.governor; ballotCids = voted; rights
      _ <- submit opener $ exerciseCmd resolvedCid ExecuteManualRound
      pure "complete: existing round resolved and approval executed"

proposalVote : Text -> Script Text
proposalVote runId = do
  stepHeading 3 "EXISTING PROPOSAL MANUAL VOTE"
  (_,state) <- findAnchorAtLeast runId 2
  initialState 3 [state.opener, state.member]
  sourceCatalogueEvidence state.opener
  outcome <- manualExistingRound runId 3 False
  finalState 3 [state.opener, state.member] outcome
  pure outcome

milestoneVote : Text -> Script Text
milestoneVote runId = do
  stepHeading 4 "EXISTING MILESTONE MANUAL VOTE"
  (_,state) <- findAnchorAtLeast runId 2
  initialState 4 [state.opener, state.member]
  sourceCatalogueEvidence state.opener
  outcome <- manualExistingRound runId 4 True
  finalState 4 [state.opener, state.member] outcome
  pure outcome



-- Step 5 runs the real Splice allocation choice on wall-clock time, with no
-- setTime. Feasibility rests on splice-amulet-0.1.22 validAmuletConfig only
-- requiring tickDuration > days 0, and Bootstrap_Rounds only requiring
-- tickDuration <= round0Duration. A short positive tick therefore lets real
-- time satisfy all three AdvanceOpenMiningRounds deadlines:
--   roundToArchive.targetClosesAt <= now, latestRound.opensAt <= now and
--   middleRound.opensAt + tickDuration <= now.
-- Every production check in the choice stays intact: the configured manager
-- must equal the submitting fundManager and the amount must be covered.
couponTick : RelTime
couponTick = seconds 20

-- A resolve can be stamped with a ledger time behind the script's own clock,
-- for example when the container host is suspended mid-run and Canton resumes
-- behind wall clock. The window check then reports "voting still open" even
-- though the script already observed the close. Only that one condition is
-- retried; every other refusal aborts immediately, so a real rejection is
-- never retried into a pass.
--
-- NOTE: this retry path has not been exercised in a live run. It exists
-- because a suspended host produced the condition once; the recorded runs all
-- resolved on the first attempt.
resolveWhenClosed : Int -> Party -> ContractId AgendaGovernor
  -> ContractId AgendaProposal -> [ContractId AgendaBallot]
  -> [(Party, RightRef)] -> Script Resolution
resolveWhenClosed attempt opener governor proposalCid ballotCids rights = do
  outcome <- trySubmit opener $ exerciseCmd governor ResolveAgenda with
    proposalCid; ballotCids; rights
  case outcome of
    Right resolution -> pure resolution
    Left err
      | not (isInfixOf "voting still open" (show err)) ->
          abort ("resolution refused for a reason that is not retried: " <> show err)
      | attempt >= 10 -> abort ("window still reported open after retries: " <> show err)
      | otherwise -> do
          debug ("[TIMING] ledger time still inside the window, retrying: " <> show err)
          sleep (seconds 5)
          resolveWhenClosed (attempt + 1) opener governor proposalCid ballotCids rights

couponAllocate : Text -> Script Text
couponAllocate runId = do
  (anchorCid,state) <- findAnchor runId 4
  stepHeading 5 "COUPON ALLOCATION"
  let witnesses = [state.opener, state.member]
  initialState 5 witnesses
  phase 5 "SETUP"
  business 5 "Shows what an approved decision can hand to the money side, and where it stops."
  business 5 "Three synthetic roles: issuer (DSO), configured fund manager, beneficiary."
  business 5 "Allocating a Development Fund coupon: an entitlement voucher, not coins."
  business 5 "Caveat: NOT a mint, NOT a payment. The beneficiary collects nothing."
  debug "[STEP 5] sandbox-local AmuletRules; the DSO, manager and beneficiary are synthetic demo parties"
  debug "[STEP 5] this allocates a DevelopmentFundCoupon only; it is NOT a payment and NOT a mint"
  -- The approved milestone from step 4 is the stated reason only. It carries no
  -- Foundation authority and does not entitle anyone to funds.
  approvals <- query @ApprovedMilestone state.member
  let [(milestoneCid,_)] = [(cid,a) | (cid,a) <- approvals, a.milestone == illustrativeMilestone]
  dso <- allocateParty "babycdf-coupon-dso"
  manager <- allocateParty "babycdf-coupon-manager"
  wrongManager <- allocateParty "babycdf-coupon-wrong-manager"
  beneficiary <- allocateParty "babycdf-coupon-beneficiary"
  let issuanceCurve = defaultAmuletConfig.issuanceCurve
      issuance = issuanceCurve.initialValue with optDevelopmentFundPercentage = Some 0.05
      config = defaultAmuletConfig with
        optDevelopmentFundManager = Some manager
        tickDuration = couponTick
        issuanceCurve = issuanceCurve with initialValue = issuance
      configSchedule = Schedule with initialValue = config; futureValues = []
  -- isDevNet = True marks this as a development network, which is what a
  -- throwaway sandbox is. It is not a production or MainNet configuration.
  forA_ [dso, manager, wrongManager, beneficiary] $ \party ->
    action 5 ("allocate party " <> who party) "allocated"
  rules <- submit dso $ createCmd AmuletRules with
    dso; configSchedule; isDevNet = True; contractStateSchemaVersion = None
  action 5 (who dso <> " creates AmuletRules (isDevNet, fund manager " <> who manager
    <> ", tick " <> show couponTick <> ")") ("AmuletRules " <> cid rules)
  externalRules <- submit dso $ createCmd ExternalPartyAmuletRules with dso
  action 5 (who dso <> " creates ExternalPartyAmuletRules")
    ("ExternalPartyAmuletRules " <> cid externalRules)
  debug ("[STEP 5] bootstrapping rounds with tickDuration " <> show couponTick
    <> "; the source coupon is minted by Splice's DSO-controlled round transition, not by this demo")
  _ <- submit dso $ exerciseCmd rules AmuletRules_Bootstrap_Rounds with
    amuletPrice = 0.5; round0Duration = couponTick; initialRound = None
  action 5 (who dso <> " exercises AmuletRules_Bootstrap_Rounds on " <> cid rules
    <> " (amuletPrice 0.5, round0Duration " <> show couponTick <> ")") "rounds 0, 1, 2 opened"
  rounds <- query @OpenMiningRound dso
  let [oldest] = [cid | (cid, round) <- rounds, round.round == Round 0]
      [middle] = [cid | (cid, round) <- rounds, round.round == Round 1]
      [latest] = [cid | (cid, round) <- rounds, round.round == Round 2]
  Some round0 <- queryContractId dso oldest
  debug ("[TIMING] round 0 targetClosesAt " <> show round0.targetClosesAt
    <> "; waiting for real time, no setTime")
  waitUntilClosed round0.targetClosesAt
  advanced <- submit dso $ exerciseCmd rules AmuletRules_AdvanceOpenMiningRounds with
    amuletPrice = 0.5
    roundToArchiveCid = oldest
    middleRoundCid = middle
    latestRoundCid = latest
  action 5 (who dso <> " exercises AmuletRules_AdvanceOpenMiningRounds on " <> cid rules
    <> " (archive round 0 " <> cid oldest <> ")")
    ("SummarizingMiningRound " <> cid advanced.summarizingRoundCid
      <> "; OpenMiningRound " <> cid advanced.openRoundCid)
  debug "[STEP 5] rounds advanced on wall-clock time; all three Splice deadline checks passed unmodified"
  issued <- submit dso $ exerciseCmd rules AmuletRules_MiningRound_StartIssuing with
    miningRoundCid = advanced.summarizingRoundCid
    summary = OpenMiningRoundSummary with
      totalValidatorRewardCoupons = 0.0
      totalFeaturedAppRewardCoupons = 0.0
      totalUnfeaturedAppRewardCoupons = 0.0
      totalSvRewardWeight = 0
      optTotalValidatorFaucetCoupons = Some 0
  action 5 (who dso <> " exercises AmuletRules_MiningRound_StartIssuing on " <> cid rules
    <> " (zero reward coupons)") ("IssuingMiningRound " <> cid issued.issuingRoundCid)
  let Some source = issued.unclaimedDevelopmentFundCouponCid
  Some unclaimed <- queryContractId dso source
  debug ("[STEP 5] issuance produced an UnclaimedDevelopmentFundCoupon of " <> show unclaimed.amount)
  business 5 ("Network issuance, not this demo, produced an unclaimed pot of "
    <> show unclaimed.amount <> ". The manager may allocate only out of that pot.")
  couponEvidence 5 dso beneficiary "After issuance, before any allocation"
  phase 5 "SAFETY CHECK: WRONG MANAGER AND OVER-AMOUNT"
  business 5 "Two bad allocations are tried first, so the boundaries are visible."
  now <- getTime
  let amount = 1.0
      expiresAt = now `addRelTime` hours 2
      -- The reason text is prefixed "sandbox" on purpose: it cites a demo
      -- contract and issue #540 as provenance for the narration, and is not a
      -- claim that issue #540 was approved or funded by anyone.
      reason = "sandbox ApprovedMilestone " <> show milestoneCid <> " " <> milestoneSubject.url
      allocate fundManager requestedAmount = exerciseCmd rules AmuletRules_AllocateDevelopmentFundCoupon with
        unclaimedDevelopmentFundCouponCids = [source]
        beneficiary; amount = requestedAmount; expiresAt; reason; fundManager
  assert (unclaimed.amount >= amount)
  expectedRefusal 5 ("Expected 1: " <> name wrongManager
    <> " is not the configured manager. Seeing the fund is not being entitled to spend it.")
  wrong <- trySubmit (actAs wrongManager <> readAs dso) $ allocate wrongManager amount
  case wrong of
    Left err -> do
      rejected 5 (who wrongManager <> " exercises AmuletRules_AllocateDevelopmentFundCoupon (amount "
        <> show amount <> ", wrong manager)") (show err)
      -- Splice's own require text, stable in this pinned package version.
      assert (isInfixOf "configured Development Fund manager" (show err))
      debug "[STEP 5] BLOCKED as expected: submitter is not the configured Development Fund manager, asserted"
      expectedRefusal 5 "Actual: REJECTED - must be the configured Development Fund manager (asserted)."
    Right _ -> abort "wrong manager allocated"
  expectedRefusal 5 ("Expected 2: the correct manager asks for " <> show (unclaimed.amount + 1.0)
    <> " when only " <> show unclaimed.amount <> " exists. The right role does not create funds.")
  over <- trySubmit (actAs manager <> readAs dso) $ allocate manager (unclaimed.amount + 1.0)
  case over of
    Left err -> do
      rejected 5 (who manager <> " exercises AmuletRules_AllocateDevelopmentFundCoupon (amount "
        <> show (unclaimed.amount + 1.0) <> " exceeds " <> show unclaimed.amount <> ")") (show err)
      assert (isInfixOf "insufficient amount to cover the requested allocation" (show err))
      debug "[STEP 5] BLOCKED as expected: requested amount exceeds the unclaimed coupon, asserted"
      expectedRefusal 5 "Actual: REJECTED - insufficient amount to cover the request (asserted)."
    Right _ -> abort "over-amount allocation accepted"
  couponEvidence 5 dso beneficiary "After both refusals (nothing allocated)"
  phase 5 "ALLOCATION"
  business 5 ("The configured manager allocates " <> show amount <> " to the beneficiary.")
  business 5 "Reason cites the step-4 sandbox milestone as provenance only; it confers nothing."
  debug ("[STEP 5] allocating " <> show amount <> " to the beneficiary, reason cites the sandbox milestone")
  result <- submit (actAs manager <> readAs dso) $ allocate manager amount
  action 5 (who manager <> " exercises AmuletRules_AllocateDevelopmentFundCoupon (amount "
    <> show amount <> ", beneficiary " <> who beneficiary <> ")")
    ("DevelopmentFundCoupon " <> cid result.developmentFundCouponCid)
  Some coupon <- queryContractId beneficiary result.developmentFundCouponCid
  assert (coupon.beneficiary == beneficiary && coupon.amount == amount
    && coupon.fundManager == manager && coupon.reason == reason)
  let Some leftoverCid = result.optUnclaimedDevelopmentFundCouponCid
  Some leftover <- queryContractId dso leftoverCid
  assert (leftover.amount == unclaimed.amount - amount)
  debug ("[STEP 5] verified DevelopmentFundCoupon " <> show result.developmentFundCouponCid
    <> "; leftover unclaimed " <> show leftover.amount)
  outcomeLine 5 ("Recorded: coupon for " <> show amount
    <> " to the beneficiary. Beneficiary, amount, manager and reason all read back and checked.")
  outcomeLine 5 ("Pot reduced by exactly that amount: " <> show leftover.amount <> " unclaimed.")
  debug "[STEP 5] no Amulet was minted and no beneficiary collection was performed"
  outcomeLine 5 "Caveat: no coins minted, nothing collected. Turning this into money is out of scope."
  advance anchorCid state 5
  debug "[STEP 5] signed DemoAnchor advanced to step 5"
  couponEvidence 5 dso beneficiary "After ALLOCATION"
  finalState 5 witnesses
    ("a DevelopmentFundCoupon for " <> show amount
      <> " was allocated by the configured manager after two refusals; the unclaimed pot fell to "
      <> show leftover.amount <> ". No mint, no payment, nothing collected.")
  pure "step 5 complete"

-- Independent security fixtures. Each allocates its own round and ballots;
-- bootstrap is sufficient, and no fixture consumes or replaces the run anchor.
credentialRefusals : Text -> Script Text
credentialRefusals = credentialRefusalsWith waitUntilClosed

credentialRefusalsWith : (Time -> Script ()) -> Text -> Script Text
credentialRefusalsWith closeWindow runId = do
  (_,state) <- findAnchorAtLeast runId 1
  (blockedSource,blockedSubject) <- fixtureSource state.opener False
  stepHeading 6 "OPTIONAL 2: CREDENTIAL BOUNDARIES"
  phase 6 "INDEPENDENT FIXTURE (BOOTSTRAP SUFFICIENT)"
  business 6 "Wrong consortium reaches validation; foreign issuer hits lookup privacy."
  business 6 "Lookup privacy is NOT proof of issuer-authority enforcement."
  debug "[OPTIONAL 2] independent credential fixture; no main anchor mutation"
  let witnesses = [state.opener, state.member]
      members = map fst state.credentials
      quorateVoters = coreQuorum quorumSize state.core
      shortVoters = coreQuorum belowQuorumSize state.core
  assert (length quorateVoters == quorumSize && length shortVoters == belowQuorumSize)
  -- Case 1: two invalid credentials, both resolved against the same closed
  -- proposal. ResolveAgenda is nonconsuming and only archives the proposal on
  -- success, so a refused attempt leaves the round reusable for the next one.
  debug "[STEP 6] case 1: invalid and foreign credentials presented at resolution"
  phase 6 "CASE 1: WRONG CREDENTIALS"
  business 6 "Somebody tries to get a vote counted with the wrong paperwork."
  business 6 "Two variants: a wrong-consortium credential, and a foreign issuer's."
  outcomeEvidence 6 witnesses "Before case 1"
  foreignCdf <- allocateParty "babycdf-foreign-issuer"
  action 6 ("allocate party " <> who foreignCdf) "allocated (issuer outside this consortium)"
  now0 <- getTime
  -- The substituted credential must belong to a member who actually votes in
  -- this round: a credential presented for an absent member is refused for
  -- that reason alone and would prove nothing about the credential check.
  let (voter :: _) = quorateVoters
  foreignInvite <- submit foreignCdf $ createCmd VotingRightInvitation with
    cdf = foreignCdf; consortiumId = "foreign-consortium"
    member = voter; expiresAt = now0 `addRelTime` hours 1
  action 6 (who foreignCdf <> " creates VotingRightInvitation for " <> who voter
    <> " (consortium foreign-consortium)") ("VotingRightInvitation " <> cid foreignInvite)
  foreignRight <- submit voter $ exerciseCmd foreignInvite AcceptDirect
  action 6 (who voter <> " exercises VotingRightInvitation.AcceptDirect on " <> cid foreignInvite
    <> " (foreign issuer " <> who foreignCdf <> ")") ("DirectVotingRight " <> cid foreignRight)
  -- Issued by this demo's issuer, so the opener can fetch it, but bound to
  -- another consortium. This one reaches the credential check itself.
  wrongInvite <- submit state.opener $ createCmd VotingRightInvitation with
    cdf = state.opener; consortiumId = "wrong-consortium"
    member = voter; expiresAt = now0 `addRelTime` hours 1
  action 6 (who state.opener <> " creates VotingRightInvitation for " <> who voter
    <> " (consortium wrong-consortium)") ("VotingRightInvitation " <> cid wrongInvite)
  wrongRight <- submit voter $ exerciseCmd wrongInvite AcceptDirect
  action 6 (who voter <> " exercises VotingRightInvitation.AcceptDirect on " <> cid wrongInvite
    <> " (consortium wrong-consortium)") ("DirectVotingRight " <> cid wrongRight)
  let closes1 = now0 `addRelTime` seconds state.windowSeconds
  p1 <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.member; roundId = runId <> ":blocked-foreign"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource; closesAt = closes1
    primaryRights = presentedRights state.core state.credentials
  action 6 (who state.member <> " exercises AgendaGovernor.ProposeAgenda (round " <> runId
    <> ":blocked-foreign)") ("AgendaProposal " <> cid p1)
  b1 <- inviteBallotsFor 6 state.opener p1
  business 6 ("A normal quorate round: " <> show quorumSize <> " core YES, "
    <> show absentSize <> " ABSENT. The votes are legitimate; the paperwork will not be.")
  v1 <- castYesBy 6 state.opener quorateVoters b1 "grant round used for the bad-credential test"
  closeWindow closes1
  sleep (seconds 3)
  let validRights = presentedRights quorateVoters state.credentials
      substitute right = [if m == voter then (m, right) else (m, r) | (m, r) <- validRights]
  -- Guard: if the window were still open, ResolveAgenda would refuse for that
  -- reason alone and these two cases would prove nothing about credentials.
  beforeCase1 <- getTime
  assert (beforeCase1 >= closes1)
  business 6 "Window confirmed closed first, so a refusal cannot just mean 'too early'."
  expectedRefusal 6 ("Expected 1: a different consortium's credential substituted for "
    <> name voter <> ". Membership of one group is not membership of another.")
  r1a <- trySubmit state.opener $ exerciseCmd state.governor ResolveAgenda with
    proposalCid = p1; ballotCids = v1; rights = substitute (DirectRight wrongRight)
  case r1a of
    Left err -> do
      rejected 6 (who state.opener <> " exercises AgendaGovernor.ResolveAgenda (wrong-consortium credential for "
        <> who voter <> ")") (show err)
      -- Stable: the credential is fetched through HasCheckedFetch against a
      -- RightKey carrying the consortium, so a mismatch is reported by name.
      assert (isInfixOf "Contract group identifier mismatch" (show err))
      debug "[STEP 6] BLOCKED as expected: wrong-consortium credential, mismatch asserted from the participant message"
      expectedRefusal 6 "Actual: REJECTED by the credential check - group identifier mismatch (asserted)."
    Right _ -> abort "wrong-consortium credential accepted"
  hiddenRight <- queryContractId state.opener foreignRight
  assert (hiddenRight == None)
  expectedRefusal 6 "Expected 2: a foreign issuer's credential substituted instead; not visible to opener (queried)."
  r1b <- trySubmit state.opener $ exerciseCmd state.governor ResolveAgenda with
    proposalCid = p1; ballotCids = v1; rights = substitute (DirectRight foreignRight)
  case r1b of
    Left err -> do
      rejected 6 (who state.opener <> " exercises AgendaGovernor.ResolveAgenda (foreign-issuer credential for "
        <> who voter <> ")") (show err)
      -- A foreign issuer's credential is not visible to this opener, so the
      -- refusal arrives as a lookup failure rather than the credential check.
      -- Only the window reason is excluded; the exact text is not asserted.
      assert (not (isInfixOf "voting still open" (show err)))
      debug "[STEP 6] BLOCKED as expected: foreign-issuer credential unusable here, and not refused for the window; reason unverified by code"
      expectedRefusal 6 "Actual: REJECTED by a DIFFERENT boundary - privacy, not governance."
      expectedRefusal 6 "The foreign credential is invisible here, so it failed as a lookup."
      expectedRefusal 6 "Proven positively: the refusal was not 'voting still open'. Wording not asserted."
    Right _ -> abort "foreign credential accepted"
  outcomeEvidence 6 witnesses "After case 1 (no new approval or execution)"
  -- Case 2: quorum is atLeastPresent 3, so two casts cannot decide. The engine
  -- returns Lapsed rather than failing, so this reason IS asserted in code.
  -- This is the deliberate near-miss of the positive steps: the same kind of
  -- round, with the same kind of voters and valid credentials, one vote short.
  pure runId

-- Bootstrap is sufficient; this fixture never advances the main anchor.
noQuorum : Text -> Script Text
noQuorum = noQuorumWith waitUntilClosed

noQuorumWith : (Time -> Script ()) -> Text -> Script Text
noQuorumWith closeWindow runId = do
  (_,state) <- findAnchorAtLeast runId 1
  (blockedSource,blockedSubject) <- fixtureSource state.opener False
  stepHeading 6 "OPTIONAL 3: NO QUORUM"
  let witnesses = [state.opener, state.member]
      shortVoters = coreQuorum belowQuorumSize state.core
  assert (length shortVoters == belowQuorumSize)
  debug ("[STEP 6] case 2: only " <> show belowQuorumSize
    <> " of seven cast, below the atLeastPresent 3 quorum")
  phase 6 "CASE 2: NO QUORUM"
  business 6 ("Too few turn up: " <> show belowQuorumSize <> " core YES, "
    <> show (7 - belowQuorumSize) <> " ABSENT. Quorum needs " <> show quorumSize <> ".")
  business 6 "Deliberately the approved round, one vote lighter. Credentials genuine, both YES."
  business 6 "Only the attendance differs from steps 2-4."
  expectedRefusal 6 ("Expected: " <> show belowQuorumSize
    <> " of 7 present must not decide, even though all present voted YES.")
  -- Each case re-reads the clock after the previous one, so its own window is
  -- always opened fresh; otherwise the earlier attempts eat into the margin and
  -- ResolveAgenda refuses with "voting still open".
  now2 <- getTime
  let closes2 = now2 `addRelTime` seconds state.windowSeconds
  p2 <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.member; roundId = runId <> ":blocked-quorum"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource; closesAt = closes2
    primaryRights = presentedRights state.core state.credentials
  action 6 (who state.member <> " exercises AgendaGovernor.ProposeAgenda (round " <> runId
    <> ":blocked-quorum)") ("AgendaProposal " <> cid p2)
  b2 <- inviteBallotsFor 6 state.opener p2
  votingEvidence 6 witnesses "Case 2: after ballots issued, before any cast"
  v2 <- castYesBy 6 state.opener shortVoters b2 "grant round used for the quorum test"
  votingEvidence 6 witnesses "Case 2: after casting (one vote short of quorum)"
  closeWindow closes2
  sleep (seconds 3)
  let present2 = presentedRights shortVoters state.credentials
  assert (length present2 == belowQuorumSize)
  -- Only this resolve is routed through the protected helper. The other
  -- resolves in steps 2-4 and case 1 use a plain submit, so a clock-lag
  -- refusal there still fails the run loudly rather than being retried.
  Resolution verdict2 executions2 <-
    resolveWhenClosed 0 state.opener state.governor p2 v2 present2
  action 6 (who state.opener <> " exercises AgendaGovernor.ResolveAgenda (" <> show (length v2)
    <> " ballots, only " <> show (length present2) <> " credentials presented)")
    (show verdict2 <> "; " <> show (length executions2) <> " execution(s)")
  assert (verdict2 == Count.Lapsed && null executions2)
  debug ("[STEP 6] verdict " <> show verdict2 <> " with no executions")
  debug "[STEP 6] BLOCKED as expected: quorum not met, asserted as Lapsed in code"
  decision 6 ("LAPSED - " <> show belowQuorumSize <> " YES, 0 NO, "
    <> show (7 - belowQuorumSize) <> " ABSENT. Quorum " <> show belowQuorumSize <> "/"
    <> show quorumSize <> " NOT met. 0 executions.")
  decision 6 "Nothing was rejected and no transaction failed: the count simply did not decide."
  decision 6 ("Side by side: " <> show quorumSize <> " present YES carried steps 2-4; "
    <> show belowQuorumSize <> " present YES decides nothing. Attendance is checked first.")
  decision 6 "A lapsed round is the absence of a decision, not a defeat. Asserted in code."
  outcomeEvidence 6 witnesses "After case 2 (Lapsed: no execution, no new approval)"
  -- Case 3: a ballot already cast cannot be cast again; the invitation it came
  -- from is consumed by the first cast.
  pure runId

-- Own proposal and ballots: no dependency on any other optional fixture.
doubleVote : Text -> Script Text
doubleVote runId = do
  (_,state) <- findAnchorAtLeast runId 1
  (blockedSource,blockedSubject) <- fixtureSource state.opener False
  stepHeading 6 "OPTIONAL 4: DOUBLE VOTE"
  let witnesses = [state.opener, state.member]
  debug "[STEP 6] case 3: double vote on an already-consumed ballot"
  phase 6 "CASE 3: DOUBLE VOTE"
  business 6 "One member casts a valid vote, then tries to vote again on the same entitlement."
  expectedRefusal 6 "Expected: one member, one vote. A spent ballot cannot be reused."
  now3 <- getTime
  let closes3 = now3 `addRelTime` seconds state.windowSeconds
  p3 <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.member; roundId = runId <> ":blocked-double"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource; closesAt = closes3
    primaryRights = presentedRights state.core state.credentials
  action 6 (who state.member <> " exercises AgendaGovernor.ProposeAgenda (round " <> runId
    <> ":blocked-double)") ("AgendaProposal " <> cid p3)
  b3 <- inviteBallotsFor 6 state.opener p3
  let (firstBallot :: _) = b3
  Some ballot3 <- queryContractId state.opener firstBallot
  voteNarration 6 (name ballot3.voter <> ": YES on " <> roundName ballot3.roundId
    <> " (valid, accepted)")
  cast3 <- submit ballot3.voter $ exerciseCmd firstBallot CastAgendaVote with option = Count.Voted Yes
  action 6 (who ballot3.voter <> " exercises AgendaBallot.CastAgendaVote on " <> cid firstBallot
    <> " \x2192 Voted Yes") ("new ballot " <> cid cast3)
  voteNarration 6 (name ballot3.voter <> ": tries YES again on the same spent ballot")
  reused <- trySubmit ballot3.voter $ exerciseCmd firstBallot CastAgendaVote with option = Count.Voted Yes
  case reused of
    Left err -> do
      rejected 6 (who ballot3.voter <> " exercises AgendaBallot.CastAgendaVote on consumed ballot "
        <> cid firstBallot) (show err)
      debug "[STEP 6] BLOCKED as expected: the consumed ballot cannot be exercised twice"
      expectedRefusal 6 "Actual: REJECTED. The spent ballot no longer exists to vote with."
    Right _ -> abort "consumed ballot accepted a second cast"
  voteNarration 6 (name ballot3.voter <> ": tries to change the cast vote to NO")
  expectedRefusal 6 "Expected: a cast vote is final within the round."
  recast <- trySubmit ballot3.voter $ exerciseCmd cast3 CastAgendaVote with option = Count.Voted No
  case recast of
    Left err -> do
      rejected 6 (who ballot3.voter <> " exercises AgendaBallot.CastAgendaVote on already-cast ballot "
        <> cid cast3 <> " \x2192 Voted No") (show err)
      -- "already cast" is a stable assertMsg in CastAgendaVote, so assert it.
      assert (isInfixOf "already cast" (show err))
      debug "[STEP 6] BLOCKED as expected: already cast, asserted from the participant message"
      expectedRefusal 6 "Actual: REJECTED - 'already cast' (asserted; the governance rule, not a side effect)."
    Right _ -> abort "already-cast ballot accepted another vote"
  outcomeEvidence 6 witnesses "After case 3 (no new approval or execution)"
  -- Case 4: a party outside the electorate holds no ballot and cannot propose.
  pure runId

outsiderRefusals : Text -> Script Text
outsiderRefusals runId = do
  (_,state) <- findAnchorAtLeast runId 1
  (blockedSource,blockedSubject) <- fixtureSource state.opener False
  stepHeading 6 "OPTIONAL 5: OUTSIDER BOUNDARIES"
  let witnesses = [state.opener, state.member]
  now3 <- getTime
  p3 <- submit (actAs state.member <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
    proposer = state.member; roundId = runId <> ":blocked-outsider-ballot"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource
    closesAt = now3 `addRelTime` seconds state.windowSeconds
    primaryRights = presentedRights state.core state.credentials
  b3 <- inviteBallotsFor 6 state.opener p3
  debug "[STEP 6] case 4: non-member attempts to take part"
  phase 6 "CASE 4: NON-MEMBER"
  business 6 "An outsider tries to put an item to a vote, then to cast somebody else's ballot."
  outsider <- allocateParty "babycdf-non-member"
  action 6 ("allocate party " <> who outsider) "allocated (outside the electorate)"
  expectedRefusal 6 "Expected 1: a non-member must not put an item on this agenda."
  stranger <- trySubmit outsider $ exerciseCmd state.governor ProposeAgenda with
    proposer = outsider; roundId = runId <> ":blocked-nonmember"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource
    closesAt = now3 `addRelTime` seconds state.windowSeconds
    primaryRights = presentedRights state.core state.credentials
  case stranger of
    Left err -> do
      rejected 6 (who outsider <> " exercises AgendaGovernor.ProposeAgenda (round " <> runId
        <> ":blocked-nonmember)") (show err)
      -- The governor is not visible to a non-observer, so this refusal is a
      -- lookup failure; the "not a member" assertion is never reached.
      debug "[STEP 6] BLOCKED as expected: non-member cannot even see the governor; reason unverified by code"
      expectedRefusal 6 "Actual: REJECTED by visibility, not the membership rule."
      expectedRefusal 6 "The outsider cannot see the governor, so 'not a member' was never reached."
    Right _ -> abort "non-member proposed an agenda"
  -- A still-live ballot: case 3 consumed only the first one, so take a later
  -- ballot of the same round whose own voter has not cast it yet. Attempting a
  -- consumed contract would prove nothing about membership.
  let liveBallot = case b3 of
        (_ :: second :: _) -> second
        _ -> error "expected at least two ballots in the round"
  Some liveBefore <- queryContractId state.opener liveBallot
  assert (liveBefore.vote == Count.Absent && liveBefore.voter /= outsider)
  debug ("[STEP 6] the target ballot is live and uncast, owned by " <> show liveBefore.voter)
  business 6 ("Target ballot is genuinely live and uncast, owned by " <> name liveBefore.voter <> ".")
  expectedRefusal 6 "Expected 2: a non-member must not cast somebody else's vote."
  nonMemberCast <- trySubmit outsider $ exerciseCmd liveBallot CastAgendaVote with option = Count.Voted Yes
  case nonMemberCast of
    Left err -> do
      rejected 6 (who outsider <> " exercises AgendaBallot.CastAgendaVote on live ballot "
        <> cid liveBallot <> " owned by " <> who liveBefore.voter) (show err)
      -- The ballot is an unconsumed contract whose observer is its own voter,
      -- so the outsider cannot see it and the refusal is a lookup failure.
      debug "[STEP 6] BLOCKED as expected: outsider cannot cast a live ballot it does not own; reason unverified by code"
      expectedRefusal 6 "Actual: REJECTED by visibility again. Wording not asserted."
    Right _ -> abort "non-member cast a ballot"
  -- Prove the refusal left the ballot usable: its real voter still can cast.
  unauthorized <- trySubmit (actAs outsider <> readAs state.opener) $ exerciseCmd state.governor ProposeAgenda with
    proposer = outsider; roundId = runId <> ":blocked-unauthorized-proposer"
    agenda = Grant blockedSubject; baseVersion = 0; source = Some blockedSource
    closesAt = now3 `addRelTime` seconds state.windowSeconds
    primaryRights = presentedRights state.core state.credentials
  case unauthorized of
    Left err -> do
      rejected 6 "Outsider controller with opener read authority: ProposeAgenda" (show err)
      assert (isInfixOf "not opener or eligible member" (show err))
      expectedRefusal 6 "Actual: proposer authorization asserted, with visibility supplied by opener read authority."
    Right _ -> abort "unauthorized proposer accepted with read authority"
  Some liveAfter <- queryContractId state.opener liveBallot
  assert (liveAfter.vote == Count.Absent)
  voteNarration 6 (name liveBefore.voter <> ": YES on their own ballot (the one just refused to the outsider)")
  ownerCast <- submit liveBefore.voter $ exerciseCmd liveBallot CastAgendaVote with option = Count.Voted Yes
  action 6 (who liveBefore.voter <> " exercises AgendaBallot.CastAgendaVote on " <> cid liveBallot
    <> " \x2192 Voted Yes") ("new ballot " <> cid ownerCast)
  debug "[STEP 6] the same ballot was still castable by its own voter, so it was live when the outsider was refused"
  outcomeLine 6 "That vote succeeded: the ballot was live throughout. The outsider was turned away for who they were."
  outcomeEvidence 6 witnesses "Optional outsider fixture complete; main anchor untouched"
  pure runId

-- Legacy script entry point fails closed, just like the runner dispatch.
blockedPaths : Text -> Script Text
blockedPaths _ = abort "Step 6 retired; use independent optional rounds 2-5."

-- Each entry point also runs alone from bootstrap, with an unchanged anchor.
checkOptional : Text -> (Text -> Script Text) -> Script ()
checkOptional runId optional = do
  _ <- bootstrap (BootstrapInput runId 5 ruleRefV1 ruleRefV2)
  before <- findAnchorAtLeast runId 1
  result <- optional runId
  after <- findAnchorAtLeast runId 1
  assert (result == runId && before == after)

optionalCredentialsStandalone : Script ()
optionalCredentialsStandalone = checkOptional "optional-credentials-alone" (credentialRefusalsWith setTime)

optionalQuorumStandalone : Script ()
optionalQuorumStandalone = checkOptional "optional-quorum-alone" (noQuorumWith setTime)

optionalDoubleStandalone : Script ()
optionalDoubleStandalone = checkOptional "optional-double-alone" doubleVote

optionalOutsiderStandalone : Script ()
optionalOutsiderStandalone = checkOptional "optional-outsider-alone" outsiderRefusals

optionalShuffled : Script ()
optionalShuffled = do
  let runId = "optional-shuffled"
  _ <- bootstrap (BootstrapInput runId 5 ruleRefV1 ruleRefV2)
  before <- findAnchorAtLeast runId 1
  forA_ [outsiderRefusals, noQuorumWith setTime, credentialRefusalsWith setTime, doubleVote] $ \optional -> do
    result <- optional runId
    after <- findAnchorAtLeast runId 1
    assert (result == runId && before == after)
