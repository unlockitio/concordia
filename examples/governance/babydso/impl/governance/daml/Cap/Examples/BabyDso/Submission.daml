module Cap.Examples.BabyDso.Submission where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.Types (AuthenticKey, Snapshot, ResolutionInfo (..))
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.Utils (IsBallot (..), Vote (..))


confirmationMechanismName : Text
confirmationMechanismName = "confirmation"

weightedVoteMechanismName : Text
weightedVoteMechanismName = "weighted-vote"

data DsoVote
  = V_Choice Int
  | V_Confirm AnyValue
  | V_Parameters (TextMap Decimal)
  deriving (Eq, Show)

acceptsVote : Text -> DsoVote -> Bool
acceptsVote mechanism vote = case vote of
  V_Parameters _ -> mechanism == weightedVoteMechanismName
  V_Confirm _ -> mechanism == confirmationMechanismName
  V_Choice _ -> False

sameParameters : [DsoVote] -> Bool
sameParameters votes = case [map fst (TextMap.toList parameters) | V_Parameters parameters <- votes] of
  [] -> True
  first :: rest -> all (== first) rest


template SharedBallot
  with
    dso : Party
    svs : Set Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    openingWeights : Map Party Decimal
    snapshots : Map AuthenticKey Snapshot
    votes : Map Party DsoVote
    votingClosesAt : Time
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs, Map.keys openingWeights

    ensure all (acceptsVote resolution.mechanism) (Map.values votes)
      && sameParameters (Map.values votes)

    choice SharedBallot_Cast : ContractId SharedBallot
      with
        voter : Party
        vote : DsoVote
      controller voter
      do
        now <- getTime
        require "the voting window is open" (now < votingClosesAt)
        require "the voter has the right to vote: it holds weight at opening"
          (voter `Map.member` openingWeights)
        create this with votes = Map.insert voter vote votes

    choice SharedBallot_Expire : ()
      controller dso
      do
        now <- getTime
        require "the shared ballot has expired" (now >= expiresAt)

instance HasCheckedFetch SharedBallot ResolutionInfo where
  contractGroupId ballot = ballot.resolution

instance IsBallot SharedBallot DsoVote where
  votesOf ballot = fmap Voted ballot.votes
  snapshotsOf ballot = ballot.snapshots
  actionOf ballot = ballot.actionCid
  consume = archive


template SvConfirmation
  with
    dso : Party
    confirmer : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    vote : DsoVote
    snapshots : Map AuthenticKey Snapshot
    expiresAt : Time
  where
    signatory dso, confirmer

    ensure acceptsVote resolution.mechanism vote

    choice SvConfirmation_Consume : ()
      controller dso
      do pure ()

    choice SvConfirmation_Expire : ()
      controller dso
      do
        now <- getTime
        require "the confirmation has expired" (now >= expiresAt)

instance HasCheckedFetch SvConfirmation ResolutionInfo where
  contractGroupId confirmation = confirmation.resolution

instance IsBallot SvConfirmation DsoVote where
  votesOf confirmation = Map.fromList [(confirmation.confirmer, Voted confirmation.vote)]
  snapshotsOf confirmation = confirmation.snapshots
  actionOf confirmation = confirmation.actionCid
  consume cid = exercise cid SvConfirmation_Consume
