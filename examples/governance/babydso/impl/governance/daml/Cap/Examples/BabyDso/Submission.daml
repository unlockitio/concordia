module Cap.Examples.BabyDso.Submission where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap
import qualified DA.Traversable as Traversable

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.Types (AuthenticKey, Snapshot, ResolutionInfo (..))
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.BallotV1 (Ballot, BallotView (..), Vote (..))


confirmationMechanismName : Text
confirmationMechanismName = "confirmation"

weightedVoteMechanismName : Text
weightedVoteMechanismName = "weighted-vote"


------------------  VOTE KINDS  ------------------
-- Both ballots are counted through the Ballot interface, so their votes are
-- AnyValue in the view.
--
-- The weighted vote is a set of named numbers, such as the transfer fee and
-- the entry fee, encoded as AV_Map of AV_Decimal. Cap.Governance.Utils.Votes
-- has no structured vote kind yet, so BabyDso defines the pair here.
--
-- The confirmation vote is the outcome itself, already an AnyValue: it is
-- exposed as is and decoded with Some.

-- | Encodes named numbers as AV_Map of AV_Decimal.
encodeParametersVote : Vote (TextMap Decimal) -> Vote AnyValue
encodeParametersVote = fmap toAnyValue

-- | Decodes named numbers from AV_Map of AV_Decimal.
decodeParametersVote : Vote AnyValue -> Optional (Vote (TextMap Decimal))
decodeParametersVote = Traversable.mapA fromAnyValue

sameParameters : [TextMap Decimal] -> Bool
sameParameters votes = case map (map fst . TextMap.toList) votes of
  [] -> True
  first :: rest -> all (== first) rest


template SharedBallot
  with
    dso : Party
    svs : Set Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    openingWeights : Map Party Decimal
    snapshots : Map AuthenticKey Snapshot
    votes : Map Party (TextMap Decimal)
    votingClosesAt : Time
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs, Map.keys openingWeights

    ensure resolution.mechanism == weightedVoteMechanismName
      && sameParameters (Map.values votes)

    choice SharedBallot_Cast : ContractId SharedBallot
      with
        voter : Party
        vote : TextMap Decimal
      controller voter
      do
        now <- getTime
        require "the voting window is open" (now < votingClosesAt)
        require "the voter has the right to vote: it holds weight at opening"
          (voter `Map.member` openingWeights)
        create this with votes = Map.insert voter vote votes

    choice SharedBallot_Expire : ()
      controller dso
      do
        now <- getTime
        require "the shared ballot has expired" (now >= expiresAt)

    interface instance Ballot for SharedBallot where
      view = BallotView with
        resolution; snapshots; actionCid
        votes = fmap (encodeParametersVote . Voted) votes
        consumers = [dso]
        meta = emptyMetadata

instance HasCheckedFetch SharedBallot ResolutionInfo where
  contractGroupId ballot = ballot.resolution



template SvConfirmation
  with
    dso : Party
    confirmer : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    vote : AnyValue -- the outcome the confirmer confirms
    snapshots : Map AuthenticKey Snapshot
    expiresAt : Time
  where
    signatory dso, confirmer

    ensure resolution.mechanism == confirmationMechanismName

    choice SvConfirmation_Expire : ()
      controller dso
      do
        now <- getTime
        require "the confirmation has expired" (now >= expiresAt)

    interface instance Ballot for SvConfirmation where
      view = BallotView with
        resolution; snapshots; actionCid
        votes = Map.singleton confirmer (Voted vote)
        consumers = [dso]
        meta = emptyMetadata

instance HasCheckedFetch SvConfirmation ResolutionInfo where
  contractGroupId confirmation = confirmation.resolution

