module Cap.Examples.BabyDso.Submission where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap
import qualified DA.Traversable as Traversable

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.Types (AuthenticKey, Snapshot, ResolutionInfo (..))
import Cap.Governance.Types (OwnerId, Reason, Vote (..))
import Cap.Core.Utils (IsAnyValue (..))
import Cap.Governance.ActionV1 (Action)
import Cap.Governance.VoteRecordV1 (VoteRecord, VoteRecordView (..))
import Cap.Governance.VoteTopicV1 (VoteTopic, VoteTopicView (..), VoteTopic_CastVote (..), VoteTopic_CastVoteResult (..))
import Cap.Governance.Utils.VotingRights (partyAsOwnerId)


confirmationMechanismName : Text
confirmationMechanismName = "babydso.confirmation"

weightedVoteMechanismName : Text
weightedVoteMechanismName = "babydso.weighted-vote"


------------------  VOTE KINDS  ------------------
-- Both ballots are counted through the VoteRecord interface, so their votes are
-- AnyValue in the view.
--
-- The weighted vote is a set of named numbers, such as the transfer fee and
-- the entry fee, encoded as AV_Map of AV_Decimal. Cap.Governance.Utils.Votes
-- has no structured vote kind yet, so BabyDso defines the pair here.
--
-- The confirmation vote is the outcome itself, already an AnyValue: it is
-- exposed as is and decoded with Some.

-- | Encodes named numbers as AV_Map of AV_Decimal.
encodeParametersVote : Vote (TextMap Decimal) -> Vote AnyValue
encodeParametersVote = fmap toAnyValue

-- | Decodes named numbers from AV_Map of AV_Decimal.
decodeParametersVote : Vote AnyValue -> Optional (Vote (TextMap Decimal))
decodeParametersVote = Traversable.mapA fromAnyValue

sameParameters : [TextMap Decimal] -> Bool
sameParameters votes = case map (map fst . TextMap.toList) votes of
  [] -> True
  first :: rest -> all (== first) rest


template SharedBallot
  with
    dso : Party
    svs : Set Party
    resolution : ResolutionInfo
    proposer : Party
    subject : Reason
    actionCid : ContractId Action
    openingWeights : Map OwnerId Decimal
    snapshots : Map AuthenticKey Snapshot
    votes : Map Party (TextMap Decimal)
    votingClosesAt : Time
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs

    ensure resolution.mechanism == weightedVoteMechanismName
      && sameParameters (Map.values votes)

    choice SharedBallot_Cast : ContractId SharedBallot
      with
        voter : Party
        vote : TextMap Decimal
      controller voter
      do
        now <- getTime
        require "the voting window is open" (now < votingClosesAt)
        require "the voter has the right to vote: it holds weight at opening"
          (partyAsOwnerId voter `Map.member` openingWeights)
        create this with votes = Map.insert voter vote votes

    choice SharedBallot_Expire : ()
      controller dso
      do
        now <- getTime
        require "the shared ballot has expired" (now >= expiresAt)

    interface instance VoteRecord for SharedBallot where
      view = VoteRecordView with
        resolution; snapshots; action = Some actionCid
        votes = Map.fromList
          [(partyAsOwnerId voter, encodeParametersVote (Voted vote)) | (voter, vote) <- Map.toList votes]
        consumers = [dso]
        meta = emptyMetadata

    -- The proposal is the shared ballot itself: a cast recreates it with the
    -- vote added. Each SV votes for its own OwnerId, and a weighted vote has
    -- no abstention. Vote reasons are not kept.
    interface instance VoteTopic for SharedBallot where
      view = VoteTopicView with
        resolution; subject
        proposer = partyAsOwnerId proposer
        action = Some actionCid
        voteBefore = Some votingClosesAt
        effectiveAt = None
        meta = emptyMetadata
      voteTopic_castVoteImpl self arg = do
        require "the caster casts for its own OwnerId" (arg.ownerId == partyAsOwnerId arg.caster)
        vote <- case decodeParametersVote arg.vote of
          Some (Voted vote) -> pure vote
          _ -> abort "a weighted vote is a map of named decimals, and cannot abstain"
        cid <- exercise (fromInterfaceContractId @SharedBallot self) SharedBallot_Cast with
          voter = arg.caster; vote
        pure VoteTopic_CastVoteResult with
          created = [coerceContractId cid]
          meta = emptyMetadata

instance HasCheckedFetch SharedBallot ResolutionInfo where
  contractGroupId ballot = ballot.resolution



template SvConfirmation
  with
    dso : Party
    confirmer : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    vote : AnyValue -- the outcome the confirmer confirms
    snapshots : Map AuthenticKey Snapshot
    expiresAt : Time
  where
    signatory dso, confirmer

    ensure resolution.mechanism == confirmationMechanismName

    choice SvConfirmation_Expire : ()
      controller dso
      do
        now <- getTime
        require "the confirmation has expired" (now >= expiresAt)

    interface instance VoteRecord for SvConfirmation where
      view = VoteRecordView with
        resolution; snapshots; action = Some actionCid
        votes = Map.singleton (partyAsOwnerId confirmer) (Voted vote)
        consumers = [dso]
        meta = emptyMetadata

instance HasCheckedFetch SvConfirmation ResolutionInfo where
  contractGroupId confirmation = confirmation.resolution

