module Cap.Examples.BabyDso.Submission where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap
import qualified DA.Traversable as Traversable

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), require)

import Cap.Core.AuthenticKeyV1 (AuthenticKey)
import Cap.Core.IdentityV1 (Identity (..))
import Cap.Governance.KeyedTargetV1 (Snapshot)
import Cap.Core.ResolutionV1 (ResolutionInfo (..))
import Cap.Core.AnyValue (IsAnyValue (..))
import Cap.Governance.ActionV1 (Action, ActionId)
import Cap.Governance.VoteRecordV1 (CastVote (..), Reason (..), Vote (..), VoteRecord, VoteRecordView (..))


confirmationMechanismName : Text
confirmationMechanismName = "babydso.confirmation"

weightedVoteMechanismName : Text
weightedVoteMechanismName = "babydso.weighted-vote"



-- | Encodes named numbers as AV_Map of AV_Decimal.
encodeParametersVote : Vote (TextMap Decimal) -> Vote AnyValue
encodeParametersVote = fmap toAnyValue

-- | Decodes named numbers from AV_Map of AV_Decimal.
decodeParametersVote : Vote AnyValue -> Optional (Vote (TextMap Decimal))
decodeParametersVote = Traversable.mapA fromAnyValue

-- | One SV's vote on a shared vote record.
data SvVote = SvVote
  with
    parameters : TextMap Decimal
    reason : Optional Reason
    castAt : Time
  deriving (Eq, Show)

sameParameters : [TextMap Decimal] -> Bool
sameParameters votes = case map (map fst . TextMap.toList) votes of
  [] -> True
  first :: rest -> all (== first) rest


template SharedVoteRecord
  with
    dso : Party
    svs : Set Party
    resolution : ResolutionInfo
    proposer : Party
    subject : Reason
    actionCid : ContractId Action
    actionId : ActionId -- the action's id, read from actionCid when the vote opens
    openingWeights : Map Identity Decimal
    snapshots : Map AuthenticKey Snapshot
    votes : Map Party SvVote
    votingClosesAt : Time
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs

    ensure resolution.mechanism == weightedVoteMechanismName
      && sameParameters (map (.parameters) (Map.values votes))

    choice SharedVoteRecord_Cast : ContractId SharedVoteRecord
      with
        voter : Party
        vote : TextMap Decimal
        reason : Optional Reason
      controller voter
      do
        now <- getTime
        require "the voting window is open" (now < votingClosesAt)
        require "the voter has the right to vote: it holds weight at opening"
          (PartyIdentity voter `Map.member` openingWeights)
        create this with
          votes = Map.insert voter (SvVote with parameters = vote; reason; castAt = now) votes

    choice SharedVoteRecord_Expire : ()
      controller dso
      do
        now <- getTime
        require "the shared vote record has expired" (now >= expiresAt)

    -- The decision and every SV's vote on it. A cast through Resolver_CastVote
    -- recreates the record with the vote added. Each SV votes for its own
    -- identity, and a weighted vote has no abstention.
    interface instance VoteRecord for SharedVoteRecord where
      view = VoteRecordView with
        resolution
        requester = PartyIdentity proposer
        reason = subject
        options = [actionId]
        voteBefore = Some votingClosesAt
        effectiveAt = None
        votes = Map.fromList
          [ ( PartyIdentity voter
            , CastVote with
                voter; reason = v.reason; castAt = v.castAt
                vote = encodeParametersVote (Voted v.parameters)
            )
          | (voter, v) <- Map.toList votes
          ]
        targets = snapshots
        consumers = [dso]
        meta = emptyMetadata

instance HasCheckedFetch SharedVoteRecord ResolutionInfo where
  contractGroupId record = record.resolution



template SvConfirmation
  with
    dso : Party
    confirmer : Party
    resolution : ResolutionInfo
    actionCid : ContractId Action
    actionId : ActionId -- the action's id, read from actionCid when the confirmation is made
    vote : AnyValue -- the outcome the confirmer confirms
    snapshots : Map AuthenticKey Snapshot
    confirmedAt : Time
    expiresAt : Time
  where
    signatory dso, confirmer

    ensure resolution.mechanism == confirmationMechanismName

    choice SvConfirmation_Expire : ()
      controller dso
      do
        now <- getTime
        require "the confirmation has expired" (now >= expiresAt)

    -- One SV's confirmation of the outcome. The confirmations of one action
    -- share its resolution and its single option.
    interface instance VoteRecord for SvConfirmation where
      view = VoteRecordView with
        resolution
        requester = PartyIdentity confirmer
        reason = Reason with url = ""; body = "Confirmation by " <> partyToText confirmer
        options = [actionId]
        voteBefore = Some expiresAt
        effectiveAt = None
        votes = Map.singleton (PartyIdentity confirmer) CastVote with
          voter = confirmer; vote = Voted vote; reason = None; castAt = confirmedAt
        targets = snapshots
        consumers = [dso]
        meta = emptyMetadata

instance HasCheckedFetch SvConfirmation ResolutionInfo where
  contractGroupId confirmation = confirmation.resolution

