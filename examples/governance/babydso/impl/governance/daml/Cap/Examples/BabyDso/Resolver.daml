-- | The ChoiceContext key under which a cast through Resolver_CastVote passes
-- the SharedVoteRecord to cast on, as AV_ContractId.
voteRecordContextKey : Text
voteRecordContextKey = "babydso.vote-record"

data ResolveResult r = ResolveResult
  with
    verdict : Verdict r
    executions : [ContractId Executable]
  deriving (Eq, Show)


template DsoResolver
  with
    dso : Party
    svs : Set Party
    resolverId : Text
    rightKeys : Set RightKey -- the voting rights that count and the SV holding each; weights are read when a vote opens
    executionDelay : RelTime
    executionWindow : RelTime
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs

    nonconsuming choice DsoResolver_OpenVote : ContractId SharedVoteRecord
      with
        proposer : Party
        subject : Reason
        resolution : ResolutionInfo
        actionCid : ContractId Action
        rightCids : Map RightKey (ContractId SvWeightSource)
        targetCids : Map AuthenticKey AnyContractId
        vote : TextMap Decimal
        votingClosesAt : Time
        expiresAt : Time
      controller proposer
      do
        requireResolvedBy this self resolution
        require ("the resolution names the mechanism " <> weightedVoteMechanismName) (resolution.mechanism == weightedVoteMechanismName)
        openingWeights <- fetchSummedWeights rightKeys rightCids
        require "the proposer is a voter: it holds weight at opening"
          (PartyIdentity proposer `Map.member` openingWeights)
        action <- fetch actionCid
        snapshots <- snapshotStates action targetCids
        now <- getTime
        create SharedVoteRecord with
          dso; svs; resolution; proposer; subject; actionCid; votingClosesAt; expiresAt; openingWeights
          actionId = (view action).actionId
          snapshots = snapshots
          votes = Map.singleton proposer SvVote with parameters = vote; reason = None; castAt = now

    nonconsuming choice DsoResolver_ResolveVote : ResolveResult (TextMap Decimal)
      with
        sv : Party
        resolution : ResolutionInfo
        recordCid : ContractId SharedVoteRecord
      controller sv
      do
        require "the resolving party is an sv" (sv `Set.member` svs)
        resolveVote this self resolution recordCid

    nonconsuming choice DsoResolver_Confirm : ContractId SvConfirmation
      with
        confirmer : Party
        resolution : ResolutionInfo
        actionCid : ContractId Action
        vote : AnyValue
        targetCids : Map AuthenticKey AnyContractId
        expiresAt : Time
      controller confirmer
      do
        require "the confirmer is an sv" (confirmer `Set.member` svs)
        requireResolvedBy this self resolution
        require ("the resolution names the mechanism " <> confirmationMechanismName) (resolution.mechanism == confirmationMechanismName)
        action <- fetch actionCid
        snapshots <- snapshotStates action targetCids
        now <- getTime
        create SvConfirmation with
          dso; confirmer; resolution; actionCid; vote; expiresAt
          actionId = (view action).actionId
          snapshots = snapshots
          confirmedAt = now

    nonconsuming choice DsoResolver_ResolveConfirmations : ResolveResult AnyValue
      with
        sv : Party
        resolution : ResolutionInfo
        confirmationCids : [ContractId SvConfirmation]
      controller sv
      do
        require "the resolving party is an sv" (sv `Set.member` svs)
        resolveConfirmationsOf this self resolution confirmationCids

    -- Lets a wallet that knows only the interfaces cast and resolve. A weighted
    -- vote is cast on the SharedVoteRecord the choice context names; a
    -- confirmation is made with DsoResolver_Confirm.
    interface instance Resolver for DsoResolver where
      view = ResolverView with
        keyId = resolverId
        mechanisms = [weightedVoteMechanismName, confirmationMechanismName]
        meta = emptyMetadata

      resolver_castVoteImpl resolverCid arg = do
        requireResolvedBy this (fromInterfaceContractId @DsoResolver resolverCid) arg.resolution
        require "the caster casts for its own identity" (arg.identity == PartyIdentity arg.caster)
        require ("a cast through the interface is on the mechanism " <> weightedVoteMechanismName)
          (arg.resolution.mechanism == weightedVoteMechanismName)
        recordCid <- case TextMap.lookup voteRecordContextKey arg.extraArgs.context.values of
          Some (AV_ContractId cid) -> pure (coerceContractId cid : ContractId SharedVoteRecord)
          _ -> abort ("the choice context carries no vote record under " <> voteRecordContextKey)
        _ <- fetchChecked arg.resolution recordCid
        vote <- case decodeParametersVote arg.vote of
          Some (Voted vote) -> pure vote
          _ -> abort "a weighted vote is a map of named decimals, and cannot abstain"
        cid <- exercise recordCid SharedVoteRecord_Cast with
          voter = arg.caster; vote; reason = arg.reason
        pure Resolver_CastVoteResult with
          created = [coerceContractId cid]
          meta = emptyMetadata

      resolver_resolveImpl resolverCid arg = do
        let self = fromInterfaceContractId @DsoResolver resolverCid
        require "the resolving parties are svs" (not (null arg.actors) && all (`Set.member` svs) arg.actors)
        if arg.resolution.mechanism == weightedVoteMechanismName
          then do
            recordCid <- case arg.voteRecordCids of
              [cid] -> pure (fromInterfaceContractId @SharedVoteRecord cid)
              _ -> abort "a weighted vote is resolved on its one shared vote record"
            toResolveResult <$> resolveVote this self arg.resolution recordCid
          else toResolveResult <$> resolveConfirmationsOf this self arg.resolution
            (map (fromInterfaceContractId @SvConfirmation) arg.voteRecordCids)

-- | Every sv has one vote, cast by itself.
instance HasWeights DsoResolver where
  weightsOf resolver = Map.fromList [(PartyIdentity sv, 1.0) | sv <- Set.toList resolver.svs]

-- | Each sv acts for itself, a PartyIdentity, so no identity needs a mapping.
instance HasActingParties DsoResolver where
  actingPartiesOf _ = Map.empty

-- | The key resolutions name this resolver by.
instance HasCheckedFetch DsoResolver AuthenticKey where
  contractGroupId resolver = AuthenticKey with
    authorities = Set.fromList [resolver.dso]
    id = resolver.resolverId


data RightKey = RightKey
  with
    authKey : AuthenticKey
    sv : Party
  deriving (Eq, Ord, Show)

instance HasCheckedFetch SvWeightSource RightKey where
  contractGroupId source = RightKey with
    authKey = signatoriesKey source.name source
    sv = source.sv

instance HasWeights SvWeightSource where
  weightsOf source = Map.singleton (PartyIdentity source.sv) source.weight


-- | Resolves a weighted vote on its shared vote record.
resolveVote
  : DsoResolver -> ContractId DsoResolver -> ResolutionInfo -> ContractId SharedVoteRecord
  -> Update (ResolveResult (TextMap Decimal))
resolveVote resolver self resolution recordCid = do
  require ("the resolution names the mechanism " <> weightedVoteMechanismName) (resolution.mechanism == weightedVoteMechanismName)
  let cid = toInterfaceContractId @VoteRecord recordCid
  presented <- fetchSharedVoteRecord resolver self [] resolution cid
  let record = fromSomeNote "the presented vote record is not a SharedVoteRecord" (fromInterface @SharedVoteRecord presented)
  consumeVoteRecords [cid]
  resolveWeightedVote resolver record

-- | Resolves the confirmations of one action.
resolveConfirmationsOf
  : DsoResolver -> ContractId DsoResolver -> ResolutionInfo -> [ContractId SvConfirmation]
  -> Update (ResolveResult AnyValue)
resolveConfirmationsOf resolver self resolution confirmationCids = do
  require ("the resolution names the mechanism " <> confirmationMechanismName) (resolution.mechanism == confirmationMechanismName)
  presented <- fetchVoteRecords resolver self [validateContractSignedByActingParties resolver] resolution
    (map (toInterfaceContractId @VoteRecord) confirmationCids)
  let (cids, records) = unzip presented
      confirmations = map
        (fromSomeNote "a presented confirmation is not an SvConfirmation" . fromInterface @SvConfirmation)
        records
  consumeVoteRecords cids
  resolveConfirmations resolver confirmations

toResolveResult : IsAnyValue r => ResolveResult r -> Resolver_ResolveResult
toResolveResult result = Resolver_ResolveResult with
  status = case result.verdict of
    Decided _ -> RS_Decided
    Undecided -> RS_Undecided
    Lapsed -> RS_Lapsed
  outcome = case result.verdict of
    Decided winner -> Some (toAnyValue winner)
    _ -> None
  executions = result.executions
  meta = emptyMetadata

resolveWeightedVote
  : DsoResolver -> SharedVoteRecord -> Update (ResolveResult (TextMap Decimal))
resolveWeightedVote resolver record = do
  now <- getTime
  requireMet (validClosed "the voting window" record.votingClosesAt now)
  require "the proposal has not expired" (now < record.expiresAt)

  let actionCid = record.actionCid
      snapshots = record.snapshots
  let weights = record.openingWeights
      records = [toInterface @VoteRecord record]
  requireMetFrom
    [validVotes decodeParametersVote (const [])]
    [validateDistinctIdentitiesAmong]
    records
  let counted = casts decodeParametersVote weights records
      verdict = decide (atLeastShareOfTotal 2 3) weightedMedianByField counted
  executions <- case verdict of
    Decided winner -> do
      action <- fetch actionCid
      require "the executed action is the option the vote is on" ((view action).actionId == record.actionId)
      let opensAt = now `addRelTime` resolver.executionDelay
      result <- exercise actionCid Action_AuthorizeExecution with
        actors = [resolver.dso]
        executionTerms = ExecutionTerms with
          authorities = Set.fromList [resolver.dso]
          executors = [[sv] | sv <- Set.toList resolver.svs]
          cancellers = []
          opensAt
          cancelAfter = opensAt
          expiresAt = Some (opensAt `addRelTime` resolver.executionWindow)
          meta = emptyMetadata
        outcome = Some (toAnyValue winner)
        snapshots = snapshots
        extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      pure result.executionCids
    _ -> pure []
  pure ResolveResult with verdict; executions

weightedMedianByField : Tally (TextMap Decimal) (TextMap Decimal)
weightedMedianByField casts = case [parameters | Cast with vote = Voted parameters <- Map.values casts] of
  [] -> None
  first :: _
    | TextMap.null first -> None
    | otherwise -> TextMap.fromList <$> forA (map fst (TextMap.toList first)) (\field -> do
        value <- weightedMedian
          (fmap (\c -> Cast with weight = c.weight; vote = fieldVote field c.vote) casts)
        pure (field, value))
  where
    fieldVote : Text -> Vote (TextMap Decimal) -> Vote Decimal
    fieldVote field (Voted parameters) = optional Abstained Voted (TextMap.lookup field parameters)
    fieldVote _ Abstained = Abstained
    fieldVote _ Absent = Absent


resolveConfirmations
  : DsoResolver -> [SvConfirmation] -> Update (ResolveResult AnyValue)
resolveConfirmations resolver confirmations = do
  now <- getTime
  require "no confirmation has expired" (all ((now <) . (.expiresAt)) confirmations)
  let records = map (toInterface @VoteRecord) confirmations
      actionCid = fromSomeNote "the confirmations name different actions, or there are none"
        (sameOptional (map (.actionCid) confirmations))
      snapshots = expectSameSnapshots records
  option <- case expectSameAction records of
    [option] -> pure option
    _ -> abort "a confirmation has exactly one option"
  let counted = casts Some (weightsOf resolver) records
      verdict = decide (atLeastVotes (byzantineQuorum (Set.size resolver.svs))) unanimous counted
  outcome <- case verdict of
    Decided outcome -> pure outcome
    _ -> abort "too few svs confirmed one outcome"
  action <- fetch actionCid
  require "the executed action is the option the svs confirmed" ((view action).actionId == option)

  result <- exercise actionCid Action_AuthorizeExecution with
    actors = [resolver.dso]
    executionTerms = ExecutionTerms with
      authorities = Set.fromList [resolver.dso]
      executors = [[sv] | sv <- Set.toList resolver.svs]
      cancellers = []
      opensAt = now
      cancelAfter = now
      expiresAt = Some (now `addRelTime` resolver.executionWindow)
      meta = emptyMetadata
    outcome = Some outcome
    snapshots
    extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
  pure ResolveResult with
    verdict = Decided outcome
    executions = result.executionCids

byzantineQuorum : Int -> Int
byzantineQuorum voters =
  let tolerated = floor (intToDecimal (voters - 1) / 3.0)
  in ceiling (intToDecimal (voters + tolerated + 1) / 2.0)
