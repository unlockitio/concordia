module Cap.Examples.BabyDso.Resolver where

import Prelude hiding (Action)

import DA.Map (Map)
import qualified DA.Map as Map
import DA.Set (Set)
import qualified DA.Set as Set
import DA.TextMap (TextMap)
import qualified DA.TextMap as TextMap
import DA.Time (RelTime, addRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Util (HasCheckedFetch (..), fetchChecked, require)

import Cap.Core.Types (AuthenticKey (..), ExecutionAction (..), ExecutionCore (..), ResolutionInfo (..))
import Cap.Core.Utils
  ( IsAnyValue (..), fetchGroup, requireClosed, requireMet, requireMetFrom, requireResolvedBy, signedKey )
import Cap.Governance.ActionV1
import Cap.Governance.BallotV1 (Ballot)
import Cap.Governance.ExecutableV1 (Executable)
import Cap.Governance.Utils
  ( Cast (..), HasVotingRights (..), Tally, Verdict (..), Vote (..), atLeastShareOfTotal, atLeastVotes
  , casts, consumeBallots, decide, distinctVotersAmongBallots, equalWeights, expectUniformAction
  , expectUniformSnapshots, fetchWeightsPerContract, nonNegativeWeights, snapshotStates, unanimous
  , votersEligible, votesDecodable, weightedMedian )

import Cap.Examples.BabyDso.Rights
import Cap.Examples.BabyDso.Submission


data ResolveResult r = ResolveResult
  with
    verdict : Verdict r
    executions : [ContractId Executable]
  deriving (Eq, Show)


template DsoResolver
  with
    dso : Party
    svs : Set Party
    resolverId : Text
    rightKeys : Set RightKey -- the voting rights that count and the SV holding each; weights are read when a vote opens
    executionDelay : RelTime
    executionWindow : RelTime
    expiresAt : Time
  where
    signatory dso
    observer Set.toList svs

    nonconsuming choice DsoResolver_OpenVote : ContractId SharedBallot
      with
        proposer : Party
        resolution : ResolutionInfo
        actionCid : ContractId Action
        rightCids : Map RightKey (ContractId SvWeightSource)
        targetCids : Map AuthenticKey AnyContractId
        vote : TextMap Decimal
        votingClosesAt : Time
        expiresAt : Time
      controller proposer
      do
        requireResolvedBy (resolverKey this) (coerceContractId self) resolution
        require ("the resolution names the mechanism " <> weightedVoteMechanismName) (resolution.mechanism == weightedVoteMechanismName)
        openingWeights <- fetchWeightsPerContract rightKeys rightCids
        require "the proposer is a voter: it holds weight at opening"
          (proposer `Map.member` openingWeights)
        action <- fetch actionCid
        snapshots <- snapshotStates action targetCids
        create SharedBallot with
          dso; svs; resolution; actionCid; votingClosesAt; expiresAt; openingWeights
          snapshots = snapshots
          votes = Map.singleton proposer vote

    nonconsuming choice DsoResolver_ResolveVote : ResolveResult (TextMap Decimal)
      with
        sv : Party
        resolution : ResolutionInfo
        ballotCid : ContractId SharedBallot
      controller sv
      do
        require "the resolving party is an sv" (sv `Set.member` svs)
        requireResolvedBy (resolverKey this) (coerceContractId self) resolution
        require ("the resolution names the mechanism " <> weightedVoteMechanismName) (resolution.mechanism == weightedVoteMechanismName)
        ballot <- fetchChecked resolution ballotCid
        consumeBallots [toInterfaceContractId @Ballot ballotCid]
        resolveWeightedVote this ballot

    nonconsuming choice DsoResolver_Confirm : ContractId SvConfirmation
      with
        confirmer : Party
        resolution : ResolutionInfo
        actionCid : ContractId Action
        vote : AnyValue
        targetCids : Map AuthenticKey AnyContractId
        expiresAt : Time
      controller confirmer
      do
        require "the confirmer is an sv" (confirmer `Set.member` svs)
        requireResolvedBy (resolverKey this) (coerceContractId self) resolution
        require ("the resolution names the mechanism " <> confirmationMechanismName) (resolution.mechanism == confirmationMechanismName)
        action <- fetch actionCid
        snapshots <- snapshotStates action targetCids
        create SvConfirmation with
          dso; confirmer; resolution; actionCid; vote; expiresAt
          snapshots = snapshots

    nonconsuming choice DsoResolver_ResolveConfirmations : ResolveResult AnyValue
      with
        sv : Party
        resolution : ResolutionInfo
        confirmationCids : [ContractId SvConfirmation]
      controller sv
      do
        require "the resolving party is an sv" (sv `Set.member` svs)
        requireResolvedBy (resolverKey this) (coerceContractId self) resolution
        require ("the resolution names the mechanism " <> confirmationMechanismName) (resolution.mechanism == confirmationMechanismName)
        presented <- fetchGroup resolution confirmationCids
        let (cids, confirmations) = unzip presented
        consumeBallots (map (toInterfaceContractId @Ballot) cids)
        resolveConfirmations this confirmations

resolverKey : DsoResolver -> AuthenticKey
resolverKey resolver = AuthenticKey with
  authorities = Set.fromList [resolver.dso]
  id = resolver.resolverId


data RightKey = RightKey
  with
    authKey : AuthenticKey
    sv : Party
  deriving (Eq, Ord, Show)

instance HasCheckedFetch SvWeightSource RightKey where
  contractGroupId source = RightKey with
    authKey = signedKey source.name source
    sv = source.sv

instance HasVotingRights SvWeightSource where
  rightsOf source = Map.singleton source.sv source.weight


resolveWeightedVote
  : DsoResolver -> SharedBallot -> Update (ResolveResult (TextMap Decimal))
resolveWeightedVote resolver ballot = do
  now <- getTime
  requireClosed "the voting window has closed" now ballot.votingClosesAt
  require "the proposal has not expired" (now < ballot.expiresAt)

  let actionCid = ballot.actionCid
      snapshots = ballot.snapshots
  -- The window and the opening weights are read from the typed ballot; the
  -- votes are counted through the Ballot interface.
  let weights = ballot.openingWeights
      ballots = [toInterface @Ballot ballot]
  requireMet (nonNegativeWeights weights)
  requireMetFrom
    [votesDecodable decodeParametersVote, votersEligible (Set.fromList (Map.keys weights))]
    [distinctVotersAmongBallots]
    ballots
  let counted = casts decodeParametersVote weights ballots
      verdict = decide (atLeastShareOfTotal 2 3) weightedMedianByField counted
  executions <- case verdict of
    Decided winner -> do
      let opensAt = now `addRelTime` resolver.executionDelay
      result <- exercise actionCid Action_AuthorizeExecution with
        actors = [resolver.dso]
        executionCore = ExecutionCore with
          authorities = Set.fromList [resolver.dso]
          availableActions = Map.fromList [(EA_Execute, [[sv] | sv <- Set.toList resolver.svs])]
          opensAt
          cancelAfter = opensAt
          expiresAt = Some (opensAt `addRelTime` resolver.executionWindow)
          meta = emptyMetadata
        outcome = Some (toAnyValue winner)
        snapshots = snapshots
        extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      pure result.executionCids
    _ -> pure []
  pure ResolveResult with verdict; executions

weightedMedianByField : Tally (TextMap Decimal) (TextMap Decimal)
weightedMedianByField casts = case [parameters | Cast with vote = Voted parameters <- Map.values casts] of
  [] -> None
  first :: _
    | TextMap.null first -> None
    | otherwise -> TextMap.fromList <$> forA (map fst (TextMap.toList first)) (\field -> do
        value <- weightedMedian
          (fmap (\c -> Cast with weight = c.weight; vote = fieldVote field c.vote) casts)
        pure (field, value))
  where
    fieldVote : Text -> Vote (TextMap Decimal) -> Vote Decimal
    fieldVote field (Voted parameters) = optional Abstained Voted (TextMap.lookup field parameters)
    fieldVote _ Abstained = Abstained
    fieldVote _ Absent = Absent


resolveConfirmations
  : DsoResolver -> [SvConfirmation] -> Update (ResolveResult AnyValue)
resolveConfirmations resolver confirmations = do
  now <- getTime
  require "no confirmation has expired" (all ((now <) . (.expiresAt)) confirmations)
  -- The expiry is read from the typed confirmations; the votes are counted
  -- through the Ballot interface. A confirmation's vote is the outcome itself,
  -- so it is decoded with Some.
  let ballots = map (toInterface @Ballot) confirmations
      actionCid = expectUniformAction ballots
      snapshots = expectUniformSnapshots ballots
  requireMetFrom [votersEligible resolver.svs] [distinctVotersAmongBallots] ballots
  let counted = casts Some (equalWeights resolver.svs) ballots
      verdict = decide (atLeastVotes (byzantineQuorum (Set.size resolver.svs))) unanimous counted
  outcome <- case verdict of
    Decided outcome -> pure outcome
    _ -> abort "too few svs confirmed one outcome"

  result <- exercise actionCid Action_AuthorizeExecution with
    actors = [resolver.dso]
    executionCore = ExecutionCore with
      authorities = Set.fromList [resolver.dso]
      availableActions = Map.fromList [(EA_Execute, [[sv] | sv <- Set.toList resolver.svs])]
      opensAt = now
      cancelAfter = now
      expiresAt = Some (now `addRelTime` resolver.executionWindow)
      meta = emptyMetadata
    outcome = Some outcome
    snapshots
    extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
  pure ResolveResult with
    verdict = Decided outcome
    executions = result.executionCids

byzantineQuorum : Int -> Int
byzantineQuorum voters =
  let tolerated = floor (intToDecimal (voters - 1) / 3.0)
  in ceiling (intToDecimal (voters + tolerated + 1) / 2.0)
