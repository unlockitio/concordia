module Cap.Examples.BabyDso.Demo where

import DA.Assert ((===))
import DA.List (sort)
import qualified DA.Map as Map
import Daml.Script hiding (AnyContractId)

import qualified DA.TextMap as TextMap

import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyMetadata)

import Cap.Governance.VoteRecordV1 (Vote (..), VoteRecord)
import Cap.Governance.ResolverV1 (Resolver, Resolver_CastVote (..))
import Cap.Core.IdentityV1 (Identity (..))
import Cap.Governance.Count (Verdict (..))

import Cap.Examples.BabyDso.Config
import Cap.Examples.BabyDso.Resolver (voteRecordContextKey)
import Cap.Examples.BabyDso.Submission (SharedVoteRecord, encodeParametersVote, weightedVoteMechanismName)

import Cap.Examples.BabyDso.Demo.Fixture


svsSetBothFees : Script ()
svsSetBothFees = do
  f <- setupAs "happy"

  opened <- openVoteAs f f.sv1 (feeVote 0.05 2.0)
  Some record <- queryContractId f.sv1 opened
  record.openingWeights === Map.fromList [(PartyIdentity f.sv1, 5.0), (PartyIdentity f.sv2, 3.0), (PartyIdentity f.sv3, 1.0)]

  withSv2 <- castAs f f.sv2 opened (feeVote 0.06 2.5)
  recordCid <- castAs f f.sv3 withSv2 (feeVote 0.09 4.0)
  Some cast <- queryContractId f.sv1 recordCid
  Map.keys cast.votes === sort [f.sv1, f.sv2, f.sv3]

  setTime f.terms.votingClosesAt
  result <- resolveVoteAs f f.sv1 recordCid
  result.verdict === Decided (feeParameters 0.05 2.0)
  [execution] <- pure result.executions
  queryContractId f.sv1 recordCid >>= (=== None)

  Some pending <- queryInterfaceContractId f.sv2 execution
  setTime pending.executionTerms.opensAt
  executed <- executeAs f f.sv2 execution
  length executed.created === 2
  queryInterfaceContractId f.sv2 execution >>= (=== None)

  feesNow f >>= (=== (0.05, 2.0))
  [(_, config)] <- query @AmuletConfig f.amuletAuthority
  config.epoch === openingEpoch + 1

svsConfirmBothFees : Script ()
svsConfirmBothFees = do
  f <- setupAs "confirm"
  let confirmed = feeValue 0.04 1.5

  sv2Confirmation <- confirmAs f f.sv2 confirmed
  sv3Confirmation <- confirmAs f f.sv3 confirmed

  result <- resolveConfirmationsAs f f.sv1 [sv2Confirmation, sv3Confirmation]
  result.verdict === Decided confirmed
  [execution] <- pure result.executions
  queryContractId f.dso sv2Confirmation >>= (=== None)
  queryContractId f.dso sv3Confirmation >>= (=== None)

  executed <- executeAs f f.sv1 execution
  length executed.created === 2
  queryInterfaceContractId f.sv1 execution >>= (=== None)

  feesNow f >>= (=== (0.04, 1.5))
  [(_, config)] <- query @AmuletConfig f.amuletAuthority
  config.epoch === openingEpoch + 1


-- A wallet that knows only the interfaces reads the decision through the
-- VoteRecord interface and casts through the Resolver interface, on the record
-- passed in the choice context. An SV cannot cast for another SV's identity.
svCastsThroughTheResolverInterface : Script ()
svCastsThroughTheResolverInterface = do
  f <- setupAs "proposal-interface"
  opened <- openVoteAs f f.sv1 (feeVote 0.05 2.0)
  let recordCid = toInterfaceContractId @VoteRecord opened
      resolverCid = toInterfaceContractId @Resolver f.resolverCid

  Some proposal <- queryInterfaceContractId f.sv2 recordCid
  proposal.resolution.mechanism === weightedVoteMechanismName
  proposal.requester === PartyIdentity f.sv1
  proposal.reason === feeSubject
  proposal.voteBefore === Some f.terms.votingClosesAt
  length proposal.options === 1
  Map.keys proposal.votes === [PartyIdentity f.sv1]

  let castFor identity = exerciseCmd resolverCid Resolver_CastVote with
        caster = f.sv2
        identity
        resolution = proposal.resolution
        vote = encodeParametersVote (Voted (feeVote 0.06 2.5))
        reason = None
        extraArgs = ExtraArgs with
          context = ChoiceContext with
            values = TextMap.fromList [(voteRecordContextKey, AV_ContractId (coerceContractId opened))]
          meta = emptyMetadata
  submitMustFail (actAs f.sv2 <> readAs f.dso) (castFor (PartyIdentity f.sv3))
  result <- submit (actAs f.sv2 <> readAs f.dso) (castFor (PartyIdentity f.sv2))

  [created] <- pure result.created
  Some cast <- queryContractId f.sv1 (coerceContractId created : ContractId SharedVoteRecord)
  Map.keys cast.votes === sort [f.sv1, f.sv2]
